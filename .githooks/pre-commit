#!/usr/bin/env bash
# Pre-commit hook: Formateo y verificación de código Python mediante Ruff.

set -e

STAGED_FILES=()
while IFS= read -r -d '' file; do
    if [[ "$file" == *.py ]]; then
        STAGED_FILES+=("$file")
    fi
done < <(git diff --cached --name-only -z --diff-filter=ACM)

if [ "${#STAGED_FILES[@]}" -eq 0 ]; then
    exit 0
fi

echo "[pre-commit] Formateando archivos Python en stage con Ruff..."

if [ -f "./.venv/Scripts/ruff.exe" ]; then
    RUFF="./.venv/Scripts/ruff.exe"
elif [ -f "./.venv/bin/ruff" ]; then
    RUFF="./.venv/bin/ruff"
elif command -v ruff >/dev/null 2>&1; then
    RUFF="ruff"
else
    echo "[pre-commit] Advertencia: Ruff no está disponible. Omitiendo formato."
    exit 0
fi

"$RUFF" check --fix "${STAGED_FILES[@]}"
"$RUFF" format "${STAGED_FILES[@]}"

git add -- "${STAGED_FILES[@]}"
exit 0
