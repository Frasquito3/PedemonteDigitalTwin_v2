				 	<EmbeddedIcon>false</EmbeddedIcon>				
					<Id>1787148083269</Id>
					<Name><![CDATA[btnAgregarPedidoFormulario]]></Name>
					<X>110</X><Y>553</Y>
					<Label><X>0</X><Y>-10</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
					<BasicProperties Width="205" Height="32">
                        <EmbeddedIcon>false</EmbeddedIcon>	
						<TextColor>-15257011</TextColor>
						<Enabled>true</Enabled>
						<EnableExpression><![CDATA[instanciaInterfazActual == null
&&
!ejecucionEnCurso
&&
!pypelineSolicitudEnCurso]]></EnableExpression>
						<ActionCode><![CDATA[boolean pedidoAgregado =
    agregarPedidoFormulario();


if (pedidoAgregado) {

    // Restablecer las variables del formulario.

    pedidoIdFormulario = "";

    clienteFormulario = "";

    direccionFormulario = "";

    barrioFormulario = "";

    unidadesFormulario = "1";

    latitudFormulario = "";

    longitudFormulario = "";

    requiereVolcadorFormulario = false;

    tieneVentanaFormulario = false;


    // Recuperar el horario normal del turno actual.

    actualizarHorarioFormulario();


    // Sincronizar visualmente los campos de texto.

    editPedidoIdFormulario.setText(
        pedidoIdFormulario
    );

    editClienteFormulario.setText(
        clienteFormulario
    );

    editDireccionFormulario.setText(
        direccionFormulario
    );

    editBarrioFormulario.setText(
        barrioFormulario
    );

    editUnidadesFormulario.setText(
        unidadesFormulario
    );

    editLatitudFormulario.setText(
        latitudFormulario
    );

    editLongitudFormulario.setText(
        longitudFormulario
    );


    // Restablecer los controles booleanos.

    checkRequiereVolcadorFormulario
        .setSelected(
            false
        );

    checkTieneVentanaFormulario
        .setSelected(
            false
        );


    // Sincronizar los horarios restaurados.

    editHoraDesdeFormulario.setText(
        horaDesdeFormulario
    );

    editHoraHastaFormulario.setText(
        horaHastaFormulario
    );
}]]></ActionCode>
