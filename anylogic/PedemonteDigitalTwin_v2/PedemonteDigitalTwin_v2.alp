				<FinalTime><![CDATA[300.0]]></FinalTime>	
			</ModelTimeProperties>
			<ObservationField>
				<Name><![CDATA[configurado]]></Name>
				<Type><![CDATA[boolean]]></Type>
			</ObservationField>
			<ObservationField>
				<Name><![CDATA[accionRecibida]]></Name>
				<Type><![CDATA[boolean]]></Type>
			</ObservationField>
			<ObservationField>
				<Name><![CDATA[ejecucionEnCurso]]></Name>
