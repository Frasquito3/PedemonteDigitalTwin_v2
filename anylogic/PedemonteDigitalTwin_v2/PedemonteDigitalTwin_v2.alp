				<Control Type="Button">
				 	<EmbeddedIcon>false</EmbeddedIcon>				
					<Id>1787145329848</Id>
					<Name><![CDATA[btnPrepararInstancia]]></Name>
					<X>1145</X><Y>749</Y>
					<Label><X>0</X><Y>-10</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
					<BasicProperties Width="195" Height="32">
                        <EmbeddedIcon>false</EmbeddedIcon>	
						<TextColor>-15257011</TextColor>
						<Enabled>true</Enabled>
						<EnableExpression><![CDATA[!pedidosFormulario.isEmpty()
&&
instanciaInterfazActual == null
&&
!ejecucionEnCurso
&&
!pypelineSolicitudEnCurso]]></EnableExpression>
						<ActionCode><![CDATA[try {

    InstanciaTurno nuevaInstancia =
        construirInstanciaFormulario();


    guardarInstanciaBaseRepetible(
        nuevaInstancia
    );


    instanciaInterfazActual =
        crearCopiaInstanciaBaseRepetible();


    if (!instanciaBaseAisladaDeActual()) {

        throw new IllegalStateException(
            "La instancia activa comparte "
            + "referencias con la instancia base."
        );
    }


    mostrarInstanciaEnGIS(
        instanciaInterfazActual
    );


    indexarPuntosPedidosGIS(
        instanciaInterfazActual
    );


    limpiarComparacionEstimadaLocal();


    boolean matrizLista =
        verificarCacheVialInstanciaActual();


    if (matrizLista) {

        mensajeInterfazPlanificacion =
            "Instancia preparada."
            + "\nMatriz vial lista."
            + "\nPuede planificar.";

    } else {

        mensajeInterfazPlanificacion =
            "Instancia preparada."
            + "\nFaltan "
            + cacheVialTramosFaltantes
            + " tramos viales."
            + "\nExporte la matriz.";
    }


    traceln(
        resumenInstanciaInterfaz()
    );


    traceln(
        "INSTANCIA BASE AISLADA | "
        + instanciaBaseAisladaDeActual()
    );


} catch (Exception ex) {

    instanciaInterfazActual =
        null;


    limpiarComparacionEstimadaLocal();


    limpiarInstanciaBaseRepetible();


    cacheVialInstanciaCompleta =
        false;


    cacheVialTramosRequeridos =
        0;


    cacheVialTramosFaltantes =
        0;


    cacheVialEstadoInterfaz =
        "ERROR";


    limpiarPedidosGIS();


    mensajeInterfazPlanificacion =
        "Error al preparar instancia: "
        + ex.getClass()
            .getSimpleName()
        + ": "
        + ex.getMessage();


    traceln(
        mensajeInterfazPlanificacion
    );


    ex.printStackTrace();
}]]></ActionCode>
					</BasicProperties>
					<ExtendedProperties>
						<Font Name="SansSerif" Size="10" Style="1"/>
						<LabelText><![CDATA[Preparar operación]]></LabelText>
					</ExtendedProperties>
				</Control>
				<Control Type="Button">
				 	<EmbeddedIcon>false</EmbeddedIcon>				
					<Id>1787145354943</Id>
					<Name><![CDATA[btnLimpiarInstancia]]></Name>
					<X>1355</X><Y>749</Y>
					<Label><X>0</X><Y>-10</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
					<BasicProperties Width="200" Height="32">
                        <EmbeddedIcon>false</EmbeddedIcon>	
						<TextColor>-15257011</TextColor>
						<Enabled>true</Enabled>
						<EnableExpression><![CDATA[(
    !pedidosFormulario.isEmpty()
    ||
    instanciaInterfazActual != null
    ||
    instanciaBaseRepetibleDisponible()
    ||
    comparacionEstimadaDisponible
    ||
    comparacionSimuladaDisponible
)
&&
!ejecucionEnCurso
&&
!pypelineSolicitudEnCurso
&&
!reinicioCompletoSolicitado]]></EnableExpression>
						<ActionCode><![CDATA[solicitarNuevaOperacionConReinicioCompleto();]]></ActionCode>
					</BasicProperties>
