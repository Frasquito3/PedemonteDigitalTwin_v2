			<Text><![CDATA[/**
 * RegistroActividadCamion
 */	
public class RegistroActividadCamion implements Serializable {

	public int camionId = -1;

	public TipoActividadCamion tipo = null;

	public double inicioMinDia = -1.0;

	public double finMinDia = -1.0;

	public double duracionMin = 0.0;

	public int numeroViaje = -1;

	public String pedidoId = "";

	public double distanciaMetros = 0.0;

	public int personasAsignadas = 0;

	public int unidades = 0;


	@Override
	public String toString() {

	    return "RegistroActividadCamion{" +
	        "camionId=" + camionId +
	        ", tipo=" + tipo +
	        ", inicio=" + inicioMinDia +
	        ", fin=" + finMinDia +
	        ", duracion=" + duracionMin +
	        ", viaje=" + numeroViaje +
	        ", pedidoId='" + pedidoId + '\'' +
	        ", distanciaMetros=" + distanciaMetros +
	        ", personas=" + personasAsignadas +
	        ", unidades=" + unidades +
	        '}';
	}

}]]></Text>
