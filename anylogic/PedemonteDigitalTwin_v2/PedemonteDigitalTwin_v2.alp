			<Name><![CDATA[PedidoRuntime]]></Name>
			<Folder>1786556019063</Folder>
			<Text><![CDATA[/**
 * PedidoRuntime
 */	
public class PedidoRuntime implements Serializable {

	public PedidoInput input = null;

	public EstadoPedido estado = EstadoPedido.PENDIENTE;

	public int camionIdAsignado = -1;

	public int numeroViajeAsignado = -1;

	public int ordenEnViaje = -1;

	public double minutoCarga = -1.0;

	public double minutoSalida = -1.0;

	public double minutoLlegada = -1.0;

	public double minutoEntrega = -1.0;
	
	public double minutoInicioEspera = -1.0;

	public double tiempoEsperaClienteMin = 0.0;

	public double minutoInicioDescarga = -1.0;

	public double duracionDescargaMin = 0.0;

	public double anticipacionLlegadaMin = 0.0;

	public double tardanzaLlegadaMin = 0.0;

	public boolean aceptadoAntes = false;

	public boolean llegadaTardia = false;

	public double minutoNoEntrega = -1.0;

	public String motivoNoEntrega = "";


	public PedidoRuntime() {
	}


	public PedidoRuntime(PedidoInput input) {
	    this.input = input;
	}


	@Override
	public String toString() {

	    String id = input == null
	        ? "null"
	        : input.pedidoId;

	    return "PedidoRuntime{" +
	        "pedidoId='" + id + '\'' +
	        ", estado=" + estado +
	        ", camion=" + camionIdAsignado +
	        ", viaje=" + numeroViajeAsignado +
	        ", orden=" + ordenEnViaje +
	        '}';
	}

}]]></Text>
		</JavaClass>
