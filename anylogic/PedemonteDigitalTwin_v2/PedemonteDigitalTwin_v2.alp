				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788043963409</Id>
					<Name><![CDATA[detallePedidosFormulario]]></Name>
					<X>-810</X><Y>3970</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    pedidosFormulario == null
    ||
    pedidosFormulario.isEmpty()
) {

    return "Todavía no hay tareas cargadas.";
}


StringBuilder detalle =
    new StringBuilder();


int limiteVisual =
    7;

int mostradas =
    0;


for (
    PedidoInput pedido
    : pedidosFormulario
) {

    if (pedido == null) {
        continue;
    }


    if (mostradas >= limiteVisual) {
        break;
    }


    String pedidoId =
        pedido.pedidoId == null
        ? ""
        : pedido.pedidoId.trim();


    if (pedidoId.isEmpty()) {

        pedidoId =
            "(sin ID)";
    }


    String cliente =
        pedido.cliente == null
        ? ""
        : pedido.cliente.trim();


    if (cliente.length() > 22) {

        cliente =
            cliente.substring(
                0,
                19
            )
            + "...";
    }


    if (mostradas > 0) {

        detalle.append(
            "\n"
        );
    }


    detalle
        .append(
            mostradas + 1
        )
        .append(
            ". "
        )
        .append(
            pedidoId
        );


    if (!cliente.isEmpty()) {

        detalle
            .append(
                " | "
            )
            .append(
                cliente
            );
    }


    detalle
        .append(
            " | "
        )
        .append(
            pedido.unidadesCapacidad
        )
        .append(
            " u"
        );


    detalle.append(
        "\n   "
    );


    if (
        pedido.tieneVentanaEspecifica
    ) {

        detalle
            .append(
                formatearHoraFormulario(
                    pedido.horaDesdeMin
                )
            )
            .append(
                "-"
            )
            .append(
                formatearHoraFormulario(
                    pedido.horaHastaMin
                )
            );

    } else {

        detalle.append(
            "Sin ventana"
        );
    }


    detalle.append(
        " | "
    );


    if (
        pedido.requiereVolcador
    ) {

        detalle.append(
            "Requiere volcador"
        );

    } else {

        detalle.append(
            "Sin volcador"
        );
    }


    mostradas++;
}


int restantes =
    pedidosFormulario.size()
    - mostradas;


if (restantes > 0) {

    detalle
        .append(
            "\n... y "
        )
        .append(
            restantes
        )
        .append(
            restantes == 1
            ? " tarea más."
            : " tareas más."
        );
}


return detalle.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788044264583</Id>
					<Name><![CDATA[resumenPedidosVisual]]></Name>
					<X>-810</X><Y>4000</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[String resumen = resumenPedidosFormulario();

if (resumen == null || resumen.trim().isEmpty()) {
    return "Sin pedidos cargados.";
}

String[] partes = resumen.split("\\s*\\|\\s*");

if (partes.length < 5) {
    return resumen;
}

return partes[0]
    + "\n"
    + partes[1]
    + "     "
    + partes[2]
    + "\n"
    + partes[3]
    + "     "
    + partes[4];]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788044277808</Id>
					<Name><![CDATA[detallePedidoFormulario]]></Name>
					<X>-810</X><Y>4030</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[indice]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if (
    pedidosFormulario == null
    || indice < 0
    || indice >= pedidosFormulario.size()
) {
    return "";
}

PedidoInput pedido = pedidosFormulario.get(indice);

if (pedido == null) {
    return "";
}

String pedidoId =
    pedido.pedidoId == null
    ? ""
    : pedido.pedidoId.trim();

if (pedidoId.isEmpty()) {
    pedidoId = "(sin ID)";
}

String cliente =
    pedido.cliente == null
    ? ""
    : pedido.cliente.trim();

if (cliente.length() > 24) {
    cliente = cliente.substring(0, 21) + "...";
}

String ventana;

if (pedido.tieneVentanaEspecifica) {
    ventana =
        formatearHoraFormulario(pedido.horaDesdeMin)
        + "–"
        + formatearHoraFormulario(pedido.horaHastaMin);
} else {
    ventana = "Sin ventana";
}

String tipoEntrega =
    pedido.requiereVolcador
    ? "Requiere volcador"
    : "Sin volcador";

String primeraLinea =
    (indice + 1)
    + ". "
    + pedidoId;

if (!cliente.isEmpty()) {
    primeraLinea += " · " + cliente;
}

primeraLinea +=
    " · "
    + pedido.unidadesCapacidad
    + " u";

return primeraLinea
    + "\n"
    + "    "
    + ventana
    + " · "
    + tipoEntrega;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788044298121</Id>
					<Name><![CDATA[pieDetallePedidosFormulario]]></Name>
					<X>-810</X><Y>4060</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int total =
    pedidosFormulario == null
    ? 0
    : pedidosFormulario.size();

if (total == 0) {
    return "No hay tareas para mostrar.";
}

int visibles = Math.min(total, 5);

if (total > visibles) {
    return "Mostrando "
        + visibles
        + " de "
        + total
        + " tareas.";
}

return total == 1
    ? "Mostrando 1 tarea."
    : "Mostrando " + total + " tareas.";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1788101649718</Id>
					<Name><![CDATA[instanciaListaParaComparacion]]></Name>
					<X>-810</X><Y>4090</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return
    instanciaInterfazActual != null
    &&
    cacheVialInstanciaCompleta
    &&
    !ejecucionEnCurso
    &&
    !pypelineSolicitudEnCurso;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788101666326</Id>
					<Name><![CDATA[resumenInstanciaComparacion]]></Name>
					<X>-810</X><Y>4120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[InstanciaTurno instancia =
    obtenerInstanciaResumenComparacion();


if (instancia == null) {

    return
        "Todavía no hay una instancia "
        + "preparada para comparar.";
}


java.util.HashSet<String> pedidosOriginales =
    new java.util.HashSet<String>();

int unidadesTotales = 0;

int tareasConVolcador = 0;

int tareasConVentana = 0;


for (
    PedidoInput pedido
    : instancia.pedidos
) {

    if (pedido == null) {
        continue;
    }


    String pedidoOriginalId =
        pedido.pedidoOriginalId == null
        ? ""
        : pedido.pedidoOriginalId.trim();


    if (pedidoOriginalId.isEmpty()) {

        pedidoOriginalId =
            pedido.pedidoId == null
            ? ""
            : pedido.pedidoId.trim();
    }


    if (!pedidoOriginalId.isEmpty()) {

        pedidosOriginales.add(
            pedidoOriginalId
        );
    }


    unidadesTotales +=
        pedido.unidadesCapacidad;


    if (pedido.requiereVolcador) {

        tareasConVolcador++;
    }


    if (pedido.tieneVentanaEspecifica) {

        tareasConVentana++;
    }
}


String turnoVisible =
    instancia.turno == Turno.MANANA
    ? "MAÑANA"
    : "TARDE";


return
    "Turno: "
    + turnoVisible
    + "  |  Fecha: "
    + instancia.fechaOperacion
    + "  |  Semilla: "
    + instancia.seedEscenario

    + "\nPedidos originales: "
    + pedidosOriginales.size()
    + "  |  Tareas finales: "
    + instancia.pedidos.size()
    + "  |  Unidades: "
    + unidadesTotales

    + "\nVolcador: "
    + tareasConVolcador
    + "  |  Con ventana: "
    + tareasConVentana
    + "  |  Camiones: "
    + instancia.cantidadCamiones
    + " × "
    + instancia.capacidadCamion
    + " u";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788101680622</Id>
					<Name><![CDATA[estadoPreparacionComparacion]]></Name>
					<X>-810</X><Y>4150</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (ejecucionEnCurso) {

    return instanciaBaseRepetibleDisponible()
        ? "Operación en curso. "
            + "La instancia base permanece preservada."
        : "Existe una operación en curso.";
}


if (pypelineSolicitudEnCurso) {

    return
        "Existe una solicitud Python en curso.";
}


if (instanciaInterfazActual != null) {

    if (!cacheVialInstanciaCompleta) {

        return
            "Matriz vial incompleta: faltan "
            + cacheVialTramosFaltantes
            + " tramo(s).";
    }


    return
        "Instancia y matriz vial listas "
        + "para comparar.";
}


if (instanciaBaseRepetibleDisponible()) {

    return
        "Instancia base preservada. "
        + "No existe una instancia activa.";
}


return
    "Prepare una instancia para "
    + "habilitar la comparación.";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788102691197</Id>
					<Name><![CDATA[limpiarComparacionEstimadaLocal]]></Name>
					<X>-810</X><Y>4180</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[limpiarComparacionSimuladaLocal();

limpiarPlanComparacionSeleccionado();


comparacionEstimadaResultados =
    new double[5][20];


comparacionEstimadaMetodoRecibido =
    new boolean[5];


comparacionEstimadaDisponible =
    false;


comparacionEstimadaEstado =
    "Sin comparación estimada.";


comparacionEstimadaResumenPython =
    "SIN_COMPARACION";


comparacionEstimadaFirmaPython =
    "SIN_COMPARACION";


comparacionEstimadaTiempoTotalMs =
    0.0;


metodoPlanComparacionSeleccionado =
    "RL";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1788102708636</Id>
					<Name><![CDATA[indiceMetodoComparacion]]></Name>
					<X>-810</X><Y>4210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metodo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String normalizado =
    metodo == null
    ? ""
    : metodo
        .trim()
        .toUpperCase(
            java.util.Locale.ROOT
        )
        .replace(
            "Í",
            "I"
        );


switch (normalizado) {

    case "RL":
        return 0;

    case "HIBRIDO":
        return 1;

    case "GREEDY":
        return 2;

    case "RANDOM":
        return 3;

    case "GA":
        return 4;

    default:
        return -1;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788102730100</Id>
					<Name><![CDATA[nombreMetodoComparacion]]></Name>
					<X>-810</X><Y>4240</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[codigo]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[switch (codigo) {

    case 0:
        return "RL";

    case 1:
        return "HIBRIDO";

    case 2:
        return "GREEDY";

    case 3:
        return "RANDOM";

    case 4:
        return "GA";

    default:
        return "DESCONOCIDO";
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1788102748612</Id>
					<Name><![CDATA[metodoComparacionRecibido]]></Name>
					<X>-810</X><Y>4270</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metodo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[int indice =
    indiceMetodoComparacion(
        metodo
    );


return
    comparacionEstimadaDisponible
    &&
    indice >= 0
    &&
    indice
        < comparacionEstimadaMetodoRecibido.length
    &&
    comparacionEstimadaMetodoRecibido[
        indice
    ];]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1788102798282</Id>
					<Name><![CDATA[metodoComparacionFactible]]></Name>
					<X>-810</X><Y>4300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metodo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[int indice =
    indiceMetodoComparacion(
        metodo
    );


if (
    !metodoComparacionRecibido(
        metodo
    )
) {

    return false;
}


double[] resultado =
    comparacionEstimadaResultados[
        indice
    ];


return
    resultado != null
    &&
    resultado.length == 20
    &&
    resultado[1] >= 0.5;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788102816331</Id>
					<Name><![CDATA[textoFactibleComparacion]]></Name>
					<X>-810</X><Y>4330</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metodo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (
    !metodoComparacionRecibido(
        metodo
    )
) {

    return "—";
}


return
    metodoComparacionFactible(
        metodo
    )
    ? "Sí"
    : "No";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788102833642</Id>
					<Name><![CDATA[estadoVisualComparacionEstimada]]></Name>
					<X>-810</X><Y>4360</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (pypelineSolicitudEnCurso) {

    if (
        comparacionSimuladaEstado != null
        &&
        comparacionSimuladaEstado.startsWith(
            "Ejecutando comparación simulada"
        )
    ) {

        return
            comparacionSimuladaEstado;
    }


    return
        "Ejecutando RL, HÍBRIDO, "
        + "GREEDY, RANDOM y GA...";
}


if (
    comparacionSimuladaEstado != null
    &&
    comparacionSimuladaEstado.startsWith(
        "Error"
    )
) {

    return
        comparacionSimuladaEstado;
}


if (comparacionSimuladaDisponible) {

    return
        comparacionSimuladaEstado;
}


if (comparacionEstimadaDisponible) {

    return
        comparacionEstimadaEstado;
}


if (
    comparacionEstimadaEstado != null
    &&
    comparacionEstimadaEstado.startsWith(
        "Error"
    )
) {

    return
        comparacionEstimadaEstado;
}


return
    estadoPreparacionComparacion();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788102849202</Id>
					<Name><![CDATA[estadoTablaComparacionEstimada]]></Name>
					<X>-810</X><Y>4390</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    pypelineSolicitudEnCurso
    &&
    comparacionSimuladaEstado != null
    &&
    comparacionSimuladaEstado.startsWith(
        "Ejecutando comparación simulada"
    )
) {

    return
        "Ejecutando cinco corridas externas "
        + "independientes...";
}


if (pypelineSolicitudEnCurso) {

    return
        "Ejecutando comparación estimada...";
}


if (comparacionSimuladaDisponible) {

    return
        comparacionSimuladaEstado;
}


if (comparacionEstimadaDisponible) {

    return
        comparacionEstimadaEstado
        + " Comparación simulada pendiente.";
}


if (
    comparacionSimuladaEstado != null
    &&
    comparacionSimuladaEstado.startsWith(
        "Error"
    )
) {

    return
        comparacionSimuladaEstado;
}


return
    "Todavía no se ejecutó "
    + "la comparación estimada.";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1788102861401</Id>
					<Name><![CDATA[ejecutarComparacionEstimadaPypeline]]></Name>
					<X>-810</X><Y>4420</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    ejecucionEnCurso
    ||
    pypelineSolicitudEnCurso
) {

    comparacionEstimadaEstado =
        "Existe una planificación "
        + "o ejecución en curso.";

    return false;
}


if (
    instanciaInterfazActual == null
) {

    comparacionEstimadaEstado =
        "Prepare una instancia antes "
        + "de ejecutar la comparación.";

    return false;
}


if (
    !verificarCacheVialInstanciaActual()
) {

    comparacionEstimadaEstado =
        "Matriz vial incompleta: faltan "
        + cacheVialTramosFaltantes
        + " tramo(s).";

    return false;
}


if (
    !inicializarSelectorPypeline()
) {

    comparacionEstimadaEstado =
        "No fue posible inicializar "
        + "el selector Python: "
        + pypelineEstadoSelector;

    return false;
}


limpiarComparacionEstimadaLocal();


pypelineSolicitudEnCurso =
    true;


comparacionEstimadaEstado =
    "Ejecutando comparación estimada...";


try {

    InstanciaTurno instancia =
        instanciaInterfazActual;


    double[] instanciaVector =
        construirVectorInstanciaPypeline(
            instancia
        );


    String vectorLiteral =
        pyCommunicator.toJson(
            instanciaVector
        );


    String comando =
        "pedemonte_selector_bridge."
        + "comparar_estimado_vector("
        + vectorLiteral
        + ", "
        + instancia.seedEscenario
        + ", "
        + instancia.seedEjecucion
        + ")";


    double[] vectorComparacion =
        pyCommunicator.runResults(
            double[].class,
            comando
        );


    if (
        vectorComparacion == null
        ||
        vectorComparacion.length < 4
    ) {

        throw new IllegalStateException(
            "Python devolvió un vector "
            + "de comparación vacío "
            + "o incompleto."
        );
    }


    int version =
        (int) Math.round(
            vectorComparacion[0]
        );


    int cantidadMetodos =
        (int) Math.round(
            vectorComparacion[1]
        );


    int camposPorMetodo =
        (int) Math.round(
            vectorComparacion[2]
        );


    int longitudEsperada =
        4
        +
        cantidadMetodos
        *
        camposPorMetodo;


    if (version != 1) {

        throw new IllegalStateException(
            "Versión no soportada del "
            + "protocolo de comparación: "
            + version
        );
    }


    if (cantidadMetodos != 5) {

        throw new IllegalStateException(
            "Python devolvió "
            + cantidadMetodos
            + " métodos; se esperaban 5."
        );
    }


    if (camposPorMetodo != 20) {

        throw new IllegalStateException(
            "Python devolvió "
            + camposPorMetodo
            + " campos por método; "
            + "se esperaban 20."
        );
    }


    if (
        vectorComparacion.length
        != longitudEsperada
    ) {

        throw new IllegalStateException(
            "Longitud incorrecta del "
            + "vector comparativo. "
            + "Esperada="
            + longitudEsperada
            + ", recibida="
            + vectorComparacion.length
            + "."
        );
    }


    comparacionEstimadaTiempoTotalMs =
        vectorComparacion[3];


    int metodosFactibles =
        0;


    for (
        int posicion = 0;
        posicion < cantidadMetodos;
        posicion++
    ) {

        int base =
            4
            +
            posicion
            *
            camposPorMetodo;


        int codigoMetodo =
            (int) Math.round(
                vectorComparacion[base]
            );


        if (
            codigoMetodo < 0
            ||
            codigoMetodo >= 5
        ) {

            throw new IllegalStateException(
                "Código de método inválido: "
                + codigoMetodo
            );
        }


        if (
            comparacionEstimadaMetodoRecibido[
                codigoMetodo
            ]
        ) {

            throw new IllegalStateException(
                "Python devolvió dos veces "
                + "el método "
                + nombreMetodoComparacion(
                    codigoMetodo
                )
                + "."
            );
        }


        double[] bloque =
            new double[20];


        System.arraycopy(
            vectorComparacion,
            base,
            bloque,
            0,
            20
        );


        comparacionEstimadaResultados[
            codigoMetodo
        ] =
            bloque;


        comparacionEstimadaMetodoRecibido[
            codigoMetodo
        ] =
            true;


        if (
            bloque[1] >= 0.5
        ) {

            metodosFactibles++;
        }
    }


    for (
        int indice = 0;
        indice < 5;
        indice++
    ) {

        if (
            !comparacionEstimadaMetodoRecibido[
                indice
            ]
        ) {

            throw new IllegalStateException(
                "No se recibió el resultado "
                + "del método "
                + nombreMetodoComparacion(
                    indice
                )
                + "."
            );
        }
    }


    comparacionEstimadaResumenPython =
        pyCommunicator.runResults(
            String.class,

            (
                "pedemonte_selector_bridge."
                + "obtener_resumen_"
                + "comparacion_estimada()"
            )
        );


    comparacionEstimadaFirmaPython =
        pyCommunicator.runResults(
            String.class,

            (
                "pedemonte_selector_bridge."
                + "obtener_firma_"
                + "comparacion_estimada()"
            )
        );


    if (
        comparacionEstimadaResumenPython
            == null
        ||
        !comparacionEstimadaResumenPython
            .startsWith(
                "OK|"
            )
    ) {

        throw new IllegalStateException(
            "Resumen inesperado de Python: "
            + comparacionEstimadaResumenPython
        );
    }


    if (
        comparacionEstimadaFirmaPython
            == null
        ||
        comparacionEstimadaFirmaPython
            .equals(
                "SIN_COMPARACION"
            )
    ) {

        throw new IllegalStateException(
            "Python no devolvió la firma "
            + "de la comparación."
        );
    }


    comparacionEstimadaDisponible =
        true;


    comparacionEstimadaEstado =
        "Comparación finalizada: "
        + metodosFactibles
        + "/5 métodos factibles"
        + " | "
        + String.format(
            java.util.Locale.US,
            "%.2f",
            comparacionEstimadaTiempoTotalMs
        )
        + " ms.";


    traceln(
        "================================"
    );

    traceln(
        "=== COMPARACIÓN ESTIMADA ======="
    );

    traceln(
        "================================"
    );

    traceln(
        comparacionEstimadaEstado
    );

    traceln(
        comparacionEstimadaResumenPython
    );

    traceln(
        "firma="
        + comparacionEstimadaFirmaPython
    );


    return true;


} catch (Exception ex) {

    String detalleError =
        ex.getClass()
            .getSimpleName()
        + ": "
        + String.valueOf(
            ex.getMessage()
        );


    limpiarComparacionEstimadaLocal();


    comparacionEstimadaEstado =
        "Error de comparación: "
        + detalleError;


    traceln(
        "ERROR COMPARACIÓN ESTIMADA: "
        + detalleError
    );


    ex.printStackTrace();


    return false;


} finally {

    pypelineSolicitudEnCurso =
        false;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double[]]]></ReturnType>
					<Id>1788103248641</Id>
					<Name><![CDATA[bloqueComparacionEstimada]]></Name>
					<X>-810</X><Y>4450</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metodo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[int indice =
    indiceMetodoComparacion(
        metodo
    );


if (
    !comparacionEstimadaDisponible
    ||
    indice < 0
    ||
    indice
        >= comparacionEstimadaResultados.length
    ||
    !comparacionEstimadaMetodoRecibido[
        indice
    ]
) {

    return null;
}


double[] resultado =
    comparacionEstimadaResultados[
        indice
    ];


if (
    resultado == null
    ||
    resultado.length != 20
) {

    return null;
}


return resultado;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788103272209</Id>
					<Name><![CDATA[formatearNumeroComparacion]]></Name>
					<X>-810</X><Y>4480</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[valor]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[decimales]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if (
    Double.isNaN(
        valor
    )
    ||
    Double.isInfinite(
        valor
    )
    ||
    valor < 0.0
) {

    return "—";
}


return String.format(
    java.util.Locale.US,
    "%."
        + decimales
        + "f",
    valor
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788103300296</Id>
					<Name><![CDATA[textoMetricaComparacion]]></Name>
					<X>-810</X><Y>4510</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metodo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[metrica]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[double[] estimado =
    bloqueComparacionEstimada(
        metodo
    );


if (
    estimado == null
    ||
    estimado[1] < 0.5
) {

    return "—";
}


String clave =
    metrica == null
    ? ""
    : metrica
        .trim()
        .toUpperCase(
            java.util.Locale.ROOT
        );


int indiceEstimado;

int indiceSimulado;

int decimales;

boolean entero =
    false;


switch (clave) {

    case "COSTO":

        indiceEstimado = 3;
        indiceSimulado = 3;
        decimales = 2;

        break;


    case "DISTANCIA":

        indiceEstimado = 12;
        indiceSimulado = 4;
        decimales = 2;

        break;


    case "DURACION":

        indiceEstimado = 13;
        indiceSimulado = 5;
        decimales = 1;

        break;


    case "VIAJES":

        indiceEstimado = 14;
        indiceSimulado = 6;
        decimales = 0;
        entero = true;

        break;


    case "TARDANZA":

        indiceEstimado = 16;
        indiceSimulado = 7;
        decimales = 1;

        break;


    case "DESBALANCE":

        indiceEstimado = 17;
        indiceSimulado = 8;
        decimales = 1;

        break;


    case "PLANIFICACION":

        return
            formatearNumeroComparacion(
                estimado[18],
                2
            );


    default:

        return "—";
}


String textoEstimado;


if (entero) {

    textoEstimado =
        String.valueOf(
            (int) Math.round(
                estimado[
                    indiceEstimado
                ]
            )
        );

} else {

    textoEstimado =
        formatearNumeroComparacion(
            estimado[
                indiceEstimado
            ],
            decimales
        );
}


double[] simulado =
    bloqueComparacionSimulada(
        metodo
    );


String textoSimulado =
    "—";


if (
    simulado != null
    &&
    (int) Math.round(
        simulado[1]
    ) == 1
) {

    if (entero) {

        textoSimulado =
            String.valueOf(
                (int) Math.round(
                    simulado[
                        indiceSimulado
                    ]
                )
            );

    } else {

        textoSimulado =
            formatearNumeroComparacion(
                simulado[
                    indiceSimulado
                ],
                decimales
            );
    }
}


return
    textoEstimado
    + " / "
    + textoSimulado;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788103325592</Id>
					<Name><![CDATA[textoDiferenciaCostoComparacion]]></Name>
					<X>-810</X><Y>4540</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metodo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[double[] estimado =
    bloqueComparacionEstimada(
        metodo
    );


double[] simulado =
    bloqueComparacionSimulada(
        metodo
    );


if (
    estimado == null
    ||
    estimado[1] < 0.5
    ||
    simulado == null
    ||
    (int) Math.round(
        simulado[1]
    ) != 1
) {

    return "—";
}


double diferencia =
    simulado[3]
    -
    estimado[3];


if (
    Double.isNaN(
        diferencia
    )
    ||
    Double.isInfinite(
        diferencia
    )
) {

    return "—";
}


if (
    Math.abs(
        diferencia
    ) < 0.005
) {

    diferencia =
        0.0;
}


return String.format(
    java.util.Locale.US,
    "%+.2f",
    diferencia
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788104740442</Id>
					<Name><![CDATA[limpiarPlanComparacionSeleccionado]]></Name>
					<X>-810</X><Y>4570</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[planComparacionSeleccionadoActual =
    null;


vectorPlanComparacionSeleccionado =
    new double[0];


planComparacionSeleccionadoListo =
    false;


metodoPlanComparacionAplicado =
    "";


estadoPlanComparacionSeleccionado =
    "Seleccione un plan factible.";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788104773722</Id>
					<Name><![CDATA[estadoSeleccionPlanComparacion]]></Name>
					<X>-810</X><Y>4600</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    planComparacionSeleccionadoListo
    &&
    planComparacionSeleccionadoActual != null
) {

    return
        estadoPlanComparacionSeleccionado;
}


if (!comparacionEstimadaDisponible) {

    return
        "Ejecute la comparación estimada "
        + "para habilitar la selección de planes.";
}


int cantidadFactibles =
    0;


for (
    int indice = 0;
    indice < 5;
    indice++
) {

    if (
        comparacionEstimadaMetodoRecibido[
            indice
        ]
        &&
        comparacionEstimadaResultados[
            indice
        ] != null
        &&
        comparacionEstimadaResultados[
            indice
        ].length == 20
        &&
        comparacionEstimadaResultados[
            indice
        ][1] >= 0.5
    ) {

        cantidadFactibles++;
    }
}


return
    cantidadFactibles
    + "/5 métodos factibles. "
    + "Seleccione el plan que desea utilizar.";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788104794339</Id>
					<Name><![CDATA[prepararVisualPlanComparacion]]></Name>
					<X>-810</X><Y>4630</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[modo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[plan]]></Name>
						<Type><![CDATA[PlanTurno]]></Type>
					</Parameter>
					<Body><![CDATA[if (plan == null) {

    throw new IllegalArgumentException(
        "El plan seleccionado no puede ser null."
    );
}


double[] resultado =
    bloqueComparacionEstimada(
        modo
    );


if (
    resultado == null
    ||
    resultado.length != 20
) {

    throw new IllegalStateException(
        "No existe el resultado estimado "
        + "del método seleccionado."
    );
}


String modoVisible =
    "HIBRIDO".equals(
        modo
    )
    ? "HÍBRIDO"
    : modo;


String algoritmoResultante =
    plan.algoritmo == null
    ? "—"
    : plan.algoritmo.toString();


reiniciarPanelSelectorVisual(
    modo
);


// La vista utiliza una presentación común para
// cualquier plan recuperado de la comparación.

uiSelectorPoliticaOperacional =
    false;


uiSelectorModoSolicitado =
    modo;


uiSelectorFuente =
    modoVisible;


uiSelectorMotivo =
    "COMPARACION_ESTIMADA";


uiSelectorEstado =
    "PLAN LISTO";


uiSelectorAviso =
    "";


uiSelectorCostoElegido =
    resultado[3];


uiSelectorTiempoMs =
    resultado[18];


uiSelectorCostoGreedy =
    Double.NaN;


uiSelectorCostoGA =
    Double.NaN;


uiSelectorCostoRL =
    Double.NaN;


uiSelectorMejoraGreedyPct =
    Double.NaN;


uiSelectorSeedGA =
    -1L;


uiSelectorLineaPrincipal =
    "Costo estimado | "
    + formatoCostoSelector(
        resultado[3]
    );


uiSelectorLineaSecundaria =
    "Método seleccionado | "
    + modoVisible;


uiSelectorLineaDetalle =
    "Algoritmo resultante | "
    + algoritmoResultante;


uiSelectorLineaResultado =
    "Resultado | Listo para ejecutar";


actualizarColoresSelectorVisual();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1788104829570</Id>
					<Name><![CDATA[seleccionarPlanComparacionParaOperacion]]></Name>
					<X>-810</X><Y>4660</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    ejecucionEnCurso
    ||
    pypelineSolicitudEnCurso
) {

    estadoPlanComparacionSeleccionado =
        "Existe una planificación "
        + "o ejecución en curso.";

    return false;
}


if (
    instanciaInterfazActual == null
) {

    estadoPlanComparacionSeleccionado =
        "La instancia preparada "
        + "ya no está disponible.";

    return false;
}


if (!comparacionEstimadaDisponible) {

    estadoPlanComparacionSeleccionado =
        "Primero debe ejecutarse "
        + "la comparación estimada.";

    return false;
}


int indiceMetodo =
    indiceMetodoComparacion(
        metodoPlanComparacionSeleccionado
    );


if (indiceMetodo < 0) {

    estadoPlanComparacionSeleccionado =
        "Método seleccionado no reconocido.";

    return false;
}


String modo =
    nombreMetodoComparacion(
        indiceMetodo
    );


if (
    !metodoComparacionFactible(
        modo
    )
) {

    estadoPlanComparacionSeleccionado =
        "El método "
        + modo
        + " no produjo un plan factible.";

    return false;
}


if (
    !inicializarSelectorPypeline()
) {

    estadoPlanComparacionSeleccionado =
        "No fue posible acceder "
        + "al selector Python.";

    return false;
}


pypelineSolicitudEnCurso =
    true;


try {

    String firmaDisponible =
        pyCommunicator.runResults(
            String.class,

            (
                "pedemonte_selector_bridge."
                + "obtener_firma_"
                + "comparacion_estimada()"
            )
        );


    if (
        firmaDisponible == null
        ||
        "SIN_COMPARACION".equals(
            firmaDisponible
        )
    ) {

        throw new IllegalStateException(
            "Python ya no conserva "
            + "la comparación estimada."
        );
    }


    if (
        comparacionEstimadaFirmaPython == null
        ||
        !comparacionEstimadaFirmaPython.equals(
            firmaDisponible
        )
    ) {

        throw new IllegalStateException(
            "La firma de la comparación "
            + "ya no coincide con "
            + "la instancia preparada."
        );
    }


    String modoLiteral =
        pyCommunicator.toJson(
            modo
        );


    double[] planVector =
        pyCommunicator.runResults(
            double[].class,

            (
                "pedemonte_selector_bridge."
                + "obtener_plan_"
                + "comparacion_vector("
                + modoLiteral
                + ")"
            )
        );


    if (
        planVector == null
        ||
        planVector.length < 5
    ) {

        throw new IllegalStateException(
            "Python devolvió un plan "
            + "vacío o incompleto."
        );
    }


    PlanTurno plan =
        crearPlanAlpyneDinamico(
            planVector,
            instanciaInterfazActual
        );


    ResultadoValidacionPlan validacion =
        validarPlan(
            instanciaInterfazActual,
            plan
        );


    if (!validacion.valido) {

        throw new IllegalStateException(
            "El plan recuperado no superó "
            + "la validación de AnyLogic: "
            + validacion.errores
        );
    }


    vectorPlanComparacionSeleccionado =
        planVector.clone();


    pypelineUltimoPlanVector =
        planVector.clone();


    planComparacionSeleccionadoActual =
        plan;


    planComparacionSeleccionadoListo =
        true;


    metodoPlanComparacionAplicado =
        modo;


    modoPlanificacionPypeline =
        modo;


    prepararVisualPlanComparacion(
        modo,
        plan
    );


    mostrarPlanEnGIS(
        instanciaInterfazActual,
        plan
    );


    String modoVisible =
        "HIBRIDO".equals(
            modo
        )
        ? "HÍBRIDO"
        : modo;


    estadoPlanComparacionSeleccionado =
        "Plan "
        + modoVisible
        + " preparado para su ejecución.";


    mensajeInterfazPlanificacion =
        "Plan "
        + modoVisible
        + " recuperado de la comparación."
        + "\nRevise el GIS y pulse "
        + "Generar o ejecutar plan.";


    traceln(
        "================================"
    );

    traceln(
        "=== PLAN DE COMPARACIÓN ========"
    );

    traceln(
        "================================"
    );

    traceln(
        "Método seleccionado: "
        + modoVisible
    );

    traceln(
        "Algoritmo resultante: "
        + plan.algoritmo
    );

    traceln(
        "Costo estimado: "
        + plan.costoEstimado
    );

    traceln(
        "Plan recuperado sin regeneración."
    );


    irAVistaOperacion();


    return true;


} catch (Exception ex) {

    String detalleError =
        ex.getClass()
            .getSimpleName()
        + ": "
        + String.valueOf(
            ex.getMessage()
        );


    limpiarPlanComparacionSeleccionado();


    estadoPlanComparacionSeleccionado =
        "Error al seleccionar el plan: "
        + detalleError;


    traceln(
        "ERROR AL SELECCIONAR PLAN "
        + "COMPARATIVO: "
        + detalleError
    );


    ex.printStackTrace();


    return false;


} finally {

    pypelineSolicitudEnCurso =
        false;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[PedidoInput]]></ReturnType>
					<Id>1788107889898</Id>
					<Name><![CDATA[copiarPedidoInput]]></Name>
					<X>-810</X><Y>4690</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[origen]]></Name>
						<Type><![CDATA[PedidoInput]]></Type>
					</Parameter>
					<Body><![CDATA[if (origen == null) {

    throw new IllegalArgumentException(
        "No se puede copiar un PedidoInput null."
    );
}


PedidoInput copia =
    new PedidoInput();


copia.pedidoId =
    origen.pedidoId;

copia.pedidoOriginalId =
    origen.pedidoOriginalId;

copia.numeroParte =
    origen.numeroParte;

copia.totalPartes =
    origen.totalPartes;

copia.turno =
    origen.turno;

copia.latitud =
    origen.latitud;

copia.longitud =
    origen.longitud;

copia.unidadesCapacidad =
    origen.unidadesCapacidad;

copia.requiereVolcador =
    origen.requiereVolcador;

copia.tieneVentanaEspecifica =
    origen.tieneVentanaEspecifica;

copia.horaDesdeMin =
    origen.horaDesdeMin;

copia.horaHastaMin =
    origen.horaHastaMin;

copia.cliente =
    origen.cliente;

copia.direccion =
    origen.direccion;

copia.barrio =
    origen.barrio;

copia.observaciones =
    origen.observaciones;


return copia;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[InstanciaTurno]]></ReturnType>
					<Id>1788107927138</Id>
					<Name><![CDATA[copiarInstanciaTurno]]></Name>
					<X>-810</X><Y>4720</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[origen]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Body><![CDATA[if (origen == null) {

    throw new IllegalArgumentException(
        "No se puede copiar una InstanciaTurno null."
    );
}


InstanciaTurno copia =
    new InstanciaTurno();


copia.instanciaId =
    origen.instanciaId;

copia.fechaOperacion =
    origen.fechaOperacion;

copia.turno =
    origen.turno;

copia.latCorralon =
    origen.latCorralon;

copia.lonCorralon =
    origen.lonCorralon;

copia.capacidadCamion =
    origen.capacidadCamion;

copia.cantidadCamiones =
    origen.cantidadCamiones;

copia.horaInicioTurnoMin =
    origen.horaInicioTurnoMin;

copia.horaFinObjetivoMin =
    origen.horaFinObjetivoMin;

copia.horaFinToleranciaMin =
    origen.horaFinToleranciaMin;

copia.seedEscenario =
    origen.seedEscenario;

copia.seedEjecucion =
    origen.seedEjecucion;


if (origen.pedidos == null) {

    throw new IllegalArgumentException(
        "La instancia de origen no contiene "
        + "una lista de pedidos válida."
    );
}


for (
    PedidoInput pedido
    : origen.pedidos
) {

    copia.pedidos.add(
        copiarPedidoInput(
            pedido
        )
    );
}


return copia;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.util.ArrayList<PedidoInput>]]></ReturnType>
					<Id>1788107964867</Id>
					<Name><![CDATA[construirPedidosOriginalesBase]]></Name>
					<X>-810</X><Y>4750</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Body><![CDATA[java.util.ArrayList<PedidoInput> originales =
    new java.util.ArrayList<PedidoInput>();


if (
    instancia == null
    ||
    instancia.pedidos == null
) {

    return originales;
}


java.util.LinkedHashMap<
    String,
    PedidoInput
> porPedidoOriginal =
    new java.util.LinkedHashMap<
        String,
        PedidoInput
    >();


for (
    PedidoInput tarea
    : instancia.pedidos
) {

    if (tarea == null) {

        throw new IllegalArgumentException(
            "La instancia contiene una tarea null."
        );
    }


    String originalId =
        tarea.pedidoOriginalId == null
        ? ""
        : tarea.pedidoOriginalId.trim();


    if (originalId.isEmpty()) {

        originalId =
            tarea.pedidoId == null
            ? ""
            : tarea.pedidoId.trim();
    }


    if (originalId.isEmpty()) {

        throw new IllegalArgumentException(
            "Existe una tarea sin identificador "
            + "de pedido original."
        );
    }


    PedidoInput original =
        porPedidoOriginal.get(
            originalId
        );


    if (original == null) {

        original =
            copiarPedidoInput(
                tarea
            );


        original.pedidoId =
            originalId;

        original.pedidoOriginalId =
            originalId;

        original.numeroParte =
            1;

        original.totalPartes =
            1;

        original.unidadesCapacidad =
            0;


        porPedidoOriginal.put(
            originalId,
            original
        );
    }


    original.unidadesCapacidad +=
        tarea.unidadesCapacidad;
}


originales.addAll(
    porPedidoOriginal.values()
);


return originales;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788107995922</Id>
					<Name><![CDATA[guardarInstanciaBaseRepetible]]></Name>
					<X>-810</X><Y>4780</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Body><![CDATA[if (instancia == null) {

    throw new IllegalArgumentException(
        "La instancia base no puede ser null."
    );
}


InstanciaTurno copiaBase =
    copiarInstanciaTurno(
        instancia
    );


java.util.ArrayList<PedidoInput>
    originalesBase =
        construirPedidosOriginalesBase(
            copiaBase
        );


double[] vectorBase =
    construirVectorInstanciaPypeline(
        copiaBase
    );


if (
    copiaBase.pedidos.isEmpty()
    ||
    originalesBase.isEmpty()
    ||
    vectorBase.length == 0
) {

    throw new IllegalStateException(
        "No fue posible construir una "
        + "instancia base completa."
    );
}


// Las asignaciones se realizan al final para evitar
// dejar un estado parcialmente construido.

instanciaBaseRepetible =
    copiaBase;


pedidosOriginalesBaseRepetible =
    originalesBase;


vectorInstanciaBaseRepetible =
    vectorBase.clone();


traceln(
    "INSTANCIA BASE PRESERVADA"
    + " | id="
    + instanciaBaseRepetible.instanciaId
    + " | originales="
    + pedidosOriginalesBaseRepetible.size()
    + " | tareas="
    + instanciaBaseRepetible.pedidos.size()
    + " | vector="
    + vectorInstanciaBaseRepetible.length
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788108013378</Id>
