					<Parameter>
						<Name><![CDATA[pedido]]></Name>
						<Type><![CDATA[PedidoInput]]></Type>
					</Parameter>
					<Body><![CDATA[if (pedido == null) {
    throw new IllegalArgumentException(
        "Pedido nulo al calcular tiempo de descarga."
    );
}

return TIEMPO_DESCARGA_BASE_PRUEBA_MIN
    + TIEMPO_DESCARGA_POR_UNIDAD_PRUEBA_MIN
    * pedido.unidadesCapacidad;]]></Body>
				</Function>
