					<X>-810</X><Y>340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[plan]]></Name>
						<Type><![CDATA[PlanTurno]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[camionId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[for (PlanCamion planCamion : plan.camiones) {

    if (planCamion.camionId == camionId) {
        return planCamion;
    }
}


throw new IllegalArgumentException(
    "No existe PlanCamion para camionId="
    + camionId
);]]></Body>
