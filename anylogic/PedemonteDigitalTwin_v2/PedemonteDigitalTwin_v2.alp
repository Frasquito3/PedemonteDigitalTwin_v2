				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788123980101</Id>
					<Name><![CDATA[posicionXPuntoCostoTiempo]]></Name>
					<X>-810</X><Y>6190</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metodo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[double tiempo =
    valorGraficoCostoTiempo(
        metodo,
        "TIEMPO"
    );


double maximo =
    maximoTiempoGraficoCostoTiempo();


if (
    Double.isNaN(tiempo)
    ||
    Double.isInfinite(tiempo)
    ||
    maximo <= 0.0
) {

    return 3945.0;
}


// Se agrega un margen del 5 % para que el punto
// de mayor tiempo no toque el borde derecho.

double limiteSuperior =
    maximo
    *
    1.05;


double posicion =
    3945.0
    +
    510.0
    *
    tiempo
    /
    limiteSuperior;


return Math.max(
    3945.0,
    Math.min(
        4455.0,
        posicion
    )
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788123999083</Id>
					<Name><![CDATA[posicionYPuntoCostoTiempo]]></Name>
					<X>-810</X><Y>6220</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metodo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[double costo =
    valorGraficoCostoTiempo(
        metodo,
        "COSTO"
    );


double minimo =
    minimoCostoGraficoCostoTiempo();


double maximo =
    maximoCostoGraficoCostoTiempo();


if (
    Double.isNaN(costo)
    ||
    Double.isInfinite(costo)
) {

    return 830.0;
}


double rango =
    maximo
    -
    minimo;


if (rango < 1.0) {

    rango =
        1.0;
}


double margen =
    rango
    *
    0.05;


double limiteInferior =
    minimo
    -
    margen;


double limiteSuperior =
    maximo
    +
    margen;


double posicion =
    830.0
    -
    108.0
    *
    (
        costo
        -
        limiteInferior
    )
    /
    (
        limiteSuperior
        -
        limiteInferior
    );


return Math.max(
    722.0,
    Math.min(
        830.0,
        posicion
    )
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1788129200362</Id>
					<Name><![CDATA[solicitarNuevaOperacionConReinicioCompleto]]></Name>
					<X>-810</X><Y>6250</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (reinicioCompletoSolicitado) {

    return false;
}


if (
    ejecucionEnCurso
    ||
    pypelineSolicitudEnCurso
) {

    mensajeInterfazPlanificacion =
        "No se puede iniciar una nueva operación "
        + "mientras existe una planificación "
        + "o ejecución en curso.";


    traceln(
        mensajeInterfazPlanificacion
    );


    return false;
}


com.anylogic.engine.Experiment<?> experimento =
    getEngine().getExperiment();


if (
    !(experimento
        instanceof
        com.anylogic.engine.ExperimentSimulation)
) {

    mensajeInterfazPlanificacion =
        "El experimento actual no permite "
        + "el reinicio completo interactivo.";


    traceln(
        mensajeInterfazPlanificacion
    );


    return false;
}


final com.anylogic.engine.ExperimentSimulation<?>
    experimentoSimulacion =
        (
            com.anylogic.engine.ExperimentSimulation<?>
        ) experimento;


// La propiedad pertenece al proceso Java,
// no al agente Main.
//
// Por eso sobrevive a la destrucción del modelo
// y puede ser leída por el nuevo Main.

System.setProperty(
    "pedemonte.restart.mode",
    "NUEVA_OPERACION"
);


// Eliminamos cualquier dato residual que en el futuro
// pertenezca al flujo de repetición de instancia.

System.clearProperty(
    "pedemonte.restart.payload"
);


reinicioCompletoSolicitado =
    true;


mensajeInterfazPlanificacion =
    "Reiniciando el modelo para "
    + "una nueva operación...";


traceln(
    "REINICIO COMPLETO SOLICITADO"
    + " | modo=NUEVA_OPERACION"
);


// La acción del botón debe terminar antes de destruir
// el agente Main que la está ejecutando.
//
// Por eso stop() y run() se realizan desde un hilo
// corto, sin volver a utilizar referencias del Main.

Thread hiloReinicio =
    new Thread(
        new Runnable() {

            @Override
            public void run() {

                try {

                    Thread.sleep(
                        150L
                    );


                    experimentoSimulacion.stop();


                    Thread.sleep(
                        150L
                    );


                    experimentoSimulacion.run();


                } catch (
                    InterruptedException ex
                ) {

                    Thread.currentThread()
                        .interrupt();


                    ex.printStackTrace();


                } catch (
                    Exception ex
                ) {

                    ex.printStackTrace();
                }
            }
        },
        "pedemonte-full-restart"
    );


hiloReinicio.setDaemon(
    true
);


hiloReinicio.start();


return true;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1788129257053</Id>
					<Name><![CDATA[aplicarModoReinicioInicial]]></Name>
					<X>-810</X><Y>6280</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[String modoReinicio =
    System.getProperty(
        "pedemonte.restart.mode",
        ""
    );


if (modoReinicio == null) {

    modoReinicio =
        "";
}


modoReinicio =
    modoReinicio.trim();


if (modoReinicio.isEmpty()) {

    return false;
}


// =====================================================
// NUEVA OPERACIÓN
// =====================================================

if (
    "NUEVA_OPERACION".equals(
        modoReinicio
    )
) {

    System.clearProperty(
        "pedemonte.restart.mode"
    );


    System.clearProperty(
        "pedemonte.restart.payload"
    );


    reinicioCompletoSolicitado =
        false;


    mensajeInterfazPlanificacion =
        "Nueva operación lista."
        + "\nCargue los pedidos y prepare "
        + "una nueva instancia.";


    getExperimentHost().navigateTo(
        viewPedidos
    );


    traceln(
        "================================"
    );

    traceln(
        "=== NUEVA OPERACIÓN ============"
    );

    traceln(
        "================================"
    );

    traceln(
        "MODELO RECREADO"
        + " | tiempo="
        + time()
        + " | instancia=null"
        + " | pedidos="
        + pedidosFormulario.size()
    );


    return true;
}


// =====================================================
// REPETIR INSTANCIA
// =====================================================

if (
    !"REPETIR_INSTANCIA".equals(
        modoReinicio
    )
) {

    System.clearProperty(
        "pedemonte.restart.mode"
    );


    System.clearProperty(
        "pedemonte.restart.payload"
    );


    return false;
}


String payload =
    System.getProperty(
        "pedemonte.restart.payload",
        ""
    );


System.clearProperty(
    "pedemonte.restart.mode"
);


System.clearProperty(
    "pedemonte.restart.payload"
);


reinicioCompletoSolicitado =
    false;


try {

    InstanciaTurno restaurada =
        restaurarInstanciaDesdePayload(
            payload
        );


    if (
        restaurada.seedEscenario < 1L
        ||
        restaurada.seedEscenario
            > Integer.MAX_VALUE
    ) {

        throw new IllegalArgumentException(
            "La semilla restaurada no puede "
            + "representarse en seedFormulario: "
            + restaurada.seedEscenario
        );
    }


    guardarInstanciaBaseRepetible(
        restaurada
    );


    instanciaInterfazActual =
        crearCopiaInstanciaBaseRepetible();


    pedidosFormulario.clear();


    for (
        PedidoInput pedido
        : instanciaBaseRepetible.pedidos
    ) {

        pedidosFormulario.add(
            copiarPedidoInput(
                pedido
            )
        );
    }


    turnoFormulario =
        restaurada.turno.toString();


    fechaFormulario =
        restaurada.fechaOperacion;


    seedFormulario =
        (int) restaurada.seedEscenario;


    java.util.HashSet<String>
        originales =
            new java.util.HashSet<String>();


    for (
        PedidoInput pedido
        : pedidosFormulario
    ) {

        if (
            pedido != null
            &&
            pedido.pedidoOriginalId != null
            &&
            !pedido.pedidoOriginalId
                .trim()
                .isEmpty()
        ) {

            originales.add(
                pedido.pedidoOriginalId
            );
        }
    }


    contadorPedidosFormulario =
        originales.size()
        +
        1;


    actualizarHorarioFormulario();


    String metodoRestaurado;


    try {

        String contenido =
            new String(
                java.util.Base64
                    .getDecoder()
                    .decode(
                        payload
                    ),
                java.nio.charset.StandardCharsets.UTF_8
            );


        java.util.Properties datos =
            new java.util.Properties();


        datos.load(
            new java.io.StringReader(
                contenido
            )
        );


        metodoRestaurado =
            datos.getProperty(
                "interfaz.metodo",
                "RL"
            )
            .trim()
            .toUpperCase(
                java.util.Locale.ROOT
            );


    } catch (Exception ex) {

        metodoRestaurado =
            "RL";
    }


    java.util.HashSet<String>
        metodosValidos =
            new java.util.HashSet<String>(
                java.util.Arrays.asList(
                    "RL",
                    "HIBRIDO",
                    "GREEDY",
                    "RANDOM",
                    "GA"
                )
            );


    modoPlanificacionPypeline =
        metodosValidos.contains(
            metodoRestaurado
        )
        ? metodoRestaurado
        : "RL";
        
    comboModoPlanificacion.setValue(
	    modoPlanificacionPypeline
	);


    limpiarComparacionEstimadaLocal();


    mostrarInstanciaEnGIS(
        instanciaInterfazActual
    );


    indexarPuntosPedidosGIS(
        instanciaInterfazActual
    );


    boolean matrizLista =
        verificarCacheVialInstanciaActual();


    mensajeFormulario =
        "Instancia restaurada: "
        + originales.size()
        + " pedido(s) original(es), "
        + pedidosFormulario.size()
        + " tarea(s).";


    if (matrizLista) {

        mensajeInterfazPlanificacion =
            "Instancia restaurada."
            + "\nMétodo seleccionado: "
            + modoPlanificacionPypeline
            + "\nPuede generar y ejecutar el plan.";

    } else {

        mensajeInterfazPlanificacion =
            "Instancia restaurada."
            + "\nFaltan "
            + cacheVialTramosFaltantes
            + " tramos viales.";
    }


    getExperimentHost().navigateTo(
        viewOperacion
    );


    traceln(
        "================================"
    );

    traceln(
        "=== INSTANCIA REPETIDA ========="
    );

    traceln(
        "================================"
    );

    traceln(
        "MODELO RECREADO"
        + " | tiempo="
        + time()
        + " | instancia="
        + instanciaBaseRepetible.instanciaId
        + " | originales="
        + originales.size()
        + " | tareas="
        + instanciaBaseRepetible.pedidos.size()
        + " | metodo="
        + modoPlanificacionPypeline
        + " | cache="
        + (
            matrizLista
            ? "LISTA"
            : "INCOMPLETA"
        )
    );


    return true;


} catch (Exception ex) {

    instanciaInterfazActual =
        null;


    limpiarInstanciaBaseRepetible();


    pedidosFormulario.clear();


    cacheVialInstanciaCompleta =
        false;


    cacheVialTramosRequeridos =
        0;


    cacheVialTramosFaltantes =
        0;


    cacheVialEstadoInterfaz =
        "ERROR";


    mensajeFormulario =
        "No fue posible restaurar "
        + "la instancia anterior.";


    mensajeInterfazPlanificacion =
        "Error al repetir la instancia: "
        + ex.getClass()
            .getSimpleName()
        + ": "
        + String.valueOf(
            ex.getMessage()
        );


    getExperimentHost().navigateTo(
        viewPedidos
    );


    traceln(
        "ERROR AL RESTAURAR INSTANCIA"
        + " | "
        + mensajeInterfazPlanificacion
    );


    ex.printStackTrace();


    return true;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788131302201</Id>
					<Name><![CDATA[crearPayloadReinicioInstancia]]></Name>
					<X>-810</X><Y>6310</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (!instanciaBaseRepetibleDisponible()) {

    throw new IllegalStateException(
        "No existe una instancia base "
        + "disponible para repetir."
    );
}


InstanciaTurno instancia =
    instanciaBaseRepetible;


java.util.Properties datos =
    new java.util.Properties();


datos.setProperty(
    "version",
    "1"
);


datos.setProperty(
    "interfaz.metodo",
    modoPlanificacionPypeline == null
        ? "RL"
        : modoPlanificacionPypeline
            .trim()
            .toUpperCase(
                java.util.Locale.ROOT
            )
);


datos.setProperty(
    "instancia.id",
    instancia.instanciaId == null
        ? ""
        : instancia.instanciaId
);


datos.setProperty(
    "instancia.fecha",
    instancia.fechaOperacion == null
        ? ""
        : instancia.fechaOperacion
);


datos.setProperty(
    "instancia.turno",
    instancia.turno == null
        ? ""
        : instancia.turno.toString()
);


datos.setProperty(
    "instancia.latCorralon",
    String.valueOf(
        instancia.latCorralon
    )
);


datos.setProperty(
    "instancia.lonCorralon",
    String.valueOf(
        instancia.lonCorralon
    )
);


datos.setProperty(
    "instancia.capacidadCamion",
    String.valueOf(
        instancia.capacidadCamion
    )
);


datos.setProperty(
    "instancia.cantidadCamiones",
    String.valueOf(
        instancia.cantidadCamiones
    )
);


datos.setProperty(
    "instancia.horaInicioTurnoMin",
    String.valueOf(
        instancia.horaInicioTurnoMin
    )
);


datos.setProperty(
    "instancia.horaFinObjetivoMin",
    String.valueOf(
        instancia.horaFinObjetivoMin
    )
);


datos.setProperty(
    "instancia.horaFinToleranciaMin",
    String.valueOf(
        instancia.horaFinToleranciaMin
    )
);


datos.setProperty(
    "instancia.seedEscenario",
    String.valueOf(
        instancia.seedEscenario
    )
);


datos.setProperty(
    "instancia.seedEjecucion",
    String.valueOf(
        instancia.seedEjecucion
    )
);


if (
    instancia.pedidos == null
    ||
    instancia.pedidos.isEmpty()
) {

    throw new IllegalStateException(
        "La instancia base no contiene pedidos."
    );
}


datos.setProperty(
    "pedidos.cantidad",
    String.valueOf(
        instancia.pedidos.size()
    )
);


for (
    int indice = 0;
    indice < instancia.pedidos.size();
    indice++
) {

    PedidoInput pedido =
        instancia.pedidos.get(
            indice
        );


    if (pedido == null) {

        throw new IllegalStateException(
            "La instancia contiene un pedido null "
            + "en la posición "
            + indice
            + "."
        );
    }


    String prefijo =
        "pedido."
        + indice
        + ".";


    datos.setProperty(
        prefijo + "pedidoId",
        pedido.pedidoId == null
            ? ""
            : pedido.pedidoId
    );


    datos.setProperty(
        prefijo + "pedidoOriginalId",
        pedido.pedidoOriginalId == null
            ? ""
            : pedido.pedidoOriginalId
    );


    datos.setProperty(
        prefijo + "numeroParte",
        String.valueOf(
            pedido.numeroParte
        )
    );


    datos.setProperty(
        prefijo + "totalPartes",
        String.valueOf(
            pedido.totalPartes
        )
    );


    datos.setProperty(
        prefijo + "turno",
        pedido.turno == null
            ? ""
            : pedido.turno.toString()
    );


    datos.setProperty(
        prefijo + "latitud",
        String.valueOf(
            pedido.latitud
        )
    );


    datos.setProperty(
        prefijo + "longitud",
        String.valueOf(
            pedido.longitud
        )
    );


    datos.setProperty(
        prefijo + "unidadesCapacidad",
        String.valueOf(
            pedido.unidadesCapacidad
        )
    );


    datos.setProperty(
        prefijo + "requiereVolcador",
        String.valueOf(
            pedido.requiereVolcador
        )
    );


    datos.setProperty(
        prefijo + "tieneVentanaEspecifica",
        String.valueOf(
            pedido.tieneVentanaEspecifica
        )
    );


    datos.setProperty(
        prefijo + "horaDesdeMin",
        String.valueOf(
            pedido.horaDesdeMin
        )
    );


    datos.setProperty(
        prefijo + "horaHastaMin",
        String.valueOf(
            pedido.horaHastaMin
        )
    );


    datos.setProperty(
        prefijo + "cliente",
        pedido.cliente == null
            ? ""
            : pedido.cliente
    );


    datos.setProperty(
        prefijo + "direccion",
        pedido.direccion == null
            ? ""
            : pedido.direccion
    );


    datos.setProperty(
        prefijo + "barrio",
        pedido.barrio == null
            ? ""
            : pedido.barrio
    );


    datos.setProperty(
        prefijo + "observaciones",
        pedido.observaciones == null
            ? ""
            : pedido.observaciones
    );
}


try {

    java.io.StringWriter escritor =
        new java.io.StringWriter();


    datos.store(
        escritor,
        null
    );


    byte[] contenido =
        escritor
            .toString()
            .getBytes(
                java.nio.charset.StandardCharsets.UTF_8
            );


    return java.util.Base64
        .getEncoder()
        .encodeToString(
            contenido
        );


} catch (java.io.IOException ex) {

    throw new IllegalStateException(
        "No fue posible serializar "
        + "la instancia para reiniciarla.",
        ex
    );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[InstanciaTurno]]></ReturnType>
					<Id>1788131323225</Id>
					<Name><![CDATA[restaurarInstanciaDesdePayload]]></Name>
					<X>-810</X><Y>6340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[payload]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String payloadLimpio =
    payload == null
    ? ""
    : payload.trim();


if (payloadLimpio.isEmpty()) {

    throw new IllegalArgumentException(
        "El payload de repetición está vacío."
    );
}


String contenido;


try {

    byte[] bytes =
        java.util.Base64
            .getDecoder()
            .decode(
                payloadLimpio
            );


    contenido =
        new String(
            bytes,
            java.nio.charset.StandardCharsets.UTF_8
        );


} catch (IllegalArgumentException ex) {

    throw new IllegalArgumentException(
        "El payload de repetición "
        + "no posee Base64 válido.",
        ex
    );
}


java.util.Properties datos =
    new java.util.Properties();


try {

    datos.load(
        new java.io.StringReader(
            contenido
        )
    );


} catch (java.io.IOException ex) {

    throw new IllegalStateException(
        "No fue posible leer el payload "
        + "de repetición.",
        ex
    );
}


String version =
    datos.getProperty(
        "version",
        ""
    ).trim();


if (!"1".equals(version)) {

    throw new IllegalArgumentException(
        "Versión de payload no soportada: "
        + version
    );
}


InstanciaTurno instancia =
    new InstanciaTurno();


instancia.instanciaId =
    datos.getProperty(
        "instancia.id",
        ""
    ).trim();


instancia.fechaOperacion =
    datos.getProperty(
        "instancia.fecha",
        ""
    ).trim();


String turnoInstancia =
    datos.getProperty(
        "instancia.turno",
        ""
    ).trim();


if (
    instancia.instanciaId.isEmpty()
    ||
    instancia.fechaOperacion.isEmpty()
    ||
    turnoInstancia.isEmpty()
) {

    throw new IllegalArgumentException(
        "El payload no contiene una identidad "
        + "de instancia completa."
    );
}


instancia.turno =
    Turno.valueOf(
        turnoInstancia
    );


try {

    instancia.latCorralon =
        Double.parseDouble(
            datos.getProperty(
                "instancia.latCorralon"
            )
        );


    instancia.lonCorralon =
        Double.parseDouble(
            datos.getProperty(
                "instancia.lonCorralon"
            )
        );


    instancia.capacidadCamion =
        Integer.parseInt(
            datos.getProperty(
                "instancia.capacidadCamion"
            )
        );


    instancia.cantidadCamiones =
        Integer.parseInt(
            datos.getProperty(
                "instancia.cantidadCamiones"
            )
        );


    instancia.horaInicioTurnoMin =
	    Integer.parseInt(
	        datos.getProperty(
	            "instancia.horaInicioTurnoMin"
	        )
	    );
	
	
	instancia.horaFinObjetivoMin =
	    Integer.parseInt(
	        datos.getProperty(
	            "instancia.horaFinObjetivoMin"
	        )
	    );
	
	
	instancia.horaFinToleranciaMin =
	    Integer.parseInt(
	        datos.getProperty(
	            "instancia.horaFinToleranciaMin"
	        )
	    );


    instancia.seedEscenario =
        Long.parseLong(
            datos.getProperty(
                "instancia.seedEscenario"
            )
        );


    instancia.seedEjecucion =
        Long.parseLong(
            datos.getProperty(
                "instancia.seedEjecucion"
            )
        );


} catch (
    NumberFormatException
    |
    NullPointerException ex
) {

    throw new IllegalArgumentException(
        "El payload contiene una configuración "
        + "numérica inválida.",
        ex
    );
}


int cantidadPedidos;


try {

    cantidadPedidos =
        Integer.parseInt(
            datos.getProperty(
                "pedidos.cantidad",
                "0"
            )
        );


} catch (NumberFormatException ex) {

    throw new IllegalArgumentException(
        "Cantidad de pedidos inválida "
        + "en el payload.",
        ex
    );
}


if (cantidadPedidos <= 0) {

    throw new IllegalArgumentException(
        "El payload no contiene pedidos."
    );
}


for (
    int indice = 0;
    indice < cantidadPedidos;
    indice++
) {

    String prefijo =
        "pedido."
        + indice
        + ".";


    PedidoInput pedido =
        new PedidoInput();


    pedido.pedidoId =
        datos.getProperty(
            prefijo + "pedidoId",
            ""
        ).trim();


    pedido.pedidoOriginalId =
        datos.getProperty(
            prefijo + "pedidoOriginalId",
            ""
        ).trim();


    if (
        pedido.pedidoId.isEmpty()
        ||
        pedido.pedidoOriginalId.isEmpty()
    ) {

        throw new IllegalArgumentException(
            "El pedido "
            + indice
            + " no posee identificadores válidos."
        );
    }


    try {

        pedido.numeroParte =
            Integer.parseInt(
                datos.getProperty(
                    prefijo + "numeroParte"
                )
            );


        pedido.totalPartes =
            Integer.parseInt(
                datos.getProperty(
                    prefijo + "totalPartes"
                )
            );


        pedido.turno =
            Turno.valueOf(
                datos.getProperty(
                    prefijo + "turno"
                )
            );


        pedido.latitud =
            Double.parseDouble(
                datos.getProperty(
                    prefijo + "latitud"
                )
            );


        pedido.longitud =
            Double.parseDouble(
                datos.getProperty(
                    prefijo + "longitud"
                )
            );


        pedido.unidadesCapacidad =
            Integer.parseInt(
                datos.getProperty(
                    prefijo + "unidadesCapacidad"
                )
            );


        pedido.requiereVolcador =
            Boolean.parseBoolean(
                datos.getProperty(
                    prefijo + "requiereVolcador"
                )
            );


        pedido.tieneVentanaEspecifica =
            Boolean.parseBoolean(
                datos.getProperty(
                    prefijo + "tieneVentanaEspecifica"
                )
            );


        pedido.horaDesdeMin =
		    Integer.parseInt(
		        datos.getProperty(
		            prefijo + "horaDesdeMin"
		        )
		    );
		
		
		pedido.horaHastaMin =
		    Integer.parseInt(
		        datos.getProperty(
		            prefijo + "horaHastaMin"
		        )
		    );


    } catch (
        NumberFormatException
        |
        NullPointerException ex
    ) {

        throw new IllegalArgumentException(
            "Configuración inválida en el pedido "
            + indice
            + ".",
            ex
        );
    }


    pedido.cliente =
        datos.getProperty(
            prefijo + "cliente",
            ""
        );


    pedido.direccion =
        datos.getProperty(
            prefijo + "direccion",
            ""
        );


    pedido.barrio =
        datos.getProperty(
            prefijo + "barrio",
            ""
        );


    pedido.observaciones =
        datos.getProperty(
            prefijo + "observaciones",
            ""
        );


    instancia.pedidos.add(
        pedido
    );
}


return instancia;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1788131353498</Id>
					<Name><![CDATA[solicitarRepetirInstanciaConReinicioCompleto]]></Name>
					<X>-810</X><Y>6370</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (reinicioCompletoSolicitado) {

    return false;
}


if (
    ejecucionEnCurso
    ||
    pypelineSolicitudEnCurso
) {

    mensajeInterfazPlanificacion =
        "No se puede repetir la instancia "
        + "mientras existe una planificación "
        + "o ejecución en curso.";


    traceln(
        mensajeInterfazPlanificacion
    );


    return false;
}


if (
    !ejecucionFinalizada
    ||
    resultadoActual == null
) {

    mensajeInterfazPlanificacion =
        "Primero debe finalizar una operación "
        + "para repetir la instancia.";


    traceln(
        mensajeInterfazPlanificacion
    );


    return false;
}


if (!instanciaBaseRepetibleDisponible()) {

    mensajeInterfazPlanificacion =
        "No existe una copia base "
        + "de la instancia actual.";


    traceln(
        mensajeInterfazPlanificacion
    );


    return false;
}


String payload =
    crearPayloadReinicioInstancia();


com.anylogic.engine.Experiment<?> experimento =
    getEngine().getExperiment();


if (
    !(experimento
        instanceof
        com.anylogic.engine.ExperimentSimulation)
) {

    mensajeInterfazPlanificacion =
        "El experimento actual no permite "
        + "repetir la instancia mediante "
        + "reinicio completo.";


    traceln(
        mensajeInterfazPlanificacion
    );


    return false;
}


final com.anylogic.engine.ExperimentSimulation<?>
    experimentoSimulacion =
        (
            com.anylogic.engine.ExperimentSimulation<?>
        ) experimento;


System.setProperty(
    "pedemonte.restart.mode",
    "REPETIR_INSTANCIA"
);


System.setProperty(
    "pedemonte.restart.payload",
    payload
);


reinicioCompletoSolicitado =
    true;


mensajeInterfazPlanificacion =
    "Reiniciando el modelo para repetir "
    + "la misma instancia...";


traceln(
    "REINICIO COMPLETO SOLICITADO"
    + " | modo=REPETIR_INSTANCIA"
    + " | instancia="
    + instanciaBaseRepetible.instanciaId
    + " | tareas="
    + instanciaBaseRepetible.pedidos.size()
    + " | metodo="
    + modoPlanificacionPypeline
);


Thread hiloReinicio =
    new Thread(
        new Runnable() {

            @Override
            public void run() {

                try {

                    Thread.sleep(
                        150L
                    );


                    experimentoSimulacion.stop();


                    Thread.sleep(
                        150L
                    );


                    experimentoSimulacion.run();


                } catch (
                    InterruptedException ex
                ) {

                    Thread.currentThread()
                        .interrupt();


                    ex.printStackTrace();


                } catch (
                    Exception ex
                ) {

                    ex.printStackTrace();
                }
            }
        },
        "pedemonte-repeat-instance"
    );


hiloReinicio.setDaemon(
    true
);


hiloReinicio.start();


return true;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788133756927</Id>
					<Name><![CDATA[emitirErrorSelectorUbicacionWeb]]></Name>
					<X>-810</X><Y>6400</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[requestId]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[mensaje]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[java.util.Map<String, Object> error =
    new java.util.LinkedHashMap<String, Object>();


error.put(
    "requestId",
    requestId == null
        ? ""
        : requestId
);


error.put(
    "mensaje",
    mensaje == null
        ? "Error no especificado."
        : mensaje
);


webAppPedidos
    .dialog
    .getBridge()
    .emit(
        "pedemonteSelectorError",
        error
    );


webToolkitEstado =
    "SELECTOR_ERROR";


mensajeFormulario =
    mensaje == null
    ? "Error en el selector web."
    : mensaje;


traceln(
    "WEB SELECTOR ERROR"
    + " | requestId="
    + String.valueOf(
        requestId
    )
    + " | mensaje="
    + mensajeFormulario
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1788133777807</Id>
					<Name><![CDATA[abrirSelectorUbicacionWeb]]></Name>
					<X>-810</X><Y>6430</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (!webToolkitListo) {

    mensajeFormulario =
        "El mapa web todavía no está listo.";


    return false;
}


if (
    instanciaInterfazActual != null
    ||
    ejecucionEnCurso
    ||
    pypelineSolicitudEnCurso
    ||
    reinicioCompletoSolicitado
) {

    mensajeFormulario =
        "La ubicación solo puede modificarse "
        + "antes de preparar la operación.";


    return false;
}


if (webSelectorEnCurso) {

    mostrarVentanaWebPedidosAlFrente();


    return true;
}


webSelectorSecuencia++;


webSelectorSolicitudId =
    "ubicacion-"
    + webSelectorSecuencia
    + "-"
    + System.currentTimeMillis();


webSelectorEnCurso =
    true;


boolean tieneUbicacionInicial =
    false;


double latitudInicial =
    LAT_CORRALON;


double longitudInicial =
    LON_CORRALON;


try {

    String latitudTexto =
        latitudFormulario == null
        ? ""
        : latitudFormulario.trim();


    String longitudTexto =
        longitudFormulario == null
        ? ""
        : longitudFormulario.trim();


    if (
        !latitudTexto.isEmpty()
        &&
        !longitudTexto.isEmpty()
    ) {

        latitudInicial =
            parsearDecimalFormulario(
                latitudTexto,
                "Latitud"
            );


        longitudInicial =
            parsearDecimalFormulario(
                longitudTexto,
                "Longitud"
            );


        tieneUbicacionInicial =
            Double.isFinite(
                latitudInicial
            )
            &&
            Double.isFinite(
                longitudInicial
            )
            &&
            latitudInicial >= -90.0
            &&
            latitudInicial <= 90.0
            &&
            longitudInicial >= -180.0
            &&
            longitudInicial <= 180.0;
    }


} catch (Exception ex) {

    tieneUbicacionInicial =
        false;
}


java.util.Map<String, Object> solicitud =
    new java.util.LinkedHashMap<String, Object>();


solicitud.put(
    "requestId",
    webSelectorSolicitudId
);


solicitud.put(
    "tieneUbicacionInicial",
    tieneUbicacionInicial
);


solicitud.put(
    "latitudInicial",
    latitudInicial
);


solicitud.put(
    "longitudInicial",
    longitudInicial
);


solicitud.put(
    "zoom",
    tieneUbicacionInicial
        ? 17
        : 14
);


try {

    mostrarVentanaWebPedidosAlFrente();


    webAppPedidos
        .dialog
        .getBridge()
        .emit(
            "pedemonteAbrirSelectorUbicacion",
            solicitud
        );


    webToolkitEstado =
        "SELECTOR_ABIERTO";


    mensajeFormulario =
        "Seleccione un punto en el mapa web "
        + "y confirme la ubicación.";


    traceln(
        "WEB SELECTOR ABIERTO"
        + " | requestId="
        + webSelectorSolicitudId
        + " | inicial="
        + tieneUbicacionInicial
    );


    return true;


} catch (Exception ex) {

    webSelectorEnCurso =
        false;


    emitirErrorSelectorUbicacionWeb(
        webSelectorSolicitudId,
        "No fue posible abrir el selector web: "
        + ex.getClass()
            .getSimpleName()
        + ": "
        + String.valueOf(
            ex.getMessage()
        )
    );


    webSelectorSolicitudId =
        "";


    return false;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1788133794664</Id>
					<Name><![CDATA[procesarUbicacionSeleccionadaWeb]]></Name>
					<X>-810</X><Y>6460</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[data]]></Name>
						<Type><![CDATA[Object]]></Type>
					</Parameter>
					<Body><![CDATA[if (
    !(data
        instanceof
        java.util.Map)
) {

    emitirErrorSelectorUbicacionWeb(
        webSelectorSolicitudId,
        "La respuesta del mapa no tiene "
        + "el formato esperado."
    );


    return false;
}


java.util.Map<?, ?> payload =
    (java.util.Map<?, ?>) data;


String requestId =
    String.valueOf(
        payload.get(
            "requestId"
        )
    ).trim();


if (
    !webSelectorEnCurso
    ||
    requestId.isEmpty()
    ||
    !requestId.equals(
        webSelectorSolicitudId
    )
    ||
    requestId.equals(
        webSelectorUltimoResultadoId
    )
) {

    emitirErrorSelectorUbicacionWeb(
        requestId,
        "La solicitud de ubicación ya no está activa."
    );


    return false;
}


Object latitudObjeto =
    payload.get(
        "latitud"
    );


Object longitudObjeto =
    payload.get(
        "longitud"
    );


if (
    !(latitudObjeto
        instanceof
        Number)

    ||

    !(longitudObjeto
        instanceof
        Number)
) {

    emitirErrorSelectorUbicacionWeb(
        requestId,
        "La latitud o longitud recibida "
        + "no es numérica."
    );


    return false;
}


double latitud =
    (
        (Number) latitudObjeto
    ).doubleValue();


double longitud =
    (
        (Number) longitudObjeto
    ).doubleValue();


if (
    !Double.isFinite(
        latitud
    )
    ||
    latitud < -90.0
    ||
    latitud > 90.0
    ||
    !Double.isFinite(
        longitud
    )
    ||
    longitud < -180.0
    ||
    longitud > 180.0
) {

    emitirErrorSelectorUbicacionWeb(
        requestId,
        "Las coordenadas recibidas "
        + "están fuera del rango permitido."
    );


    return false;
}


latitudFormulario =
    String.format(
        java.util.Locale.US,
        "%.6f",
        latitud
    );


longitudFormulario =
    String.format(
        java.util.Locale.US,
        "%.6f",
        longitud
    );


editLatitudFormulario.setText(
    latitudFormulario
);


editLongitudFormulario.setText(
    longitudFormulario
);


webSelectorUltimoResultadoId =
    requestId;


webSelectorEnCurso =
    false;


webSelectorSolicitudId =
    "";


webToolkitEstado =
    "UBICACION_OK";


mensajeFormulario =
    "Ubicación seleccionada: "
    + latitudFormulario
    + ", "
    + longitudFormulario;


java.util.Map<String, Object> respuesta =
    new java.util.LinkedHashMap<String, Object>();


respuesta.put(
    "requestId",
    requestId
);


respuesta.put(
    "latitud",
    latitud
);


respuesta.put(
    "longitud",
    longitud
);


respuesta.put(
    "mensaje",
    "Ubicación aplicada correctamente."
);


webAppPedidos
    .dialog
    .getBridge()
    .emit(
        "pedemonteUbicacionAceptada",
        respuesta
    );


webAppPedidos
    .dialog
    .hide();


traceln(
    "WEB UBICACION APLICADA"
    + " | requestId="
    + requestId
    + " | latitud="
    + latitudFormulario
    + " | longitud="
    + longitudFormulario
);


return true;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1788133817800</Id>
					<Name><![CDATA[procesarCancelacionSelectorUbicacionWeb]]></Name>
					<X>-810</X><Y>6490</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[data]]></Name>
						<Type><![CDATA[Object]]></Type>
					</Parameter>
					<Body><![CDATA[if (
    !(data
        instanceof
        java.util.Map)
) {

    return false;
}


java.util.Map<?, ?> payload =
    (java.util.Map<?, ?>) data;


String requestId =
    String.valueOf(
        payload.get(
            "requestId"
        )
    ).trim();


if (
    !webSelectorEnCurso
    ||
    !requestId.equals(
        webSelectorSolicitudId
    )
) {

    return false;
}


webSelectorEnCurso =
    false;


webSelectorSolicitudId =
    "";


webToolkitEstado =
    "SELECTOR_CANCELADO";


mensajeFormulario =
    "Selección de ubicación cancelada.";


java.util.Map<String, Object> respuesta =
    new java.util.LinkedHashMap<String, Object>();


respuesta.put(
    "requestId",
    requestId
);


webAppPedidos
    .dialog
    .getBridge()
    .emit(
        "pedemonteSelectorCancelado",
        respuesta
    );


webAppPedidos
    .dialog
    .hide();


traceln(
    "WEB SELECTOR CANCELADO"
    + " | requestId="
    + requestId
);


return true;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[javax.swing.JFrame]]></ReturnType>
					<Id>1788139898700</Id>
					<Name><![CDATA[obtenerVentanaWebPedidos]]></Name>
					<X>-810</X><Y>6520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[try {

    java.lang.reflect.Field campoVentana =
        webAppPedidos
            .dialog
            .getClass()
            .getDeclaredField(
                "dialog"
            );


    campoVentana.setAccessible(
        true
    );


    Object valorVentana =
        campoVentana.get(
            webAppPedidos.dialog
        );


    if (
        valorVentana
        instanceof
        javax.swing.JFrame
    ) {

        return
            (javax.swing.JFrame)
            valorVentana;
    }


    return null;


} catch (Exception ex) {

    traceln(
        "WEBTOOLKIT FOCO NO DISPONIBLE"
        + " | error="
        + ex.getClass()
            .getSimpleName()
        + ": "
        + String.valueOf(
            ex.getMessage()
        )
    );


    return null;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788139918733</Id>
					<Name><![CDATA[mostrarVentanaWebPedidosAlFrente]]></Name>
					<X>-810</X><Y>6550</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[webAppPedidos
    .dialog
    .show();


javax.swing.SwingUtilities.invokeLater(
    new Runnable() {

        @Override
        public void run() {

            final javax.swing.JFrame ventana =
                obtenerVentanaWebPedidos();


            if (ventana == null) {

                return;
            }


            try {

                // Recupera la ventana si quedó minimizada.
                ventana.setExtendedState(
                    java.awt.Frame.NORMAL
                );


                ventana.setVisible(
                    true
                );


                /*
                 * La dejamos temporalmente por encima.
                 *
                 * Esto obliga a Windows a mostrarla
                 * delante de AnyLogic, pero no la deja
                 * permanentemente sobre todas las
                 * aplicaciones.
                 */
                ventana.setAlwaysOnTop(
                    true
                );


                ventana.toFront();


                ventana.requestFocus();


                ventana.requestFocusInWindow();


                javax.swing.Timer liberarPrimerPlano =
                    new javax.swing.Timer(
                        350,
                        new java.awt.event.ActionListener() {

                            @Override
                            public void actionPerformed(
                                java.awt.event.ActionEvent evento
                            ) {

                                try {

                                    ventana.setAlwaysOnTop(
                                        false
                                    );


                                } finally {

                                    (
                                        (javax.swing.Timer)
                                        evento.getSource()
                                    ).stop();
                                }
                            }
                        }
                    );


                liberarPrimerPlano.setRepeats(
                    false
                );


                liberarPrimerPlano.start();


            } catch (Exception ex) {

                traceln(
                    "WEBTOOLKIT NO PUDO TOMAR FOCO"
                    + " | error="
                    + ex.getClass()
                        .getSimpleName()
                    + ": "
                    + String.valueOf(
                        ex.getMessage()
                    )
                );
            }
        }
    }
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788140729859</Id>
					<Name><![CDATA[textoCampoWeb]]></Name>
					<X>-810</X><Y>6580</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[datos]]></Name>
						<Type><![CDATA[java.util.Map<?, ?>]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[campo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (
    datos == null
    ||
    campo == null
) {

    return "";
}


Object valor =
    datos.get(
        campo
    );


return valor == null
    ? ""
    : String.valueOf(
        valor
    ).trim();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788140764876</Id>
					<Name><![CDATA[numeroCampoWeb]]></Name>
					<X>-810</X><Y>6610</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[datos]]></Name>
						<Type><![CDATA[java.util.Map<?, ?>]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[campo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (datos == null) {

    throw new IllegalArgumentException(
        "No se recibieron datos web."
    );
}


Object valor =
    datos.get(
        campo
    );


double resultado;


if (valor instanceof Number) {

    resultado =
        ((Number) valor)
            .doubleValue();

} else {

    String texto =
        valor == null
        ? ""
        : String.valueOf(
            valor
        )
        .trim()
        .replace(
            ',',
            '.'
        );


    if (texto.isEmpty()) {

        throw new IllegalArgumentException(
            "Falta el campo "
            + campo
            + "."
        );
    }


    try {

        resultado =
            Double.parseDouble(
                texto
            );

    } catch (NumberFormatException ex) {

        throw new IllegalArgumentException(
            "El campo "
            + campo
            + " no es numérico."
        );
    }
}


if (!Double.isFinite(resultado)) {

    throw new IllegalArgumentException(
        "El campo "
        + campo
        + " no contiene un valor finito."
    );
}


return resultado;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1788140801156</Id>
					<Name><![CDATA[enteroCampoWeb]]></Name>
					<X>-810</X><Y>6640</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[datos]]></Name>
						<Type><![CDATA[java.util.Map<?, ?>]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[campo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[double valor =
    numeroCampoWeb(
        datos,
        campo
    );


if (
    valor != Math.rint(
        valor
    )
    ||
    valor < Integer.MIN_VALUE
    ||
    valor > Integer.MAX_VALUE
) {

    throw new IllegalArgumentException(
        "El campo "
        + campo
        + " debe ser un número entero."
    );
}


return (int) valor;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1788140826373</Id>
					<Name><![CDATA[booleanoCampoWeb]]></Name>
					<X>-810</X><Y>6670</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[datos]]></Name>
						<Type><![CDATA[java.util.Map<?, ?>]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[campo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (datos == null) {

    return false;
}


Object valor =
    datos.get(
        campo
    );


if (valor == null) {

    return false;
}


if (valor instanceof Boolean) {

    return
        ((Boolean) valor)
            .booleanValue();
}


if (valor instanceof Number) {

    return
        ((Number) valor)
            .doubleValue()
        != 0.0;
}


String texto =
    String.valueOf(
        valor
    )
    .trim()
    .toLowerCase(
        java.util.Locale.ROOT
    );


if (
    "1".equals(texto)
    ||
    "true".equals(texto)
    ||
    "si".equals(texto)
    ||
    "sí".equals(texto)
) {

    return true;
}


if (
    texto.isEmpty()
    ||
    "0".equals(texto)
    ||
    "false".equals(texto)
    ||
    "no".equals(texto)
) {

    return false;
}


throw new IllegalArgumentException(
    "El campo "
    + campo
    + " no contiene un booleano válido."
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.util.ArrayList<java.util.Map<String,Object>>]]></ReturnType>
					<Id>1788140853404</Id>
					<Name><![CDATA[construirPedidosOriginalesWeb]]></Name>
					<X>-810</X><Y>6700</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[java.util.LinkedHashMap<
    String,
    java.util.ArrayList<PedidoInput>
> grupos =
    new java.util.LinkedHashMap<
        String,
        java.util.ArrayList<PedidoInput>
    >();


for (
    PedidoInput pedido
    : pedidosFormulario
) {

    if (pedido == null) {

        continue;
    }


    String originalId =
        pedido.pedidoOriginalId == null
        ? ""
        : pedido.pedidoOriginalId.trim();


    if (originalId.isEmpty()) {

        originalId =
            pedido.pedidoId == null
            ? ""
            : pedido.pedidoId.trim();
    }


    if (originalId.isEmpty()) {

        continue;
    }


    java.util.ArrayList<PedidoInput> grupo =
        grupos.get(
            originalId
        );


    if (grupo == null) {

        grupo =
            new java.util.ArrayList<PedidoInput>();


        grupos.put(
            originalId,
            grupo
        );
    }


    grupo.add(
        pedido
    );
}


java.util.ArrayList<
    java.util.Map<String, Object>
> resultado =
    new java.util.ArrayList<
        java.util.Map<String, Object>
    >();


for (
    java.util.Map.Entry<
        String,
        java.util.ArrayList<PedidoInput>
    > entrada
    : grupos.entrySet()
) {

    java.util.ArrayList<PedidoInput> grupo =
        entrada.getValue();


    if (
        grupo == null
        ||
        grupo.isEmpty()
    ) {

        continue;
    }


    PedidoInput base =
        grupo.get(
            0
        );


    int unidadesTotales =
        0;


    String observaciones =
        "";


    for (
        PedidoInput parte
        : grupo
    ) {

        if (parte == null) {

            continue;
        }


        unidadesTotales +=
            parte.unidadesCapacidad;


        String observacionParte =
            parte.observaciones == null
            ? ""
            : parte.observaciones.trim();


        if (
            observaciones.isEmpty()
            &&
            !observacionParte.isEmpty()
            &&
            !"Pedido cargado desde interfaz."
                .equals(
                    observacionParte
                )
            &&
            !(
                observacionParte.startsWith(
                    "Parte "
                )
                &&
                observacionParte.endsWith(
                    "generada automáticamente."
                )
            )
        ) {

            observaciones =
                observacionParte;
        }
    }


    java.util.Map<String, Object> item =
        new java.util.LinkedHashMap<String, Object>();


    item.put(
        "pedido_id",
        entrada.getKey()
    );


    item.put(
        "turno",
        base.turno == null
            ? turnoFormulario
            : base.turno.toString()
    );


    item.put(
        "latitud",
        base.latitud
    );


    item.put(
        "longitud",
        base.longitud
    );


    item.put(
        "unidades_capacidad",
        unidadesTotales
    );


    item.put(
        "requiere_volcador",
        base.requiereVolcador
            ? 1
            : 0
    );


    item.put(
        "hora_desde",
        base.tieneVentanaEspecifica
            ? formatearHoraFormulario(
                base.horaDesdeMin
            )
            : ""
    );


    item.put(
        "hora_hasta",
        base.tieneVentanaEspecifica
            ? formatearHoraFormulario(
                base.horaHastaMin
            )
            : ""
    );


    item.put(
        "cliente",
        base.cliente == null
            ? ""
            : base.cliente
    );


    item.put(
        "direccion",
        base.direccion == null
            ? ""
            : base.direccion
    );


    item.put(
        "barrio",
        base.barrio == null
            ? ""
            : base.barrio
    );


    item.put(
        "observaciones",
        observaciones
    );


    resultado.add(
        item
    );
}


return resultado;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788140876812</Id>
					<Name><![CDATA[emitirEstadoPedidosWeb]]></Name>
					<X>-810</X><Y>6730</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[requestId]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[accion]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[exito]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[mensaje]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (!webToolkitListo) {

    return;
}


java.util.ArrayList<
    java.util.Map<String, Object>
> originales =
    construirPedidosOriginalesWeb();


java.util.Map<String, Object> estado =
    new java.util.LinkedHashMap<String, Object>();


estado.put(
    "contrato",
    1
);


estado.put(
    "requestId",
    requestId == null
        ? ""
        : requestId
);


estado.put(
    "accion",
    accion == null
        ? ""
        : accion
);


estado.put(
    "exito",
    exito
);


estado.put(
    "mensaje",
    mensaje == null
        ? ""
        : mensaje
);


estado.put(
    "pedidos",
    originales
);


estado.put(
    "cantidadOriginales",
    originales.size()
);


estado.put(
    "cantidadTareas",
    pedidosFormulario.size()
);


estado.put(
    "turno",
    turnoFormulario
);


estado.put(
    "fecha",
    fechaFormulario
);


estado.put(
    "seed",
    seedFormulario
);


estado.put(
    "editable",
    instanciaInterfazActual == null
    &&
    !ejecucionEnCurso
    &&
    !pypelineSolicitudEnCurso
    &&
    !reinicioCompletoSolicitado
);


webAppPedidos
    .dialog
    .getBridge()
    .emit(
        "pedemonteEstadoPedidosActualizado",
        estado
    );]]></Body>
				</Function>
