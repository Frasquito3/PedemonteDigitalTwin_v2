public class PlanTurno implements Serializable {

	public String instanciaId = "";

	public AlgoritmoPlanificacion algoritmo =
	    AlgoritmoPlanificacion.GREEDY;

	public java.util.ArrayList<PlanCamion> camiones =
	    new java.util.ArrayList<PlanCamion>();

	public double costoEstimado = 0.0;

	public double tiempoComputoMs = 0.0;

	public java.util.ArrayList<String> warnings =
	    new java.util.ArrayList<String>();


	@Override
	public String toString() {
	    return "PlanTurno{" +
	        "instanciaId='" + instanciaId + '\'' +
	        ", algoritmo=" + algoritmo +
	        ", camiones=" + camiones +
	        ", costoEstimado=" + costoEstimado +
	        ", tiempoComputoMs=" + tiempoComputoMs +
	        '}';
