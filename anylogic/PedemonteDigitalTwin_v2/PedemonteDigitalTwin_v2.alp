					<Id>1788108072810</Id>
					<Name><![CDATA[obtenerInstanciaResumenComparacion]]></Name>
					<X>-810</X><Y>4930</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (instanciaInterfazActual != null) {

    return instanciaInterfazActual;
}


if (instanciaBaseRepetibleDisponible()) {

    return instanciaBaseRepetible;
}


return null;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[InstanciaTurno]]></ReturnType>
					<Id>1788109879241</Id>
					<Name><![CDATA[aplicarMetadatosInstanciaAlpyne]]></Name>
					<X>-810</X><Y>4960</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Body><![CDATA[if (instancia == null) {

    throw new IllegalArgumentException(
        "La instancia dinámica no puede ser null."
    );
}


String instanciaId =
    alpyneInstanciaId == null
    ? ""
    : alpyneInstanciaId.trim();


if (instanciaId.isEmpty()) {

    throw new IllegalArgumentException(
        "Alpyne no recibió instanciaId."
    );
}


String fechaOperacion =
    alpyneFechaOperacion == null
    ? ""
    : alpyneFechaOperacion.trim();


if (fechaOperacion.isEmpty()) {

    throw new IllegalArgumentException(
        "Alpyne no recibió fechaOperacion."
    );
}


if (alpyneSeedEscenario <= 0) {

    throw new IllegalArgumentException(
        "Alpyne recibió una seedEscenario inválida: "
        + alpyneSeedEscenario
    );
}


String contratoIds =
    alpyneIdentificadoresPedidos == null
    ? ""
    : alpyneIdentificadoresPedidos.trim();


if (contratoIds.isEmpty()) {

    throw new IllegalArgumentException(
        "Alpyne no recibió los identificadores "
        + "de los pedidos."
    );
}


String[] partes =
    contratoIds.split(
        "\\|",
        -1
    );


if (partes.length < 2) {

    throw new IllegalArgumentException(
        "Contrato de identificadores incompleto."
    );
}


if (!"IDMAP1".equals(partes[0])) {

    throw new IllegalArgumentException(
        "Versión no soportada del contrato "
        + "de identificadores: "
        + partes[0]
    );
}


int cantidadDeclarada;


try {

    cantidadDeclarada =
        Integer.parseInt(
            partes[1]
        );

} catch (NumberFormatException ex) {

    throw new IllegalArgumentException(
        "Cantidad inválida en el contrato "
        + "de identificadores.",
        ex
    );
}


if (
    cantidadDeclarada
    != instancia.pedidos.size()
) {

    throw new IllegalArgumentException(
        "El contrato declara "
        + cantidadDeclarada
        + " pedidos, pero la instancia contiene "
        + instancia.pedidos.size()
        + "."
    );
}


if (
    partes.length
    != cantidadDeclarada + 2
) {

    throw new IllegalArgumentException(
        "Cantidad incorrecta de bloques "
        + "en el contrato de identificadores."
    );
}


java.util.Base64.Decoder decoder =
    java.util.Base64.getDecoder();


java.util.HashSet<String> idsTareas =
    new java.util.HashSet<String>();


for (
    int indice = 0;
    indice < cantidadDeclarada;
    indice++
) {

    String bloque =
        partes[indice + 2];


    String[] par =
        bloque.split(
            ":",
            -1
        );


    if (par.length != 2) {

        throw new IllegalArgumentException(
            "Bloque de identificadores inválido "
            + "en la posición "
            + indice
            + "."
        );
    }


    String pedidoId;


    String pedidoOriginalId;


    try {

        pedidoId =
            new String(
                decoder.decode(
                    par[0]
                ),
                java.nio.charset.StandardCharsets.UTF_8
            );


        pedidoOriginalId =
            new String(
                decoder.decode(
                    par[1]
                ),
                java.nio.charset.StandardCharsets.UTF_8
            );

    } catch (IllegalArgumentException ex) {

        throw new IllegalArgumentException(
            "Base64 inválido en los identificadores "
            + "del pedido "
            + indice
            + ".",
            ex
        );
    }


    pedidoId =
        pedidoId.trim();


    pedidoOriginalId =
        pedidoOriginalId.trim();


    if (
        pedidoId.isEmpty()
        ||
        pedidoOriginalId.isEmpty()
    ) {

        throw new IllegalArgumentException(
            "El pedido "
            + indice
            + " contiene identificadores vacíos."
        );
    }


    if (!idsTareas.add(pedidoId)) {

        throw new IllegalArgumentException(
            "Identificador de tarea duplicado: "
            + pedidoId
        );
    }


    PedidoInput pedido =
        instancia.pedidos.get(
            indice
        );


    pedido.pedidoId =
        pedidoId;


    pedido.pedidoOriginalId =
        pedidoOriginalId;
}


instancia.instanciaId =
    instanciaId;


instancia.fechaOperacion =
    fechaOperacion;


instancia.seedEscenario =
    alpyneSeedEscenario;


instancia.seedEjecucion =
    alpyneSeedEjecucion;


traceln(
    "IDENTIDAD ALPYNE APLICADA"
    + " | instancia="
    + instancia.instanciaId
    + " | fecha="
    + instancia.fechaOperacion
    + " | seedEscenario="
    + instancia.seedEscenario
    + " | seedEjecucion="
    + instancia.seedEjecucion
    + " | tareas="
    + instancia.pedidos.size()
);


return instancia;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788112043920</Id>
					<Name><![CDATA[limpiarComparacionSimuladaLocal]]></Name>
					<X>-810</X><Y>4990</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[comparacionSimuladaResultados =
    new double[5][21];


comparacionSimuladaMetodoRecibido =
    new boolean[5];


comparacionSimuladaDisponible =
    false;


comparacionSimuladaCompleta =
    false;


comparacionSimuladaEstado =
    "Sin comparación simulada.";


comparacionSimuladaResumenPython =
    "SIN_COMPARACION_SIMULADA";


comparacionSimuladaFirmaPython =
    "SIN_COMPARACION_SIMULADA";


comparacionSimuladaTiempoTotalSegundos =
    0.0;


comparacionSimuladaDetalleMetodo =
    new String[5];
    
modoResumenComparacion =
    "Estimado";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788112091271</Id>
					<Name><![CDATA[construirContratoIdentificadoresComparacion]]></Name>
					<X>-810</X><Y>5020</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Body><![CDATA[if (
    instancia == null
    ||
    instancia.pedidos == null
    ||
    instancia.pedidos.isEmpty()
) {

    throw new IllegalArgumentException(
        "La instancia no contiene pedidos "
        + "para construir el contrato de identidad."
    );
}


java.util.Base64.Encoder encoder =
    java.util.Base64.getEncoder();


StringBuilder contrato =
    new StringBuilder();


contrato.append(
    "IDMAP1|"
);


contrato.append(
    instancia.pedidos.size()
);


for (
    int indice = 0;
    indice < instancia.pedidos.size();
    indice++
) {

    PedidoInput pedido =
        instancia.pedidos.get(
            indice
        );


    if (pedido == null) {

        throw new IllegalArgumentException(
            "La tarea "
            + indice
            + " es null."
        );
    }


    String pedidoId =
        pedido.pedidoId == null
        ? ""
        : pedido.pedidoId.trim();


    String pedidoOriginalId =
        pedido.pedidoOriginalId == null
        ? ""
        : pedido.pedidoOriginalId.trim();


    if (pedidoOriginalId.isEmpty()) {

        pedidoOriginalId =
            pedidoId;
    }


    if (
        pedidoId.isEmpty()
        ||
        pedidoOriginalId.isEmpty()
    ) {

        throw new IllegalArgumentException(
            "La tarea "
            + indice
            + " posee identificadores vacíos."
        );
    }


    String pedidoCodificado =
        encoder.encodeToString(
            pedidoId.getBytes(
                java.nio.charset.StandardCharsets.UTF_8
            )
        );


    String originalCodificado =
        encoder.encodeToString(
            pedidoOriginalId.getBytes(
                java.nio.charset.StandardCharsets.UTF_8
            )
        );


    contrato.append(
        "|"
    );


    contrato.append(
        pedidoCodificado
    );


    contrato.append(
        ":"
    );


    contrato.append(
        originalCodificado
    );
}


return contrato.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788112111231</Id>
					<Name><![CDATA[resolverModeloExportadoComparacionSimulada]]></Name>
					<X>-810</X><Y>5050</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[try {

    String raizPython =
        resolverRaizPythonPypeline();


    java.io.File archivo =
        new java.io.File(
            raizPython,
            "anylogic_export"
            + java.io.File.separator
            + "simulated_comparison"
            + java.io.File.separator
            + "PedemonteDigitalTwin_v2.zip"
        ).getCanonicalFile();


    if (!archivo.isFile()) {

        throw new IllegalStateException(
            "No existe el modelo exportado: "
            + archivo.getCanonicalPath()
        );
    }


    return archivo.getCanonicalPath();


} catch (java.io.IOException ex) {

    throw new IllegalStateException(
        "No fue posible resolver el modelo "
        + "exportado de comparación.",
        ex
    );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double[]]]></ReturnType>
					<Id>1788112124767</Id>
					<Name><![CDATA[bloqueComparacionSimulada]]></Name>
					<X>-810</X><Y>5080</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metodo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[int indice =
    indiceMetodoComparacion(
        metodo
    );


if (
    !comparacionSimuladaDisponible
    ||
    indice < 0
    ||
    indice
        >= comparacionSimuladaResultados.length
    ||
    !comparacionSimuladaMetodoRecibido[
        indice
    ]
) {

    return null;
}


double[] resultado =
    comparacionSimuladaResultados[
        indice
    ];


if (
    resultado == null
    ||
    resultado.length != 21
) {

    return null;
}


return resultado;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1788112150423</Id>
					<Name><![CDATA[codigoEstadoComparacionSimulada]]></Name>
					<X>-810</X><Y>5110</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metodo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[double[] resultado =
    bloqueComparacionSimulada(
        metodo
    );


if (resultado == null) {

    return 0;
}


return
    (int) Math.round(
        resultado[1]
    );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788112169063</Id>
					<Name><![CDATA[textoEstadoSimuladoComparacion]]></Name>
					<X>-810</X><Y>5140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metodo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[switch (
    codigoEstadoComparacionSimulada(
        metodo
    )
) {

    case 1:
        return "Finalizado";

    case 2:
        return "Error";

    case 3:
        return "Omitido";

    default:
        return "No simulado";
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.awt.Color]]></ReturnType>
					<Id>1788112185535</Id>
					<Name><![CDATA[colorEstadoSimuladoComparacion]]></Name>
					<X>-810</X><Y>5170</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metodo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[switch (
    codigoEstadoComparacionSimulada(
        metodo
    )
) {

    case 1:
        return java.awt.Color.decode(
            "#DDF4E8"
        );

    case 2:
        return java.awt.Color.decode(
            "#FDE2E2"
        );

    case 3:
        return java.awt.Color.decode(
            "#FFF1CC"
        );

    default:
        return java.awt.Color.decode(
            "#E8EEF5"
        );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1788112207064</Id>
					<Name><![CDATA[ejecutarComparacionSimuladaPypeline]]></Name>
					<X>-810</X><Y>5200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    ejecucionEnCurso
    ||
    pypelineSolicitudEnCurso
) {

    comparacionSimuladaEstado =
        "Existe una planificación "
        + "o ejecución en curso.";

    return false;
}


if (!instanciaBaseRepetibleDisponible()) {

    comparacionSimuladaEstado =
        "No existe una instancia base "
        + "preservada para comparar.";

    return false;
}


if (!comparacionEstimadaDisponible) {

    comparacionSimuladaEstado =
        "Primero debe ejecutarse "
        + "la comparación estimada.";

    return false;
}


if (
    comparacionEstimadaFirmaPython == null
    ||
    "SIN_COMPARACION".equals(
        comparacionEstimadaFirmaPython
    )
) {

    comparacionSimuladaEstado =
        "La comparación estimada "
        + "no posee una firma válida.";

    return false;
}


if (!inicializarSelectorPypeline()) {

    comparacionSimuladaEstado =
        "No fue posible inicializar "
        + "el selector Python: "
        + pypelineEstadoSelector;

    return false;
}


limpiarComparacionSimuladaLocal();


pypelineSolicitudEnCurso =
    true;


comparacionSimuladaEstado =
    "Ejecutando comparación simulada: "
    + "5 corridas externas independientes...";


try {

    InstanciaTurno instancia =
        instanciaBaseRepetible;


    double[] instanciaVector =
        vectorInstanciaBaseRepetible == null
        ? new double[0]
        : vectorInstanciaBaseRepetible.clone();


    if (instanciaVector.length == 0) {

        instanciaVector =
            construirVectorInstanciaPypeline(
                instancia
            );
    }


    String raizPython =
        resolverRaizPythonPypeline();


    String modeloExportado =
        resolverModeloExportadoComparacionSimulada();


    String contratoIds =
        construirContratoIdentificadoresComparacion(
            instancia
        );


    String vectorLiteral =
        pyCommunicator.toJson(
            instanciaVector
        );


    String modeloLiteral =
        pyCommunicator.toJson(
            modeloExportado
        );


    String raizLiteral =
        pyCommunicator.toJson(
            raizPython
        );


    String idsLiteral =
        pyCommunicator.toJson(
            contratoIds
        );


    String instanciaIdLiteral =
        pyCommunicator.toJson(
            instancia.instanciaId
        );


    String fechaLiteral =
        pyCommunicator.toJson(
            instancia.fechaOperacion
        );


    pyCommunicator.run(
        "import importlib",

        (
            "from planner.integration "
            + "import simulated_comparison_bridge "
            + "as pedemonte_simulated_bridge"
        ),

        (
            "pedemonte_simulated_bridge = "
            + "importlib.reload("
            + "pedemonte_simulated_bridge)"
        )
    );


    String comando =
        "pedemonte_simulated_bridge."
        + "comparar_simulado_vector("
        + vectorLiteral
        + ", "
        + instancia.seedEscenario
        + ", "
        + instancia.seedEjecucion
        + ", "
        + modeloLiteral
        + ", "
        + raizLiteral
        + ", "
        + idsLiteral
        + ", "
        + instanciaIdLiteral
        + ", "
        + fechaLiteral
        + ", proveedores_habilitados=True"
        + ", timeout_segundos_por_metodo=240"
        + ", horizonte_simulacion_min=600.0"
        + ")";


    double[] vectorComparacion =
        pyCommunicator.runResults(
            double[].class,
            comando
        );


    if (
        vectorComparacion == null
        ||
        vectorComparacion.length < 4
    ) {

        throw new IllegalStateException(
            "Python devolvió un vector simulado "
            + "vacío o incompleto."
        );
    }


    int version =
        (int) Math.round(
            vectorComparacion[0]
        );


    int cantidadMetodos =
        (int) Math.round(
            vectorComparacion[1]
        );


    int camposPorMetodo =
        (int) Math.round(
            vectorComparacion[2]
        );


    if (version != 1) {

        throw new IllegalStateException(
            "Versión simulada no soportada: "
            + version
        );
    }


    if (cantidadMetodos != 5) {

        throw new IllegalStateException(
            "Python devolvió "
            + cantidadMetodos
            + " métodos simulados; "
            + "se esperaban 5."
        );
    }


    if (camposPorMetodo != 21) {

        throw new IllegalStateException(
            "Python devolvió "
            + camposPorMetodo
            + " campos por método; "
            + "se esperaban 21."
        );
    }


    int longitudEsperada =
        4
        +
        cantidadMetodos
        *
        camposPorMetodo;


    if (
        vectorComparacion.length
        != longitudEsperada
    ) {

        throw new IllegalStateException(
            "Longitud incorrecta del vector "
            + "simulado. Esperada="
            + longitudEsperada
            + ", recibida="
            + vectorComparacion.length
            + "."
        );
    }


    comparacionSimuladaTiempoTotalSegundos =
        vectorComparacion[3];


    int finalizados =
        0;


    for (
        int posicion = 0;
        posicion < cantidadMetodos;
        posicion++
    ) {

        int base =
            4
            +
            posicion
            *
            camposPorMetodo;


        int codigoMetodo =
            (int) Math.round(
                vectorComparacion[base]
            );


        int codigoEstado =
            (int) Math.round(
                vectorComparacion[
                    base + 1
                ]
            );


        if (
            codigoMetodo < 0
            ||
            codigoMetodo >= 5
        ) {

            throw new IllegalStateException(
                "Código de método simulado inválido: "
                + codigoMetodo
            );
        }


        if (
            codigoEstado < 1
            ||
            codigoEstado > 3
        ) {

            throw new IllegalStateException(
                "Código de estado simulado inválido: "
                + codigoEstado
            );
        }


        if (
            comparacionSimuladaMetodoRecibido[
                codigoMetodo
            ]
        ) {

            throw new IllegalStateException(
                "Python devolvió dos veces "
                + "el resultado simulado de "
                + nombreMetodoComparacion(
                    codigoMetodo
                )
                + "."
            );
        }


        double[] bloque =
            new double[21];


        System.arraycopy(
            vectorComparacion,
            base,
            bloque,
            0,
            21
        );


        comparacionSimuladaResultados[
            codigoMetodo
        ] =
            bloque;


        comparacionSimuladaMetodoRecibido[
            codigoMetodo
        ] =
            true;


        if (codigoEstado == 1) {

            finalizados++;
        }
    }


    for (
        int indice = 0;
        indice < 5;
        indice++
    ) {

        if (
            !comparacionSimuladaMetodoRecibido[
                indice
            ]
        ) {

            throw new IllegalStateException(
                "No se recibió el resultado "
                + "simulado de "
                + nombreMetodoComparacion(
                    indice
                )
                + "."
            );
        }
    }


    comparacionSimuladaResumenPython =
        pyCommunicator.runResults(
            String.class,

            (
                "pedemonte_simulated_bridge."
                + "obtener_resumen_"
                + "comparacion_simulada()"
            )
        );


    comparacionSimuladaFirmaPython =
        pyCommunicator.runResults(
            String.class,

            (
                "pedemonte_simulated_bridge."
                + "obtener_firma_"
                + "comparacion_simulada()"
            )
        );


    if (
        comparacionSimuladaResumenPython == null
        ||
        !comparacionSimuladaResumenPython.startsWith(
            "OK|"
        )
    ) {

        throw new IllegalStateException(
            "Resumen simulado inesperado: "
            + comparacionSimuladaResumenPython
        );
    }


    if (
        comparacionSimuladaFirmaPython == null
        ||
        !comparacionSimuladaFirmaPython.equals(
            comparacionEstimadaFirmaPython
        )
    ) {

        throw new IllegalStateException(
            "La firma simulada no coincide "
            + "con la comparación estimada."
        );
    }


    for (
        int indice = 0;
        indice < 5;
        indice++
    ) {

        String metodo =
            nombreMetodoComparacion(
                indice
            );


        String metodoLiteral =
            pyCommunicator.toJson(
                metodo
            );


        comparacionSimuladaDetalleMetodo[
            indice
        ] =
            pyCommunicator.runResults(
                String.class,

                (
                    "pedemonte_simulated_bridge."
                    + "obtener_estado_metodo_"
                    + "comparacion_simulada("
                    + metodoLiteral
                    + ")"
                )
            );
    }


    comparacionSimuladaDisponible =
        true;


    comparacionSimuladaCompleta =
        finalizados == 5;


    comparacionSimuladaEstado =
        "Comparación simulada finalizada: "
        + finalizados
        + "/5 métodos"
        + " | "
        + String.format(
            java.util.Locale.US,
            "%.2f",
            comparacionSimuladaTiempoTotalSegundos
        )
        + " s.";


    traceln(
        "================================"
    );

    traceln(
        "=== COMPARACIÓN SIMULADA ======="
    );

    traceln(
        "================================"
    );

    traceln(
        comparacionSimuladaEstado
    );

    traceln(
        comparacionSimuladaResumenPython
    );


    for (
        int indice = 0;
        indice < 5;
        indice++
    ) {

        traceln(
            comparacionSimuladaDetalleMetodo[
                indice
            ]
        );
    }


    return comparacionSimuladaCompleta;


} catch (Exception ex) {

    String detalleError =
        ex.getClass()
            .getSimpleName()
        + ": "
        + String.valueOf(
            ex.getMessage()
        );


    limpiarComparacionSimuladaLocal();


    comparacionSimuladaEstado =
        "Error de comparación simulada: "
        + detalleError;


    traceln(
        "ERROR COMPARACIÓN SIMULADA: "
        + detalleError
    );


    ex.printStackTrace();


    return false;


} finally {

    pypelineSolicitudEnCurso =
        false;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1788113950984</Id>
					<Name><![CDATA[usarResultadosSimuladosParaRanking]]></Name>
					<X>-810</X><Y>5230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return
    "Simulado".equals(
        modoResumenComparacion
    )
    &&
    comparacionSimuladaDisponible
    &&
    comparacionSimuladaCompleta;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788113966376</Id>
					<Name><![CDATA[nombreVisibleRankingComparacion]]></Name>
					<X>-810</X><Y>5260</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metodo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (metodo == null) {

    return "—";
}


if (
    "HIBRIDO".equals(
        metodo
    )
) {

    return "HÍBRIDO";
}


return metodo;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788113995384</Id>
					<Name><![CDATA[valorCostoRankingComparacion]]></Name>
					<X>-810</X><Y>5290</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metodo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (
    usarResultadosSimuladosParaRanking()
) {

    double[] simulado =
        bloqueComparacionSimulada(
            metodo
        );


    if (
        simulado == null
        ||
        (int) Math.round(
            simulado[1]
        ) != 1
    ) {

        return Double.NaN;
    }


    return simulado[3];
}


double[] estimado =
    bloqueComparacionEstimada(
        metodo
    );


if (
    estimado == null
    ||
    estimado[1] < 0.5
) {

    return Double.NaN;
}


return estimado[3];]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788114014704</Id>
					<Name><![CDATA[resumenRankingComparacion]]></Name>
					<X>-810</X><Y>5320</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    !comparacionEstimadaDisponible
) {

    return
        "Ranking por costo";
}


if (
    usarResultadosSimuladosParaRanking()
) {

    return
        "Ranking por costo simulado";
}


return
    "Ranking por costo estimado";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788114542514</Id>
					<Name><![CDATA[valorMetricaResumenComparacion]]></Name>
					<X>-810</X><Y>5350</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metodo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[metrica]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String clave =
    metrica == null
    ? ""
    : metrica
        .trim()
        .toUpperCase(
            java.util.Locale.ROOT
        );


if (
    usarResultadosSimuladosParaRanking()
) {

    double[] resultado =
        bloqueComparacionSimulada(
            metodo
        );


    if (
        resultado == null
        ||
        (int) Math.round(
            resultado[1]
        ) != 1
    ) {

        return Double.NaN;
    }


    switch (clave) {

        case "COSTO":
            return resultado[3];

        case "DISTANCIA":
            return resultado[4];

        case "DESBALANCE":
            return resultado[8];

        default:
            return Double.NaN;
    }
}


double[] resultado =
    bloqueComparacionEstimada(
        metodo
    );


if (
    resultado == null
    ||
    resultado[1] < 0.5
) {

    return Double.NaN;
}


switch (clave) {

    case "COSTO":
        return resultado[3];

    case "DISTANCIA":
        return resultado[12];

    case "DESBALANCE":
        return resultado[17];

    default:
        return Double.NaN;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788114567770</Id>
					<Name><![CDATA[metodoGanadorResumenComparacion]]></Name>
					<X>-810</X><Y>5380</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metrica]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (
    !comparacionEstimadaDisponible
) {

    return "";
}


String[] metodos = {
    "RL",
    "HIBRIDO",
    "GREEDY",
    "RANDOM",
    "GA"
};


String ganador =
    "";


double mejorValor =
    Double.NaN;


for (
    String metodo
    : metodos
) {

    double valor =
        valorMetricaResumenComparacion(
            metodo,
            metrica
        );


    if (
        Double.isNaN(
            valor
        )
        ||
        Double.isInfinite(
            valor
        )
    ) {

        continue;
    }


    if (ganador.isEmpty()) {

        ganador =
            metodo;


        mejorValor =
            valor;


        continue;
    }


    double valorRedondeado =
        Math.round(
            valor
            *
            100.0
        )
        /
        100.0;


    double mejorRedondeado =
        Math.round(
            mejorValor
            *
            100.0
        )
        /
        100.0;


    if (
        valorRedondeado
        <
        mejorRedondeado
    ) {

        ganador =
            metodo;


        mejorValor =
            valor;
    }
}


return ganador;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788114597722</Id>
					<Name><![CDATA[textoTarjetaResumenComparacion]]></Name>
					<X>-810</X><Y>5410</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metrica]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (
    !comparacionEstimadaDisponible
) {

    return
        "—"
        + "\nSin datos";
}


String ganador =
    metodoGanadorResumenComparacion(
        metrica
    );


if (
    ganador == null
    ||
    ganador.isEmpty()
) {

    return
        "—"
        + "\nSin datos";
}


double valor =
    valorMetricaResumenComparacion(
        ganador,
        metrica
    );


String clave =
    metrica == null
    ? ""
    : metrica
        .trim()
        .toUpperCase(
            java.util.Locale.ROOT
        );


String unidad;


switch (clave) {

    case "DISTANCIA":

        unidad =
            " km";

        break;


    case "DESBALANCE":

        unidad =
            " min";

        break;


    default:

        unidad =
            "";
}


return
    nombreVisibleRankingComparacion(
        ganador
    )
    +
    "\n"
    +
    formatearNumeroComparacion(
        valor,
        2
    )
    +
    unidad;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String[]]]></ReturnType>
					<Id>1788115343007</Id>
					<Name><![CDATA[ordenMetodosRankingComparacion]]></Name>
					<X>-810</X><Y>5440</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[String[] metodos = {
    "RL",
    "HIBRIDO",
    "GREEDY",
    "RANDOM",
    "GA"
};


double[] valores =
    new double[
        metodos.length
    ];


for (
    int indice = 0;
    indice < metodos.length;
    indice++
) {

    valores[indice] =
        valorCostoRankingComparacion(
            metodos[indice]
        );
}


// Ordenamiento estable ascendente.
// Se comparan los costos redondeados a dos
// decimales para evitar desempates por ruido
// numérico de punto flotante.

for (
    int posicion = 0;
    posicion < metodos.length - 1;
    posicion++
) {

    for (
        int candidato = posicion + 1;
        candidato < metodos.length;
        candidato++
    ) {

        double costoPosicion =
            valores[posicion];


        double costoCandidato =
            valores[candidato];


        boolean posicionInvalida =
            Double.isNaN(
                costoPosicion
            )
            ||
            Double.isInfinite(
                costoPosicion
            );


        boolean candidatoValido =
            !Double.isNaN(
                costoCandidato
            )
            &&
            !Double.isInfinite(
                costoCandidato
            );


        boolean intercambiar =
            posicionInvalida
            &&
            candidatoValido;


        if (
            !posicionInvalida
            &&
            candidatoValido
        ) {

            double costoPosicionRedondeado =
                Math.round(
                    costoPosicion
                    *
                    100.0
                )
                /
                100.0;


            double costoCandidatoRedondeado =
                Math.round(
                    costoCandidato
                    *
                    100.0
                )
                /
                100.0;


            intercambiar =
                costoCandidatoRedondeado
                <
                costoPosicionRedondeado;
        }


        if (intercambiar) {

            String metodoTemporal =
                metodos[posicion];


            metodos[posicion] =
                metodos[candidato];


            metodos[candidato] =
                metodoTemporal;


            double valorTemporal =
                valores[posicion];


            valores[posicion] =
                valores[candidato];


            valores[candidato] =
                valorTemporal;
        }
    }
}


return metodos;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788115360743</Id>
					<Name><![CDATA[textoPuestoRankingComparacion]]></Name>
					<X>-810</X><Y>5470</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[posicion]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if (
    posicion < 0
    ||
    posicion >= 5
) {

    return "—";
}


if (
    !comparacionEstimadaDisponible
) {

    return
        "—"
        + "\nSin datos";
}


String[] orden =
    ordenMetodosRankingComparacion();


String metodo =
    orden[posicion];


double costo =
    valorCostoRankingComparacion(
        metodo
    );


if (
    Double.isNaN(
        costo
    )
    ||
    Double.isInfinite(
        costo
    )
) {

    return
        (posicion + 1)
        + "°"
        + "\n—"
        + "\nSin datos";
}


return
    (posicion + 1)
    + "°"

    + "\n"

    + nombreVisibleRankingComparacion(
        metodo
    )

    + "\n"

    + formatearNumeroComparacion(
        costo,
        2
    );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1788117472587</Id>
					<Name><![CDATA[graficoComparacionDisponible]]></Name>
					<X>-810</X><Y>5500</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    !comparacionEstimadaDisponible
) {

    return false;
}


boolean fuenteSimulada =
    "Simulado".equals(
        modoDatosComparacion
    );


boolean fuenteDoble =
    modoGraficoComparacionDoble();


if (
    graficoCostoTiempoSeleccionado()
    &&
    (
        fuenteSimulada
        ||
        fuenteDoble
    )
) {

    return false;
}


if (
    fuenteSimulada
    ||
    fuenteDoble
) {

    if (
        !comparacionSimuladaDisponible
        ||
        !comparacionSimuladaCompleta
    ) {

        return false;
    }
}


if (
    "Tiempo de planificación".equals(
        graficoComparacionSeleccionado
    )
    &&
    (
        fuenteSimulada
        ||
        fuenteDoble
    )
) {

    return false;
}


if (
    graficoDesgloseCostoSeleccionado()
    &&
    fuenteDoble
) {

    return false;
}


return true;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
