		<JavaClass>
			<Id>1786556950491</Id>
			<Name><![CDATA[ResultadoValidacionPlan]]></Name>
			<Folder>1786556019063</Folder>
			<Text><![CDATA[/**
 * ResultadoValidacionPlan
 */	
public class ResultadoValidacionPlan implements Serializable {

	public boolean valido = true;

	public java.util.ArrayList<String> errores =
	    new java.util.ArrayList<String>();


	public void agregarError(String error) {
	    valido = false;
	    errores.add(error);
	}


	@Override
	public String toString() {
	    return "ResultadoValidacionPlan{" +
	        "valido=" + valido +
	        ", errores=" + errores +
	        '}';
	}

}]]></Text>
		</JavaClass>
