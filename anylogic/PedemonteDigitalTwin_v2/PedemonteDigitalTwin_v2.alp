					<Body><![CDATA[switch (turno) {
    case MANANA:
        return HORA_FIN_MANANA_MIN;

    case TARDE:
        return HORA_FIN_TARDE_MIN;

    default:
        throw new IllegalArgumentException(
            "Turno no soportado: " + turno
        );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
