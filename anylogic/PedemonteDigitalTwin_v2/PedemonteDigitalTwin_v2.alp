				 	<EmbeddedIcon>false</EmbeddedIcon>				
					<Id>1787145354943</Id>
					<Name><![CDATA[btnLimpiarInstancia]]></Name>
					<X>270</X><Y>775</Y>
					<Label><X>0</X><Y>-10</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
					<BasicProperties Width="140" Height="32">
                        <EmbeddedIcon>false</EmbeddedIcon>	
						<TextColor>-11377547</TextColor>
						<Enabled>true</Enabled>
						<EnableExpression><![CDATA[instanciaInterfazActual != null
&&
!ejecucionEnCurso
&&
!pypelineSolicitudEnCurso]]></EnableExpression>
						<ActionCode><![CDATA[if (
    ejecucionEnCurso
    ||
    pypelineSolicitudEnCurso
) {

    traceln(
        "No se puede limpiar la instancia "
        + "mientras existe una planificación "
        + "o ejecución en curso."
    );

    return;
}


instanciaInterfazActual =
    null;


cacheVialInstanciaCompleta =
    false;


cacheVialTramosRequeridos =
    0;


cacheVialTramosFaltantes =
    0;


cacheVialEstadoInterfaz =
    "SIN INSTANCIA";


limpiarRutasPlanGIS();


limpiarMarcadoresCamionesGIS();


limpiarPedidosGIS();


mensajeInterfazPlanificacion =
    "Sin instancia cargada.";


traceln(
    mensajeInterfazPlanificacion
);]]></ActionCode>
					</BasicProperties>
					<ExtendedProperties>
						<Font Name="SansSerif" Size="10" Style="0"/>
						<LabelText><![CDATA[Limpiar operación]]></LabelText>
					</ExtendedProperties>
				</Control>
