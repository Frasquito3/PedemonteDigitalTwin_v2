							<Value Class="CodeValue">
								<Code><![CDATA[webToolkitListo =
    true;


webToolkitEstado =
    "CONECTADO";


webToolkitUltimoMensaje =
    "__ready__";


java.util.Map<String, Object> contexto =
    new java.util.LinkedHashMap<String, Object>();


contexto.put(
    "mensaje",
    "AnyLogic conectado correctamente"
);


contexto.put(
    "contrato",
    1
);


contexto.put(
    "tiempoModelo",
    time()
);


contexto.put(
    "modo",
    "PRUEBA_CONEXION"
);


webAppPedidos
    .dialog
    .getBridge()
    .emit(
        "pedemonteWebReady",
        contexto
    );


traceln(
    "================================"
);

traceln(
    "=== WEBTOOLKIT CONECTADO ======="
);

traceln(
    "================================"
);

traceln(
    "HTML listo"
    + " | ruta=web/pedidos/pedidos.html"
    + " | contrato=1"
);

emitirEstadoPedidosWeb(
    "",
    "INICIAL",
    true,
    "Estado inicial sincronizado."
);

webAppPedidos
    .dialog
    .hide();]]></Code>
