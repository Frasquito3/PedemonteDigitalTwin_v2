					<X>-810</X><Y>4810</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[instanciaBaseRepetible =
    null;


pedidosOriginalesBaseRepetible =
    new java.util.ArrayList<PedidoInput>();


vectorInstanciaBaseRepetible =
    new double[0];]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1788108024810</Id>
					<Name><![CDATA[instanciaBaseRepetibleDisponible]]></Name>
					<X>-810</X><Y>4840</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return
    instanciaBaseRepetible != null
    &&
    instanciaBaseRepetible.pedidos != null
    &&
    !instanciaBaseRepetible.pedidos.isEmpty()
    &&
    pedidosOriginalesBaseRepetible != null
    &&
    !pedidosOriginalesBaseRepetible.isEmpty()
    &&
    vectorInstanciaBaseRepetible != null
    &&
    vectorInstanciaBaseRepetible.length > 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[InstanciaTurno]]></ReturnType>
					<Id>1788108039250</Id>
					<Name><![CDATA[crearCopiaInstanciaBaseRepetible]]></Name>
					<X>-810</X><Y>4870</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (!instanciaBaseRepetibleDisponible()) {

    throw new IllegalStateException(
        "No existe una instancia base repetible."
    );
}


return copiarInstanciaTurno(
    instanciaBaseRepetible
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1788108056427</Id>
					<Name><![CDATA[instanciaBaseAisladaDeActual]]></Name>
					<X>-810</X><Y>4900</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    instanciaBaseRepetible == null
    ||
    instanciaInterfazActual == null
) {

    return false;
}


if (
    instanciaBaseRepetible
        == instanciaInterfazActual
    ||
    instanciaBaseRepetible.pedidos
        == instanciaInterfazActual.pedidos
) {

    return false;
}


if (
    instanciaBaseRepetible.pedidos.size()
    != instanciaInterfazActual.pedidos.size()
) {

    return false;
}


for (
    int i = 0;
    i < instanciaBaseRepetible.pedidos.size();
    i++
) {

    if (
        instanciaBaseRepetible.pedidos.get(i)
        ==
        instanciaInterfazActual.pedidos.get(i)
    ) {

        return false;
    }
}


return true;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
