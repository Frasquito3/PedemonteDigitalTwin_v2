				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1787864597120</Id>
					<Name><![CDATA[parsearEnteroPositivoFormulario]]></Name>
					<X>-810</X><Y>3610</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[valor]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[nombreCampo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String texto =
    textoLimpioFormulario(
        valor
    );


if (texto.isEmpty()) {

    throw new IllegalArgumentException(
        "Completá el campo "
        + nombreCampo
        + "."
    );
}


if (!texto.matches("\\d+")) {

    throw new IllegalArgumentException(
        nombreCampo
        + " debe contener un número entero."
    );
}


int resultado;


try {

    resultado =
        Integer.parseInt(
            texto
        );

} catch (Exception ex) {

    throw new IllegalArgumentException(
        nombreCampo
        + " contiene un valor demasiado grande."
    );
}


if (resultado <= 0) {

    throw new IllegalArgumentException(
        nombreCampo
        + " debe ser mayor que cero."
    );
}


return resultado;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787864624416</Id>
					<Name><![CDATA[parsearDecimalFormulario]]></Name>
					<X>-810</X><Y>3640</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[valor]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[nombreCampo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String texto =
    textoLimpioFormulario(
        valor
    );


if (texto.isEmpty()) {

    throw new IllegalArgumentException(
        "Completá el campo "
        + nombreCampo
        + "."
    );
}


// Permite escribir decimales con punto o coma.

texto =
    texto.replace(
        ',',
        '.'
    );


double resultado;


try {

    resultado =
        Double.parseDouble(
            texto
        );

} catch (Exception ex) {

    throw new IllegalArgumentException(
        nombreCampo
        + " debe contener un número decimal válido."
    );
}


if (!Double.isFinite(resultado)) {

    throw new IllegalArgumentException(
        nombreCampo
        + " no contiene un valor finito."
    );
}


return resultado;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.awt.Color]]></ReturnType>
					<Id>1787864649912</Id>
					<Name><![CDATA[colorMensajeFormulario]]></Name>
					<X>-810</X><Y>3670</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[String mensaje =
    mensajeFormulario == null
    ? ""
    : mensajeFormulario.trim();


if (
    mensaje.startsWith(
        "Revisá"
    )
    ||
    mensaje.startsWith(
        "No se puede"
    )
    ||
    mensaje.startsWith(
        "No se pudo"
    )
    ||
    mensaje.startsWith(
        "Error"
    )
) {

    return new java.awt.Color(
        185,
        28,
        28
    );
}


if (
    mensaje.startsWith(
        "OK:"
    )
    ||
    mensaje.startsWith(
        "Importación completada"
    )
    ||
    mensaje.contains(
        "agregado"
    )
) {

    return new java.awt.Color(
        22,
        101,
        52
    );
}


return new java.awt.Color(
    100,
    116,
    139
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1787864834583</Id>
					<Name><![CDATA[abreviarTextoDashboard]]></Name>
					<X>-810</X><Y>3700</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[valor]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[maximo]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[String texto =
    valor == null
    ? ""
    : valor.trim();


if (
    texto.length()
    <= maximo
) {

    return texto;
}


if (maximo <= 1) {

    return "…";
}


return texto.substring(
    0,
    maximo - 1
)
+ "…";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1787864860247</Id>
					<Name><![CDATA[detalleCamionDashboard]]></Name>
					<X>-810</X><Y>3730</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[camionId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[String estado =
    estadosCamionesGIS.get(
        camionId
    );


if (
    estado == null
    ||
    estado.trim().isEmpty()
) {

    return "Sin actividad";
}


estado =
    estado.trim();


if (
    estado.equals(
        "EN_CORRALON"
    )
) {

    return "Disponible";
}


if (
    estado.equals(
        "PLAN_FINALIZADO"
    )
) {

    return "Sin pendientes";
}


if (
    estado.equals(
        "REGRESANDO_CORRALON"
    )
) {

    return "Hacia corralón";
}


if (
    estado.startsWith(
        "VIAJANDO_A_"
    )
) {

    String destino =
        estado.substring(
            "VIAJANDO_A_".length()
        );


    return "Hacia "
	    + abreviarTextoDashboard(
	        destino,
	        9
	    );
}


if (
    estado.startsWith(
        "EN_CLIENTE_"
    )
) {

    String cliente =
        estado.substring(
            "EN_CLIENTE_".length()
        );


    return "Atiende "
	    + abreviarTextoDashboard(
	        cliente,
	        8
	    );
}


if (
    estado.contains(
        "CARGA"
    )
) {

    return "Preparando salida";
}


if (
    estado.contains(
        "ESPERA"
    )
) {

    return "En espera";
}


return "Estado operativo";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Camion]]></ReturnType>
					<Id>1788011089065</Id>
					<Name><![CDATA[obtenerCamionGIS]]></Name>
					<X>-810</X><Y>3760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[camionId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if (camionId < 0) {

    return null;
}


for (Camion camion : camiones) {

    if (
        camion != null
        &&
        camion.camionId == camionId
    ) {

        return camion;
    }
}


return null;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788011174913</Id>
					<Name><![CDATA[actualizarSeguimientoCamionGIS]]></Name>
					<X>-810</X><Y>3790</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    mapaGIS == null
    ||
    modoVistaGIS < 0
) {

    return;
}


Camion camion =
    obtenerCamionGIS(
        modoVistaGIS
    );


if (camion == null) {

    return;
}


double latitud =
    camion.getLatitude();


double longitud =
    camion.getLongitude();


if (
    !Double.isFinite(
        latitud
    )
    ||
    !Double.isFinite(
        longitud
    )
) {

    return;
}


mapaGIS.setProjectionCenter(
    latitud,
    longitud
);


mapaGIS.setMapScale(
    escalaSeguimientoGIS
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788011189378</Id>
					<Name><![CDATA[activarSeguimientoCamionGIS]]></Name>
					<X>-810</X><Y>3820</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[camionId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if (mapaGIS == null) {

    return;
}


Camion camion =
    obtenerCamionGIS(
        camionId
    );


if (camion == null) {

    traceln(
        "VISTA GIS | camión no disponible: "
        + camionId
    );

    return;
}


double latitud =
    camion.getLatitude();


double longitud =
    camion.getLongitude();


if (
    !Double.isFinite(
        latitud
    )
    ||
    !Double.isFinite(
        longitud
    )
) {

    return;
}


modoVistaGIS =
    camionId;


// Primero ubicamos el centro en la posición actual.
mapaGIS.setProjectionCenter(
    latitud,
    longitud
);


// La escala es una proporción: 1 / 20000.
mapaGIS.setMapScale(
    escalaSeguimientoGIS
);


traceln(
    "VISTA GIS | siguiendo camión "
    + camionId
    + " | escala="
    + escalaSeguimientoGIS
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788011223659</Id>
					<Name><![CDATA[activarVistaGeneralGIS]]></Name>
					<X>-810</X><Y>3850</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[modoVistaGIS =
    -1;


if (mapaGIS == null) {

    return;
}


InstanciaTurno referencia =
    instanciaInterfazActual != null
    ? instanciaInterfazActual
    : instanciaActual;


if (referencia == null) {

    mapaGIS.fitBounds(
        LAT_CORRALON - 0.004,
        LON_CORRALON - 0.004,
        LAT_CORRALON + 0.004,
        LON_CORRALON + 0.004
    );

    return;
}


double latitudMinima =
    referencia.latCorralon;


double latitudMaxima =
    referencia.latCorralon;


double longitudMinima =
    referencia.lonCorralon;


double longitudMaxima =
    referencia.lonCorralon;


if (referencia.pedidos != null) {

    for (
        PedidoInput pedido
        : referencia.pedidos
    ) {

        if (
            pedido == null
            ||
            !Double.isFinite(
                pedido.latitud
            )
            ||
            !Double.isFinite(
                pedido.longitud
            )
        ) {

            continue;
        }


        latitudMinima =
            Math.min(
                latitudMinima,
                pedido.latitud
            );


        latitudMaxima =
            Math.max(
                latitudMaxima,
                pedido.latitud
            );


        longitudMinima =
            Math.min(
                longitudMinima,
                pedido.longitud
            );


        longitudMaxima =
            Math.max(
                longitudMaxima,
                pedido.longitud
            );
    }
}


double margenLatitud =
    Math.max(
        0.002,
        (
            latitudMaxima
            - latitudMinima
        )
        *
        0.12
    );


double margenLongitud =
    Math.max(
        0.002,
        (
            longitudMaxima
            - longitudMinima
        )
        *
        0.12
    );


mapaGIS.fitBounds(
    latitudMinima
        - margenLatitud,
    longitudMinima
        - margenLongitud,
    latitudMaxima
        + margenLatitud,
    longitudMaxima
        + margenLongitud
);


traceln(
    "VISTA GIS | vista general"
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
