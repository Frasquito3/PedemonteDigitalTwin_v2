					<Name><![CDATA[textoLeyendaGraficoComparacion]]></Name>
					<X>-810</X><Y>5710</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    !graficoComparacionDisponible()
) {

    return "";
}

if (
    graficoCostoTiempoSeleccionado()
) {

    return
        "Eje X: tiempo de planificación (ms)"
        + "  |  Eje Y: costo estimado"
        + "  |  Mejor zona: abajo a la izquierda";
}


if (
    modoGraficoComparacionDoble()
) {

    return
        "Azul = Estimado  |  Verde = Simulado"
        + "  |  Escala relativa al mayor valor visible";
}


return
    "Fuente: "
    + modoDatosComparacion
    + "  |  Escala relativa al mayor valor visible"
    + "  |  Menor valor = mejor desempeño";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
