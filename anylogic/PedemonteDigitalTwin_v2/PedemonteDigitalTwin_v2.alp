				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1786648231033</Id>
					<Name><![CDATA[viajesTotalesAlpyne]]></Name>
					<X>-810</X><Y>1660</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    resultadoActual == null
    ||
    resultadoActual.metricasGlobales == null
) {
    return 0;
}

return resultadoActual
    .metricasGlobales
    .viajesTotales;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1786650931745</Id>
					<Name><![CDATA[enteroAlpyne]]></Name>
					<X>-810</X><Y>1690</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[valor]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[campo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (!Double.isFinite(valor)) {

    throw new IllegalArgumentException(
        campo
        + " debe ser finito."
    );
}


double redondeado =
    Math.rint(valor);


if (
    Math.abs(
        valor
        - redondeado
    )
    > 1e-9
) {

    throw new IllegalArgumentException(
        campo
        + " debe ser entero. Valor recibido: "
        + valor
    );
}


if (
    redondeado
    < Integer.MIN_VALUE

    ||

    redondeado
    > Integer.MAX_VALUE
) {

    throw new IllegalArgumentException(
        campo
        + " está fuera del rango int."
    );
}


return (int) redondeado;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1786651010081</Id>
					<Name><![CDATA[booleanoAlpyne]]></Name>
					<X>-810</X><Y>1720</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[valor]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[campo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[int valorEntero =
    enteroAlpyne(
        valor,
        campo
    );


if (
    valorEntero != 0
    &&
    valorEntero != 1
) {

    throw new IllegalArgumentException(
        campo
        + " debe valer 0 o 1."
    );
}


return valorEntero == 1;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[AlgoritmoPlanificacion]]></ReturnType>
					<Id>1786651039834</Id>
					<Name><![CDATA[algoritmoAlpyne]]></Name>
					<X>-810</X><Y>1750</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[codigo]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[switch (codigo) {

    case 0:
        return AlgoritmoPlanificacion.RL;

    case 1:
        return AlgoritmoPlanificacion.GA;

    case 2:
        return AlgoritmoPlanificacion.GREEDY;

    case 3:
        return AlgoritmoPlanificacion.RANDOM;

    case 4:
        return AlgoritmoPlanificacion.MANUAL_TEST;

    default:
        throw new IllegalArgumentException(
            "Código de algoritmo no soportado: "
            + codigo
        );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[InstanciaTurno]]></ReturnType>
					<Id>1786651064713</Id>
					<Name><![CDATA[crearInstanciaAlpyneDinamica]]></Name>
					<X>-810</X><Y>1780</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[datos]]></Name>
						<Type><![CDATA[double[]]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[seed]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[final int TAMANO_CABECERA =
    8;

final int TAMANO_PEDIDO =
    10;


if (datos == null) {

    throw new IllegalArgumentException(
        "instanciaVector no puede ser null."
    );
}


if (
    datos.length
    < TAMANO_CABECERA
) {

    throw new IllegalArgumentException(
        "instanciaVector no contiene "
        + "la cabecera completa."
    );
}


int version =
    enteroAlpyne(
        datos[0],
        "instancia.version"
    );


if (
    version
    != alpyneProtocoloVersion
) {

    throw new IllegalArgumentException(
        "Versión de protocolo no soportada: "
        + version
    );
}


int turnoCodigo =
    enteroAlpyne(
        datos[1],
        "instancia.turnoCodigo"
    );


Turno turno;


if (turnoCodigo == 0) {

    turno =
        Turno.MANANA;

} else if (turnoCodigo == 1) {

    turno =
        Turno.TARDE;

} else {

    throw new IllegalArgumentException(
        "turnoCodigo debe ser 0 o 1."
    );
}


int cantidadPedidos =
    enteroAlpyne(
        datos[2],
        "instancia.cantidadPedidos"
    );


if (
    cantidadPedidos <= 0
    ||
    cantidadPedidos > MAX_PEDIDOS_RL
) {

    throw new IllegalArgumentException(
        "Cantidad de pedidos fuera de rango: "
        + cantidadPedidos
    );
}


int capacidadCamion =
    enteroAlpyne(
        datos[3],
        "instancia.capacidadCamion"
    );


if (
    capacidadCamion
    != CAPACIDAD_CAMION
) {

    throw new IllegalArgumentException(
        "La capacidad recibida es "
        + capacidadCamion
        + ", pero el modelo utiliza "
        + CAPACIDAD_CAMION
        + "."
    );
}


int cantidadCamiones =
    enteroAlpyne(
        datos[4],
        "instancia.cantidadCamiones"
    );


if (
    cantidadCamiones
    != CANTIDAD_CAMIONES
) {

    throw new IllegalArgumentException(
        "La cantidad de camiones recibida es "
        + cantidadCamiones
        + ", pero el modelo utiliza "
        + CANTIDAD_CAMIONES
        + "."
    );
}


double latCorralon =
    datos[5];

double lonCorralon =
    datos[6];


if (
    !Double.isFinite(latCorralon)
    ||
    latCorralon < -90.0
    ||
    latCorralon > 90.0
) {

    throw new IllegalArgumentException(
        "Latitud de corralón inválida."
    );
}


if (
    !Double.isFinite(lonCorralon)
    ||
    lonCorralon < -180.0
    ||
    lonCorralon > 180.0
) {

    throw new IllegalArgumentException(
        "Longitud de corralón inválida."
    );
}


int longitudEsperada =
    TAMANO_CABECERA
    +
    cantidadPedidos
    * TAMANO_PEDIDO;


if (
    datos.length
    != longitudEsperada
) {

    throw new IllegalArgumentException(
        "Longitud incorrecta de instanciaVector. "
        + "Esperada="
        + longitudEsperada
        + ", recibida="
        + datos.length
    );
}


InstanciaTurno instancia =
    new InstanciaTurno();


instancia.instanciaId =
    "ALPYNE-DYNAMIC-"
    + seed;

instancia.fechaOperacion =
    "2026-08-13";

instancia.turno =
    turno;

instancia.latCorralon =
    latCorralon;

instancia.lonCorralon =
    lonCorralon;

instancia.capacidadCamion =
    capacidadCamion;

instancia.cantidadCamiones =
    cantidadCamiones;

instancia.horaInicioTurnoMin =
    horaInicioTurno(
        turno
    );

instancia.horaFinObjetivoMin =
    horaFinObjetivoTurno(
        turno
    );

instancia.horaFinToleranciaMin =
    horaFinToleranciaTurno(
        turno
    );

instancia.seedEscenario =
    seed;

instancia.seedEjecucion =
    seed;


for (
    int i = 0;
    i < cantidadPedidos;
    i++
) {

    int base =
        TAMANO_CABECERA
        +
        i * TAMANO_PEDIDO;


    int pedidoIndice =
        enteroAlpyne(
            datos[base],
            "pedido[" + i + "].indice"
        );


    if (
        pedidoIndice
        != i
    ) {

        throw new IllegalArgumentException(
            "Los pedidos deben estar indexados "
            + "consecutivamente desde cero. "
            + "Esperado="
            + i
            + ", recibido="
            + pedidoIndice
        );
    }


    int originalIndice =
        enteroAlpyne(
            datos[base + 1],
            "pedido[" + i + "].originalIndice"
        );


    if (
        originalIndice < 0
        ||
        originalIndice >= cantidadPedidos
    ) {

        throw new IllegalArgumentException(
            "Índice original fuera de rango "
            + "para pedido "
            + i
            + "."
        );
    }


    int numeroParte =
        enteroAlpyne(
            datos[base + 2],
            "pedido[" + i + "].numeroParte"
        );


    int totalPartes =
        enteroAlpyne(
            datos[base + 3],
            "pedido[" + i + "].totalPartes"
        );


    if (
        totalPartes <= 0
        ||
        numeroParte <= 0
        ||
        numeroParte > totalPartes
    ) {

        throw new IllegalArgumentException(
            "Partición inválida para pedido "
            + i
            + ": "
            + numeroParte
            + "/"
            + totalPartes
        );
    }


    int unidades =
        enteroAlpyne(
            datos[base + 4],
            "pedido[" + i + "].unidades"
        );


    if (
        unidades <= 0
        ||
        unidades > capacidadCamion
    ) {

        throw new IllegalArgumentException(
            "Unidades fuera de capacidad "
            + "para pedido "
            + i
            + ": "
            + unidades
        );
    }


    boolean requiereVolcador =
        booleanoAlpyne(
            datos[base + 5],
            "pedido[" + i + "].requiereVolcador"
        );


    double latitud =
        datos[base + 6];

    double longitud =
        datos[base + 7];


    if (
        !Double.isFinite(latitud)
        ||
        latitud < -90.0
        ||
        latitud > 90.0
    ) {

        throw new IllegalArgumentException(
            "Latitud inválida para pedido "
            + i
            + "."
        );
    }


    if (
        !Double.isFinite(longitud)
        ||
        longitud < -180.0
        ||
        longitud > 180.0
    ) {

        throw new IllegalArgumentException(
            "Longitud inválida para pedido "
            + i
            + "."
        );
    }


    int horaDesde =
        enteroAlpyne(
            datos[base + 8],
            "pedido[" + i + "].horaDesde"
        );


    int horaHasta =
        enteroAlpyne(
            datos[base + 9],
            "pedido[" + i + "].horaHasta"
        );


    boolean tieneVentana =
        horaDesde != -1
        ||
        horaHasta != -1;


    if (
        (horaDesde == -1)
        !=
        (horaHasta == -1)
    ) {

        throw new IllegalArgumentException(
            "La ventana del pedido "
            + i
            + " debe indicar ambos límites "
            + "o utilizar -1 en ambos."
        );
    }


    if (tieneVentana) {

        if (
            horaDesde
            < instancia.horaInicioTurnoMin

            ||

            horaHasta
            > instancia.horaFinObjetivoMin

            ||

            horaDesde
            >= horaHasta
        ) {

            throw new IllegalArgumentException(
                "Ventana inválida para pedido "
                + i
                + ": "
                + horaDesde
                + "-"
                + horaHasta
            );
        }
    }


    PedidoInput pedido =
        new PedidoInput();


    pedido.pedidoId =
        String.format(
            "ALP-P%03d",
            pedidoIndice + 1
        );


    pedido.pedidoOriginalId =
        String.format(
            "ALP-O%03d",
            originalIndice + 1
        );


    pedido.numeroParte =
        numeroParte;

    pedido.totalPartes =
        totalPartes;

    pedido.turno =
        turno;

    pedido.latitud =
        latitud;

    pedido.longitud =
        longitud;

    pedido.unidadesCapacidad =
        unidades;

    pedido.requiereVolcador =
        requiereVolcador;

    pedido.tieneVentanaEspecifica =
    tieneVentana;


	if (tieneVentana) {
	
	    pedido.horaDesdeMin =
	        horaDesde;
	
	    pedido.horaHastaMin =
	        horaHasta;
	
	} else {
	
	    // Un pedido sin ventana específica puede
	    // atenderse durante todo el horario normal
	    // del turno.
	
	    pedido.horaDesdeMin =
	        instancia.horaInicioTurnoMin;
	
	    pedido.horaHastaMin =
	        instancia.horaFinObjetivoMin;
	}


    pedido.cliente =
        "Cliente Alpyne "
        + (pedidoIndice + 1);

    pedido.direccion =
        "Dirección dinámica "
        + (pedidoIndice + 1);

    pedido.barrio =
        "TEST_ALPYNE";

    pedido.observaciones =
        "Instancia recibida desde Python.";


    instancia.pedidos.add(
        pedido
    );
}


return instancia;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[PlanTurno]]></ReturnType>
					<Id>1786651122801</Id>
					<Name><![CDATA[crearPlanAlpyneDinamico]]></Name>
					<X>-810</X><Y>1810</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[datos]]></Name>
						<Type><![CDATA[double[]]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Body><![CDATA[final int TAMANO_CABECERA =
    5;

final int TAMANO_ASIGNACION =
    4;


if (datos == null) {

    throw new IllegalArgumentException(
        "planVector no puede ser null."
    );
}


if (instancia == null) {

    throw new IllegalArgumentException(
        "La instancia dinámica no puede ser null."
    );
}


if (
    datos.length
    < TAMANO_CABECERA
) {

    throw new IllegalArgumentException(
        "planVector no contiene "
        + "la cabecera completa."
    );
}


int version =
    enteroAlpyne(
        datos[0],
        "plan.version"
    );


if (
    version
    != alpyneProtocoloVersion
) {

    throw new IllegalArgumentException(
        "Versión de plan no soportada: "
        + version
    );
}


int cantidadAsignaciones =
    enteroAlpyne(
        datos[1],
        "plan.cantidadAsignaciones"
    );


if (
    cantidadAsignaciones
    != instancia.pedidos.size()
) {

    throw new IllegalArgumentException(
        "El plan debe asignar exactamente "
        + instancia.pedidos.size()
        + " pedidos, pero declara "
        + cantidadAsignaciones
        + "."
    );
}


int algoritmoCodigo =
    enteroAlpyne(
        datos[2],
        "plan.algoritmoCodigo"
    );


double costoEstimado =
    datos[3];

double tiempoComputoMs =
    datos[4];


if (
    !Double.isFinite(costoEstimado)
    ||
    costoEstimado < 0.0
) {

    throw new IllegalArgumentException(
        "costoEstimado inválido: "
        + costoEstimado
    );
}


if (
    !Double.isFinite(tiempoComputoMs)
    ||
    tiempoComputoMs < 0.0
) {

    throw new IllegalArgumentException(
        "tiempoComputoMs inválido: "
        + tiempoComputoMs
    );
}


int longitudEsperada =
    TAMANO_CABECERA
    +
    cantidadAsignaciones
    * TAMANO_ASIGNACION;


if (
    datos.length
    != longitudEsperada
) {

    throw new IllegalArgumentException(
        "Longitud incorrecta de planVector. "
        + "Esperada="
        + longitudEsperada
        + ", recibida="
        + datos.length
    );
}


java.util.ArrayList<int[]> asignaciones =
    new java.util.ArrayList<int[]>();

java.util.HashSet<Integer> pedidosVistos =
    new java.util.HashSet<Integer>();

java.util.HashSet<String> posicionesVistas =
    new java.util.HashSet<String>();


for (
    int i = 0;
    i < cantidadAsignaciones;
    i++
) {

    int base =
        TAMANO_CABECERA
        +
        i * TAMANO_ASIGNACION;


    int camionId =
        enteroAlpyne(
            datos[base],
            "asignacion[" + i + "].camionId"
        );


    int numeroViaje =
        enteroAlpyne(
            datos[base + 1],
            "asignacion[" + i + "].numeroViaje"
        );


    int ordenEnViaje =
        enteroAlpyne(
            datos[base + 2],
            "asignacion[" + i + "].ordenEnViaje"
        );


    int pedidoIndice =
        enteroAlpyne(
            datos[base + 3],
            "asignacion[" + i + "].pedidoIndice"
        );


    if (
        camionId < 0
        ||
        camionId >= instancia.cantidadCamiones
    ) {

        throw new IllegalArgumentException(
            "camionId fuera de rango: "
            + camionId
        );
    }


    if (numeroViaje <= 0) {

        throw new IllegalArgumentException(
            "numeroViaje debe ser mayor que cero."
        );
    }


    if (ordenEnViaje <= 0) {

        throw new IllegalArgumentException(
            "ordenEnViaje debe comenzar en 1."
        );
    }


    if (
        pedidoIndice < 0
        ||
        pedidoIndice >= instancia.pedidos.size()
    ) {

        throw new IllegalArgumentException(
            "pedidoIndice fuera de rango: "
            + pedidoIndice
        );
    }


    if (
        !pedidosVistos.add(
            pedidoIndice
        )
    ) {

        throw new IllegalArgumentException(
            "El pedido "
            + pedidoIndice
            + " aparece más de una vez."
        );
    }


    String clavePosicion =
        camionId
        + ":"
        + numeroViaje
        + ":"
        + ordenEnViaje;


    if (
        !posicionesVistas.add(
            clavePosicion
        )
    ) {

        throw new IllegalArgumentException(
            "Posición duplicada en el plan: "
            + clavePosicion
        );
    }


    asignaciones.add(
        new int[] {
            camionId,
            numeroViaje,
            ordenEnViaje,
            pedidoIndice
        }
    );
}


java.util.Collections.sort(
    asignaciones,

    new java.util.Comparator<int[]>() {

        @Override
        public int compare(
            int[] a,
            int[] b
        ) {

            if (a[0] != b[0]) {
                return Integer.compare(
                    a[0],
                    b[0]
                );
            }

            if (a[1] != b[1]) {
                return Integer.compare(
                    a[1],
                    b[1]
                );
            }

            return Integer.compare(
                a[2],
                b[2]
            );
        }
    }
);


PlanTurno plan =
    new PlanTurno();


plan.instanciaId =
    instancia.instanciaId;

plan.algoritmo =
    algoritmoAlpyne(
        algoritmoCodigo
    );

plan.costoEstimado =
    costoEstimado;

plan.tiempoComputoMs =
    tiempoComputoMs;


for (
    int camionId = 0;
    camionId < instancia.cantidadCamiones;
    camionId++
) {

    PlanCamion planCamion =
        new PlanCamion();

    planCamion.camionId =
        camionId;

    plan.camiones.add(
        planCamion
    );
}


int camionAnterior =
    -1;

int viajeAnterior =
    -1;

int ordenEsperado =
    1;

ViajePlan viajeActual =
    null;


for (
    int[] asignacion
    : asignaciones
) {

    int camionId =
        asignacion[0];

    int numeroViaje =
        asignacion[1];

    int ordenEnViaje =
        asignacion[2];

    int pedidoIndice =
        asignacion[3];


    boolean nuevoViaje =
        camionId != camionAnterior
        ||
        numeroViaje != viajeAnterior;


    if (nuevoViaje) {

        ordenEsperado =
            1;

        viajeActual =
            new ViajePlan();

        viajeActual.numeroViaje =
            numeroViaje;


        plan.camiones
            .get(camionId)
            .viajes
            .add(
                viajeActual
            );


        camionAnterior =
            camionId;

        viajeAnterior =
            numeroViaje;
    }


    if (
        ordenEnViaje
        != ordenEsperado
    ) {

        throw new IllegalArgumentException(
            "Orden no consecutivo en camión "
            + camionId
            + ", viaje "
            + numeroViaje
            + ". Esperado="
            + ordenEsperado
            + ", recibido="
            + ordenEnViaje
        );
    }


    viajeActual.pedidoIds.add(
        instancia.pedidos
            .get(pedidoIndice)
            .pedidoId
    );


    ordenEsperado++;
}


return plan;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1787143749925</Id>
					<Name><![CDATA[resolverRaizPythonPypeline]]></Name>
					<X>-810</X><Y>1840</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[java.util.ArrayList<java.io.File> candidatos =
    new java.util.ArrayList<java.io.File>();


// =====================================================
// RUTA CONSERVADA POR EL EXPERIMENTO ALPYNE
// =====================================================

String rutaPropiedadSistema =
    System.getProperty(
        "pedemonte.python.root",
        ""
    );


if (
    rutaPropiedadSistema != null
    &&
    !rutaPropiedadSistema
        .trim()
        .isEmpty()
) {

    candidatos.add(
        new java.io.File(
            rutaPropiedadSistema.trim()
        )
    );
}


// =====================================================
// RUTA CONFIGURADA DIRECTAMENTE EN MAIN
// =====================================================

if (
    rutaPythonProyectoPypeline != null
    &&
    !rutaPythonProyectoPypeline
        .trim()
        .isEmpty()
) {

    candidatos.add(
        new java.io.File(
            rutaPythonProyectoPypeline.trim()
        )
    );
}


// =====================================================
// BÚSQUEDA RELATIVA DESDE user.dir
// =====================================================

java.io.File actual =
    new java.io.File(
        System.getProperty(
            "user.dir"
        )
    );


for (
    int nivel = 0;
    nivel < 7
    &&
    actual != null;
    nivel++
) {

    candidatos.add(
        actual
    );

    candidatos.add(
        new java.io.File(
            actual,
            "python"
        )
    );

    actual =
        actual.getParentFile();
}


// =====================================================
// VALIDACIÓN DE CANDIDATOS
// =====================================================

for (
    java.io.File candidato
    : candidatos
) {

    if (candidato == null) {
        continue;
    }

    try {

        java.io.File raiz =
            candidato
            .getCanonicalFile();


        java.io.File planner =
            new java.io.File(
                raiz,
                "planner"
            );


        java.io.File pyrefly =
            new java.io.File(
                raiz,
                "pyrefly.toml"
            );


        if (
            planner.isDirectory()
            &&
            pyrefly.isFile()
        ) {

            /*
             * Se conserva también en Main para que el
             * resto de la ejecución pueda consultarla.
             */
            rutaPythonProyectoPypeline =
                raiz.getCanonicalPath();


            return rutaPythonProyectoPypeline;
        }

    } catch (
        java.io.IOException ex
    ) {

        // Se prueba el siguiente candidato.
    }
}


// =====================================================
// ERROR EXPLÍCITO
// =====================================================

throw new IllegalStateException(
    "No se encontró la carpeta python "
    + "del proyecto. user.dir="
    + System.getProperty(
        "user.dir"
    )
    + ", propiedad pedemonte.python.root="
    + System.getProperty(
        "pedemonte.python.root",
        ""
    )
    + ". También puede indicarse manualmente "
    + "en rutaPythonProyectoPypeline."
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double[]]]></ReturnType>
					<Id>1787143770742</Id>
					<Name><![CDATA[construirVectorInstanciaPypeline]]></Name>
					<X>-810</X><Y>1870</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Body><![CDATA[final int TAMANO_CABECERA =
    8;

final int TAMANO_PEDIDO =
    10;


if (instancia == null) {

    throw new IllegalArgumentException(
        "instancia no puede ser null."
    );
}


if (
    instancia.pedidos == null
    ||
    instancia.pedidos.isEmpty()
) {

    throw new IllegalArgumentException(
        "La instancia debe contener pedidos."
    );
}


if (
    instancia.pedidos.size()
    > MAX_PEDIDOS_RL
) {

    throw new IllegalArgumentException(
        "La instancia supera MAX_PEDIDOS_RL."
    );
}


int cantidad =
    instancia.pedidos.size();


double[] vector =
    new double[
        TAMANO_CABECERA
        +
        cantidad
        * TAMANO_PEDIDO
    ];


int turnoCodigo;


if (
    instancia.turno
        == Turno.MANANA
) {

    turnoCodigo = 0;

} else if (
    instancia.turno
        == Turno.TARDE
) {

    turnoCodigo = 1;

} else {

    throw new IllegalArgumentException(
        "Turno no soportado."
    );
}


vector[0] =
    alpyneProtocoloVersion;

vector[1] =
    turnoCodigo;

vector[2] =
    cantidad;

vector[3] =
    instancia.capacidadCamion;

vector[4] =
    instancia.cantidadCamiones;

vector[5] =
    instancia.latCorralon;

vector[6] =
    instancia.lonCorralon;

vector[7] =
    0.0;


java.util.LinkedHashMap<
    String,
    Integer
> indicesOriginales =
    new java.util.LinkedHashMap<
        String,
        Integer
    >();


for (
    int i = 0;
    i < cantidad;
    i++
) {

    PedidoInput pedido =
        instancia.pedidos.get(
            i
        );


    if (pedido == null) {

        throw new IllegalArgumentException(
            "Pedido null en índice "
            + i
            + "."
        );
    }


    String originalId =
        pedido.pedidoOriginalId;


    if (
        originalId == null
        ||
        originalId
            .trim()
            .isEmpty()
    ) {

        originalId =
            pedido.pedidoId;
    }


    Integer originalIndice =
        indicesOriginales.get(
            originalId
        );


    if (
        originalIndice == null
    ) {

        originalIndice =
            indicesOriginales.size();

        indicesOriginales.put(
            originalId,
            originalIndice
        );
    }


    int base =
        TAMANO_CABECERA
        +
        i
        * TAMANO_PEDIDO;


    vector[base] =
        i;

    vector[base + 1] =
        originalIndice;

    vector[base + 2] =
        pedido.numeroParte;

    vector[base + 3] =
        pedido.totalPartes;

    vector[base + 4] =
        pedido.unidadesCapacidad;

    vector[base + 5] =
        pedido.requiereVolcador
        ? 1.0
        : 0.0;

    vector[base + 6] =
        pedido.latitud;

    vector[base + 7] =
        pedido.longitud;


    if (
        pedido
        .tieneVentanaEspecifica
    ) {

        vector[base + 8] =
            pedido.horaDesdeMin;

        vector[base + 9] =
            pedido.horaHastaMin;

    } else {

        vector[base + 8] =
            -1.0;

        vector[base + 9] =
            -1.0;
    }
}


return vector;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1787144695860</Id>
					<Name><![CDATA[inicializarSelectorPypeline]]></Name>
					<X>-810</X><Y>1900</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    pypelineSelectorInicializado
) {

    return true;
}


try {

    String raizPython =
        resolverRaizPythonPypeline();


    java.io.File archivoModelo =
        new java.io.File(
            raizPython,
            rutaModeloRLPypelineRelativa
        ).getCanonicalFile();


    if (!archivoModelo.isFile()) {

        throw new IllegalStateException(
            "No existe el modelo RL: "
            + archivoModelo
                .getCanonicalPath()
        );
    }


    java.io.File archivoCacheVial =
        new java.io.File(
            raizPython,
            "data/routing/cache_vial.csv"
        ).getCanonicalFile();


    if (!archivoCacheVial.isFile()) {

        throw new IllegalStateException(
            "No existe la caché vial: "
            + archivoCacheVial
                .getCanonicalPath()
            + ". Prepará la instancia y pulsá "
            + "Exportar matriz vial antes de planificar."
        );
    }


    String raizLiteral =
        pyCommunicator.toJson(
            raizPython
        );


    String modeloLiteral =
        pyCommunicator.toJson(
            archivoModelo
                .getCanonicalPath()
        );


    String cacheLiteral =
        pyCommunicator.toJson(
            archivoCacheVial
                .getCanonicalPath()
        );


    pyCommunicator.run(
        "import sys",

        "import importlib",

        "pedemonte_root = "
            + raizLiteral,

        (
            "sys.path.insert(0, pedemonte_root) "
            + "if pedemonte_root not in sys.path "
            + "else None"
        ),

        (
            "from planner.integration "
		    + "import selector_bridge "
		    + "as pedemonte_selector_bridge"
        ),

        (
            "pedemonte_selector_bridge = "
            + "importlib.reload("
            + "pedemonte_selector_bridge)"
        )
    );


    String estado =
        pyCommunicator.runResults(
            String.class,

            (
                "pedemonte_selector_bridge."
                + "inicializar("
                + modeloLiteral
                + ", max_pedidos=30, "
                + "deterministic=True, "
                + "cache_vial_path="
                + cacheLiteral
                + ", version_cache_vial="
                + "'pedemonte-vial-v1', "
                + "permitir_fallback_vial=False)"
            )
        );


    if (
        estado == null
        ||
        !estado.startsWith(
            "OK|"
        )
    ) {

        throw new IllegalStateException(
            "Respuesta inesperada al "
            + "inicializar el selector: "
            + estado
        );
    }


    if (
        !estado.contains(
            "proveedor=VIAL_CACHE"
        )
        ||
        !estado.contains(
            "fallback=ESTRICTO"
        )
    ) {

        throw new IllegalStateException(
            "El selector no confirmó el uso "
            + "estricto de la caché vial: "
            + estado
        );
    }


    String modos =
        pyCommunicator.runResults(
            String.class,

            (
                "pedemonte_selector_bridge."
                + "obtener_modos_disponibles()"
            )
        );


    pypelineSelectorInicializado =
        true;

    pypelineEstadoSelector =
        estado;


    traceln(
        "PYPELINE SELECTOR: "
        + estado
        + " | modos="
        + modos
    );


    return true;


} catch (Exception ex) {

    pypelineSelectorInicializado =
        false;

    pypelineEstadoSelector =
        ex.getClass()
            .getSimpleName()
        + ": "
        + ex.getMessage();


    traceln(
        "ERROR PYPELINE SELECTOR: "
        + pypelineEstadoSelector
    );


    ex.printStackTrace();


    return false;
}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[PlanTurno]]></ReturnType>
					<Id>1787144712140</Id>
					<Name><![CDATA[generarPlanSeleccionadoPypeline]]></Name>
					<X>-810</X><Y>1930</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Body><![CDATA[if (instancia == null) {

    throw new IllegalArgumentException(
        "instancia no puede ser null."
    );
}


if (
    !inicializarSelectorPypeline()
) {

    throw new IllegalStateException(
        "No fue posible inicializar "
        + "el selector Pypeline: "
        + pypelineEstadoSelector
    );
}


String modo =
    modoPlanificacionPypeline == null
    ? ""
    : modoPlanificacionPypeline
        .trim()
        .toUpperCase();


java.util.HashSet<String> modosValidos =
    new java.util.HashSet<String>(
        java.util.Arrays.asList(
            "GREEDY",
            "RANDOM",
            "GA",
            "RL",
            "HIBRIDO"
        )
    );


if (!modosValidos.contains(modo)) {

    throw new IllegalArgumentException(
        "Modo de planificación inválido: "
        + modo
    );
}


double[] instanciaVector =
    construirVectorInstanciaPypeline(
        instancia
    );


String vectorLiteral =
    pyCommunicator.toJson(
        instanciaVector
    );


String modoLiteral =
    pyCommunicator.toJson(
        modo
    );


String comando =
    "pedemonte_selector_bridge."
    + "planificar_vector("
    + vectorLiteral
    + ", "
    + instancia.seedEscenario
    + ", "
    + instancia.seedEjecucion
    + ", "
    + modoLiteral
    + ")";


double[] planVector =
    pyCommunicator.runResults(
        double[].class,
        comando
    );


if (
    planVector == null
    ||
    planVector.length < 5
) {

    throw new IllegalStateException(
        "Python devolvió un planVector "
        + "vacío o incompleto."
    );
}


pypelineUltimoPlanVector =
    planVector.clone();


PlanTurno plan =
    crearPlanAlpyneDinamico(
        planVector,
        instancia
    );


ResultadoValidacionPlan validacion =
    validarPlan(
        instancia,
        plan
    );


if (!validacion.valido) {

    throw new IllegalStateException(
        "El selector devolvió un "
        + "plan inválido: "
        + validacion.errores
    );
}


String decision =
    pyCommunicator.runResults(
        String.class,

        (
            "pedemonte_selector_bridge."
            + "obtener_ultima_decision()"
        )
    );


pypelineEstadoSelector =
    decision;


traceln(
    "PYPELINE SELECTOR DECISIÓN: "
    + decision
);

registrarDecisionSelectorVisual(
    decision
);

return plan;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1787145197425</Id>
					<Name><![CDATA[resumenInstanciaInterfaz]]></Name>
					<X>-810</X><Y>1960</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (instanciaInterfazActual == null) {

    return "Sin instancia cargada.";
}


int unidadesTotales =
    0;

int pedidosVolcador =
    0;

int pedidosConVentana =
    0;


for (
    PedidoInput pedido
    : instanciaInterfazActual.pedidos
) {

    if (pedido == null) {
        continue;
    }


    unidadesTotales +=
        pedido.unidadesCapacidad;


    if (pedido.requiereVolcador) {

        pedidosVolcador++;
    }


    if (
        pedido
            .tieneVentanaEspecifica
    ) {

        pedidosConVentana++;
    }
}


return
    "Instancia: "
    + instanciaInterfazActual.instanciaId

    + "\nTurno: "
    + instanciaInterfazActual.turno
    + " | Pedidos: "
    + instanciaInterfazActual
        .pedidos
        .size()

    + "\nUnidades: "
    + unidadesTotales
    + " | Volcador: "
    + pedidosVolcador

    + "\nCon ventana: "
    + pedidosConVentana;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Turno]]></ReturnType>
					<Id>1787146560681</Id>
					<Name><![CDATA[obtenerTurnoFormulario]]></Name>
					<X>-810</X><Y>1990</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[String valor =
    turnoFormulario == null
    ? ""
    : turnoFormulario
        .trim()
        .toUpperCase();


if (valor.equals("MANANA")) {

    return Turno.MANANA;
}


if (valor.equals("TARDE")) {

    return Turno.TARDE;
}


throw new IllegalArgumentException(
    "Turno no soportado: "
    + turnoFormulario
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787146580162</Id>
					<Name><![CDATA[actualizarHorarioFormulario]]></Name>
					<X>-810</X><Y>2020</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Turno turno =
    obtenerTurnoFormulario();


horaDesdeFormulario =
    formatearHoraFormulario(
        horaInicioTurno(
            turno
        )
    );


horaHastaFormulario =
    formatearHoraFormulario(
        horaFinObjetivoTurno(
            turno
        )
    );


if (editHoraDesdeFormulario != null) {

    editHoraDesdeFormulario.setText(
        horaDesdeFormulario
    );
}


if (editHoraHastaFormulario != null) {

    editHoraHastaFormulario.setText(
        horaHastaFormulario
    );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1787146590842</Id>
					<Name><![CDATA[agregarPedidoFormulario]]></Name>
					<X>-810</X><Y>2050</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    ejecucionEnCurso
    ||
    pypelineSolicitudEnCurso
) {

    mensajeFormulario =
        "No se pueden agregar pedidos "
        + "durante una planificación "
        + "o ejecución.";

    return false;
}


try {

    Turno turno =
        obtenerTurnoFormulario();


    String pedidoOriginalId =
        textoLimpioFormulario(
            pedidoIdFormulario
        );


    if (pedidoOriginalId.isEmpty()) {

        pedidoOriginalId =
            String.format(
                java.util.Locale.US,
                "PED-%03d",
                contadorPedidosFormulario
            );
    }


    if (
        !pedidoOriginalId.matches(
            "[A-Za-z0-9._-]+"
        )
    ) {

        throw new IllegalArgumentException(
            "El ID solo puede contener letras, "
            + "números, punto, guion y guion bajo."
        );
    }


    for (
        PedidoInput existente
        : pedidosFormulario
    ) {

        if (
            existente != null
            &&
            pedidoOriginalId.equalsIgnoreCase(
                existente.pedidoOriginalId
            )
        ) {

            throw new IllegalArgumentException(
                "Ya existe el pedido original "
                + pedidoOriginalId
                + "."
            );
        }
    }


    int unidadesTotales =
        parsearEnteroPositivoFormulario(
            unidadesFormulario,
            "Unidades"
        );


    double latitud =
        parsearDecimalFormulario(
            latitudFormulario,
            "Latitud"
        );


    double longitud =
        parsearDecimalFormulario(
            longitudFormulario,
            "Longitud"
        );


    if (
        latitud < -90.0
        ||
        latitud > 90.0
    ) {

        throw new IllegalArgumentException(
            "La latitud debe estar entre "
            + "-90 y 90."
        );
    }


    if (
        longitud < -180.0
        ||
        longitud > 180.0
    ) {

        throw new IllegalArgumentException(
            "La longitud debe estar entre "
            + "-180 y 180."
        );
    }


    if (
        Math.abs(latitud) < 0.000001
        &&
        Math.abs(longitud) < 0.000001
    ) {

        throw new IllegalArgumentException(
            "Las coordenadas 0, 0 "
            + "no son válidas para este proyecto."
        );
    }


    int horaDesde =
        horaInicioTurno(
            turno
        );


    int horaHasta =
        horaFinObjetivoTurno(
            turno
        );


    if (tieneVentanaFormulario) {

        horaDesde =
            parsearHoraFormulario(
                horaDesdeFormulario
            );


        horaHasta =
            parsearHoraFormulario(
                horaHastaFormulario
            );


        if (
            horaDesde
            < horaInicioTurno(
                turno
            )
        ) {

            throw new IllegalArgumentException(
                "La hora desde no puede ser "
                + "anterior al inicio del turno."
            );
        }


        if (
            horaHasta
            > horaFinObjetivoTurno(
                turno
            )
        ) {

            throw new IllegalArgumentException(
                "La hora hasta no puede superar "
                + "el final normal del turno."
            );
        }


        if (
            horaDesde
            >= horaHasta
        ) {

            throw new IllegalArgumentException(
                "La hora desde debe ser "
                + "anterior a la hora hasta."
            );
        }
    }


    int totalPartes =
        (
            unidadesTotales
            +
            CAPACIDAD_CAMION
            - 1
        )
        /
        CAPACIDAD_CAMION;


    if (totalPartes > 8) {

        throw new IllegalArgumentException(
            "El pedido requiere "
            + totalPartes
            + " partes. El máximo permitido es 8."
        );
    }


    if (
        pedidosFormulario.size()
        + totalPartes
        > MAX_PEDIDOS_RL
    ) {

        throw new IllegalArgumentException(
            "La instancia tendría "
            + (
                pedidosFormulario.size()
                + totalPartes
            )
            + " tareas después del split, "
            + "pero el máximo permitido es "
            + MAX_PEDIDOS_RL
            + "."
        );
    }


    String cliente =
        textoLimpioFormulario(
            clienteFormulario
        );


    String direccion =
        textoLimpioFormulario(
            direccionFormulario
        );


    String barrio =
        textoLimpioFormulario(
            barrioFormulario
        );


    int unidadesRestantes =
        unidadesTotales;


    for (
        int numeroParte = 1;
        numeroParte <= totalPartes;
        numeroParte++
    ) {

        int unidadesParte =
            Math.min(
                CAPACIDAD_CAMION,
                unidadesRestantes
            );


        PedidoInput pedido =
            new PedidoInput();


        pedido.pedidoOriginalId =
            pedidoOriginalId;


        pedido.pedidoId =
            totalPartes == 1
            ? pedidoOriginalId
            : pedidoOriginalId
                + "-P"
                + numeroParte;


        pedido.numeroParte =
            numeroParte;

        pedido.totalPartes =
            totalPartes;

        pedido.turno =
            turno;

        pedido.latitud =
            latitud;

        pedido.longitud =
            longitud;

        pedido.unidadesCapacidad =
            unidadesParte;


        // Cada parte hereda el volcador.

        pedido.requiereVolcador =
            requiereVolcadorFormulario;


        pedido.tieneVentanaEspecifica =
            tieneVentanaFormulario;

        pedido.horaDesdeMin =
            horaDesde;

        pedido.horaHastaMin =
            horaHasta;

        pedido.cliente =
            cliente;

        pedido.direccion =
            direccion;

        pedido.barrio =
            barrio;


        pedido.observaciones =
            totalPartes == 1
            ? "Pedido cargado desde interfaz."
            : "Parte "
                + numeroParte
                + "/"
                + totalPartes
                + " generada automáticamente.";


        pedidosFormulario.add(
            pedido
        );


        unidadesRestantes -=
            unidadesParte;
    }


    contadorPedidosFormulario++;


    mensajeFormulario =
        "OK: Pedido "
        + pedidoOriginalId
        + " agregado. "
        + unidadesTotales
        + " unidad(es), "
        + totalPartes
        + " tarea(s).";


    pedidoIdFormulario =
        "";

    clienteFormulario =
        "";

    direccionFormulario =
        "";

    barrioFormulario =
        "";

    unidadesFormulario =
        "1";

    requiereVolcadorFormulario =
        false;


    traceln(
        mensajeFormulario
    );


    return true;


} catch (
    IllegalArgumentException ex
) {

    mensajeFormulario =
        "Revisá el pedido: "
        + ex.getMessage();


    traceln(
        mensajeFormulario
    );


    return false;


} catch (Exception ex) {

    mensajeFormulario =
        "No se pudo agregar el pedido. "
        + "Revisá los datos ingresados.";


    traceln(
        "ERROR FORMULARIO PEDIDO"
        + " | tipo="
        + ex.getClass()
            .getSimpleName()
        + " | detalle="
        + ex.getMessage()
    );


    return false;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1787146608722</Id>
					<Name><![CDATA[eliminarUltimoPedidoFormulario]]></Name>
					<X>-810</X><Y>2080</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (pedidosFormulario.isEmpty()) {

    mensajeFormulario =
        "No hay pedidos para eliminar.";

    return false;
}


String originalId =
    pedidosFormulario
        .get(
            pedidosFormulario.size()
            - 1
        )
        .pedidoOriginalId;


int eliminados =
    0;


for (
    int i =
        pedidosFormulario.size()
        - 1;

    i >= 0;

    i--
) {

    PedidoInput pedido =
        pedidosFormulario.get(
            i
        );


    if (
        pedido != null
        &&
        originalId.equals(
            pedido.pedidoOriginalId
        )
    ) {

        pedidosFormulario.remove(
            i
        );

        eliminados++;
    }
}


mensajeFormulario =
    "Pedido original "
    + originalId
    + " eliminado. Tareas quitadas="
    + eliminados
    + ".";


traceln(
    mensajeFormulario
);


return true;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1787146622178</Id>
					<Name><![CDATA[resumenPedidosFormulario]]></Name>
					<X>-810</X><Y>2110</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (pedidosFormulario.isEmpty()) {

    return "Sin pedidos cargados.";
}


java.util.HashSet<String> originales =
    new java.util.HashSet<String>();


int unidades =
    0;

int volcadores =
    0;

int ventanas =
    0;


for (
    PedidoInput pedido
    : pedidosFormulario
) {

    if (pedido == null) {
        continue;
    }


    originales.add(
        pedido.pedidoOriginalId
    );


    unidades +=
        pedido.unidadesCapacidad;


    if (pedido.requiereVolcador) {

        volcadores++;
    }


    if (
        pedido
        .tieneVentanaEspecifica
    ) {

        ventanas++;
    }
}


return
    "Originales: "
    + originales.size()
    + " | Tareas finales: "
    + pedidosFormulario.size()
    + " | Unidades: "
    + unidades
    + " | Tareas con volcador: "
    + volcadores
    + " | Tareas con ventana: "
    + ventanas;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[InstanciaTurno]]></ReturnType>
					<Id>1787146636450</Id>
					<Name><![CDATA[construirInstanciaFormulario]]></Name>
					<X>-810</X><Y>2140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (pedidosFormulario.isEmpty()) {

    throw new IllegalStateException(
        "No hay pedidos cargados."
    );
}


Turno turno =
    obtenerTurnoFormulario();


for (
    PedidoInput pedido
    : pedidosFormulario
) {

    if (pedido.turno != turno) {

        throw new IllegalStateException(
            "Todos los pedidos deben "
            + "pertenecer al mismo turno."
        );
    }
}


InstanciaTurno instancia =
    new InstanciaTurno();


instancia.instanciaId =
    "UI-"
    + fechaFormulario
    + "-"
    + seedFormulario;

instancia.fechaOperacion =
    fechaFormulario;

instancia.turno =
    turno;

instancia.latCorralon =
    LAT_CORRALON;

instancia.lonCorralon =
    LON_CORRALON;

instancia.capacidadCamion =
    CAPACIDAD_CAMION;

instancia.cantidadCamiones =
    CANTIDAD_CAMIONES;

instancia.horaInicioTurnoMin =
    horaInicioTurno(
        turno
    );

instancia.horaFinObjetivoMin =
    horaFinObjetivoTurno(
        turno
    );

instancia.horaFinToleranciaMin =
    horaFinToleranciaTurno(
        turno
    );

instancia.seedEscenario =
    seedFormulario;

instancia.seedEjecucion =
    1000000L
    +
    seedFormulario;


for (
    PedidoInput pedido
    : pedidosFormulario
) {

    instancia.pedidos.add(
        copiarPedidoInput(
            pedido
        )
    );
}


return instancia;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787150808306</Id>
					<Name><![CDATA[inicializarGIS]]></Name>
					<X>-810</X><Y>2170</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (mapaGIS == null) {

    throw new IllegalStateException(
        "No existe el elemento mapaGIS."
    );
}


// Aseguramos que el mapa esté visible.

mapaGIS.setVisible(
    true
);


// Si ya existía un punto del corralón,
// lo retiramos antes de volver a crearlo.

if (puntoCorralonGIS != null) {

    mapaGIS.remove(
        puntoCorralonGIS
    );

    puntoCorralonGIS =
        null;
}


// Creamos el punto geográfico.

puntoCorralonGIS =
    new com.anylogic.engine.markup.GISPoint(
        mapaGIS,
        false,
        LAT_CORRALON,
        LON_CORRALON
    );


puntoCorralonGIS.setTitle(
    "Pedemonte Materiales | Corralón"
);


puntoCorralonGIS.setRadius(
    10.0
);


puntoCorralonGIS.setFillColor(
    new java.awt.Color(
        211,
        47,
        47
    )
);


puntoCorralonGIS.setLineColor(
    java.awt.Color.BLACK
);


puntoCorralonGIS.setLineWidth(
    2.0
);


puntoCorralonGIS.setVisible(
    true
);


// IMPORTANTE:
//
// Crear el GISPoint no alcanza para que
// aparezca dinámicamente en la animación.
// Debemos agregarlo al conjunto de dibujo
// del mapa.

mapaGIS.add(
    puntoCorralonGIS
);


// Centramos y damos un encuadre inicial
// alrededor del corralón.

mapaGIS.fitBounds(
    LAT_CORRALON - 0.004,
    LON_CORRALON - 0.004,
    LAT_CORRALON + 0.004,
    LON_CORRALON + 0.004
);


gisInicializado =
    true;


mensajeGIS =
    "GIS inicializado. Corralón visible en "
    + LAT_CORRALON
    + ", "
    + LON_CORRALON
    + ".";


traceln(
    mensajeGIS
);


traceln(
    "GIS CORRALÓN AGREGADO | lat="
    + LAT_CORRALON
    + " | lon="
    + LON_CORRALON
    + " | visible="
    + puntoCorralonGIS.isVisible()
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787150823890</Id>
					<Name><![CDATA[limpiarPedidosGIS]]></Name>
					<X>-810</X><Y>2200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (mapaGIS == null) {

    puntosPedidosGIS.clear();

    puntosPedidosPorOriginalGIS.clear();

    estadosPedidosGIS.clear();

    mensajeGIS =
        "GIS no disponible.";

    mensajeEstadosPedidosGIS =
        "Sin estados operativos de pedidos.";

    return;
}


for (
    com.anylogic.engine.markup.GISPoint punto
    : puntosPedidosGIS
) {

    if (punto != null) {

        mapaGIS.remove(
            punto
        );
    }
}


puntosPedidosGIS.clear();

puntosPedidosPorOriginalGIS.clear();

estadosPedidosGIS.clear();


mensajeGIS =
    gisInicializado
    ? "GIS sin clientes cargados."
    : "GIS no inicializado.";


mensajeEstadosPedidosGIS =
    "Sin estados operativos de pedidos.";


traceln(
    mensajeGIS
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787150836307</Id>
					<Name><![CDATA[mostrarInstanciaEnGIS]]></Name>
					<X>-810</X><Y>2230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Body><![CDATA[if (instancia == null) {

    throw new IllegalArgumentException(
        "instancia no puede ser null."
    );
}


if (
    instancia.pedidos == null
    ||
    instancia.pedidos.isEmpty()
) {

    throw new IllegalArgumentException(
        "La instancia no contiene pedidos."
    );
}


if (!gisInicializado) {

    inicializarGIS();
}


limpiarRutasPlanGIS();

limpiarMarcadoresCamionesGIS();

limpiarPedidosGIS();


// =====================================================
// AGRUPAR TAREAS POR PEDIDO ORIGINAL
// =====================================================
//
// Las partes de un pedido dividido comparten
// ubicación. Mostramos un solo punto por pedido
// original para evitar puntos superpuestos.

java.util.LinkedHashMap<
    String,
    java.util.ArrayList<PedidoInput>
> gruposOriginales =
    new java.util.LinkedHashMap<
        String,
        java.util.ArrayList<PedidoInput>
    >();


for (
    PedidoInput pedido
    : instancia.pedidos
) {

    if (pedido == null) {

        throw new IllegalStateException(
            "La instancia contiene un pedido null."
        );
    }


    String originalId =
        pedido.pedidoOriginalId;


    if (
        originalId == null
        ||
        originalId.trim().isEmpty()
    ) {

        originalId =
            pedido.pedidoId;
    }


    java.util.ArrayList<PedidoInput> grupo =
        gruposOriginales.get(
            originalId
        );


    if (grupo == null) {

        grupo =
            new java.util.ArrayList<PedidoInput>();

        gruposOriginales.put(
            originalId,
            grupo
        );
    }


    grupo.add(
        pedido
    );
}


// =====================================================
// LÍMITES PARA AJUSTAR AUTOMÁTICAMENTE EL MAPA
// =====================================================

double latitudMinima =
    instancia.latCorralon;

double latitudMaxima =
    instancia.latCorralon;

double longitudMinima =
    instancia.lonCorralon;

double longitudMaxima =
    instancia.lonCorralon;


// =====================================================
// CREAR LOS PUNTOS DE LOS CLIENTES
// =====================================================

for (
    java.util.Map.Entry<
        String,
        java.util.ArrayList<PedidoInput>
    > entrada
    : gruposOriginales.entrySet()
) {

    String originalId =
        entrada.getKey();


    java.util.ArrayList<PedidoInput> partes =
        entrada.getValue();


    if (
        partes == null
        ||
        partes.isEmpty()
    ) {

        continue;
    }


    PedidoInput primerPedido =
        partes.get(
            0
        );


    double latitud =
        primerPedido.latitud;

    double longitud =
        primerPedido.longitud;


    if (
        !Double.isFinite(
            latitud
        )
        ||
        latitud < -90.0
        ||
        latitud > 90.0
    ) {

        throw new IllegalArgumentException(
            "Latitud GIS inválida para "
            + originalId
            + ": "
            + latitud
        );
    }


    if (
        !Double.isFinite(
            longitud
        )
        ||
        longitud < -180.0
        ||
        longitud > 180.0
    ) {

        throw new IllegalArgumentException(
            "Longitud GIS inválida para "
            + originalId
            + ": "
            + longitud
        );
    }


    int unidadesTotales =
        0;

    boolean requiereVolcador =
        false;

    boolean tieneVentana =
        false;


    for (
        PedidoInput parte
        : partes
    ) {

        if (parte == null) {

            throw new IllegalStateException(
                "El pedido original "
                + originalId
                + " contiene una parte null."
            );
        }


        // Todas las partes del pedido original
        // deberían compartir las coordenadas.

        if (
            Math.abs(
                parte.latitud
                - latitud
            ) > 0.000000001

            ||

            Math.abs(
                parte.longitud
                - longitud
            ) > 0.000000001
        ) {

            throw new IllegalStateException(
                "Las partes del pedido original "
                + originalId
                + " no comparten ubicación."
            );
        }


        unidadesTotales +=
            parte.unidadesCapacidad;


        requiereVolcador =
            requiereVolcador
            ||
            parte.requiereVolcador;


        tieneVentana =
            tieneVentana
            ||
            parte.tieneVentanaEspecifica;
    }


    // =================================================
    // COLOR DEL PUNTO
    // =================================================

    java.awt.Color colorRelleno;


    if (
        requiereVolcador
        &&
        tieneVentana
    ) {

        // Magenta:
        // ventana y volcador.

        colorRelleno =
            new java.awt.Color(
                194,
                24,
                91
            );

    } else if (requiereVolcador) {

        // Naranja:
        // requiere volcador.

        colorRelleno =
            new java.awt.Color(
                251,
                140,
                0
            );

    } else if (tieneVentana) {

        // Violeta:
        // tiene ventana específica.

        colorRelleno =
            new java.awt.Color(
                103,
                58,
                183
            );

    } else {

        // Azul:
        // pedido normal.

        colorRelleno =
            new java.awt.Color(
                30,
                136,
                229
            );
    }


    // =================================================
    // CREACIÓN DEL GISPOINT
    // =================================================

    com.anylogic.engine.markup.GISPoint punto =
        new com.anylogic.engine.markup.GISPoint(
            mapaGIS,
            false,
            latitud,
            longitud
        );


    punto.setRadius(
        9.0
    );


    punto.setFillColor(
        colorRelleno
    );


    punto.setLineColor(
        java.awt.Color.BLACK
    );


    punto.setLineWidth(
        2.0
    );


    String titulo =
        originalId
        + " | unidades="
        + unidadesTotales
        + " | tareas="
        + partes.size()
        + " | volcador="
        + requiereVolcador
        + " | ventana="
        + tieneVentana;


    if (
        primerPedido.cliente != null
        &&
        !primerPedido.cliente
            .trim()
            .isEmpty()
    ) {

        titulo +=
            " | cliente="
            + primerPedido.cliente.trim();
    }


    punto.setTitle(
        titulo
    );


    punto.setVisible(
        true
    );


    // IMPORTANTE:
    //
    // Esta llamada agrega el punto al conjunto
    // de elementos que el mapa debe representar.

    mapaGIS.add(
        punto
    );


    puntosPedidosGIS.add(
        punto
    );


    // Actualizamos los límites para encuadrar
    // automáticamente todos los puntos.

    latitudMinima =
        Math.min(
            latitudMinima,
            latitud
        );

    latitudMaxima =
        Math.max(
            latitudMaxima,
            latitud
        );

    longitudMinima =
        Math.min(
            longitudMinima,
            longitud
        );

    longitudMaxima =
        Math.max(
            longitudMaxima,
            longitud
        );


    traceln(
        "GIS CLIENTE AGREGADO | id="
        + originalId
        + " | lat="
        + latitud
        + " | lon="
        + longitud
        + " | visible="
        + punto.isVisible()
        + " | color="
        + (
            requiereVolcador
            && tieneVentana
            ? "MAGENTA"
            : requiereVolcador
                ? "NARANJA"
                : tieneVentana
                    ? "VIOLETA"
                    : "AZUL"
        )
    );
}


// =====================================================
// AJUSTAR ENCUADRE DEL MAPA
// =====================================================

double diferenciaLatitud =
    latitudMaxima
    - latitudMinima;

double diferenciaLongitud =
    longitudMaxima
    - longitudMinima;


// Margen mínimo para evitar que un punto quede
// pegado al borde o que el mapa intente ajustar
// un rectángulo de tamaño cero.

double margenLatitud =
    Math.max(
        0.0015,
        diferenciaLatitud
        * 0.25
    );

double margenLongitud =
    Math.max(
        0.0015,
        diferenciaLongitud
        * 0.25
    );


mapaGIS.fitBounds(
    latitudMinima
        - margenLatitud,

    longitudMinima
        - margenLongitud,

    latitudMaxima
        + margenLatitud,

    longitudMaxima
        + margenLongitud
);


// =====================================================
// ESTADO FINAL
// =====================================================

mensajeGIS =
    "GIS actualizado: corralón + "
    + puntosPedidosGIS.size()
    + " cliente(s).";


traceln(
    mensajeGIS
);


traceln(
    "GIS LÍMITES | sur="
    + (
        latitudMinima
        - margenLatitud
    )
    + " | oeste="
    + (
        longitudMinima
        - margenLongitud
    )
    + " | norte="
    + (
        latitudMaxima
        + margenLatitud
    )
    + " | este="
    + (
        longitudMaxima
        + margenLongitud
    )
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787152438918</Id>
					<Name><![CDATA[limpiarRutasPlanGIS]]></Name>
					<X>-810</X><Y>2260</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (mapaGIS == null) {

    rutasPlanGIS.clear();

    rutasActivasPorCamionGIS.clear();

    cantidadSegmentosPlanGIS =
        0;

    mensajeRutasGIS =
        "Mapa GIS no disponible.";

    return;
}


for (
    com.anylogic.engine.markup.GISRoute ruta
    : rutasPlanGIS
) {

    if (ruta != null) {

        mapaGIS.remove(
            ruta
        );
    }
}


rutasPlanGIS.clear();


rutasActivasPorCamionGIS.clear();


cantidadSegmentosPlanGIS =
    0;


mensajeRutasGIS =
    "Sin viajes activos en el mapa.";


traceln(
    "GIS RUTAS LIMPIADAS"
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[PedidoInput]]></ReturnType>
					<Id>1787152450702</Id>
					<Name><![CDATA[buscarPedidoParaGIS]]></Name>
					<X>-810</X><Y>2290</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[pedidoId]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (instancia == null) {

    throw new IllegalArgumentException(
        "instancia no puede ser null."
    );
}


if (
    pedidoId == null
    ||
    pedidoId.trim().isEmpty()
) {

    throw new IllegalArgumentException(
        "pedidoId no puede estar vacío."
    );
}


if (instancia.pedidos == null) {

    throw new IllegalStateException(
        "La instancia no contiene "
        + "una lista de pedidos."
    );
}


for (
    PedidoInput pedido
    : instancia.pedidos
) {

    if (
        pedido != null
        &&
        pedidoId.equals(
            pedido.pedidoId
        )
    ) {

        return pedido;
    }
}


throw new IllegalArgumentException(
    "El plan referencia un pedido "
    + "inexistente: "
    + pedidoId
    + "."
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.awt.Color]]></ReturnType>
					<Id>1787152497798</Id>
					<Name><![CDATA[colorRutaCamionGIS]]></Name>
					<X>-810</X><Y>2320</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[camionId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if (camionId == 0) {

    // Verde fuerte.

    return new java.awt.Color(
        46,
        125,
        50
    );
}


if (camionId == 1) {

    // Violeta oscuro.
    // Se diferencia claramente del verde
    // incluso cuando las rutas se cruzan.

    return new java.awt.Color(
        123,
        31,
        162
    );
}


// Colores defensivos para posibles
// camiones adicionales.

int indice =
    Math.abs(
        camionId
    )
    %
    4;


if (indice == 0) {

    return new java.awt.Color(
        21,
        101,
        192
    );
}


if (indice == 1) {

    return new java.awt.Color(
        230,
        81,
        0
    );
}


if (indice == 2) {

    return new java.awt.Color(
        0,
        121,
        107
    );
}


return new java.awt.Color(
    84,
    110,
    122
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[com.anylogic.engine.markup.GISRoute]]></ReturnType>
					<Id>1787152531694</Id>
					<Name><![CDATA[crearSegmentoRutaGIS]]></Name>
					<X>-810</X><Y>2350</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[latitudOrigen]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[longitudOrigen]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[latitudDestino]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[longitudDestino]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[colorRuta]]></Name>
						<Type><![CDATA[java.awt.Color]]></Type>
					</Parameter>
					<Body><![CDATA[if (mapaGIS == null) {

    throw new IllegalStateException(
        "No existe mapaGIS."
    );
}


if (colorRuta == null) {

    throw new IllegalArgumentException(
        "colorRuta no puede ser null."
    );
}


if (
    !Double.isFinite(
        latitudOrigen
    )
    ||
    latitudOrigen < -90.0
    ||
    latitudOrigen > 90.0
) {

    throw new IllegalArgumentException(
        "Latitud de origen inválida: "
        + latitudOrigen
        + "."
    );
}


if (
    !Double.isFinite(
        longitudOrigen
    )
    ||
    longitudOrigen < -180.0
    ||
    longitudOrigen > 180.0
) {

    throw new IllegalArgumentException(
        "Longitud de origen inválida: "
        + longitudOrigen
        + "."
    );
}


if (
    !Double.isFinite(
        latitudDestino
    )
    ||
    latitudDestino < -90.0
    ||
    latitudDestino > 90.0
) {

    throw new IllegalArgumentException(
        "Latitud de destino inválida: "
        + latitudDestino
        + "."
    );
}


if (
    !Double.isFinite(
        longitudDestino
    )
    ||
    longitudDestino < -180.0
    ||
    longitudDestino > 180.0
) {

    throw new IllegalArgumentException(
        "Longitud de destino inválida: "
        + longitudDestino
        + "."
    );
}


// Un segmento entre dos coordenadas
// exactamente iguales no sería visible.

if (
    Math.abs(
        latitudOrigen
        - latitudDestino
    ) < 0.000000001

    &&

    Math.abs(
        longitudOrigen
        - longitudDestino
    ) < 0.000000001
) {

    return null;
}


com.anylogic.engine.markup.GISRoute ruta =
    mapaGIS.getRoute(
        latitudOrigen,
        longitudOrigen,
        latitudDestino,
        longitudDestino
    );


if (ruta == null) {

    throw new IllegalStateException(
        "mapaGIS.getRoute devolvió null."
    );
}


// El Camión 1 utiliza una línea violeta más ancha.
// El Camión 0 utiliza una línea verde más fina.
//
// Cuando ambas rutas coinciden, la verde queda
// visible en el centro y la violeta permanece
// visible en los bordes.

double anchoRuta =
    4.0;


if (
    colorRuta.equals(
        colorRutaCamionGIS(
            0
        )
    )
) {

    anchoRuta =
        3.0;

} else if (
    colorRuta.equals(
        colorRutaCamionGIS(
            1
        )
    )
) {

    anchoRuta =
        7.0;
}


ruta.setLineColor(
    colorRuta
);


ruta.setLineWidth(
    anchoRuta
);


rutasPlanGIS.add(
    ruta
);


cantidadSegmentosPlanGIS++;


return ruta;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787152600926</Id>
					<Name><![CDATA[mostrarPlanEnGIS]]></Name>
					<X>-810</X><Y>2380</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[plan]]></Name>
						<Type><![CDATA[PlanTurno]]></Type>
					</Parameter>
					<Body><![CDATA[if (instancia == null) {

    throw new IllegalArgumentException(
        "instancia no puede ser null."
    );
}


if (plan == null) {

    throw new IllegalArgumentException(
        "plan no puede ser null."
    );
}


if (!gisInicializado) {

    inicializarGIS();
}


ResultadoValidacionPlan validacion =
    validarPlan(
        instancia,
        plan
    );


if (!validacion.valido) {

    throw new IllegalArgumentException(
        "No se puede representar un "
        + "plan inválido en GIS: "
        + validacion.errores
    );
}


/*
 * Ya no dibujamos el plan completo.
 *
 * Cada agente Camion solicitará la representación
 * de su viaje actual al comenzar la carga y la
 * eliminará cuando vuelva al corralón.
 */

limpiarRutasPlanGIS();


int viajesPlanificados =
    0;


int camionesConViajes =
    0;


int tramosPlanificados =
    0;


for (
    PlanCamion planCamion
    : plan.camiones
) {

    if (planCamion == null) {

        throw new IllegalStateException(
            "El plan contiene un "
            + "PlanCamion null."
        );
    }


    if (
        planCamion.viajes == null
        ||
        planCamion.viajes.isEmpty()
    ) {

        traceln(
            "GIS PLAN | camion="
            + planCamion.camionId
            + " | sin viajes"
        );

        continue;
    }


    camionesConViajes++;


    for (
        ViajePlan viaje
        : planCamion.viajes
    ) {

        if (viaje == null) {

            throw new IllegalStateException(
                "El camión "
                + planCamion.camionId
                + " contiene un viaje null."
            );
        }


        if (
            viaje.pedidoIds == null
            ||
            viaje.pedidoIds.isEmpty()
        ) {

            traceln(
                "GIS PLAN | camion="
                + planCamion.camionId
                + " | viaje="
                + viaje.numeroViaje
                + " | sin pedidos"
            );

            continue;
        }


        viajesPlanificados++;


        String origenActual =
            "CORRALON";


        int numeroTramo =
            1;


        for (
            String pedidoId
            : viaje.pedidoIds
        ) {

            buscarPedidoParaGIS(
                instancia,
                pedidoId
            );


            traceln(
                "GIS PLAN | camion="
                + planCamion.camionId
                + " | viaje="
                + viaje.numeroViaje
                + " | tramo="
                + numeroTramo
                + " | "
                + origenActual
                + " -> "
                + pedidoId
                + " | dibujo diferido"
            );


            origenActual =
                pedidoId;


            numeroTramo++;


            tramosPlanificados++;
        }


        traceln(
            "GIS PLAN | camion="
            + planCamion.camionId
            + " | viaje="
            + viaje.numeroViaje
            + " | tramo="
            + numeroTramo
            + " | "
            + origenActual
            + " -> CORRALON"
            + " | dibujo diferido"
        );


        tramosPlanificados++;
    }
}


// Los marcadores se preparan desde el inicio.
// Las rutas aparecerán cuando cada camión inicie
// su viaje correspondiente.

inicializarMarcadoresCamionesGIS(
    instancia
);


mensajeRutasGIS =
    "Plan preparado: "
    + viajesPlanificados
    + " viaje(s), "
    + tramosPlanificados
    + " tramo(s). "
    + "Se mostrará solo el viaje activo.";


traceln(
    mensajeRutasGIS
);


traceln(
    "GIS PLAN DINÁMICO"
    + " | viajesPlanificados="
    + viajesPlanificados
    + " | tramosPlanificados="
    + tramosPlanificados
    + " | camionesConViajes="
    + camionesConViajes
);
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787153354543</Id>
					<Name><![CDATA[limpiarMarcadoresCamionesGIS]]></Name>
					<X>-810</X><Y>2410</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (mapaGIS == null) {

    marcadoresCamionesGIS.clear();

    estadosCamionesGIS.clear();

    mensajeCamionesGIS =
        "Mapa GIS no disponible.";

    return;
}


for (
    com.anylogic.engine.markup.GISPoint marcador
    : marcadoresCamionesGIS.values()
) {

    if (marcador != null) {

        mapaGIS.remove(
            marcador
        );
    }
}


marcadoresCamionesGIS.clear();

estadosCamionesGIS.clear();


mensajeCamionesGIS =
    "Sin camiones representados en el mapa.";


traceln(
    "GIS MARCADORES DE CAMIONES LIMPIADOS"
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787153367753</Id>
					<Name><![CDATA[actualizarMarcadorCamionGIS]]></Name>
					<X>-810</X><Y>2440</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[camionId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[latitud]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[longitud]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[estado]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (mapaGIS == null) {

    throw new IllegalStateException(
        "No existe mapaGIS."
    );
}


if (camionId < 0) {

    throw new IllegalArgumentException(
        "camionId no puede ser negativo."
    );
}


if (
    !Double.isFinite(
        latitud
    )
    ||
    latitud < -90.0
    ||
    latitud > 90.0
) {

    throw new IllegalArgumentException(
        "Latitud inválida para el camión "
        + camionId
        + ": "
        + latitud
        + "."
    );
}


if (
    !Double.isFinite(
        longitud
    )
    ||
    longitud < -180.0
    ||
    longitud > 180.0
) {

    throw new IllegalArgumentException(
        "Longitud inválida para el camión "
        + camionId
        + ": "
        + longitud
        + "."
    );
}


String estadoNormalizado =
    estado == null
    ? "SIN_ESTADO"
    : estado.trim();


if (estadoNormalizado.isEmpty()) {

    estadoNormalizado =
        "SIN_ESTADO";
}


// =====================================================
// ELIMINAR EL MARCADOR ANTERIOR
// =====================================================

com.anylogic.engine.markup.GISPoint marcadorAnterior =
    marcadoresCamionesGIS.get(
        camionId
    );


if (marcadorAnterior != null) {

    mapaGIS.remove(
        marcadorAnterior
    );
}


marcadoresCamionesGIS.remove(
    camionId
);


// =====================================================
// CONSERVAR EL ESTADO TEXTUAL
// =====================================================

estadosCamionesGIS.put(
    camionId,
    estadoNormalizado
);


mensajeCamionesGIS =
    "Camión "
    + camionId
    + ": "
    + estadoNormalizado
    + ".";


// =====================================================
// MARCADOR CIRCULAR OPCIONAL
// =====================================================

if (!mostrarMarcadoresDiagnosticoGIS) {

    return;
}


com.anylogic.engine.markup.GISPoint marcadorNuevo =
    new com.anylogic.engine.markup.GISPoint(
        mapaGIS,
        false,
        latitud,
        longitud
    );


marcadorNuevo.setTitle(
    "Diagnóstico Camión "
    + camionId
    + " | "
    + estadoNormalizado
);


marcadorNuevo.setRadius(
    13.0
);


marcadorNuevo.setFillColor(
    colorRutaCamionGIS(
        camionId
    )
);


marcadorNuevo.setLineColor(
    java.awt.Color.WHITE
);


marcadorNuevo.setLineWidth(
    4.0
);


marcadorNuevo.setVisible(
    true
);


mapaGIS.add(
    marcadorNuevo
);


marcadoresCamionesGIS.put(
    camionId,
    marcadorNuevo
);


traceln(
    "GIS MARCADOR DIAGNÓSTICO"
    + " | camion="
    + camionId
    + " | estado="
    + estadoNormalizado
    + " | lat="
    + latitud
    + " | lon="
    + longitud
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787153409871</Id>
					<Name><![CDATA[inicializarMarcadoresCamionesGIS]]></Name>
					<X>-810</X><Y>2470</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Body><![CDATA[if (instancia == null) {

    throw new IllegalArgumentException(
        "instancia no puede ser null."
    );
}


if (instancia.cantidadCamiones <= 0) {

    throw new IllegalArgumentException(
        "La cantidad de camiones debe ser "
        + "mayor que cero."
    );
}


if (!gisInicializado) {

    inicializarGIS();
}


limpiarMarcadoresCamionesGIS();


for (
    int camionId = 0;
    camionId < instancia.cantidadCamiones;
    camionId++
) {

    double centroIndice =
        (
            instancia.cantidadCamiones
            - 1
        )
        /
        2.0;


    double desplazamientoLatitud =
        (
            camionId
            - centroIndice
        )
        *
        0.00012;


    actualizarMarcadorCamionGIS(
        camionId,
        instancia.latCorralon
            + desplazamientoLatitud,
        instancia.lonCorralon,
        "EN_CORRALON"
    );
}


mensajeCamionesGIS =
    "Camiones 2D inicializados: "
    + estadosCamionesGIS.size()
    + ".";


if (mostrarMarcadoresDiagnosticoGIS) {

    mensajeCamionesGIS +=
        " Marcadores diagnósticos visibles.";

} else {

    mensajeCamionesGIS +=
        " Marcadores diagnósticos ocultos.";
}


traceln(
    mensajeCamionesGIS
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787154132647</Id>
					<Name><![CDATA[actualizarEstadoCamionGISOperativo]]></Name>
					<X>-810</X><Y>2500</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[camionId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[latitud]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[longitud]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[estado]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[/*
 * Punto único de entrada desde los agentes Camion
 * hacia la representación GIS.
 *
 * Las coordenadas recibidas representan la posición
 * operativa real. Las coordenadas visuales pueden
 * recibir un pequeño desplazamiento para impedir
 * que el marcador quede oculto detrás de un cliente
 * o del corralón.
 */

if (
    MODO_EJECUCION
        != ModoEjecucion.SIMULACION
    &&
    MODO_EJECUCION
        != ModoEjecucion.PRODUCCION
) {

    return;
}


if (
    !gisInicializado
    ||
    mapaGIS == null
) {

    return;
}


if (camionId < 0) {

    throw new IllegalArgumentException(
        "camionId no puede ser negativo."
    );
}


if (
    !Double.isFinite(
        latitud
    )
    ||
    latitud < -90.0
    ||
    latitud > 90.0
) {

    throw new IllegalArgumentException(
        "Latitud operativa inválida para "
        + "el camión "
        + camionId
        + ": "
        + latitud
        + "."
    );
}


if (
    !Double.isFinite(
        longitud
    )
    ||
    longitud < -180.0
    ||
    longitud > 180.0
) {

    throw new IllegalArgumentException(
        "Longitud operativa inválida para "
        + "el camión "
        + camionId
        + ": "
        + longitud
        + "."
    );
}


String estadoNormalizado =
    estado == null
    ? "SIN_ESTADO"
    : estado.trim();


if (estadoNormalizado.isEmpty()) {

    estadoNormalizado =
        "SIN_ESTADO";
}


// =====================================================
// COORDENADAS REALES Y VISUALES
// =====================================================

double latitudVisual =
    latitud;

double longitudVisual =
    longitud;


boolean estaEnCorralon =
    Math.abs(
        latitud
        - LAT_CORRALON
    ) < 0.000000001
    &&
    Math.abs(
        longitud
        - LON_CORRALON
    ) < 0.000000001;


// =====================================================
// SEPARACIÓN VISUAL EN EL CORRALÓN
// =====================================================

if (estaEnCorralon) {

    int cantidadCamionesVisual =
        CANTIDAD_CAMIONES;


    if (
        instanciaActual != null
        &&
        instanciaActual.cantidadCamiones > 0
    ) {

        cantidadCamionesVisual =
            instanciaActual.cantidadCamiones;
    }


    double centroIndice =
        (
            cantidadCamionesVisual
            - 1
        )
        /
        2.0;


    double desplazamientoLatitud =
        (
            camionId
            - centroIndice
        )
        *
        0.00012;


    latitudVisual +=
        desplazamientoLatitud;


// =====================================================
// SEPARACIÓN VISUAL EN CLIENTES
// =====================================================

} else {

    /*
     * El camión se encuentra exactamente en las
     * coordenadas de un cliente.
     *
     * Aplicamos un desplazamiento de aproximadamente
     * diez a veinte metros para que el marcador no
     * quede tapado por el GISPoint del pedido.
     *
     * La coordenada operativa real no se modifica.
     */

    double separacionBase =
        0.00014;


    int posicionVisual =
        Math.floorMod(
            camionId,
            4
        );


    if (posicionVisual == 0) {

        // Camión 0:
        // arriba y a la derecha.

        latitudVisual +=
            separacionBase;

        longitudVisual +=
            separacionBase;

    } else if (posicionVisual == 1) {

        // Camión 1:
        // abajo y a la izquierda.

        latitudVisual -=
            separacionBase;

        longitudVisual -=
            separacionBase;

    } else if (posicionVisual == 2) {

        // Camión adicional:
        // arriba y a la izquierda.

        latitudVisual +=
            separacionBase;

        longitudVisual -=
            separacionBase;

    } else {

        // Camión adicional:
        // abajo y a la derecha.

        latitudVisual -=
            separacionBase;

        longitudVisual +=
            separacionBase;
    }
}


// =====================================================
// ACTUALIZAR EL MARCADOR
// =====================================================

actualizarMarcadorCamionGIS(
    camionId,
    latitudVisual,
    longitudVisual,
    estadoNormalizado
);


// =====================================================
// DIAGNÓSTICO
// =====================================================

traceln(
    "GIS POSICIÓN OPERATIVA"
    + " | camion="
    + camionId
    + " | estado="
    + estadoNormalizado
    + " | latReal="
    + latitud
    + " | lonReal="
    + longitud
    + " | latVisual="
    + latitudVisual
    + " | lonVisual="
    + longitudVisual
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1787154178558</Id>
					<Name><![CDATA[resumenEstadosCamionesGIS]]></Name>
					<X>-810</X><Y>2530</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (estadosCamionesGIS.isEmpty()) {

    return mensajeCamionesGIS;
}


StringBuilder resumen =
    new StringBuilder();


for (
    java.util.Map.Entry<
        Integer,
        String
    > entrada
    : estadosCamionesGIS.entrySet()
) {

    if (resumen.length() > 0) {

        resumen.append(
            " | "
        );
    }


    resumen.append(
        "Camión "
    );

    resumen.append(
        entrada.getKey()
    );

    resumen.append(
        ": "
    );

    resumen.append(
        entrada.getValue()
    );
}


return resumen.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1787155874135</Id>
					<Name><![CDATA[obtenerPedidoOriginalIdGIS]]></Name>
					<X>-810</X><Y>2560</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[pedido]]></Name>
						<Type><![CDATA[PedidoInput]]></Type>
					</Parameter>
					<Body><![CDATA[if (pedido == null) {

    throw new IllegalArgumentException(
        "pedido no puede ser null."
    );
}


String originalId =
    pedido.pedidoOriginalId;


if (
    originalId == null
    ||
    originalId.trim().isEmpty()
) {

    originalId =
        pedido.pedidoId;
}


if (
    originalId == null
    ||
    originalId.trim().isEmpty()
) {

    throw new IllegalStateException(
        "El pedido no tiene identificador."
    );
}


return originalId.trim();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.awt.Color]]></ReturnType>
					<Id>1787155911927</Id>
					<Name><![CDATA[colorBasePedidoGIS]]></Name>
					<X>-810</X><Y>2590</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[pedido]]></Name>
						<Type><![CDATA[PedidoInput]]></Type>
					</Parameter>
					<Body><![CDATA[if (pedido == null) {

    throw new IllegalArgumentException(
        "pedido no puede ser null."
    );
}


if (
    pedido.requiereVolcador
    &&
    pedido.tieneVentanaEspecifica
) {

    // Magenta:
    // ventana y volcador.

    return new java.awt.Color(
        194,
        24,
        91
    );
}


if (pedido.requiereVolcador) {

    // Naranja:
    // requiere volcador.

    return new java.awt.Color(
        251,
        140,
        0
    );
}


if (
    pedido.tieneVentanaEspecifica
) {

    // Violeta:
    // ventana específica.

    return new java.awt.Color(
        103,
        58,
        183
    );
}


// Azul:
// pedido normal.

return new java.awt.Color(
    30,
    136,
    229
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.awt.Color]]></ReturnType>
					<Id>1787155951559</Id>
					<Name><![CDATA[colorEstadoPedidoGIS]]></Name>
					<X>-810</X><Y>2620</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[estado]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[colorBase]]></Name>
						<Type><![CDATA[java.awt.Color]]></Type>
					</Parameter>
					<Body><![CDATA[String valor =
    estado == null
    ? "PENDIENTE"
    : estado.trim().toUpperCase();


if (valor.equals("PENDIENTE")) {

    return colorBase == null
        ? java.awt.Color.GRAY
        : colorBase;
}


if (valor.equals("PLANIFICADO")) {

    return new java.awt.Color(
        96,
        125,
        139
    );
}


if (valor.equals("CARGADO")) {

    return new java.awt.Color(
        25,
        118,
        210
    );
}


if (valor.equals("EN_TRANSITO")) {

    return new java.awt.Color(
        0,
        188,
        212
    );
}


if (valor.equals("ESPERANDO")) {

    return new java.awt.Color(
        251,
        192,
        45
    );
}


if (valor.equals("PARCIAL")) {

    return new java.awt.Color(
        124,
        179,
        66
    );
}


if (valor.equals("ENTREGADO")) {

    return new java.awt.Color(
        46,
        125,
        50
    );
}


if (valor.equals("NO_ENTREGADO")) {

    return new java.awt.Color(
        211,
        47,
        47
    );
}


if (
    valor.equals(
        "PENDIENTE_DIA_SIGUIENTE"
    )
) {

    return new java.awt.Color(
        121,
        85,
        72
    );
}


return new java.awt.Color(
    117,
    117,
    117
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1787155990847</Id>
					<Name><![CDATA[estadoAgregadoPedidoOriginalGIS]]></Name>
					<X>-810</X><Y>2650</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[originalId]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (
    originalId == null
    ||
    originalId.trim().isEmpty()
) {

    throw new IllegalArgumentException(
        "originalId no puede estar vacío."
    );
}


int totalPartes =
    0;

int partesEntregadas =
    0;


boolean existeNoEntregado =
    false;

boolean existePendienteDiaSiguiente =
    false;

boolean existeEsperando =
    false;

boolean existeEnTransito =
    false;

boolean existeCargado =
    false;

boolean existePlanificado =
    false;


for (
    PedidoRuntime runtime
    : pedidosRuntime.values()
) {

    if (
        runtime == null
        ||
        runtime.input == null
    ) {

        continue;
    }


    String runtimeOriginalId =
        obtenerPedidoOriginalIdGIS(
            runtime.input
        );


    if (
        !originalId.equals(
            runtimeOriginalId
        )
    ) {

        continue;
    }


    totalPartes++;


    if (
        runtime.estado
        == EstadoPedido.ENTREGADO
    ) {

        partesEntregadas++;

    } else if (
        runtime.estado
        == EstadoPedido.NO_ENTREGADO
    ) {

        existeNoEntregado =
            true;

    } else if (
        runtime.estado
        == EstadoPedido
            .PENDIENTE_DIA_SIGUIENTE
    ) {

        existePendienteDiaSiguiente =
            true;

    } else if (
        runtime.estado
        == EstadoPedido.ESPERANDO
    ) {

        existeEsperando =
            true;

    } else if (
        runtime.estado
        == EstadoPedido.EN_TRANSITO
    ) {

        existeEnTransito =
            true;

    } else if (
        runtime.estado
        == EstadoPedido.CARGADO
    ) {

        existeCargado =
            true;

    } else if (
        runtime.estado
        == EstadoPedido.PLANIFICADO
    ) {

        existePlanificado =
            true;
    }
}


if (totalPartes == 0) {

    return "PENDIENTE";
}


if (
    partesEntregadas
    == totalPartes
) {

    return "ENTREGADO";
}


if (existeNoEntregado) {

    return "NO_ENTREGADO";
}


if (
    existePendienteDiaSiguiente
) {

    return "PENDIENTE_DIA_SIGUIENTE";
}


if (partesEntregadas > 0) {

    return "PARCIAL";
}


if (existeEsperando) {

    return "ESPERANDO";
}


if (existeEnTransito) {

    return "EN_TRANSITO";
}


if (existeCargado) {

    return "CARGADO";
}


if (existePlanificado) {

    return "PLANIFICADO";
}


return "PENDIENTE";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787156018343</Id>
					<Name><![CDATA[indexarPuntosPedidosGIS]]></Name>
					<X>-810</X><Y>2680</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Body><![CDATA[if (instancia == null) {

    throw new IllegalArgumentException(
        "instancia no puede ser null."
    );
}


puntosPedidosPorOriginalGIS.clear();

estadosPedidosGIS.clear();


java.util.LinkedHashSet<String> originales =
    new java.util.LinkedHashSet<String>();


for (
    PedidoInput pedido
    : instancia.pedidos
) {

    if (pedido == null) {

        continue;
    }


    originales.add(
        obtenerPedidoOriginalIdGIS(
            pedido
        )
    );
}


if (
    originales.size()
    != puntosPedidosGIS.size()
) {

    throw new IllegalStateException(
        "No coincide la cantidad de pedidos "
        + "originales con los puntos GIS. "
        + "Originales="
        + originales.size()
        + ", puntos="
        + puntosPedidosGIS.size()
        + "."
    );
}


int indice =
    0;


for (
    String originalId
    : originales
) {

    com.anylogic.engine.markup.GISPoint punto =
        puntosPedidosGIS.get(
            indice
        );


    puntosPedidosPorOriginalGIS.put(
        originalId,
        punto
    );


    estadosPedidosGIS.put(
        originalId,
        "PENDIENTE"
    );


    indice++;
}


mensajeEstadosPedidosGIS =
    "Pedidos GIS indexados: "
    + puntosPedidosPorOriginalGIS.size()
    + ".";


traceln(
    mensajeEstadosPedidosGIS
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787156039551</Id>
					<Name><![CDATA[actualizarPuntoPedidoOriginalGIS]]></Name>
					<X>-810</X><Y>2710</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[originalId]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (
    !gisInicializado
    ||
    mapaGIS == null
) {

    return;
}


InstanciaTurno instanciaFuente =
    instanciaActual != null
    ? instanciaActual
    : instanciaInterfazActual;


if (instanciaFuente == null) {

    return;
}


PedidoInput primerPedido =
    null;


int unidadesTotales =
    0;

int cantidadPartes =
    0;

int partesEntregadas =
    0;


boolean requiereVolcador =
    false;

boolean tieneVentana =
    false;


for (
    PedidoInput pedido
    : instanciaFuente.pedidos
) {

    if (pedido == null) {

        continue;
    }


    String pedidoOriginalId =
        obtenerPedidoOriginalIdGIS(
            pedido
        );


    if (
        !originalId.equals(
            pedidoOriginalId
        )
    ) {

        continue;
    }


    if (primerPedido == null) {

        primerPedido =
            pedido;
    }


    cantidadPartes++;

    unidadesTotales +=
        pedido.unidadesCapacidad;

    requiereVolcador =
        requiereVolcador
        ||
        pedido.requiereVolcador;

    tieneVentana =
        tieneVentana
        ||
        pedido.tieneVentanaEspecifica;


    PedidoRuntime runtime =
        pedidosRuntime.get(
            pedido.pedidoId
        );


    if (
        runtime != null
        &&
        runtime.estado
            == EstadoPedido.ENTREGADO
    ) {

        partesEntregadas++;
    }
}


if (primerPedido == null) {

    throw new IllegalArgumentException(
        "No existe el pedido original "
        + originalId
        + "."
    );
}


String estadoNuevo =
    estadoAgregadoPedidoOriginalGIS(
        originalId
    );


String estadoAnterior =
    estadosPedidosGIS.get(
        originalId
    );


com.anylogic.engine.markup.GISPoint puntoAnterior =
    puntosPedidosPorOriginalGIS.get(
        originalId
    );


if (
    estadoNuevo.equals(
        estadoAnterior
    )
    &&
    puntoAnterior != null
) {

    return;
}


// =====================================================
// ELIMINAR EL PUNTO ANTERIOR
// =====================================================

if (puntoAnterior != null) {

    mapaGIS.remove(
        puntoAnterior
    );


    puntosPedidosGIS.remove(
        puntoAnterior
    );
}


// =====================================================
// COLORES
// =====================================================

java.awt.Color colorBase =
    colorBasePedidoGIS(
        primerPedido
    );


java.awt.Color colorEstado =
    colorEstadoPedidoGIS(
        estadoNuevo,
        colorBase
    );


java.awt.Color colorBorde =
    estadoNuevo.equals(
        "PENDIENTE"
    )
    ? java.awt.Color.BLACK
    : colorBase;


// =====================================================
// CREAR EL NUEVO PUNTO
// =====================================================

com.anylogic.engine.markup.GISPoint puntoNuevo =
    new com.anylogic.engine.markup.GISPoint(
        mapaGIS,
        false,
        primerPedido.latitud,
        primerPedido.longitud
    );


double radio =
    9.0;


if (
    estadoNuevo.equals("CARGADO")
    ||
    estadoNuevo.equals("EN_TRANSITO")
    ||
    estadoNuevo.equals("ESPERANDO")
) {

    radio =
        11.0;

} else if (
    estadoNuevo.equals("ENTREGADO")
    ||
    estadoNuevo.equals("NO_ENTREGADO")
    ||
    estadoNuevo.equals("PARCIAL")
) {

    radio =
        10.0;
}


puntoNuevo.setRadius(
    radio
);


puntoNuevo.setFillColor(
    colorEstado
);


puntoNuevo.setLineColor(
    colorBorde
);


puntoNuevo.setLineWidth(
    estadoNuevo.equals("PENDIENTE")
    ? 2.0
    : 3.0
);


String titulo =
    originalId
    + " | estado="
    + estadoNuevo
    + " | unidades="
    + unidadesTotales
    + " | partes="
    + cantidadPartes
    + " | entregadas="
    + partesEntregadas
    + "/"
    + cantidadPartes
    + " | volcador="
    + requiereVolcador
    + " | ventana="
    + tieneVentana;


if (
    primerPedido.cliente != null
    &&
    !primerPedido.cliente
        .trim()
        .isEmpty()
) {

    titulo +=
        " | cliente="
        + primerPedido.cliente.trim();
}


puntoNuevo.setTitle(
    titulo
);


puntoNuevo.setVisible(
    true
);


mapaGIS.add(
    puntoNuevo
);


puntosPedidosGIS.add(
    puntoNuevo
);


puntosPedidosPorOriginalGIS.put(
    originalId,
    puntoNuevo
);


estadosPedidosGIS.put(
    originalId,
    estadoNuevo
);


traceln(
    "GIS PEDIDO ACTUALIZADO"
    + " | original="
    + originalId
    + " | estadoAnterior="
    + estadoAnterior
    + " | estadoNuevo="
    + estadoNuevo
    + " | entregadas="
    + partesEntregadas
    + "/"
    + cantidadPartes
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1787156068879</Id>
					<Name><![CDATA[resumenEstadosPedidosGIS]]></Name>
					<X>-810</X><Y>2740</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (estadosPedidosGIS.isEmpty()) {

    return mensajeEstadosPedidosGIS;
}


int pendientes =
    0;

int planificados =
    0;

int cargados =
    0;

int enTransito =
    0;

int esperando =
    0;

int parciales =
    0;

int entregados =
    0;

int noEntregados =
    0;

int siguienteDia =
    0;


for (
    String estado
    : estadosPedidosGIS.values()
) {

    if (estado == null) {

        continue;
    }


    if (estado.equals("PENDIENTE")) {

        pendientes++;

    } else if (
        estado.equals("PLANIFICADO")
    ) {

        planificados++;

    } else if (
        estado.equals("CARGADO")
    ) {

        cargados++;

    } else if (
        estado.equals("EN_TRANSITO")
    ) {

        enTransito++;

    } else if (
        estado.equals("ESPERANDO")
    ) {

        esperando++;

    } else if (
        estado.equals("PARCIAL")
    ) {

        parciales++;

    } else if (
        estado.equals("ENTREGADO")
    ) {

        entregados++;

    } else if (
        estado.equals("NO_ENTREGADO")
    ) {

        noEntregados++;

    } else if (
        estado.equals(
            "PENDIENTE_DIA_SIGUIENTE"
        )
    ) {

        siguienteDia++;
    }
}


return
    "Pedidos GIS"
    + " | pendientes="
    + pendientes
    + " | planificados="
    + planificados
    + " | cargados="
    + cargados
    + " | en tránsito="
    + enTransito
    + " | esperando="
    + esperando
    + " | parciales="
    + parciales
    + " | entregados="
    + entregados
    + " | no entregados="
    + noEntregados
    + " | día siguiente="
    + siguienteDia;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787156087048</Id>
					<Name><![CDATA[actualizarEstadosPedidosGIS]]></Name>
					<X>-810</X><Y>2770</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    !gisInicializado
    ||
    mapaGIS == null
    ||
    puntosPedidosPorOriginalGIS.isEmpty()
) {

    return;
}


InstanciaTurno instanciaFuente =
    instanciaActual != null
    ? instanciaActual
    : instanciaInterfazActual;


if (instanciaFuente == null) {

    return;
}


java.util.LinkedHashSet<String> originales =
    new java.util.LinkedHashSet<String>();


for (
    PedidoInput pedido
    : instanciaFuente.pedidos
) {

    if (pedido != null) {

        originales.add(
            obtenerPedidoOriginalIdGIS(
                pedido
            )
        );
    }
}


for (
    String originalId
    : originales
) {

    actualizarPuntoPedidoOriginalGIS(
        originalId
    );
}


mensajeEstadosPedidosGIS =
    resumenEstadosPedidosGIS();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1787569775337</Id>
					<Name><![CDATA[estadoCamionDashboard]]></Name>
					<X>-810</X><Y>2800</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[camionId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[String estado =
    estadosCamionesGIS.get(
        camionId
    );


if (
    estado == null
    ||
    estado.trim().isEmpty()
) {

    return "Sin plan";
}


estado =
    estado.trim();


if (
    estado.equals(
        "EN_CORRALON"
    )
) {

    return "En corralón";
}


if (
    estado.equals(
        "PLAN_FINALIZADO"
    )
) {

    return "Finalizado";
}


if (
    estado.equals(
        "REGRESANDO_CORRALON"
    )
) {

    return "Regresando";
}


if (
    estado.startsWith(
        "VIAJANDO_A_"
    )
) {

    return "En ruta";
}


if (
    estado.startsWith(
        "EN_CLIENTE_"
    )
) {

    return "En cliente";
}


if (
    estado.contains(
        "CARGA"
    )
) {

    return "Cargando";
}


if (
    estado.contains(
        "ESPERA"
    )
) {

    return "Esperando";
}


return estado
    .replace(
        '_',
        ' '
    );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1787578289378</Id>
					<Name><![CDATA[exportarCacheVialInstanciaActual]]></Name>
					<X>-810</X><Y>2830</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[final String VERSION_CACHE =
    "pedemonte-vial-v1";

final String ENCABEZADO_CACHE =
    "version_cache,"
    + "lat_origen,"
    + "lon_origen,"
    + "lat_destino,"
    + "lon_destino,"
    + "distancia_metros,"
    + "tiempo_base_min,"
    + "fuente_distancia,"
    + "fuente_tiempo";


java.nio.file.Path rutaTemporal =
    null;


try {

    if (instanciaInterfazActual == null) {

        throw new IllegalStateException(
            "No existe una instancia preparada."
        );
    }


    if (
        instanciaInterfazActual.pedidos == null
        ||
        instanciaInterfazActual.pedidos.isEmpty()
    ) {

        throw new IllegalStateException(
            "La instancia no contiene pedidos."
        );
    }


    if (mapaGIS == null) {

        throw new IllegalStateException(
            "No existe mapaGIS."
        );
    }


    double latCorralon =
        instanciaInterfazActual.latCorralon;

    double lonCorralon =
        instanciaInterfazActual.lonCorralon;


    if (
        !Double.isFinite(latCorralon)
        ||
        !Double.isFinite(lonCorralon)
        ||
        latCorralon < -90.0
        ||
        latCorralon > 90.0
        ||
        lonCorralon < -180.0
        ||
        lonCorralon > 180.0
    ) {

        throw new IllegalArgumentException(
            "Las coordenadas del corralón "
            + "no son válidas."
        );
    }


    /*
     * Las coordenadas se normalizan a seis
     * decimales, igual que el proveedor Python.
     *
     * LinkedHashMap conserva un orden estable
     * y elimina ubicaciones duplicadas.
     */

    java.util.LinkedHashMap<String, double[]>
        coordenadasUnicas =
            new java.util.LinkedHashMap<
                String,
                double[]
            >();


    String claveCorralon =
        String.format(
            java.util.Locale.US,
            "%.6f,%.6f",
            latCorralon,
            lonCorralon
        );


    coordenadasUnicas.put(
        claveCorralon,
        new double[] {
            latCorralon,
            lonCorralon
        }
    );


    for (
        PedidoInput pedido
        : instanciaInterfazActual.pedidos
    ) {

        if (pedido == null) {
            continue;
        }


        if (
            !Double.isFinite(pedido.latitud)
            ||
            !Double.isFinite(pedido.longitud)
            ||
            pedido.latitud < -90.0
            ||
            pedido.latitud > 90.0
            ||
            pedido.longitud < -180.0
            ||
            pedido.longitud > 180.0
        ) {

            throw new IllegalArgumentException(
                "Coordenadas inválidas en el pedido "
                + pedido.pedidoId
                + "."
            );
        }


        String clavePedido =
            String.format(
                java.util.Locale.US,
                "%.6f,%.6f",
                pedido.latitud,
                pedido.longitud
            );


        if (
            !coordenadasUnicas.containsKey(
                clavePedido
            )
        ) {

            coordenadasUnicas.put(
                clavePedido,
                new double[] {
                    pedido.latitud,
                    pedido.longitud
                }
            );
        }
    }


    if (coordenadasUnicas.size() < 2) {

        throw new IllegalStateException(
            "Se necesitan al menos dos "
            + "ubicaciones diferentes."
        );
    }


    String raizPython =
        resolverRaizPythonPypeline();


    java.io.File directorioRouting =
        new java.io.File(
            raizPython,
            "data/routing"
        );


    if (
        !directorioRouting.isDirectory()
        &&
        !directorioRouting.mkdirs()
    ) {

        throw new java.io.IOException(
            "No se pudo crear el directorio "
            + directorioRouting
                .getCanonicalPath()
            + "."
        );
    }


    java.io.File archivoCache =
        new java.io.File(
            directorioRouting,
            "cache_vial.csv"
        );


    /*
     * Las filas existentes se leen y normalizan.
     * No se pierden tramos exportados anteriormente.
     */

    java.util.TreeMap<String, String>
        filasCache =
            new java.util.TreeMap<
                String,
                String
            >();


    if (archivoCache.isFile()) {

        java.util.List<String> lineas =
            java.nio.file.Files.readAllLines(
                archivoCache.toPath(),
                java.nio.charset
                    .StandardCharsets
                    .UTF_8
            );


        if (!lineas.isEmpty()) {

            String encabezadoExistente =
                lineas.get(0)
                    .replace(
                        "\uFEFF",
                        ""
                    )
                    .trim();


            if (
                !ENCABEZADO_CACHE.equals(
                    encabezadoExistente
                )
            ) {

                throw new IllegalStateException(
                    "El encabezado de la caché "
                    + "vial no es compatible."
                );
            }
        }


        for (
            int indice = 1;
            indice < lineas.size();
            indice++
        ) {

            String linea =
                lineas.get(indice)
                    .trim();


            if (linea.isEmpty()) {
                continue;
            }


            String[] columnas =
                linea.split(
                    ",",
                    -1
                );


            if (columnas.length != 9) {

                throw new IllegalStateException(
                    "Fila CSV inválida en la línea "
                    + (indice + 1)
                    + "."
                );
            }


            String versionFila =
                columnas[0].trim();


            if (
                !VERSION_CACHE.equals(
                    versionFila
                )
            ) {

                throw new IllegalStateException(
                    "Versión incompatible en la "
                    + "línea "
                    + (indice + 1)
                    + ": "
                    + versionFila
                    + "."
                );
            }


            double latOrigenExistente =
                Double.parseDouble(
                    columnas[1].trim()
                );

            double lonOrigenExistente =
                Double.parseDouble(
                    columnas[2].trim()
                );

            double latDestinoExistente =
                Double.parseDouble(
                    columnas[3].trim()
                );

            double lonDestinoExistente =
                Double.parseDouble(
                    columnas[4].trim()
                );

            double distanciaExistente =
                Double.parseDouble(
                    columnas[5].trim()
                );


            if (
                !Double.isFinite(
                    distanciaExistente
                )
                ||
                distanciaExistente <= 0.0
            ) {

                throw new IllegalStateException(
                    "Distancia inválida en la línea "
                    + (indice + 1)
                    + "."
                );
            }


            String claveExistente =
                String.format(
                    java.util.Locale.US,
                    "%.6f,%.6f,%.6f,%.6f",
                    latOrigenExistente,
                    lonOrigenExistente,
                    latDestinoExistente,
                    lonDestinoExistente
                );


            String filaAnterior =
                filasCache.get(
                    claveExistente
                );


            if (
                filaAnterior != null
                &&
                !filaAnterior.equals(linea)
            ) {

                throw new IllegalStateException(
                    "La caché contiene filas "
                    + "conflictivas para el tramo "
                    + claveExistente
                    + "."
                );
            }


            filasCache.put(
                claveExistente,
                linea
            );
        }
    }


    java.util.ArrayList<double[]> puntos =
        new java.util.ArrayList<double[]>(
            coordenadasUnicas.values()
        );


    int cantidadPuntos =
        puntos.size();

    int cantidadTramosInstancia =
        cantidadPuntos
        * (cantidadPuntos - 1);

    int tramosConsultados =
        0;

    int tramosNuevos =
        0;

    int tramosReutilizados =
        0;


    java.util.TreeMap<String, String>
        nuevasFilas =
            new java.util.TreeMap<
                String,
                String
            >();


    traceln(
        "================================"
    );

    traceln(
        "=== EXPORTACIÓN CACHÉ VIAL ===="
    );

    traceln(
        "================================"
    );

    traceln(
        "Ubicaciones únicas: "
        + cantidadPuntos
    );

    traceln(
        "Tramos dirigidos requeridos: "
        + cantidadTramosInstancia
    );


    for (
        int indiceOrigen = 0;
        indiceOrigen < puntos.size();
        indiceOrigen++
    ) {

        double[] origen =
            puntos.get(
                indiceOrigen
            );


        for (
            int indiceDestino = 0;
            indiceDestino < puntos.size();
            indiceDestino++
        ) {

            if (
                indiceOrigen
                == indiceDestino
            ) {

                continue;
            }


            double[] destino =
                puntos.get(
                    indiceDestino
                );


            String latOrigenTexto =
                String.format(
                    java.util.Locale.US,
                    "%.6f",
                    origen[0]
                );

            String lonOrigenTexto =
                String.format(
                    java.util.Locale.US,
                    "%.6f",
                    origen[1]
                );

            String latDestinoTexto =
                String.format(
                    java.util.Locale.US,
                    "%.6f",
                    destino[0]
                );

            String lonDestinoTexto =
                String.format(
                    java.util.Locale.US,
                    "%.6f",
                    destino[1]
                );


            String claveTramo =
                latOrigenTexto
                + ","
                + lonOrigenTexto
                + ","
                + latDestinoTexto
                + ","
                + lonDestinoTexto;


            tramosConsultados++;


            if (
                filasCache.containsKey(
                    claveTramo
                )
                ||
                nuevasFilas.containsKey(
                    claveTramo
                )
            ) {

                tramosReutilizados++;

                traceln(
                    "CACHE VIAL | tramo="
                    + tramosConsultados
                    + "/"
                    + cantidadTramosInstancia
                    + " | REUTILIZADO | "
                    + claveTramo
                );

                continue;
            }


            traceln(
                "CACHE VIAL | tramo="
                + tramosConsultados
                + "/"
                + cantidadTramosInstancia
                + " | CONSULTANDO | "
                + claveTramo
            );


            double distanciaVial =
                mapaGIS.getDistanceByRoute(
                    origen[0],
                    origen[1],
                    destino[0],
                    destino[1]
                );


            if (
                !Double.isFinite(
                    distanciaVial
                )
                ||
                distanciaVial <= 0.0
            ) {

                throw new IllegalStateException(
                    "El proveedor vial no devolvió "
                    + "una distancia válida para "
                    + claveTramo
                    + ". Valor="
                    + distanciaVial
                    + "."
                );
            }


            String distanciaTexto =
                String.format(
                    java.util.Locale.US,
                    "%.6f",
                    distanciaVial
                );


            /*
             * tiempo_base_min queda vacío.
             * Python lo derivará utilizando
             * velocidad_base_kmh.
             */

            String nuevaFila =
                VERSION_CACHE
                + ","
                + claveTramo
                + ","
                + distanciaTexto
                + ","
                + ""
                + ","
                + "ANYLOGIC_ROUTE_PROVIDER"
                + ","
                + "VELOCIDAD_BASE_CONFIG";


            nuevasFilas.put(
                claveTramo,
                nuevaFila
            );


            tramosNuevos++;


            traceln(
                "CACHE VIAL | tramo="
                + tramosConsultados
                + "/"
                + cantidadTramosInstancia
                + " | AGREGADO | distancia="
                + distanciaTexto
                + " m"
            );
        }
    }


    /*
     * Ningún archivo se modifica hasta que todas
     * las consultas necesarias hayan finalizado.
     */

    filasCache.putAll(
        nuevasFilas
    );


    rutaTemporal =
        new java.io.File(
            directorioRouting,
            "cache_vial.csv.tmp"
        ).toPath();


    try (
        java.io.BufferedWriter escritor =
            java.nio.file.Files.newBufferedWriter(
                rutaTemporal,
                java.nio.charset
                    .StandardCharsets
                    .UTF_8,
                java.nio.file
                    .StandardOpenOption
                    .CREATE,
                java.nio.file
                    .StandardOpenOption
                    .TRUNCATE_EXISTING
            )
    ) {

        escritor.write(
            ENCABEZADO_CACHE
        );

        escritor.newLine();


        for (
            String fila
            : filasCache.values()
        ) {

            escritor.write(
                fila
            );

            escritor.newLine();
        }
    }


    try {

        java.nio.file.Files.move(
            rutaTemporal,
            archivoCache.toPath(),
            java.nio.file
                .StandardCopyOption
                .REPLACE_EXISTING,
            java.nio.file
                .StandardCopyOption
                .ATOMIC_MOVE
        );

    } catch (
        java.nio.file
            .AtomicMoveNotSupportedException ex
    ) {

        java.nio.file.Files.move(
            rutaTemporal,
            archivoCache.toPath(),
            java.nio.file
                .StandardCopyOption
                .REPLACE_EXISTING
        );
    }


    mensajeInterfazPlanificacion =
        "Caché vial actualizada."
        + "\nNuevos: "
        + tramosNuevos
        + " | Existentes: "
        + tramosReutilizados
        + "\nTotal almacenado: "
        + filasCache.size();


    traceln(
        "Archivo: "
        + archivoCache
            .getCanonicalPath()
    );

    traceln(
        "Tramos nuevos: "
        + tramosNuevos
    );

    traceln(
        "Tramos reutilizados: "
        + tramosReutilizados
    );

    traceln(
        "Tramos totales almacenados: "
        + filasCache.size()
    );

    traceln(
        "=== EXPORTACIÓN COMPLETADA ==="
    );

	pypelineSelectorInicializado =
	    false;
	
	
	pypelineEstadoSelector =
	    "CACHE_VIAL_ACTUALIZADA_REINICIALIZAR";
	
	
	boolean matrizLista =
	    verificarCacheVialInstanciaActual();
	
	
	if (matrizLista) {
	
	    mensajeInterfazPlanificacion +=
	        "\nMatriz lista para planificar.";
	
	} else {
	
	    mensajeInterfazPlanificacion +=
	        "\nVerificación: "
	        + cacheVialEstadoInterfaz
	        + ".";
	}
	
	
	return true;


} catch (
    Exception ex
) {

    mensajeInterfazPlanificacion =
        "Error al exportar caché vial."
        + "\n"
        + ex.getClass()
            .getSimpleName()
        + "\nRevisá la consola.";


    traceln(
        "ERROR EXPORTANDO CACHÉ VIAL: "
        + ex.getClass()
            .getSimpleName()
        + " | "
        + ex.getMessage()
    );


    ex.printStackTrace();


    if (rutaTemporal != null) {

        try {

            java.nio.file.Files
                .deleteIfExists(
                    rutaTemporal
                );

        } catch (
            Exception exLimpieza
        ) {

            traceln(
                "No se pudo eliminar el archivo "
                + "temporal: "
                + exLimpieza.getMessage()
            );
        }
    }


    return false;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787586633994</Id>
					<Name><![CDATA[limpiarRutaActivaCamionGIS]]></Name>
					<X>-810</X><Y>2860</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[camionId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if (camionId < 0) {

    throw new IllegalArgumentException(
        "camionId no puede ser negativo."
    );
}


java.util.ArrayList<
    com.anylogic.engine.markup.GISRoute
> rutasCamion =
    rutasActivasPorCamionGIS.remove(
        camionId
    );


if (
    rutasCamion == null
    ||
    rutasCamion.isEmpty()
) {

    return;
}


int segmentosEliminados =
    0;


for (
    com.anylogic.engine.markup.GISRoute ruta
    : rutasCamion
) {

    if (ruta == null) {
        continue;
    }


    if (mapaGIS != null) {

        mapaGIS.remove(
            ruta
        );
    }


    rutasPlanGIS.remove(
        ruta
    );


    segmentosEliminados++;
}


rutasCamion.clear();


cantidadSegmentosPlanGIS =
    rutasPlanGIS.size();


if (cantidadSegmentosPlanGIS == 0) {

    mensajeRutasGIS =
        "Sin viajes activos en el mapa.";

} else {

    mensajeRutasGIS =
        "Rutas activas: "
        + cantidadSegmentosPlanGIS
        + " segmento(s).";
}


traceln(
    "GIS VIAJE ACTIVO LIMPIADO"
    + " | camion="
    + camionId
    + " | segmentosEliminados="
    + segmentosEliminados
    + " | segmentosActivos="
    + cantidadSegmentosPlanGIS
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787586663225</Id>
					<Name><![CDATA[mostrarViajeActivoCamionGIS]]></Name>
					<X>-810</X><Y>2890</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[camionId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[viaje]]></Name>
						<Type><![CDATA[ViajePlan]]></Type>
					</Parameter>
					<Body><![CDATA[if (
    MODO_EJECUCION
        != ModoEjecucion.SIMULACION
    &&
    MODO_EJECUCION
        != ModoEjecucion.PRODUCCION
) {

    return;
}


if (camionId < 0) {

    throw new IllegalArgumentException(
        "camionId no puede ser negativo."
    );
}


if (viaje == null) {

    throw new IllegalArgumentException(
        "viaje no puede ser null."
    );
}


if (
    viaje.pedidoIds == null
    ||
    viaje.pedidoIds.isEmpty()
) {

    limpiarRutaActivaCamionGIS(
        camionId
    );

    traceln(
        "GIS VIAJE ACTIVO"
        + " | camion="
        + camionId
        + " | viaje="
        + viaje.numeroViaje
        + " | sin pedidos"
    );

    return;
}


if (instanciaActual == null) {

    throw new IllegalStateException(
        "No existe instanciaActual para "
        + "representar el viaje activo."
    );
}


if (!gisInicializado) {

    inicializarGIS();
}


if (mapaGIS == null) {

    throw new IllegalStateException(
        "No existe mapaGIS."
    );
}


limpiarRutaActivaCamionGIS(
    camionId
);


java.util.ArrayList<
    com.anylogic.engine.markup.GISRoute
> rutasCamion =
    new java.util.ArrayList<
        com.anylogic.engine.markup.GISRoute
    >();


rutasActivasPorCamionGIS.put(
    camionId,
    rutasCamion
);


try {

    java.awt.Color colorRuta =
        colorRutaCamionGIS(
            camionId
        );


    double latitudActual =
        instanciaActual.latCorralon;


    double longitudActual =
        instanciaActual.lonCorralon;


    String origenActual =
        "CORRALON";


    int numeroTramo =
        1;


    for (
        String pedidoId
        : viaje.pedidoIds
    ) {

        PedidoInput pedido =
            buscarPedidoParaGIS(
                instanciaActual,
                pedidoId
            );


        com.anylogic.engine.markup.GISRoute ruta =
            crearSegmentoRutaGIS(
                latitudActual,
                longitudActual,
                pedido.latitud,
                pedido.longitud,
                colorRuta
            );


        if (ruta == null) {

            traceln(
                "GIS VIAJE ACTIVO"
                + " | camion="
                + camionId
                + " | viaje="
                + viaje.numeroViaje
                + " | tramo="
                + numeroTramo
                + " | "
                + origenActual
                + " -> "
                + pedidoId
                + " | omitido por "
                + "coordenadas iguales"
            );

        } else {

            rutasCamion.add(
                ruta
            );


            traceln(
                "GIS VIAJE ACTIVO"
                + " | camion="
                + camionId
                + " | viaje="
                + viaje.numeroViaje
                + " | tramo="
                + numeroTramo
                + " | "
                + origenActual
                + " -> "
                + pedidoId
            );
        }


        latitudActual =
            pedido.latitud;


        longitudActual =
            pedido.longitud;


        origenActual =
            pedidoId;


        numeroTramo++;
    }


    com.anylogic.engine.markup.GISRoute rutaRetorno =
        crearSegmentoRutaGIS(
            latitudActual,
            longitudActual,
            instanciaActual.latCorralon,
            instanciaActual.lonCorralon,
            colorRuta
        );


    if (rutaRetorno == null) {

        traceln(
            "GIS VIAJE ACTIVO"
            + " | camion="
            + camionId
            + " | viaje="
            + viaje.numeroViaje
            + " | retorno omitido por "
            + "coordenadas iguales"
        );

    } else {

        rutasCamion.add(
            rutaRetorno
        );


        traceln(
            "GIS VIAJE ACTIVO"
            + " | camion="
            + camionId
            + " | viaje="
            + viaje.numeroViaje
            + " | tramo="
            + numeroTramo
            + " | "
            + origenActual
            + " -> CORRALON"
        );
    }


    if (rutasCamion.isEmpty()) {

        rutasActivasPorCamionGIS.remove(
            camionId
        );
    }


    cantidadSegmentosPlanGIS =
        rutasPlanGIS.size();


    mensajeRutasGIS =
        "Rutas activas: "
        + cantidadSegmentosPlanGIS
        + " segmento(s).";


    traceln(
        "GIS VIAJE ACTIVO MOSTRADO"
        + " | camion="
        + camionId
        + " | viaje="
        + viaje.numeroViaje
        + " | segmentosCamion="
        + rutasCamion.size()
        + " | segmentosActivos="
        + cantidadSegmentosPlanGIS
    );

} catch (Exception ex) {

    limpiarRutaActivaCamionGIS(
        camionId
    );

    throw ex;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1787598691463</Id>
					<Name><![CDATA[campoDecisionSelector]]></Name>
					<X>-810</X><Y>2920</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[decision]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[clave]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (
    decision == null
    || decision.trim().isEmpty()
    || clave == null
    || clave.trim().isEmpty()
) {
    return "";
}

String prefijo = clave.trim() + "=";

String[] partes = decision.split("\\|");

for (String parte : partes) {

    if (parte == null) {
        continue;
    }

    String candidata = parte.trim();

    /*
     * En las decisiones híbridas, el primer campo
     * interno aparece como:
     *
     * detalle=fuente=GA
     *
     * Se elimina "detalle=" para poder recuperar
     * correctamente el campo "fuente".
     */
    if (candidata.startsWith("detalle=")) {
        candidata = candidata.substring(
            "detalle=".length()
        );
    }

    if (candidata.startsWith(prefijo)) {
        return candidata.substring(
            prefijo.length()
        ).trim();
    }
}

return "";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787598720614</Id>
					<Name><![CDATA[numeroDecisionSelector]]></Name>
					<X>-810</X><Y>2950</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[decision]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[clave]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String valor = campoDecisionSelector(
    decision,
    clave
);

if (
    valor == null
    || valor.trim().isEmpty()
) {
    return Double.NaN;
}

try {

    return Double.parseDouble(
        valor.trim()
    );

} catch (Exception ex) {

    return Double.NaN;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[long]]></ReturnType>
					<Id>1787598754878</Id>
					<Name><![CDATA[longDecisionSelector]]></Name>
					<X>-810</X><Y>2980</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[decision]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[clave]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String valor = campoDecisionSelector(
    decision,
    clave
);

if (
    valor == null
    || valor.trim().isEmpty()
) {
    return -1L;
}

try {

    return Long.parseLong(
        valor.trim()
    );

} catch (Exception ex) {

    return -1L;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787598783253</Id>
					<Name><![CDATA[reiniciarPanelSelectorVisual]]></Name>
					<X>-810</X><Y>3010</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[modoSolicitado]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[uiSelectorModoSolicitado =
    modoSolicitado == null
    ||
    modoSolicitado.trim().isEmpty()
    ? "—"
    : modoSolicitado
        .trim()
        .toUpperCase();


uiSelectorFuente =
    "—";


uiSelectorMotivo =
    "PLANIFICANDO";


uiSelectorEstado =
    "PLANIFICANDO";


uiSelectorAviso =
    "";


uiSelectorCostoGreedy =
    Double.NaN;


uiSelectorCostoGA =
    Double.NaN;


uiSelectorCostoRL =
    Double.NaN;


uiSelectorCostoElegido =
    Double.NaN;


uiSelectorMejoraGreedyPct =
    Double.NaN;


uiSelectorTiempoMs =
    Double.NaN;


uiSelectorSeedGA =
    -1L;


/*
 * La bandera se reutiliza para indicar que el panel
 * debe mostrar las cuatro líneas especializadas.
 */
uiSelectorPoliticaOperacional =
    "RL".equals(
        uiSelectorModoSolicitado
    )
    ||
    "HIBRIDO".equals(
        uiSelectorModoSolicitado
    );


if (
    "RL".equals(
        uiSelectorModoSolicitado
    )
) {

    uiSelectorLineaPrincipal =
        "Costo estimado —";


    uiSelectorLineaSecundaria =
        "Restricciones horarias —";


    uiSelectorLineaDetalle =
        "Generando plan con RL";


    uiSelectorLineaResultado =
        "Esperando resultado";


} else if (
    "HIBRIDO".equals(
        uiSelectorModoSolicitado
    )
) {

    uiSelectorLineaPrincipal =
        "Plan inicial RL —";


    uiSelectorLineaSecundaria =
        "Mejora con GA —";


    uiSelectorLineaDetalle =
        "Comparando alternativas";


    uiSelectorLineaResultado =
        "Esperando resultado";


} else {

    uiSelectorLineaPrincipal =
        "Costo del modo —";


    uiSelectorLineaSecundaria =
        "Comparación no aplicable";


    uiSelectorLineaDetalle =
        "Planificación directa";


    uiSelectorLineaResultado =
        "Esperando resultado";
}


actualizarColoresSelectorVisual();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787598804926</Id>
					<Name><![CDATA[registrarDecisionSelectorVisual]]></Name>
					<X>-810</X><Y>3040</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[decision]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (
    decision == null
    ||
    decision.trim().isEmpty()
) {

    marcarSelectorErrorVisual(
        "La decisión del selector está vacía."
    );

    return;
}


// =====================================================
// DATOS GENERALES
// =====================================================

String modo =
    campoDecisionSelector(
        decision,
        "modo"
    );


String algoritmo =
    campoDecisionSelector(
        decision,
        "algoritmo"
    );


String fuente =
    campoDecisionSelector(
        decision,
        "fuente"
    );


String arquitectura =
    campoDecisionSelector(
        decision,
        "arquitectura"
    );


String motivo =
    campoDecisionSelector(
        decision,
        "motivo"
    );


String version =
    campoDecisionSelector(
        decision,
        "version"
    );



boolean esRLPuro =
    "RL_PURO_POLITICA_UNICA".equalsIgnoreCase(
        arquitectura
    )
    ||
    (
        version != null
        &&
        version.startsWith(
            "pedemonte-rl-single-policy"
        )
    );


boolean esHibridoRLGA =
    "RL_GA_SEEDED".equalsIgnoreCase(
        arquitectura
    );


uiSelectorPoliticaOperacional =
    esRLPuro
    ||
    esHibridoRLGA;


if (!modo.isEmpty()) {

    uiSelectorModoSolicitado =
        modo.toUpperCase();
}


// =====================================================
// COSTO Y TIEMPO GENERALES
// =====================================================

uiSelectorCostoElegido =
    numeroDecisionSelector(
        decision,
        "costo"
    );


uiSelectorTiempoMs =
    numeroDecisionSelector(
        decision,
        "tiempo_selector_ms"
    );


if (
    Double.isNaN(
        uiSelectorTiempoMs
    )
) {

    uiSelectorTiempoMs =
        numeroDecisionSelector(
            decision,
            "tiempo_plan_ms"
        );
}


uiSelectorSeedGA =
    longDecisionSelector(
        decision,
        "seed_ga"
    );


uiSelectorCostoGreedy =
    numeroDecisionSelector(
        decision,
        "costo_greedy"
    );


uiSelectorCostoGA =
    numeroDecisionSelector(
        decision,
        "costo_ga"
    );


uiSelectorCostoRL =
    numeroDecisionSelector(
        decision,
        "costo_rl"
    );


uiSelectorMejoraGreedyPct =
    Double.NaN;


uiSelectorAviso =
    "";


// =====================================================
// MODO RL PURO
// =====================================================

if (esRLPuro) {

    // El protocolo conserva POLITICA_UNICA para auditoría,
    // pero el dashboard muestra el nombre comprensible del método.
    uiSelectorFuente =
        "RL";


    uiSelectorMotivo =
        "RL_PURO";


    uiSelectorCostoRL =
        uiSelectorCostoElegido;


    uiSelectorCostoGA =
        Double.NaN;


    uiSelectorCostoGreedy =
        Double.NaN;


    String mascaraTemporal =
        campoDecisionSelector(
            decision,
            "mascara_temporal"
        );


    uiSelectorLineaPrincipal =
        "Costo estimado | "
        + formatoCostoSelector(
            uiSelectorCostoRL
        );


    uiSelectorLineaSecundaria =
        "Restricciones horarias | "
        +
        (
            "DURA".equalsIgnoreCase(
                mascaraTemporal
            )
            ? "ACTIVAS"
            : (
                mascaraTemporal.isEmpty()
                ? "—"
                : mascaraTemporal.toUpperCase()
            )
        );


    uiSelectorLineaDetalle =
        "Plan generado por RL";


    long tardiosElegido =
        longDecisionSelector(
            decision,
            "tardios"
        );


    double tardanzaElegida =
        numeroDecisionSelector(
            decision,
            "tardanza"
        );


    String tardiosVisible =
        tardiosElegido < 0
        ? "—"
        : String.valueOf(
            tardiosElegido
        );


    String tardanzaVisible =
        Double.isNaN(
            tardanzaElegida
        )
        ||
        Double.isInfinite(
            tardanzaElegida
        )
        ? "—"
        : String.format(
            java.util.Locale.US,
            "%.2f",
            tardanzaElegida
        );


    if (
        tardiosElegido == 0
        &&
        !Double.isNaN(
            tardanzaElegida
        )
        &&
        !Double.isInfinite(
            tardanzaElegida
        )
        &&
        tardanzaElegida <= 0.000001
    ) {

        uiSelectorLineaResultado =
            "Resultado | Sin retrasos";

    } else {

        uiSelectorLineaResultado =
            "Pedidos tardíos: "
            + tardiosVisible
            + " | Retraso: "
            + tardanzaVisible
            + " min";
    }


    String erroresRL =
        campoDecisionSelector(
            decision,
            "errores"
        );


    if (
        !erroresRL.isEmpty()
        &&
        !"NINGUNO".equalsIgnoreCase(
            erroresRL
        )
    ) {

        uiSelectorAviso =
            "El plan RL finalizó con una advertencia.";
    }


// =====================================================
// MODO HÍBRIDO RL → GA
// =====================================================

} else if (esHibridoRLGA) {

    String fuenteRL =
        campoDecisionSelector(
            decision,
            "fuente_rl"
        );


    String resultado =
        campoDecisionSelector(
            decision,
            "resultado"
        );



    String costoRefinadoTexto =
        campoDecisionSelector(
            decision,
            "costo_refinado_ga"
        );


    double costoSemilla =
        numeroDecisionSelector(
            decision,
            "costo_semilla_rl"
        );


    double costoRefinado =
        numeroDecisionSelector(
            decision,
            "costo_refinado_ga"
        );


    double mejoraPct =
        numeroDecisionSelector(
            decision,
            "mejora_pct"
        );


    long generacionesGA =
        longDecisionSelector(
            decision,
            "generaciones_ga"
        );


    uiSelectorCostoRL =
        costoSemilla;


    uiSelectorCostoGA =
        costoRefinado;


    uiSelectorCostoGreedy =
        Double.NaN;


    uiSelectorMejoraGreedyPct =
        mejoraPct;


    uiSelectorMotivo =
        motivo.isEmpty()
        ? "HIBRIDO_RL_GA"
        : motivo.toUpperCase();


    // El resultado sigue auditando si GA refinó o se conservó RL,
    // pero el modo visible para el usuario es HÍBRIDO.
    uiSelectorFuente =
        "HÍBRIDO";


    uiSelectorLineaPrincipal =
        "Plan inicial RL | "
        + formatoCostoSelector(
            costoSemilla
        );


    boolean refinamientoDisponible =
        !costoRefinadoTexto.isEmpty()
        &&
        !"NO_DISPONIBLE".equalsIgnoreCase(
            costoRefinadoTexto
        )
        &&
        !Double.isNaN(
            costoRefinado
        )
        &&
        !Double.isInfinite(
            costoRefinado
        );


    uiSelectorLineaSecundaria =
        refinamientoDisponible
        ? (
            "Plan evaluado por GA | "
            + formatoCostoSelector(
                costoRefinado
            )
        )
        : "Mejora con GA | No disponible";


    if (
        !Double.isNaN(
            mejoraPct
        )
        &&
        !Double.isInfinite(
            mejoraPct
        )
        &&
        mejoraPct > 0.005
    ) {

        uiSelectorLineaDetalle =
            String.format(
                java.util.Locale.US,
                "Mejora del costo | %.2f %%",
                mejoraPct
            );

    } else if (
        "GA_NO_EJECUTABLE".equalsIgnoreCase(
            motivo
        )
    ) {

        uiSelectorLineaDetalle =
            "GA no pudo evaluar una mejora";

    } else {

        uiSelectorLineaDetalle =
            "GA no encontró una mejora";
    }


    if (
        "REFINADO_GA".equalsIgnoreCase(
            resultado
        )
    ) {

        uiSelectorLineaResultado =
            "Resultado | GA mejoró el plan RL";

    } else {

        uiSelectorLineaResultado =
            "Resultado | Se conserva el plan RL";
    }


    String errorGA =
        campoDecisionSelector(
            decision,
            "error_ga"
        );


    if (
        !errorGA.isEmpty()
        &&
        !"NINGUNO".equalsIgnoreCase(
            errorGA
        )
    ) {

        uiSelectorAviso =
            "La mejora con GA no pudo completarse.";
    }


// =====================================================
// MODOS DIRECTOS
// =====================================================

} else {

    uiSelectorFuente =
        !fuente.isEmpty()
        ? fuente.toUpperCase()
        : (
            algoritmo.isEmpty()
            ? "—"
            : algoritmo.toUpperCase()
        );


    uiSelectorMotivo =
        motivo.isEmpty()
        ? "MODO_DIRECTO"
        : motivo.toUpperCase();


    uiSelectorLineaPrincipal =
        "Costo estimado | "
        + formatoCostoSelector(
            uiSelectorCostoElegido
        );


    uiSelectorLineaSecundaria =
        "Método aplicado | "
        + uiSelectorFuente;


    uiSelectorLineaDetalle =
        "Plan generado directamente";


    uiSelectorLineaResultado =
        "Resultado | Plan disponible";


    if (
        "GREEDY".equals(
            uiSelectorFuente
        )
        &&
        Double.isNaN(
            uiSelectorCostoGreedy
        )
    ) {

        uiSelectorCostoGreedy =
            uiSelectorCostoElegido;
    }


    if (
        "GA".equals(
            uiSelectorFuente
        )
        &&
        Double.isNaN(
            uiSelectorCostoGA
        )
    ) {

        uiSelectorCostoGA =
            uiSelectorCostoElegido;
    }


    if (
        "RL".equals(
            uiSelectorFuente
        )
        &&
        Double.isNaN(
            uiSelectorCostoRL
        )
    ) {

        uiSelectorCostoRL =
            uiSelectorCostoElegido;
    }


    String errorGA =
        campoDecisionSelector(
            decision,
            "errores_ga"
        );


    String errorRL =
        campoDecisionSelector(
            decision,
            "errores_rl"
        );


    boolean avisoGA =
        !errorGA.isEmpty()
        &&
        !"NINGUNO".equalsIgnoreCase(
            errorGA
        );


    boolean avisoRL =
        !errorRL.isEmpty()
        &&
        !"NINGUNO".equalsIgnoreCase(
            errorRL
        );


    if (avisoGA) {

        uiSelectorAviso =
            "El método GA finalizó con una advertencia.";
    }


    if (avisoRL) {

        if (
            !uiSelectorAviso.isEmpty()
        ) {

            uiSelectorAviso +=
                " | ";
        }


        uiSelectorAviso +=
            "El método RL finalizó con una advertencia.";
    }
}


// =====================================================
// ESTADO FINAL
// =====================================================

uiSelectorEstado =
    uiSelectorAviso.isEmpty()
    ? "PLAN LISTO"
    : "PLAN LISTO CON AVISO";


actualizarColoresSelectorVisual();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787598824903</Id>
					<Name><![CDATA[marcarSelectorEnEjecucionVisual]]></Name>
					<X>-810</X><Y>3070</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[uiSelectorEstado =
    "EN EJECUCIÓN";


actualizarColoresSelectorVisual();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787598837550</Id>
					<Name><![CDATA[marcarSelectorFinalizadoVisual]]></Name>
					<X>-810</X><Y>3100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[uiSelectorEstado =
    "FINALIZADO";


actualizarColoresSelectorVisual();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787598847063</Id>
					<Name><![CDATA[marcarSelectorErrorVisual]]></Name>
					<X>-810</X><Y>3130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[mensaje]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[uiSelectorEstado = "ERROR";

uiSelectorAviso =
    mensaje == null
    || mensaje.trim().isEmpty()
    ? "Error no especificado"
    : mensaje.trim();

uiSelectorMotivo =
    "PLANIFICACIÓN INTERRUMPIDA";

actualizarColoresSelectorVisual();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1787598867562</Id>
					<Name><![CDATA[formatoCostoSelector]]></Name>
					<X>-810</X><Y>3160</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[valor]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (
    Double.isNaN(valor)
    || Double.isInfinite(valor)
) {
    return "—";
}

return String.format(
    java.util.Locale.US,
    "%.2f",
    valor
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1787598885734</Id>
					<Name><![CDATA[textoMejoraSelector]]></Name>
					<X>-810</X><Y>3190</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    Double.isNaN(uiSelectorMejoraGreedyPct)
    || Double.isInfinite(
        uiSelectorMejoraGreedyPct
    )
) {
    return "Comparación no disponible";
}

if (
    Math.abs(uiSelectorMejoraGreedyPct)
    < 0.005
) {
    return "Sin diferencia frente a Greedy";
}

if (uiSelectorMejoraGreedyPct > 0.0) {

    return String.format(
        java.util.Locale.US,
        "Ahorro estimado: %.2f %% vs Greedy",
        uiSelectorMejoraGreedyPct
    );
}

return String.format(
    java.util.Locale.US,
    "Costo %.2f %% mayor que Greedy",
    Math.abs(uiSelectorMejoraGreedyPct)
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1787598898527</Id>
					<Name><![CDATA[textoTiempoSelector]]></Name>
					<X>-810</X><Y>3220</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    Double.isNaN(
        uiSelectorTiempoMs
    )
    ||
    Double.isInfinite(
        uiSelectorTiempoMs
    )
) {

    return "Cálculo: —";
}


return String.format(
    java.util.Locale.US,
    "Cálculo: %.2f ms",
    uiSelectorTiempoMs
);
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1787598911264</Id>
					<Name><![CDATA[textoMotivoSelector]]></Name>
					<X>-810</X><Y>3250</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    uiSelectorMotivo == null
    || uiSelectorMotivo.trim().isEmpty()
) {
    return "Sin motivo disponible";
}

if (
    "GA_MENOR_COSTO".equals(
        uiSelectorMotivo
    )
) {
    return "GA elegido por menor costo";
}

if (
    "GREEDY_MENOR_O_IGUAL".equals(
        uiSelectorMotivo
    )
) {
    return "Greedy elegido por mínimo o empate";
}

if (
    "RL_MENOR_COSTO".equals(
        uiSelectorMotivo
    )
) {
    return "RL elegido por menor costo";
}

if (
    "MODO_DIRECTO".equals(
        uiSelectorMotivo
    )
) {
    return "Planificación en modo directo";
}

return uiSelectorMotivo.replace(
    '_',
    ' '
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.awt.Color]]></ReturnType>
					<Id>1787598925703</Id>
					<Name><![CDATA[colorFuenteSelector]]></Name>
					<X>-810</X><Y>3280</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    "GREEDY".equals(
        uiSelectorFuente
    )
) {

    return new java.awt.Color(
        14,
        165,
        233
    );
}


if (
    "GA".equals(
        uiSelectorFuente
    )
) {

    return new java.awt.Color(
        99,
        102,
        241
    );
}


if (
    "RL".equals(
        uiSelectorFuente
    )
) {

    return new java.awt.Color(
        16,
        185,
        129
    );
}


if (
    "HÍBRIDO".equals(
        uiSelectorFuente
    )
) {

    return new java.awt.Color(
        79,
        70,
        229
    );
}


if (
    "RANDOM".equals(
        uiSelectorFuente
    )
) {

    return new java.awt.Color(
        245,
        158,
        11
    );
}


return new java.awt.Color(
    100,
    116,
    139
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.awt.Color]]></ReturnType>
					<Id>1787598952895</Id>
					<Name><![CDATA[colorEstadoSelector]]></Name>
					<X>-810</X><Y>3310</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if ("FINALIZADO".equals(uiSelectorEstado)) {
    return new java.awt.Color(
        22,
        163,
        74
    );
}

if ("EN EJECUCIÓN".equals(uiSelectorEstado)) {
    return new java.awt.Color(
        124,
        58,
        237
    );
}

if ("PLANIFICANDO".equals(uiSelectorEstado)) {
    return new java.awt.Color(
        245,
        158,
        11
    );
}

if (
    "PLAN LISTO".equals(uiSelectorEstado)
) {
    return new java.awt.Color(
        37,
        99,
        235
    );
}

if (
    "PLAN LISTO CON AVISO".equals(
        uiSelectorEstado
    )
) {
    return new java.awt.Color(
        234,
        88,
        12
    );
}

if ("ERROR".equals(uiSelectorEstado)) {
    return new java.awt.Color(
        220,
        38,
        38
    );
}

return new java.awt.Color(
    100,
    116,
    139
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787602030699</Id>
					<Name><![CDATA[actualizarColoresSelectorVisual]]></Name>
					<X>-810</X><Y>3340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[rectFuenteSelectorVisual.setFillColor(
    colorFuenteSelector()
);


rectEstadoSelectorVisual.setFillColor(
    colorEstadoSelector()
);


java.awt.Color colorNormal =
    new java.awt.Color(
        51,
        65,
        85
    );


java.awt.Color colorSecundario =
    new java.awt.Color(
        100,
        116,
        139
    );


java.awt.Color colorSeleccionado =
    new java.awt.Color(
        22,
        163,
        74
    );


java.awt.Color colorAviso =
    new java.awt.Color(
        234,
        88,
        12
    );


boolean esRLPuro =
    "RL".equals(
        uiSelectorModoSolicitado
    );


boolean esHibrido =
    "HIBRIDO".equals(
        uiSelectorModoSolicitado
    );


if (
    uiSelectorPoliticaOperacional
    &&
    esRLPuro
) {

    txtCostosSelectorVisual1.setColor(
        colorSeleccionado
    );


    txtCostosSelectorVisual2.setColor(
        colorSecundario
    );


    txtMejoraSelectorVisual.setColor(
        colorSecundario
    );


    txtMotivoSelectorVisual.setColor(
        colorSeleccionado
    );


} else if (
    uiSelectorPoliticaOperacional
    &&
    esHibrido
) {

    boolean resultadoGA =
        "GA".equals(
            uiSelectorFuente
        );


    txtCostosSelectorVisual1.setColor(
        resultadoGA
        ? colorNormal
        : colorSeleccionado
    );


    txtCostosSelectorVisual2.setColor(
        resultadoGA
        ? colorSeleccionado
        : colorNormal
    );


    if (
        uiSelectorAviso != null
        &&
        !uiSelectorAviso.isEmpty()
    ) {

        txtMejoraSelectorVisual.setColor(
            colorAviso
        );

    } else if (
        !Double.isNaN(
            uiSelectorMejoraGreedyPct
        )
        &&
        !Double.isInfinite(
            uiSelectorMejoraGreedyPct
        )
        &&
        uiSelectorMejoraGreedyPct > 0.005
    ) {

        txtMejoraSelectorVisual.setColor(
            colorSeleccionado
        );

    } else {

        txtMejoraSelectorVisual.setColor(
            colorSecundario
        );
    }


    txtMotivoSelectorVisual.setColor(
        colorSeleccionado
    );


} else {

    txtCostosSelectorVisual1.setColor(
        colorNormal
    );


    txtCostosSelectorVisual2.setColor(
        colorNormal
    );


    java.awt.Color colorMejora;


    if (
        Double.isNaN(
            uiSelectorMejoraGreedyPct
        )
        ||
        Double.isInfinite(
            uiSelectorMejoraGreedyPct
        )
    ) {

        colorMejora =
            colorSecundario;

    } else if (
        uiSelectorMejoraGreedyPct
        > 0.005
    ) {

        colorMejora =
            colorSeleccionado;

    } else if (
        uiSelectorMejoraGreedyPct
        < -0.005
    ) {

        colorMejora =
            new java.awt.Color(
                220,
                38,
                38
            );

    } else {

        colorMejora =
            colorSecundario;
    }


    txtMejoraSelectorVisual.setColor(
        colorMejora
    );


    txtMotivoSelectorVisual.setColor(
        new java.awt.Color(
            71,
            85,
            105
        )
    );
}


java.awt.Color colorPie;


if (
    uiSelectorAviso != null
    &&
    !uiSelectorAviso.isEmpty()
) {

    colorPie =
        new java.awt.Color(
            194,
            65,
            12
        );

} else {

    colorPie =
        colorSecundario;
}


txtPieSelectorVisual.setColor(
    colorPie
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1787861058276</Id>
					<Name><![CDATA[formatearHoraFormulario]]></Name>
					<X>-810</X><Y>3370</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[minutos]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if (
    minutos < 0
    ||
    minutos >= 24 * 60
) {

    throw new IllegalArgumentException(
        "Minutos fuera de rango: "
        + minutos
    );
}


return String.format(
    "%02d:%02d",
    minutos / 60,
    minutos % 60
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1787861083489</Id>
					<Name><![CDATA[parsearHoraFormulario]]></Name>
					<X>-810</X><Y>3400</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[valor]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String texto =
    valor == null
    ? ""
    : valor.trim();


if (texto.isEmpty()) {

    throw new IllegalArgumentException(
        "La hora no puede quedar vacía. "
        + "Use HH:mm, por ejemplo 07:30."
    );
}


// Conserva compatibilidad con valores antiguos en minutos.

if (texto.matches("\\d+")) {

    int minutos =
        Integer.parseInt(texto);


    if (
        minutos < 0
        ||
        minutos >= 24 * 60
    ) {

        throw new IllegalArgumentException(
            "Hora fuera de rango: "
            + texto
        );
    }


    return minutos;
}


if (
    !texto.matches(
        "(?:[01]?\\d|2[0-3]):[0-5]\\d"
    )
) {

    throw new IllegalArgumentException(
        "Formato horario inválido: "
        + texto
        + ". Use HH:mm, por ejemplo 07:30."
    );
}


String[] partes =
    texto.split(":");


int hora =
    Integer.parseInt(
        partes[0]
    );

int minuto =
    Integer.parseInt(
        partes[1]
    );


return hora * 60 + minuto;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1787861235713</Id>
					<Name><![CDATA[decodificarCampoImportacionExcel]]></Name>
					<X>-810</X><Y>3430</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[valor]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[try {

    return java.net.URLDecoder.decode(
        valor == null ? "" : valor,
        "UTF-8"
    );

} catch (Exception ex) {

    throw new RuntimeException(
        "No fue posible decodificar "
        + "un campo importado.",
        ex
    );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.io.File]]></ReturnType>
					<Id>1787861255017</Id>
					<Name><![CDATA[seleccionarArchivoPedidosExcel]]></Name>
					<X>-810</X><Y>3460</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[String ruta =
    rutaArchivoExcelSubido == null
    ? ""
    : rutaArchivoExcelSubido.trim();


if (ruta.isEmpty()) {

    mensajeFormulario =
        "Todavía no se seleccionó "
        + "ninguna planilla Excel.";

    return null;
}


try {

    java.io.File archivo =
        new java.io.File(
            ruta
        ).getCanonicalFile();


    traceln(
        "ARCHIVO EXCEL RESUELTO"
        + " | valor="
        + ruta
        + " | ruta="
        + archivo.getAbsolutePath()
        + " | existe="
        + archivo.isFile()
    );


    if (!archivo.isFile()) {

        throw new IllegalArgumentException(
            "El archivo subido no está disponible: "
            + archivo.getAbsolutePath()
        );
    }


    return archivo;


} catch (Exception ex) {

    throw new RuntimeException(
        "No fue posible resolver "
        + "la planilla Excel: "
        + ex.getMessage(),
        ex
    );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1787861273624</Id>
					<Name><![CDATA[importarPedidosExcel]]></Name>
					<X>-810</X><Y>3490</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    ejecucionEnCurso
    ||
    pypelineSolicitudEnCurso
) {

    mensajeFormulario =
        "No se puede importar durante "
        + "una planificación o ejecución.";

    return false;
}


if (instanciaInterfazActual != null) {

    mensajeFormulario =
        "Limpie la instancia preparada "
        + "antes de importar otra planilla.";

    return false;
}


java.io.File archivo =
    seleccionarArchivoPedidosExcel();


if (archivo == null) {

    mensajeFormulario =
        "Importación cancelada.";

    return false;
}


java.util.ArrayList<PedidoInput> respaldo =
    new java.util.ArrayList<PedidoInput>(
        pedidosFormulario
    );


int contadorRespaldo =
    contadorPedidosFormulario;


try {

    String raizPython =
        resolverRaizPythonPypeline();


    String raizLiteral =
        pyCommunicator.toJson(
            raizPython
        );


    String archivoLiteral =
        pyCommunicator.toJson(
            archivo.getCanonicalPath()
        );


    String turnoLiteral =
        pyCommunicator.toJson(
            obtenerTurnoFormulario()
                .toString()
        );


    pyCommunicator.run(
        "import sys",
        "import importlib",
        "pedemonte_root = "
            + raizLiteral,
        (
            "sys.path.insert(0, pedemonte_root) "
            + "if pedemonte_root not in sys.path "
            + "else None"
        ),
        (
            "from planner.integration "
		    + "import order_import_bridge "
		    + "as pedemonte_excel_bridge"
        ),
        (
            "pedemonte_excel_bridge = "
            + "importlib.reload("
            + "pedemonte_excel_bridge)"
        )
    );


    String comando =
        "pedemonte_excel_bridge."
        + "importar_pedidos_excel_pypeline("
        + archivoLiteral
        + ", "
        + turnoLiteral
        + ", "
        + CAPACIDAD_CAMION
        + ", "
        + MAX_PEDIDOS_RL
        + ")";


    String respuesta =
        pyCommunicator.runResults(
            String.class,
            comando
        );


    if (
        respuesta == null
        ||
        respuesta.trim().isEmpty()
    ) {

        throw new IllegalStateException(
            "Python devolvió una respuesta vacía."
        );
    }


    String[] lineas =
        respuesta.split(
            "\\r?\\n"
        );


    String[] cabecera =
        lineas[0].split(
            "\\|",
            -1
        );


    if (
        cabecera.length < 3
        ||
        !"PEDXLSX1".equals(
            cabecera[0]
        )
    ) {

        throw new IllegalStateException(
            "Protocolo de importación "
            + "no reconocido."
        );
    }


    if (
        "ERROR".equals(
            cabecera[1]
        )
    ) {

        StringBuilder errores =
            new StringBuilder();


        for (
            int i = 1;
            i < lineas.length;
            i++
        ) {

            String[] partes =
                lineas[i].split(
                    "\\|",
                    -1
                );


            if (
                partes.length >= 4
                &&
                "E".equals(partes[0])
            ) {

                if (errores.length() > 0) {

                    errores.append(" | ");
                }


                errores
                    .append("Fila ")
                    .append(partes[1])
                    .append(" - ")
                    .append(
                        decodificarCampoImportacionExcel(
                            partes[2]
                        )
                    )
                    .append(": ")
                    .append(
                        decodificarCampoImportacionExcel(
                            partes[3]
                        )
                    );
            }
        }


        throw new IllegalArgumentException(
            "Planilla inválida: "
            + errores.toString()
        );
    }


    if (!"OK".equals(cabecera[1])) {

        throw new IllegalStateException(
            "Estado de importación desconocido: "
            + cabecera[1]
        );
    }


    pedidosFormulario.clear();

    contadorPedidosFormulario = 1;


    int originalesImportados = 0;


    for (
        int i = 1;
        i < lineas.length;
        i++
    ) {

        String[] partes =
            lineas[i].split(
                "\\|",
                -1
            );


        if (
            partes.length < 14
            ||
            !"P".equals(partes[0])
        ) {

            throw new IllegalStateException(
                "Registro de pedido inválido "
                + "en la línea "
                + (i + 1)
                + "."
            );
        }


        String originalId =
            decodificarCampoImportacionExcel(
                partes[2]
            );


        pedidoIdFormulario =
            originalId;

        clienteFormulario =
            decodificarCampoImportacionExcel(
                partes[3]
            );

        direccionFormulario =
            decodificarCampoImportacionExcel(
                partes[4]
            );

        barrioFormulario =
            decodificarCampoImportacionExcel(
                partes[5]
            );

        unidadesFormulario =
            partes[6];

        latitudFormulario =
            partes[7];

        longitudFormulario =
            partes[8];

        requiereVolcadorFormulario =
            "1".equals(
                partes[9]
            );

        tieneVentanaFormulario =
            "1".equals(
                partes[10]
            );

        horaDesdeFormulario =
            formatearHoraFormulario(
                Integer.parseInt(
                    partes[11]
                )
            );

        horaHastaFormulario =
            formatearHoraFormulario(
                Integer.parseInt(
                    partes[12]
                )
            );


        String observacionesImportadas =
            decodificarCampoImportacionExcel(
                partes[13]
            );


        boolean agregado =
            agregarPedidoFormulario();


        if (!agregado) {

            throw new IllegalStateException(
                mensajeFormulario
            );
        }


        if (
            observacionesImportadas != null
            &&
            !observacionesImportadas
                .trim()
                .isEmpty()
        ) {

            for (
                PedidoInput pedido
                : pedidosFormulario
            ) {

                if (
                    pedido != null
                    &&
                    originalId.equals(
                        pedido.pedidoOriginalId
                    )
                ) {

                    pedido.observaciones =
                        observacionesImportadas.trim();
                }
            }
        }


        originalesImportados++;
    }


    pedidoIdFormulario = "";

    clienteFormulario = "";

    direccionFormulario = "";

    barrioFormulario = "";

    unidadesFormulario = "1";

    latitudFormulario = "";

    longitudFormulario = "";

    requiereVolcadorFormulario = false;

    tieneVentanaFormulario = false;


    actualizarHorarioFormulario();


    editPedidoIdFormulario.setText(
        pedidoIdFormulario
    );

    editClienteFormulario.setText(
        clienteFormulario
    );

    editDireccionFormulario.setText(
        direccionFormulario
    );

    editBarrioFormulario.setText(
        barrioFormulario
    );

    editUnidadesFormulario.setText(
        unidadesFormulario
    );

    editLatitudFormulario.setText(
        latitudFormulario
    );

    editLongitudFormulario.setText(
        longitudFormulario
    );

    checkRequiereVolcadorFormulario
        .setSelected(false);

    checkTieneVentanaFormulario
        .setSelected(false);

    editHoraDesdeFormulario.setText(
        horaDesdeFormulario
    );

    editHoraHastaFormulario.setText(
        horaHastaFormulario
    );


    mensajeFormulario =
        "Importación completada: "
        + originalesImportados
        + " pedido(s) original(es), "
        + pedidosFormulario.size()
        + " tarea(s) después del split.";


    traceln(
        mensajeFormulario
    );


    return true;


} catch (Exception ex) {

    pedidosFormulario.clear();

    pedidosFormulario.addAll(
        respaldo
    );

    contadorPedidosFormulario =
        contadorRespaldo;


    mensajeFormulario =
        "Error al importar Excel: "
        + ex.getMessage();


    traceln(
        mensajeFormulario
    );


    return false;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787862666671</Id>
					<Name><![CDATA[intentarFinalizarEjecucion]]></Name>
					<X>-810</X><Y>3520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    !ejecucionEnCurso
    ||
    ejecucionFinalizada
) {

    return;
}


// Los camiones todavía siguen operando.

if (
    camionesFinalizados
    < CANTIDAD_CAMIONES
) {

    return;
}


// Desde este momento no deben llegar
// nuevos proveedores.

eventoLlegadaProveedor.reset();


// Si había proveedores pendientes y ahora
// existen empleados libres, se inicia su atención.

intentarAtenderProveedoresPendientes();


// La ejecución no termina mientras exista
// algún proveedor esperando o siendo atendido.

if (
    !proveedoresPendientes.isEmpty()
    ||
    !proveedoresEnAtencion.isEmpty()
) {

    mensajeInterfazPlanificacion =
        "Camiones finalizados."
        + "\nEsperando cierre de proveedores."
        + "\nPendientes: "
        + proveedoresPendientes.size()
        + " | En atención: "
        + proveedoresEnAtencion.size();


    traceln(
        "CIERRE DIFERIDO"
        + " | camiones_finalizados="
        + camionesFinalizados
        + "/"
        + CANTIDAD_CAMIONES
        + " | proveedores_pendientes="
        + proveedoresPendientes.size()
        + " | proveedores_en_atencion="
        + proveedoresEnAtencion.size()
    );


    reprogramarFinProveedor();

    return;
}


// =====================================================
// CIERRE DEFINITIVO
// =====================================================

ejecucionEnCurso =
    false;


ejecucionFinalizada =
    true;


// En este punto las listas deberían estar vacías.
// La función conserva su responsabilidad de
// limpiar eventos y recursos remanentes.

cerrarSistemaProveedores();


resultadoActual =
    construirResultadoTurno();


marcarSelectorFinalizadoVisual();


mensajeInterfazPlanificacion =
    "Ejecución finalizada.";


if (
    resultadoActual != null
    &&
    resultadoActual.metricasGlobales
        != null
) {

    mensajeInterfazPlanificacion =
        "Ejecución finalizada."
        + "\nEntregadas: "
        + resultadoActual
            .metricasGlobales
            .tareasEntregadas
        + "/"
        + resultadoActual
            .metricasGlobales
            .tareasPlanificadas
        + "\nCosto total: "
        + String.format(
            java.util.Locale.US,
            "%.2f",
            resultadoActual.costoTotal
        );
}


if (
    MODO_EJECUCION
        == ModoEjecucion.RL_TRAINING

    ||

    MODO_EJECUCION
        == ModoEjecucion.RL_EVALUATION
) {

    alpyneMensaje =
        "EJECUCIÓN FINALIZADA";
}


traceln("");


traceln(
    "=============================="
);


traceln(
    "=== EJECUCIÓN FINALIZADA ====="
);


traceln(
    "=============================="
);


imprimirMetricasCamiones(
    resultadoActual
);


imprimirMetricasGlobales(
    resultadoActual
);


if (
    MODO_EJECUCION
        == ModoEjecucion.SIMULACION
) {

    pauseSimulation();
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1787863599500</Id>
					<Name><![CDATA[verificarCacheVialInstanciaActual]]></Name>
					<X>-810</X><Y>3550</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[cacheVialInstanciaCompleta =
    false;


cacheVialTramosRequeridos =
    0;


cacheVialTramosFaltantes =
    0;


if (instanciaInterfazActual == null) {

    cacheVialEstadoInterfaz =
        "SIN INSTANCIA";

    return false;
}


try {

    java.util.LinkedHashMap<
        String,
        double[]
    > coordenadasUnicas =
        new java.util.LinkedHashMap<
            String,
            double[]
        >();


    String claveCorralon =
        String.format(
            java.util.Locale.US,
            "%.6f,%.6f",
            instanciaInterfazActual
                .latCorralon,
            instanciaInterfazActual
                .lonCorralon
        );


    coordenadasUnicas.put(
        claveCorralon,
        new double[] {
            instanciaInterfazActual
                .latCorralon,

            instanciaInterfazActual
                .lonCorralon
        }
    );


    for (
        PedidoInput pedido
        : instanciaInterfazActual.pedidos
    ) {

        if (pedido == null) {

            continue;
        }


        String clavePedido =
            String.format(
                java.util.Locale.US,
                "%.6f,%.6f",
                pedido.latitud,
                pedido.longitud
            );


        if (
            !coordenadasUnicas
                .containsKey(
                    clavePedido
                )
        ) {

            coordenadasUnicas.put(
                clavePedido,
                new double[] {
                    pedido.latitud,
                    pedido.longitud
                }
            );
        }
    }


    java.util.ArrayList<double[]>
        puntos =
            new java.util.ArrayList<double[]>(
                coordenadasUnicas.values()
            );


    int cantidadPuntos =
        puntos.size();


    cacheVialTramosRequeridos =
        cantidadPuntos
        * (cantidadPuntos - 1);


    String raizPython =
        resolverRaizPythonPypeline();


    java.io.File archivoCache =
        new java.io.File(
            raizPython,
            "data/routing/cache_vial.csv"
        ).getCanonicalFile();


    if (!archivoCache.isFile()) {

        cacheVialTramosFaltantes =
            cacheVialTramosRequeridos;


        cacheVialEstadoInterfaz =
            "FALTAN "
            + cacheVialTramosFaltantes;


        traceln(
            "VERIFICACION CACHE VIAL"
            + " | estado="
            + cacheVialEstadoInterfaz
            + " | archivo_inexistente="
            + archivoCache.getCanonicalPath()
        );


        return false;
    }


    java.util.HashSet<String>
        clavesDisponibles =
            new java.util.HashSet<String>();


    java.util.List<String> lineas =
        java.nio.file.Files.readAllLines(
            archivoCache.toPath(),
            java.nio.charset
                .StandardCharsets
                .UTF_8
        );


    for (
        int indice = 1;
        indice < lineas.size();
        indice++
    ) {

        String linea =
            lineas.get(indice)
                .trim();


        if (linea.isEmpty()) {

            continue;
        }


        String[] columnas =
            linea.split(
                ",",
                -1
            );


        if (columnas.length != 9) {

            continue;
        }


        if (
            !"pedemonte-vial-v1".equals(
                columnas[0].trim()
            )
        ) {

            continue;
        }


        double latOrigen =
            Double.parseDouble(
                columnas[1].trim()
            );


        double lonOrigen =
            Double.parseDouble(
                columnas[2].trim()
            );


        double latDestino =
            Double.parseDouble(
                columnas[3].trim()
            );


        double lonDestino =
            Double.parseDouble(
                columnas[4].trim()
            );


        String clave =
            String.format(
                java.util.Locale.US,
                "%.6f,%.6f,%.6f,%.6f",
                latOrigen,
                lonOrigen,
                latDestino,
                lonDestino
            );


        clavesDisponibles.add(
            clave
        );
    }


    int faltantes =
        0;


    for (
        int indiceOrigen = 0;
        indiceOrigen < puntos.size();
        indiceOrigen++
    ) {

        for (
            int indiceDestino = 0;
            indiceDestino < puntos.size();
            indiceDestino++
        ) {

            if (
                indiceOrigen
                == indiceDestino
            ) {

                continue;
            }


            double[] origen =
                puntos.get(
                    indiceOrigen
                );


            double[] destino =
                puntos.get(
                    indiceDestino
                );


            String clave =
                String.format(
                    java.util.Locale.US,
                    "%.6f,%.6f,%.6f,%.6f",
                    origen[0],
                    origen[1],
                    destino[0],
                    destino[1]
                );


            if (
                !clavesDisponibles.contains(
                    clave
                )
            ) {

                faltantes++;
            }
        }
    }


    cacheVialTramosFaltantes =
        faltantes;


    cacheVialInstanciaCompleta =
        faltantes == 0;


    cacheVialEstadoInterfaz =
        cacheVialInstanciaCompleta
        ? "LISTA"
        : "FALTAN " + faltantes;


    traceln(
        "VERIFICACION CACHE VIAL"
        + " | requeridos="
        + cacheVialTramosRequeridos
        + " | faltantes="
        + cacheVialTramosFaltantes
        + " | estado="
        + cacheVialEstadoInterfaz
    );


    return cacheVialInstanciaCompleta;


} catch (Exception ex) {

    cacheVialInstanciaCompleta =
        false;


    cacheVialEstadoInterfaz =
        "ERROR";


    traceln(
        "ERROR VERIFICANDO CACHE VIAL"
        + " | "
        + ex.getClass()
            .getSimpleName()
        + ": "
        + ex.getMessage()
    );


    return false;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
