					<Name><![CDATA[horaInicioTurno]]></Name>
					<X>-810</X><Y>40</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[turno]]></Name>
						<Type><![CDATA[Turno]]></Type>
					</Parameter>
					<Body><![CDATA[switch (turno) {
    case MANANA:
        return HORA_INICIO_MANANA_MIN;

    case TARDE:
        return HORA_INICIO_TARDE_MIN;

    default:
        throw new IllegalArgumentException(
            "Turno no soportado: " + turno
        );
}]]></Body>
