					<Color>-10193781</Color>
					<Text><![CDATA[text]]></Text>
					<TextCode><![CDATA["Método: "
+ (
    modoPlanificacionPypeline == null
    ||
    modoPlanificacionPypeline.trim().isEmpty()
    ? "—"
    : (
        "HIBRIDO".equalsIgnoreCase(
            modoPlanificacionPypeline
        )
        ? "HÍBRIDO"
        : modoPlanificacionPypeline
    )
)
+ " | Rutas: "
+ (
    cacheVialEstadoInterfaz == null
    ||
    cacheVialEstadoInterfaz.trim().isEmpty()
    ? "—"
    : (
        "LISTA".equalsIgnoreCase(
            cacheVialEstadoInterfaz
        )
        ? "disponibles"
        : cacheVialEstadoInterfaz.toLowerCase()
    )
)
]]></TextCode>
