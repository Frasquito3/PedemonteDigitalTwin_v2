						<Parameter>
							<Name><![CDATA[onMessageReceived]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[webToolkitUltimoMensaje =
    type == null
    ? ""
    : type;


traceln(
    "WEBTOOLKIT JS -> ANYLOGIC"
    + " | tipo="
    + webToolkitUltimoMensaje
    + " | datos="
    + String.valueOf(
        data
    )
);


if (
    "webPing".equals(
        type
    )
) {

    String requestId =
        "";


    if (
        data
        instanceof
        java.util.Map
    ) {

        java.util.Map<?, ?> payload =
            (java.util.Map<?, ?>) data;


        Object requestIdObjeto =
            payload.get(
                "requestId"
            );


        requestId =
            requestIdObjeto == null
            ? ""
            : String.valueOf(
                requestIdObjeto
            );
    }


    java.util.Map<String, Object> respuesta =
        new java.util.LinkedHashMap<String, Object>();


    respuesta.put(
        "requestId",
        requestId
    );


    respuesta.put(
        "mensaje",
        "Conexión bidireccional funcionando"
    );


    respuesta.put(
        "tiempoModelo",
        time()
    );


    respuesta.put(
        "estado",
        "PING_OK"
    );


    webAppPedidos
        .dialog
        .getBridge()
        .emit(
            "pedemontePong",
            respuesta
        );


    webToolkitEstado =
        "PING_OK";


    traceln(
        "WEBTOOLKIT PING RESPONDIDO"
        + " | requestId="
        + requestId
    );

} else if (
    "ubicacionSeleccionada".equals(
        type
    )
) {

    procesarUbicacionSeleccionadaWeb(
        data
    );


} else if (
    "selectorUbicacionCancelado".equals(
        type
    )
) {

    procesarCancelacionSelectorUbicacionWeb(
        data
    );

} else if (
    "agregarPedidoWeb".equals(
        type
    )
) {

    procesarAgregarPedidoWeb(
        data
    );


} else if (
    "eliminarPedidoWeb".equals(
        type
    )
) {

    procesarEliminarPedidoWeb(
        data
    );


} else if (
    "limpiarPedidosWeb".equals(
        type
    )
) {

    procesarLimpiarPedidosWeb(
        data
    );


} else if (
    "importarPedidosWeb".equals(
        type
    )
) {

    procesarImportarPedidosWeb(
        data
    );

} else if (
    "finalizarGestionPedidosWeb".equals(
        type
    )
) {

    procesarFinalizarGestionPedidosWeb(
        data
    );


} else if (
    !"__ready__".equals(
        type
    )
) {

    traceln(
        "WEBTOOLKIT MENSAJE IGNORADO"
        + " | etapa=PRUEBA_CONEXION"
        + " | tipo="
        + String.valueOf(
            type
        )
    );
}]]></Code>
