		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1786581982105</Id>
			<Name><![CDATA[MatrizTiemposViaje]]></Name>
			<Folder>1786556019063</Folder>
			<Text><![CDATA[/**
 * MatrizTiemposViaje
 */	
public class MatrizTiemposViaje implements Serializable {

	public String matrizId = "";

	public java.util.ArrayList<String> nodoIds =
	    new java.util.ArrayList<String>();

	public java.util.HashMap<String, Integer> indicePorNodoId =
	    new java.util.HashMap<String, Integer>();

	public double[][] distanciaMetros =
	    new double[0][0];

	public double[][] tiempoBaseMin =
	    new double[0][0];


	public void inicializar(
	    java.util.List<String> ids
	) {

	    nodoIds.clear();
	    indicePorNodoId.clear();


	    for (String id : ids) {

	        if (
	            id == null
	            || id.trim().isEmpty()
	        ) {

	            throw new IllegalArgumentException(
	                "La matriz recibió un nodo sin ID."
	            );
	        }


	        if (indicePorNodoId.containsKey(id)) {

	            throw new IllegalArgumentException(
	                "Nodo duplicado en matriz: "
	                + id
	            );
	        }


	        int indice =
	            nodoIds.size();

	        nodoIds.add(id);

	        indicePorNodoId.put(
	            id,
	            indice
	        );
	    }


	    int n =
	        nodoIds.size();


	    distanciaMetros =
	        new double[n][n];

	    tiempoBaseMin =
	        new double[n][n];
	}


	public int indiceDe(
	    String nodoId
	) {

	    Integer indice =
	        indicePorNodoId.get(
	            nodoId
	        );


	    if (indice == null) {

	        throw new IllegalArgumentException(
	            "Nodo inexistente en matriz: "
	            + nodoId
	        );
	    }


	    return indice;
	}


	public boolean contieneNodo(
	    String nodoId
	) {

	    return indicePorNodoId
	        .containsKey(
	            nodoId
	        );
	}


	public int cantidadNodos() {
	    return nodoIds.size();
	}

}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1786582312675</Id>
			<Name><![CDATA[TravelTimeProviderMatriz]]></Name>
			<Folder>1786556019063</Folder>
			<Text><![CDATA[/**
 * TravelTimeProviderMatriz
 */	
public class TravelTimeProviderMatriz implements TravelTimeProvider {

	private MatrizTiemposViaje matriz;

	private long seedEjecucion;

	private int bucketMin;

	private int picoMananaInicioMin;

	private int picoMananaFinMin;

	private int picoTardeInicioMin;

	private int picoTardeFinMin;

	private double factorNormal;

	private double factorPicoManana;

	private double factorPicoTarde;

	private double ruidoMin;

	private double ruidoMax;


	public TravelTimeProviderMatriz(
	    MatrizTiemposViaje matriz,
	    long seedEjecucion,
	    int bucketMin,
	    int picoMananaInicioMin,
	    int picoMananaFinMin,
	    int picoTardeInicioMin,
	    int picoTardeFinMin,
	    double factorNormal,
	    double factorPicoManana,
	    double factorPicoTarde,
	    double ruidoMin,
	    double ruidoMax
	) {

	    if (matriz == null) {

	        throw new IllegalArgumentException(
	            "matriz no puede ser null."
	        );
	    }


	    if (bucketMin <= 0) {

	        throw new IllegalArgumentException(
	            "bucketMin debe ser > 0."
	        );
	    }


	    if (
	        ruidoMin <= 0.0
	        || ruidoMax < ruidoMin
	    ) {

	        throw new IllegalArgumentException(
	            "Rango de ruido inválido."
	        );
	    }


	    this.matriz =
	        matriz;

	    this.seedEjecucion =
	        seedEjecucion;

	    this.bucketMin =
	        bucketMin;

	    this.picoMananaInicioMin =
	        picoMananaInicioMin;

	    this.picoMananaFinMin =
	        picoMananaFinMin;

	    this.picoTardeInicioMin =
	        picoTardeInicioMin;

	    this.picoTardeFinMin =
	        picoTardeFinMin;

	    this.factorNormal =
	        factorNormal;

	    this.factorPicoManana =
	        factorPicoManana;

	    this.factorPicoTarde =
	        factorPicoTarde;

	    this.ruidoMin =
	        ruidoMin;

	    this.ruidoMax =
	        ruidoMax;
	}


	// =====================================================
	// Franja horaria
	// =====================================================

	private double factorBandaHoraria(
	    double minutoDia
	) {

	    if (
	        minutoDia
	            >= picoMananaInicioMin
	        &&
	        minutoDia
	            < picoMananaFinMin
	    ) {

	        return factorPicoManana;
	    }


	    if (
	        minutoDia
	            >= picoTardeInicioMin
	        &&
	        minutoDia
	            <= picoTardeFinMin
	    ) {

	        return factorPicoTarde;
	    }


	    return factorNormal;
	}


	// =====================================================
	// Ruido estable por:
	// seed + arco + bucket temporal
	// =====================================================

	private double factorRuido(
	    String origenId,
	    String destinoId,
	    double minutoDia
	) {

	    int bucket =
	        (int) Math.floor(
	            minutoDia
	            / bucketMin
	        );


	    long seedLocal =
	        seedEjecucion;


	    seedLocal =
	        31L * seedLocal
	        + origenId.hashCode();

	    seedLocal =
	        31L * seedLocal
	        + destinoId.hashCode();

	    seedLocal =
	        31L * seedLocal
	        + bucket;


	    java.util.Random rngLocal =
	        new java.util.Random(
	            seedLocal
	        );


	    double u =
	        rngLocal.nextDouble();


	    return ruidoMin
	        + u
	        * (ruidoMax - ruidoMin);
	}


	// =====================================================
	// Interface
	// =====================================================

	@Override
	public double tiempoViajeMin(
	    String origenId,
	    String destinoId,
	    double minutoDia
	) {

	    double base =
	        tiempoBaseMin(
	            origenId,
	            destinoId
	        );


	    if (base == 0.0) {
	        return 0.0;
	    }


	    double banda =
	        factorBandaHoraria(
	            minutoDia
	        );


	    double ruido =
	        factorRuido(
	            origenId,
	            destinoId,
	            minutoDia
	        );


	    return base
	        * banda
	        * ruido;
	}


	@Override
	public double distanciaMetros(
	    String origenId,
	    String destinoId
	) {

	    int i =
	        matriz.indiceDe(
	            origenId
	        );

	    int j =
	        matriz.indiceDe(
	            destinoId
	        );


	    return matriz
	        .distanciaMetros[i][j];
	}


	@Override
	public double tiempoBaseMin(
	    String origenId,
	    String destinoId
	) {

	    int i =
	        matriz.indiceDe(
	            origenId
	        );

	    int j =
	        matriz.indiceDe(
	            destinoId
	        );


	    return matriz
	        .tiempoBaseMin[i][j];
	}


	@Override
	public String nombreProvider() {
	    return "MATRIZ_OFFLINE";
	}

}]]></Text>
		</JavaClass>
