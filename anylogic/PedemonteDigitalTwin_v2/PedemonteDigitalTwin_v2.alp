			<Text><![CDATA[/**
 * DesgloseCostoTurno
 */	
public class DesgloseCostoTurno implements Serializable {

	public double costoTareasNoEntregadas = 0.0;

	public double costoPedidosOriginalesIncompletos = 0.0;

	public double costoTardanza = 0.0;

	public double costoExcesoTolerancia = 0.0;

	public double costoOperacion = 0.0;

	public double costoDistancia = 0.0;

	public double costoViajes = 0.0;

	public double costoDesbalance = 0.0;

	public double costoTotal = 0.0;


	@Override
	public String toString() {

	    return "DesgloseCostoTurno{" +
	        "noEntrega=" + costoTareasNoEntregadas +
	        ", originalesIncompletos=" +
	        costoPedidosOriginalesIncompletos +
	        ", tardanza=" + costoTardanza +
	        ", excesoTolerancia=" + costoExcesoTolerancia +
	        ", operacion=" + costoOperacion +
	        ", distancia=" + costoDistancia +
	        ", viajes=" + costoViajes +
	        ", desbalance=" + costoDesbalance +
	        ", total=" + costoTotal +
	        '}';
	}

}]]></Text>
