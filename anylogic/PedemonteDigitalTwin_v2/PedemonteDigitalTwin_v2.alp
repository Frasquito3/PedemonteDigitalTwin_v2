						<Font Name="SansSerif" Size="10" Style="1"/>
						<LabelText><![CDATA[Nueva operación]]></LabelText>
					</ExtendedProperties>
				</Control>
				<Control Type="Button">
				 	<EmbeddedIcon>false</EmbeddedIcon>				
					<Id>1787148083269</Id>
					<Name><![CDATA[btnAgregarPedidoFormulario]]></Name>
					<X>265</X><Y>800</Y>
					<Label><X>0</X><Y>-10</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
					<BasicProperties Width="380" Height="40">
                        <EmbeddedIcon>false</EmbeddedIcon>	
						<TextColor>-15257011</TextColor>
						<Enabled>true</Enabled>
						<EnableExpression><![CDATA[instanciaInterfazActual == null
&&
!ejecucionEnCurso
&&
!pypelineSolicitudEnCurso]]></EnableExpression>
						<ActionCode><![CDATA[boolean pedidoAgregado =
    agregarPedidoFormulario();


if (pedidoAgregado) {

    restablecerCamposPedidoFormulario();


    emitirEstadoPedidosWeb(
        "",
        "AGREGAR_ANYLOGIC",
        true,
        mensajeFormulario
    );
}]]></ActionCode>
