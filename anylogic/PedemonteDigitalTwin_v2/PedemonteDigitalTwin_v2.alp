				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786560383763</Id>
					<Name><![CDATA[notificarCamionFinalizado]]></Name>
					<X>-810</X><Y>370</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[camionId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[camionesFinalizados++;


traceln(
    "Main recibió fin de Camión "
    + camionId +
    ". Finalizados: "
    + camionesFinalizados +
    "/"
    + CANTIDAD_CAMIONES
);


if (
    camionesFinalizados
    >= CANTIDAD_CAMIONES
) {

    ejecucionEnCurso = false;
    ejecucionFinalizada = true;


    traceln("");
    traceln("==============================");
    traceln("=== EJECUCIÓN FINALIZADA =====");
    traceln("==============================");

    imprimirResumenFase3();
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786560408923</Id>
					<Name><![CDATA[imprimirResumenFase3]]></Name>
					<X>-810</X><Y>400</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[traceln("");
traceln("=== ESTADO FINAL DE PEDIDOS ===");


for (
    PedidoRuntime runtime
    : pedidosRuntime.values()
) {

    traceln(
        runtime.input.pedidoId
        + " -> "
        + runtime.estado
        + " | camión="
        + runtime.camionIdAsignado
        + " | viaje="
        + runtime.numeroViajeAsignado
        + " | entrega="
        + runtime.minutoEntrega
    );
}


traceln("");
traceln(
    "Hora final simulada: "
    + minutoDiaActual()
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1786560433139</Id>
					<Name><![CDATA[ejecutarPlan]]></Name>
					<X>-810</X><Y>430</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[plan]]></Name>
						<Type><![CDATA[PlanTurno]]></Type>
					</Parameter>
					<Body><![CDATA[ResultadoValidacionPlan validacion =
    validarPlan(
        instancia,
        plan
    );


if (!validacion.valido) {

    traceln("");
    traceln(
        "=== PLAN RECHAZADO ==="
    );

    for (
        String error
        : validacion.errores
    ) {

        traceln(
            "ERROR: " + error
        );
    }

    return false;
}


// -----------------------------------------------------
// Estado general
// -----------------------------------------------------

instanciaActual =
    instancia;

planActual =
    plan;

inicializarRNGsEjecucion(
    instancia.seedEjecucion
);

inicializarTrabajadores();

ejecucionEnCurso =
    true;

ejecucionFinalizada =
    false;

camionesFinalizados =
    0;


// -----------------------------------------------------
// Crear runtime
// -----------------------------------------------------

prepararPedidosRuntime(
    instanciaActual
);


// -----------------------------------------------------
// Marcar asignaciones
// -----------------------------------------------------

for (
    PlanCamion planCamion
    : plan.camiones
) {

    for (
        ViajePlan viaje
        : planCamion.viajes
    ) {

        for (
            int orden = 0;
            orden < viaje.pedidoIds.size();
            orden++
        ) {

            String pedidoId =
                viaje.pedidoIds.get(
                    orden
                );


            PedidoRuntime runtime =
                obtenerPedidoRuntime(
                    pedidoId
                );


            runtime.estado =
                EstadoPedido.PLANIFICADO;

            runtime.camionIdAsignado =
                planCamion.camionId;

            runtime.numeroViajeAsignado =
                viaje.numeroViaje;

            runtime.ordenEnViaje =
                orden;
        }
    }
}


// -----------------------------------------------------
// Asignar plan a cada agente Camion
// -----------------------------------------------------

for (Camion camion : camiones) {

    PlanCamion planCamion =
        obtenerPlanCamion(
            plan,
            camion.camionId
        );

    camion.asignarPlan(
        planCamion
    );
}


traceln("");
traceln("==============================");
traceln("=== PLAN EN EJECUCIÓN ========");
traceln("==============================");
traceln(
    "Instancia: "
    + instancia.instanciaId
);
traceln(
    "Algoritmo: "
    + plan.algoritmo
);
traceln("");

for (Camion camion : camiones) {

    camion.activarEjecucion();
}


return true;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
