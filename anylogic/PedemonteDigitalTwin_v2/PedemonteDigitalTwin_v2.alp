				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ResultadoValidacionPlan]]></ReturnType>
					<Id>1786558755592</Id>
					<Name><![CDATA[validarPlan]]></Name>
					<X>-810</X><Y>220</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[plan]]></Name>
						<Type><![CDATA[PlanTurno]]></Type>
					</Parameter>
					<Body><![CDATA[ResultadoValidacionPlan resultado =
    new ResultadoValidacionPlan();


if (instancia == null) {
    resultado.agregarError("La instancia es null.");
    return resultado;
}


if (plan == null) {
    resultado.agregarError("El plan es null.");
    return resultado;
}


if (instancia.instanciaId == null
    || !instancia.instanciaId.equals(plan.instanciaId)) {

    resultado.agregarError(
        "El plan no corresponde a la instancia. " +
        "Instancia esperada: " + instancia.instanciaId +
        ", plan recibido: " + plan.instanciaId
    );
}


// -----------------------------------------------------
// Mapa de pedidos válidos
// -----------------------------------------------------

java.util.HashMap<String, PedidoInput> pedidosPorId =
    new java.util.HashMap<String, PedidoInput>();


for (PedidoInput pedido : instancia.pedidos) {

    if (pedido == null) {
        resultado.agregarError(
            "La instancia contiene un pedido null."
        );
        continue;
    }

    if (pedido.pedidoId == null
        || pedido.pedidoId.trim().isEmpty()) {

        resultado.agregarError(
            "Existe un pedido con ID vacío."
        );
        continue;
    }

    if (pedidosPorId.containsKey(pedido.pedidoId)) {

        resultado.agregarError(
            "ID de pedido duplicado en la instancia: "
            + pedido.pedidoId
        );

        continue;
    }

    pedidosPorId.put(
        pedido.pedidoId,
        pedido
    );


    if (pedido.turno != instancia.turno) {

        resultado.agregarError(
            "Pedido " + pedido.pedidoId +
            " pertenece al turno " + pedido.turno +
            " pero la instancia es " + instancia.turno
        );
    }
}


// -----------------------------------------------------
// Camiones
// -----------------------------------------------------

if (plan.camiones == null) {

    resultado.agregarError(
        "La lista de camiones del plan es null."
    );

    return resultado;
}


if (plan.camiones.size()
    != instancia.cantidadCamiones) {

    resultado.agregarError(
        "Cantidad incorrecta de camiones en el plan. " +
        "Esperados: " + instancia.cantidadCamiones +
        ", recibidos: " + plan.camiones.size()
    );
}


java.util.HashSet<Integer> camionesEncontrados =
    new java.util.HashSet<Integer>();

java.util.HashMap<String, Integer> cantidadAsignaciones =
    new java.util.HashMap<String, Integer>();


// Inicializamos el contador de todos los pedidos.
for (String pedidoId : pedidosPorId.keySet()) {
    cantidadAsignaciones.put(pedidoId, 0);
}


// -----------------------------------------------------
// Recorremos el plan
// -----------------------------------------------------

for (PlanCamion planCamion : plan.camiones) {

    if (planCamion == null) {

        resultado.agregarError(
            "El plan contiene un PlanCamion null."
        );

        continue;
    }


    if (planCamion.camionId < 0
        || planCamion.camionId
           >= instancia.cantidadCamiones) {

        resultado.agregarError(
            "camionId inválido: "
            + planCamion.camionId
        );
    }


    if (!camionesEncontrados.add(
            planCamion.camionId)) {

        resultado.agregarError(
            "Camión repetido en el plan: "
            + planCamion.camionId
        );
    }


    if (planCamion.viajes == null) {

        resultado.agregarError(
            "El camión " + planCamion.camionId +
            " tiene viajes = null."
        );

        continue;
    }


    for (ViajePlan viaje : planCamion.viajes) {

        if (viaje == null) {

            resultado.agregarError(
                "El camión " +
                planCamion.camionId +
                " contiene un viaje null."
            );

            continue;
        }


        if (viaje.pedidoIds == null
            || viaje.pedidoIds.isEmpty()) {

            resultado.agregarError(
                "Viaje vacío en camión "
                + planCamion.camionId +
                ", viaje "
                + viaje.numeroViaje
            );

            continue;
        }


        int cargaViaje = 0;

        int cantidadVolcadores = 0;

        int posicionVolcador = -1;


        for (
            int posicion = 0;
            posicion < viaje.pedidoIds.size();
            posicion++
        ) {

            String pedidoId =
                viaje.pedidoIds.get(posicion);


            if (!pedidosPorId.containsKey(
                    pedidoId)) {

                resultado.agregarError(
                    "Pedido inexistente en el plan: "
                    + pedidoId
                );

                continue;
            }


            PedidoInput pedido =
                pedidosPorId.get(pedidoId);


            cargaViaje +=
                pedido.unidadesCapacidad;


            if (pedido.turno
                != instancia.turno) {

                resultado.agregarError(
                    "Pedido " + pedidoId +
                    " pertenece a otro turno."
                );
            }


            if (pedido.requiereVolcador) {

                cantidadVolcadores++;

                posicionVolcador =
                    posicion;
            }


            int contador =
                cantidadAsignaciones.get(
                    pedidoId
                );

            cantidadAsignaciones.put(
                pedidoId,
                contador + 1
            );
        }


        // ---------------------------------------------
        // Capacidad
        // ---------------------------------------------

        if (cargaViaje
            > instancia.capacidadCamion) {

            resultado.agregarError(
                "Capacidad excedida. Camión "
                + planCamion.camionId +
                ", viaje "
                + viaje.numeroViaje +
                ": carga="
                + cargaViaje +
                ", capacidad="
                + instancia.capacidadCamion
            );
        }


        // ---------------------------------------------
        // Volcador
        // ---------------------------------------------

        if (cantidadVolcadores > 1) {

            resultado.agregarError(
                "Más de un pedido con volcador. " +
                "Camión "
                + planCamion.camionId +
                ", viaje "
                + viaje.numeroViaje
            );
        }


        if (
            cantidadVolcadores == 1
            &&
            posicionVolcador
            != viaje.pedidoIds.size() - 1
        ) {

            resultado.agregarError(
                "El pedido con volcador no es " +
                "el último del viaje. Camión "
                + planCamion.camionId +
                ", viaje "
                + viaje.numeroViaje
            );
        }
    }
}


// -----------------------------------------------------
// Todos los pedidos exactamente una vez
// -----------------------------------------------------

for (
    java.util.Map.Entry<String, Integer> entry
    : cantidadAsignaciones.entrySet()
) {

    if (entry.getValue() == 0) {

        resultado.agregarError(
            "Pedido no asignado: "
            + entry.getKey()
        );
    }


    if (entry.getValue() > 1) {

        resultado.agregarError(
            "Pedido asignado más de una vez: "
            + entry.getKey()
        );
    }
}


return resultado;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1786558904560</Id>
					<Name><![CDATA[prepararPedidosRuntime]]></Name>
					<X>-810</X><Y>250</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Body><![CDATA[pedidosRuntime.clear();


for (PedidoInput pedido : instancia.pedidos) {

    PedidoRuntime runtime =
        new PedidoRuntime(pedido);

    runtime.estado =
        EstadoPedido.PENDIENTE;

    pedidosRuntime.put(
        pedido.pedidoId,
        runtime
    );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[PlanCamion]]></ReturnType>
					<Id>1786558951929</Id>
					<Name><![CDATA[obtenerPlanCamion]]></Name>
					<X>-810</X><Y>280</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[plan]]></Name>
						<Type><![CDATA[PlanTurno]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[camionId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[for (PlanCamion planCamion : plan.camiones) {

    if (planCamion.camionId == camionId) {
        return planCamion;
    }
}


throw new IllegalArgumentException(
    "No existe PlanCamion para camionId="
    + camionId
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786560383763</Id>
					<Name><![CDATA[notificarCamionFinalizado]]></Name>
					<X>-810</X><Y>310</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[camionId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[camionesFinalizados++;


traceln(
    "Main recibió fin de Camión "
    + camionId
    + ". Finalizados: "
    + camionesFinalizados
    + "/"
    + CANTIDAD_CAMIONES
);


// La función central decide si puede cerrar
// inmediatamente o si debe esperar proveedores.

intentarFinalizarEjecucion();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1786560433139</Id>
					<Name><![CDATA[ejecutarPlan]]></Name>
					<X>-810</X><Y>340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[plan]]></Name>
						<Type><![CDATA[PlanTurno]]></Type>
					</Parameter>
					<Body><![CDATA[ResultadoValidacionPlan validacion =
    validarPlan(
        instancia,
        plan
    );


if (!validacion.valido) {

    traceln("");
    traceln(
        "=== PLAN RECHAZADO ==="
    );

    for (
        String error
        : validacion.errores
    ) {

        traceln(
            "ERROR: " + error
        );
    }

    return false;
}


// -----------------------------------------------------
// Estado general
// -----------------------------------------------------

instanciaActual =
    instancia;

planActual =
    plan;

inicializarRNGsEjecucion(
    instancia.seedEjecucion
);

inicializarTravelTimeProvider(
    instanciaActual
);

inicializarTrabajadores();

ejecucionEnCurso =
    true;
    
inicializarSistemaProveedores();

ejecucionFinalizada =
    false;

camionesFinalizados =
    0;


// -----------------------------------------------------
// Crear runtime
// -----------------------------------------------------

prepararPedidosRuntime(
    instanciaActual
);


// -----------------------------------------------------
// Marcar asignaciones
// -----------------------------------------------------

for (
    PlanCamion planCamion
    : plan.camiones
) {

    for (
        ViajePlan viaje
        : planCamion.viajes
    ) {

        for (
            int orden = 0;
            orden < viaje.pedidoIds.size();
            orden++
        ) {

            String pedidoId =
                viaje.pedidoIds.get(
                    orden
                );


            PedidoRuntime runtime =
                obtenerPedidoRuntime(
                    pedidoId
                );


            runtime.estado =
                EstadoPedido.PLANIFICADO;

            runtime.camionIdAsignado =
                planCamion.camionId;

            runtime.numeroViajeAsignado =
                viaje.numeroViaje;

            runtime.ordenEnViaje =
                orden;
        }
    }
}


// -----------------------------------------------------
// Asignar plan a cada agente Camion
// -----------------------------------------------------

for (Camion camion : camiones) {

    PlanCamion planCamion =
        obtenerPlanCamion(
            plan,
            camion.camionId
        );

    camion.asignarPlan(
        planCamion
    );
}


traceln("");
traceln("==============================");
traceln("=== PLAN EN EJECUCIÓN ========");
traceln("==============================");
traceln(
    "Instancia: "
    + instancia.instanciaId
);
traceln(
    "Algoritmo: "
    + plan.algoritmo
);
traceln("");
marcarSelectorEnEjecucionVisual();

for (Camion camion : camiones) {

    camion.activarEjecucion();
}


return true;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[PedidoInput]]></ReturnType>
					<Id>1786560472867</Id>
					<Name><![CDATA[crearPedidoPrueba]]></Name>
					<X>-810</X><Y>370</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[id]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[unidades]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[volcador]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[lat]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[lon]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[PedidoInput p =
    new PedidoInput();


p.pedidoId = id;

p.pedidoOriginalId = id;

p.numeroParte = 1;

p.totalPartes = 1;

p.turno =
    Turno.MANANA;

p.latitud = lat;

p.longitud = lon;

p.unidadesCapacidad =
    unidades;

p.requiereVolcador =
    volcador;

p.tieneVentanaEspecifica =
    false;

p.horaDesdeMin =
    HORA_INICIO_MANANA_MIN;

p.horaHastaMin =
    HORA_FIN_MANANA_MIN;

p.cliente =
    "Cliente " + id;

p.direccion =
    "Dirección " + id;

p.barrio =
    "TEST";

p.observaciones =
    "";


return p;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786562384883</Id>
					<Name><![CDATA[inicializarRNGsEjecucion]]></Name>
					<X>-810</X><Y>400</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[seedBase]]></Name>
						<Type><![CDATA[long]]></Type>
					</Parameter>
					<Body><![CDATA[rngCarga =
    new java.util.Random(
        seedBase + 1001L
    );

rngDescarga =
    new java.util.Random(
        seedBase + 2003L
    );

rngCliente =
    new java.util.Random(
        seedBase + 3001L
    );

rngProveedor =
    new java.util.Random(
        seedBase + 5003L
    );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786562445467</Id>
					<Name><![CDATA[inicializarTrabajadores]]></Name>
					<X>-810</X><Y>430</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[trabajadores.clear();


// =====================================================
// CHOFER CAMIÓN 0
// =====================================================

TrabajadorRuntime chofer0 =
    new TrabajadorRuntime();

chofer0.trabajadorId =
    "CHOFER_0";

chofer0.tipo =
    TipoTrabajador.CHOFER;

chofer0.camionPropioId =
    0;

trabajadores.add(
    chofer0
);


// =====================================================
// CHOFER CAMIÓN 1
// =====================================================

TrabajadorRuntime chofer1 =
    new TrabajadorRuntime();

chofer1.trabajadorId =
    "CHOFER_1";

chofer1.tipo =
    TipoTrabajador.CHOFER;

chofer1.camionPropioId =
    1;

trabajadores.add(
    chofer1
);


// =====================================================
// EMPLEADO 0
// =====================================================

TrabajadorRuntime empleado0 =
    new TrabajadorRuntime();

empleado0.trabajadorId =
    "EMPLEADO_0";

empleado0.tipo =
    TipoTrabajador.EMPLEADO_CORRALON;

trabajadores.add(
    empleado0
);


// =====================================================
// EMPLEADO 1
// =====================================================

TrabajadorRuntime empleado1 =
    new TrabajadorRuntime();

empleado1.trabajadorId =
    "EMPLEADO_1";

empleado1.tipo =
    TipoTrabajador.EMPLEADO_CORRALON;

trabajadores.add(
    empleado1
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[TrabajadorRuntime]]></ReturnType>
					<Id>1786562466403</Id>
					<Name><![CDATA[obtenerChofer]]></Name>
					<X>-810</X><Y>460</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[camionId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[for (
    TrabajadorRuntime trabajador
    : trabajadores
) {

    if (
        trabajador.tipo
            == TipoTrabajador.CHOFER
        &&
        trabajador.camionPropioId
            == camionId
    ) {

        return trabajador;
    }
}


throw new IllegalArgumentException(
    "No existe chofer para camionId="
    + camionId
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Camion]]></ReturnType>
					<Id>1786562552923</Id>
					<Name><![CDATA[obtenerOtroCamion]]></Name>
					<X>-810</X><Y>490</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[camionId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[for (Camion camion : camiones) {

    if (
        camion.camionId
        != camionId
    ) {

        return camion;
    }
}


throw new IllegalStateException(
    "No se encontró el otro camión."
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.util.ArrayList<TrabajadorRuntime>]]></ReturnType>
					<Id>1786562730747</Id>
					<Name><![CDATA[asignarTrabajadoresCarga]]></Name>
					<X>-810</X><Y>520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[camion]]></Name>
						<Type><![CDATA[Camion]]></Type>
					</Parameter>
					<Body><![CDATA[java.util.ArrayList<TrabajadorRuntime> asignados =
    new java.util.ArrayList<TrabajadorRuntime>();


// =====================================================
// 1. El chofer propio siempre participa
// =====================================================

TrabajadorRuntime choferPropio =
    obtenerChofer(
        camion.camionId
    );


if (!choferPropio.estaLibre()) {

    throw new IllegalStateException(
        "El chofer del camión "
        + camion.camionId
        + " no está disponible para cargar."
    );
}


choferPropio.cargandoCamionId =
    camion.camionId;

asignados.add(
    choferPropio
);


// =====================================================
// 2. Analizamos al otro camión
// =====================================================

Camion otroCamion =
    obtenerOtroCamion(
        camion.camionId
    );


boolean otroSinTrabajo =
    !otroCamion.tieneTrabajoRestante();


int maxEmpleadosCorralon;


// -----------------------------------------------------
// CASO A:
// El otro camión ya no tiene trabajo.
// Los dos empleados pueden ayudar.
// Además puede ayudar el otro chofer.
// -----------------------------------------------------

if (otroSinTrabajo) {

    maxEmpleadosCorralon = 2;
}


// -----------------------------------------------------
// CASO B:
// El otro camión está en la calle.
//
// Chofer propio + ambos empleados
// -> normalmente 3 personas.
// -----------------------------------------------------

else if (otroCamion.enCalle) {

    maxEmpleadosCorralon = 2;
}


// -----------------------------------------------------
// CASO C:
// Ambos camiones tienen trabajo y están
// en el corralón.
//
// Intentamos repartir:
// chofer + 1 empleado para cada uno.
// -----------------------------------------------------

else {

    maxEmpleadosCorralon = 1;
}


// =====================================================
// 3. Empleados permanentes disponibles
// =====================================================

int empleadosAsignados = 0;


for (
    TrabajadorRuntime trabajador
    : trabajadores
) {

    if (
        trabajador.tipo
            != TipoTrabajador.EMPLEADO_CORRALON
    ) {
        continue;
    }


    if (!trabajador.estaLibre()) {
        continue;
    }


    if (
        empleadosAsignados
        >= maxEmpleadosCorralon
    ) {
        break;
    }


    trabajador.cargandoCamionId =
        camion.camionId;

    asignados.add(
        trabajador
    );

    empleadosAsignados++;
}


// =====================================================
// 4. Si el otro camión terminó,
// puede ayudar su chofer.
// =====================================================

if (otroSinTrabajo) {

    TrabajadorRuntime otroChofer =
        obtenerChofer(
            otroCamion.camionId
        );


    if (otroChofer.estaLibre()) {

        otroChofer.cargandoCamionId =
            camion.camionId;

        asignados.add(
            otroChofer
        );
    }
}


return asignados;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786562778122</Id>
					<Name><![CDATA[liberarTrabajadoresCarga]]></Name>
					<X>-810</X><Y>550</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[camion]]></Name>
						<Type><![CDATA[Camion]]></Type>
					</Parameter>
					<Body><![CDATA[for (
    TrabajadorRuntime trabajador
    : camion.trabajadoresCarga
) {

    if (
        trabajador.cargandoCamionId
        == camion.camionId
    ) {

        trabajador.cargandoCamionId =
            -1;
    }
}


camion.trabajadoresCarga.clear();

camion.cargandoAhora =
    false;
    
// Una solicitud de proveedor podría estar
// esperando exactamente por estos empleados.
intentarAtenderProveedoresPendientes();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786562796715</Id>
					<Name><![CDATA[tiempoCargaMin]]></Name>
					<X>-810</X><Y>580</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[unidades]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[personas]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if (unidades <= 0) {

    throw new IllegalArgumentException(
        "unidades debe ser > 0."
    );
}


if (personas <= 0) {

    throw new IllegalArgumentException(
        "personas debe ser > 0."
    );
}


if (rngCarga == null) {

    throw new IllegalStateException(
        "rngCarga no fue inicializado."
    );
}


// =====================================================
// Eficiencia efectiva del equipo
// =====================================================

double personasEfectivas =
    1.0
    +
    CARGA_EFICIENCIA_PERSONA_ADICIONAL
    * (personas - 1);


// =====================================================
// Tiempo esperado base
// =====================================================

double tiempoBase =
    CARGA_SETUP_MIN
    +
    (
        CARGA_MIN_POR_UNIDAD_1_PERSONA
        * unidades
    )
    / personasEfectivas;


// =====================================================
// Variabilidad
// =====================================================

double factorVariacion =
    triangular(
        CARGA_FACTOR_VARIACION_MIN,
        CARGA_FACTOR_VARIACION_MODA,
        CARGA_FACTOR_VARIACION_MAX,
        rngCarga
    );


return tiempoBase
    * factorVariacion;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786578215634</Id>
					<Name><![CDATA[muestrearEsperaRespuestaClienteMin]]></Name>
					<X>-810</X><Y>610</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (rngCliente == null) {

    throw new IllegalStateException(
        "rngCliente no fue inicializado."
    );
}


return triangular(
    CLIENTE_ESPERA_RESPUESTA_MIN,
    CLIENTE_ESPERA_RESPUESTA_MODA,
    CLIENTE_ESPERA_RESPUESTA_MAX,
    rngCliente
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ResultadoAtencionCliente]]></ReturnType>
					<Id>1786578241202</Id>
					<Name><![CDATA[evaluarLlegadaCliente]]></Name>
					<X>-810</X><Y>640</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[pedido]]></Name>
						<Type><![CDATA[PedidoInput]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[minutoLlegada]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (pedido == null) {

    throw new IllegalArgumentException(
        "pedido no puede ser null."
    );
}


if (rngCliente == null) {

    throw new IllegalStateException(
        "rngCliente no fue inicializado."
    );
}


ResultadoAtencionCliente resultado =
    new ResultadoAtencionCliente();


double desde;

double hasta;


if (pedido.tieneVentanaEspecifica) {

    desde =
        pedido.horaDesdeMin;

    hasta =
        pedido.horaHastaMin;

} else {

    desde =
        horaInicioTurno(
            pedido.turno
        );

    hasta =
        horaFinObjetivoTurno(
            pedido.turno
        );
}


// =====================================================
// CASO 1: LLEGADA TEMPRANA
// =====================================================

if (minutoLlegada < desde) {

    double anticipacion =
        desde - minutoLlegada;

    resultado.anticipacionMin =
        anticipacion;


    boolean puedeAceptarAntes =
        anticipacion
        <= CLIENTE_MAX_ANTICIPACION_ACEPTABLE_MIN;


    boolean aceptaAntes =
        puedeAceptarAntes
        &&
        rngCliente.nextDouble()
        < CLIENTE_PROB_ACEPTAR_ANTES;


    if (aceptaAntes) {

        resultado.decision =
            DecisionAtencionCliente.DESCARGAR_AHORA;

        resultado.aceptadoAntes =
            true;

        resultado.motivo =
            "ACEPTADO_ANTES_DE_VENTANA";

        return resultado;
    }


    // -------------------------------------------------
    // No acepta antes:
    // espera hasta apertura + tiempo de respuesta.
    // -------------------------------------------------

    double esperaHastaVentana =
        desde - minutoLlegada;

    double esperaRespuesta =
        muestrearEsperaRespuestaClienteMin();


    resultado.esperaMin =
        esperaHastaVentana
        + esperaRespuesta;

    resultado.decision =
        DecisionAtencionCliente.ESPERAR;

    resultado.motivo =
        "ESPERA_HASTA_VENTANA";

    return resultado;
}


// =====================================================
// CASO 2: DENTRO DE LA VENTANA
// =====================================================

if (minutoLlegada <= hasta) {

    double esperaRespuesta =
        muestrearEsperaRespuestaClienteMin();


    if (esperaRespuesta > 0.0) {

        resultado.decision =
            DecisionAtencionCliente.ESPERAR;

        resultado.esperaMin =
            esperaRespuesta;

        resultado.motivo =
            "ESPERA_RESPUESTA_CLIENTE";

    } else {

        resultado.decision =
            DecisionAtencionCliente.DESCARGAR_AHORA;

        resultado.motivo =
            "ATENCION_INMEDIATA";
    }


    return resultado;
}


// =====================================================
// CASO 3: LLEGADA TARDÍA
// =====================================================

resultado.llegadaTardia =
    true;

resultado.tardanzaMin =
    minutoLlegada - hasta;


boolean aceptaTarde =
    rngCliente.nextDouble()
    < CLIENTE_PROB_ACEPTAR_TARDE;


if (aceptaTarde) {

    resultado.decision =
        DecisionAtencionCliente.DESCARGAR_AHORA;

    resultado.motivo =
        "ACEPTADO_CON_TARDANZA";

} else {

    resultado.decision =
        DecisionAtencionCliente.NO_ENTREGAR;

    resultado.motivo =
        "CLIENTE_NO_ACEPTA_LLEGADA_TARDIA";
}


return resultado;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786578298067</Id>
					<Name><![CDATA[tiempoDescargaMin]]></Name>
					<X>-810</X><Y>670</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[pedido]]></Name>
						<Type><![CDATA[PedidoInput]]></Type>
					</Parameter>
					<Body><![CDATA[if (pedido == null) {

    throw new IllegalArgumentException(
        "pedido no puede ser null."
    );
}


if (pedido.unidadesCapacidad <= 0) {

    throw new IllegalArgumentException(
        "unidadesCapacidad debe ser > 0."
    );
}


if (rngDescarga == null) {

    throw new IllegalStateException(
        "rngDescarga no fue inicializado."
    );
}


double tiempoBase =
    DESCARGA_SETUP_MIN
    +
    DESCARGA_MIN_POR_UNIDAD
    * pedido.unidadesCapacidad;


double factorVariacion =
    triangular(
        DESCARGA_FACTOR_VARIACION_MIN,
        DESCARGA_FACTOR_VARIACION_MODA,
        DESCARGA_FACTOR_VARIACION_MAX,
        rngDescarga
    );


return tiempoBase
    * factorVariacion;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786580874509</Id>
					<Name><![CDATA[tiempoHastaProximoProveedorMin]]></Name>
					<X>-810</X><Y>700</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (rngProveedor == null) {

    throw new IllegalStateException(
        "rngProveedor no fue inicializado."
    );
}


if (
    PROVEEDOR_MEDIA_ENTRE_LLEGADAS_MIN
    <= 0.0
) {

    throw new IllegalStateException(
        "PROVEEDOR_MEDIA_ENTRE_LLEGADAS_MIN debe ser > 0."
    );
}


// Muestreo exponencial mediante
// transformación inversa.

double u =
    rngProveedor.nextDouble();


return -PROVEEDOR_MEDIA_ENTRE_LLEGADAS_MIN
    * Math.log(1.0 - u);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786580898437</Id>
					<Name><![CDATA[muestrearDuracionProveedorMin]]></Name>
					<X>-810</X><Y>730</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (rngProveedor == null) {

    throw new IllegalStateException(
        "rngProveedor no fue inicializado."
    );
}


return triangular(
    PROVEEDOR_DURACION_MIN,
    PROVEEDOR_DURACION_MODA,
    PROVEEDOR_DURACION_MAX,
    rngProveedor
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[SolicitudProveedorRuntime]]></ReturnType>
					<Id>1786580912460</Id>
					<Name><![CDATA[crearSolicitudProveedor]]></Name>
					<X>-810</X><Y>760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[SolicitudProveedorRuntime solicitud =
    new SolicitudProveedorRuntime();


solicitud.solicitudId =
    contadorSolicitudesProveedor++;


solicitud.minutoLlegada =
    minutoDiaActual();


solicitud.empleadosRequeridos =
    rngProveedor.nextDouble()
        < PROVEEDOR_PROB_REQUIERE_DOS_EMPLEADOS
    ? 2
    : 1;


solicitud.duracionAtencionMin =
    muestrearDuracionProveedorMin();


solicitud.estado =
    EstadoSolicitudProveedor.PENDIENTE;


historialProveedores.add(
    solicitud
);


return solicitud;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1786580931524</Id>
					<Name><![CDATA[cantidadEmpleadosCorralonLibres]]></Name>
					<X>-810</X><Y>790</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int cantidad = 0;


for (
    TrabajadorRuntime trabajador
    : trabajadores
) {

    if (
        trabajador.tipo
        != TipoTrabajador.EMPLEADO_CORRALON
    ) {
        continue;
    }


    if (trabajador.estaLibre()) {
        cantidad++;
    }
}


return cantidad;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786580953020</Id>
					<Name><![CDATA[iniciarAtencionProveedor]]></Name>
					<X>-810</X><Y>820</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[solicitud]]></Name>
						<Type><![CDATA[SolicitudProveedorRuntime]]></Type>
					</Parameter>
					<Body><![CDATA[if (
    cantidadEmpleadosCorralonLibres()
    < solicitud.empleadosRequeridos
) {

    throw new IllegalStateException(
        "No hay empleados suficientes para iniciar "
        + "la solicitud de proveedor "
        + solicitud.solicitudId
    );
}


solicitud.empleadosAsignados.clear();


for (
    TrabajadorRuntime trabajador
    : trabajadores
) {

    if (
        trabajador.tipo
        != TipoTrabajador.EMPLEADO_CORRALON
    ) {
        continue;
    }


    if (!trabajador.estaLibre()) {
        continue;
    }


    trabajador.ocupadoProveedor =
        true;


    solicitud.empleadosAsignados.add(
        trabajador
    );


    if (
        solicitud.empleadosAsignados.size()
        >= solicitud.empleadosRequeridos
    ) {
        break;
    }
}


solicitud.estado =
    EstadoSolicitudProveedor.EN_ATENCION;


solicitud.minutoInicioAtencion =
    minutoDiaActual();


solicitud.minutoFinPrevisto =
    solicitud.minutoInicioAtencion
    + solicitud.duracionAtencionMin;


proveedoresEnAtencion.add(
    solicitud
);


traceln(
    "[" + minutoDiaActual() + "] "
    + "Proveedor "
    + solicitud.solicitudId
    + " inicia atención con "
    + solicitud.empleadosAsignados
    + ". Duración="
    + solicitud.duracionAtencionMin
    + " min"
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786580983923</Id>
					<Name><![CDATA[intentarAtenderProveedoresPendientes]]></Name>
					<X>-810</X><Y>850</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[while (!proveedoresPendientes.isEmpty()) {

    SolicitudProveedorRuntime solicitud =
        proveedoresPendientes.get(0);


    if (
        cantidadEmpleadosCorralonLibres()
        < solicitud.empleadosRequeridos
    ) {

        // FIFO:
        // la primera solicitud espera.
        break;
    }


    proveedoresPendientes.remove(0);


    iniciarAtencionProveedor(
        solicitud
    );
}


reprogramarFinProveedor();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786581020628</Id>
					<Name><![CDATA[procesarLlegadaProveedor]]></Name>
					<X>-810</X><Y>880</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (!ejecucionEnCurso) {
    return;
}


SolicitudProveedorRuntime solicitud =
    crearSolicitudProveedor();


proveedoresPendientes.add(
    solicitud
);


traceln(
    "[" + minutoDiaActual() + "] "
    + "Llega proveedor "
    + solicitud.solicitudId
    + ". Requiere "
    + solicitud.empleadosRequeridos
    + " empleado(s). "
    + "Duración="
    + solicitud.duracionAtencionMin
);


intentarAtenderProveedoresPendientes();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786581104180</Id>
					<Name><![CDATA[programarProximaLlegadaProveedor]]></Name>
					<X>-810</X><Y>910</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    !PROVEEDORES_HABILITADOS
    || !ejecucionEnCurso
    || instanciaActual == null
) {

    eventoLlegadaProveedor.reset();

    return;
}


double demora =
    tiempoHastaProximoProveedorMin();


double minutoProximo =
    minutoDiaActual()
    + demora;


// No generamos proveedores
// después del horizonte operativo.
if (
    minutoProximo
    > instanciaActual.horaFinToleranciaMin
) {

    eventoLlegadaProveedor.reset();

    return;
}


eventoLlegadaProveedor.restart(
    demora
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786581143604</Id>
					<Name><![CDATA[reprogramarFinProveedor]]></Name>
					<X>-810</X><Y>940</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    proveedoresEnAtencion.isEmpty()
) {

    eventoFinAtencionProveedor.reset();

    return;
}


double menorFin =
    Double.POSITIVE_INFINITY;


for (
    SolicitudProveedorRuntime solicitud
    : proveedoresEnAtencion
) {

    if (
        solicitud.minutoFinPrevisto
        < menorFin
    ) {

        menorFin =
            solicitud.minutoFinPrevisto;
    }
}


double demora =
    menorFin
    - minutoDiaActual();


if (demora < 0.0) {
    demora = 0.0;
}


eventoFinAtencionProveedor.restart(
    demora
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786581155189</Id>
					<Name><![CDATA[procesarFinAtencionesProveedor]]></Name>
					<X>-810</X><Y>970</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double ahora =
    minutoDiaActual();


for (
    int i =
        proveedoresEnAtencion.size() - 1;

    i >= 0;

    i--
) {

    SolicitudProveedorRuntime solicitud =
        proveedoresEnAtencion.get(i);


    if (
        solicitud.minutoFinPrevisto
        > ahora + 1e-9
    ) {
        continue;
    }


    for (
        TrabajadorRuntime trabajador
        : solicitud.empleadosAsignados
    ) {

        trabajador.ocupadoProveedor =
            false;
    }


    solicitud.estado =
        EstadoSolicitudProveedor.COMPLETADA;


    solicitud.minutoFinReal =
        ahora;


    proveedoresEnAtencion.remove(i);


    traceln(
        "[" + ahora + "] "
        + "Proveedor "
        + solicitud.solicitudId
        + " finalizó atención. "
        + "Libera "
        + solicitud.empleadosAsignados
    );
}


// Puede haber un proveedor esperando
// justamente por estos empleados.

intentarAtenderProveedoresPendientes();


// Si los camiones ya finalizaron, esta atención
// podría haber sido la última actividad pendiente.

intentarFinalizarEjecucion();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786581167085</Id>
					<Name><![CDATA[inicializarSistemaProveedores]]></Name>
					<X>-810</X><Y>1000</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[contadorSolicitudesProveedor = 0;

proveedoresPendientes.clear();

proveedoresEnAtencion.clear();

historialProveedores.clear();


eventoLlegadaProveedor.reset();

eventoFinAtencionProveedor.reset();


if (PROVEEDORES_HABILITADOS) {

    programarProximaLlegadaProveedor();
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786581754529</Id>
					<Name><![CDATA[cerrarSistemaProveedores]]></Name>
					<X>-810</X><Y>1030</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[eventoLlegadaProveedor.reset();
eventoFinAtencionProveedor.reset();


double ahora =
    minutoDiaActual();


// =====================================================
// Solicitudes que estaban siendo atendidas
// =====================================================

for (
    SolicitudProveedorRuntime solicitud
    : proveedoresEnAtencion
) {

    for (
        TrabajadorRuntime trabajador
        : solicitud.empleadosAsignados
    ) {

        trabajador.ocupadoProveedor =
            false;
    }


    solicitud.estado =
        EstadoSolicitudProveedor
            .CANCELADA_FIN_EJECUCION;

    solicitud.minutoFinReal =
        ahora;

    solicitud.motivoCierre =
        "FIN_EJECUCION_CAMIONES";
}


// =====================================================
// Solicitudes que seguían esperando
// =====================================================

for (
    SolicitudProveedorRuntime solicitud
    : proveedoresPendientes
) {

    solicitud.estado =
        EstadoSolicitudProveedor
            .CANCELADA_FIN_EJECUCION;

    solicitud.minutoFinReal =
        ahora;

    solicitud.motivoCierre =
        "FIN_EJECUCION_CAMIONES";
}


proveedoresEnAtencion.clear();
proveedoresPendientes.clear();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786582161315</Id>
					<Name><![CDATA[calcularDistanciaHaversineMetros]]></Name>
					<X>-810</X><Y>1060</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[lat1]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[lon1]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[lat2]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[lon2]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[double radioTierraMetros =
    6371000.0;


double lat1Rad =
    Math.toRadians(lat1);

double lat2Rad =
    Math.toRadians(lat2);

double deltaLat =
    Math.toRadians(
        lat2 - lat1
    );

double deltaLon =
    Math.toRadians(
        lon2 - lon1
    );


double a =
    Math.sin(deltaLat / 2.0)
    * Math.sin(deltaLat / 2.0)
    +
    Math.cos(lat1Rad)
    * Math.cos(lat2Rad)
    * Math.sin(deltaLon / 2.0)
    * Math.sin(deltaLon / 2.0);


double c =
    2.0
    * Math.atan2(
        Math.sqrt(a),
        Math.sqrt(1.0 - a)
    );


return radioTierraMetros
    * c;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[MatrizTiemposViaje]]></ReturnType>
					<Id>1786582219356</Id>
					<Name><![CDATA[crearMatrizTiemposViaje]]></Name>
					<X>-810</X><Y>1090</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Body><![CDATA[if (instancia == null) {

    throw new IllegalArgumentException(
        "instancia no puede ser null."
    );
}


if (
    TRAFICO_VELOCIDAD_BASE_KMH
    <= 0.0
) {

    throw new IllegalStateException(
        "TRAFICO_VELOCIDAD_BASE_KMH debe ser > 0."
    );
}


final String VERSION_CACHE =
    "pedemonte-vial-v1";

final String ENCABEZADO_CACHE =
    "version_cache,"
    + "lat_origen,"
    + "lon_origen,"
    + "lat_destino,"
    + "lon_destino,"
    + "distancia_metros,"
    + "tiempo_base_min,"
    + "fuente_distancia,"
    + "fuente_tiempo";


String raizPython =
    resolverRaizPythonPypeline();


java.io.File archivoCache =
    new java.io.File(
        raizPython,
        "data/routing/cache_vial.csv"
    ).getAbsoluteFile();


if (!archivoCache.isFile()) {

    throw new IllegalStateException(
        "No existe la caché vial: "
        + archivoCache
            .getAbsolutePath()
        + "."
    );
}


java.util.List<String> lineas;


try {

    lineas =
        java.nio.file.Files.readAllLines(
            archivoCache.toPath(),
            java.nio.charset
                .StandardCharsets
                .UTF_8
        );

} catch (
    java.io.IOException exLectura
) {

    throw new IllegalStateException(
        "No se pudo leer la caché vial: "
        + archivoCache.getAbsolutePath(),
        exLectura
    );
}


if (lineas.isEmpty()) {

    throw new IllegalStateException(
        "La caché vial está vacía."
    );
}


String encabezado =
    lineas.get(0)
        .replace(
            "\uFEFF",
            ""
        )
        .trim();


if (
    !ENCABEZADO_CACHE.equals(
        encabezado
    )
) {

    throw new IllegalStateException(
        "El encabezado de la caché vial "
        + "no es compatible."
    );
}


java.util.HashMap<String, double[]>
    tramosViales =
        new java.util.HashMap<
            String,
            double[]
        >();


for (
    int numeroLinea = 1;
    numeroLinea < lineas.size();
    numeroLinea++
) {

    String linea =
        lineas.get(numeroLinea)
            .trim();


    if (linea.isEmpty()) {
        continue;
    }


    String[] columnas =
        linea.split(
            ",",
            -1
        );


    if (columnas.length != 9) {

        throw new IllegalStateException(
            "Fila inválida en la línea "
            + (numeroLinea + 1)
            + "."
        );
    }


    String versionFila =
        columnas[0].trim();


    if (
        !VERSION_CACHE.equals(
            versionFila
        )
    ) {

        throw new IllegalStateException(
            "Versión de caché incompatible "
            + "en la línea "
            + (numeroLinea + 1)
            + ": "
            + versionFila
            + "."
        );
    }


    double latOrigen =
        Double.parseDouble(
            columnas[1].trim()
        );

    double lonOrigen =
        Double.parseDouble(
            columnas[2].trim()
        );

    double latDestino =
        Double.parseDouble(
            columnas[3].trim()
        );

    double lonDestino =
        Double.parseDouble(
            columnas[4].trim()
        );

    double distanciaMetros =
        Double.parseDouble(
            columnas[5].trim()
        );


    if (
        !Double.isFinite(
            distanciaMetros
        )
        ||
        distanciaMetros <= 0.0
    ) {

        throw new IllegalStateException(
            "Distancia vial inválida en "
            + "la línea "
            + (numeroLinea + 1)
            + "."
        );
    }


    String tiempoTexto =
        columnas[6].trim();


    double tiempoBaseMin;


    if (tiempoTexto.isEmpty()) {

        tiempoBaseMin =
            distanciaMetros
            / 1000.0
            / TRAFICO_VELOCIDAD_BASE_KMH
            * 60.0;

    } else {

        tiempoBaseMin =
            Double.parseDouble(
                tiempoTexto
            );
    }


    if (
        !Double.isFinite(
            tiempoBaseMin
        )
        ||
        tiempoBaseMin < 0.0
    ) {

        throw new IllegalStateException(
            "Tiempo vial inválido en la línea "
            + (numeroLinea + 1)
            + "."
        );
    }


    String clave =
        String.format(
            java.util.Locale.US,
            "%.6f,%.6f,%.6f,%.6f",
            latOrigen,
            lonOrigen,
            latDestino,
            lonDestino
        );


    double[] anterior =
        tramosViales.get(
            clave
        );


    if (
        anterior != null
        &&
        (
            Math.abs(
                anterior[0]
                - distanciaMetros
            ) > 0.000001
            ||
            Math.abs(
                anterior[1]
                - tiempoBaseMin
            ) > 0.000001
        )
    ) {

        throw new IllegalStateException(
            "La caché contiene tramos "
            + "conflictivos para "
            + clave
            + "."
        );
    }


    tramosViales.put(
        clave,
        new double[] {
            distanciaMetros,
            tiempoBaseMin
        }
    );
}


java.util.ArrayList<String> ids =
    new java.util.ArrayList<String>();

java.util.ArrayList<Double> latitudes =
    new java.util.ArrayList<Double>();

java.util.ArrayList<Double> longitudes =
    new java.util.ArrayList<Double>();


ids.add(
    ID_NODO_CORRALON
);

latitudes.add(
    instancia.latCorralon
);

longitudes.add(
    instancia.lonCorralon
);


for (
    PedidoInput pedido
    : instancia.pedidos
) {

    ids.add(
        pedido.pedidoId
    );

    latitudes.add(
        pedido.latitud
    );

    longitudes.add(
        pedido.longitud
    );
}


MatrizTiemposViaje matriz =
    new MatrizTiemposViaje();


matriz.matrizId =
    instancia.instanciaId
    + "-VIAL-CACHE-v1";


matriz.inicializar(
    ids
);


int n =
    ids.size();

int tramosLeidos =
    0;


for (
    int i = 0;
    i < n;
    i++
) {

    for (
        int j = 0;
        j < n;
        j++
    ) {

        String origenTexto =
            String.format(
                java.util.Locale.US,
                "%.6f,%.6f",
                latitudes.get(i),
                longitudes.get(i)
            );

        String destinoTexto =
            String.format(
                java.util.Locale.US,
                "%.6f,%.6f",
                latitudes.get(j),
                longitudes.get(j)
            );


        if (
            i == j
            ||
            origenTexto.equals(
                destinoTexto
            )
        ) {

            matriz.distanciaMetros[i][j] =
                0.0;

            matriz.tiempoBaseMin[i][j] =
                0.0;

            continue;
        }


        String clave =
            origenTexto
            + ","
            + destinoTexto;


        double[] tramo =
            tramosViales.get(
                clave
            );


        if (tramo == null) {

            throw new IllegalStateException(
                "La caché vial no contiene el "
                + "tramo dirigido "
                + ids.get(i)
                + " -> "
                + ids.get(j)
                + " | "
                + clave
                + ". Volvé a exportar la matriz "
                + "vial para la instancia actual."
            );
        }


        matriz.distanciaMetros[i][j] =
            tramo[0];

        matriz.tiempoBaseMin[i][j] =
            tramo[1];

        tramosLeidos++;
    }
}


traceln(
    "MATRIZ VIAL ANYLOGIC | "
    + "archivo="
    + archivoCache
        .getAbsolutePath()
    + " | nodos="
    + matriz.cantidadNodos()
    + " | tramos="
    + tramosLeidos
    + " | velocidadBase="
    + TRAFICO_VELOCIDAD_BASE_KMH
    + " km/h"
);


return matriz;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786582660142</Id>
					<Name><![CDATA[inicializarTravelTimeProvider]]></Name>
					<X>-810</X><Y>1120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Body><![CDATA[matrizTiemposActual =
    crearMatrizTiemposViaje(
        instancia
    );


travelTimeProvider =
    new TravelTimeProviderMatriz(
        matrizTiemposActual,

        instancia.seedEjecucion,

        TRAFICO_BUCKET_MIN,

        HORA_INICIO_MANANA_MIN,

        TRAFICO_PICO_MANANA_FIN_MIN,

        TRAFICO_PICO_TARDE_INICIO_MIN,

        HORA_FIN_TARDE_MIN,

        TRAFICO_FACTOR_NORMAL,

        TRAFICO_FACTOR_PICO_MANANA,

        TRAFICO_FACTOR_PICO_TARDE,

        TRAFICO_RUIDO_FACTOR_MIN,

        TRAFICO_RUIDO_FACTOR_MAX
    );


traceln(
    "TravelTimeProvider: "
    + travelTimeProvider.nombreProvider()
    + " | nodos="
    + matrizTiemposActual.cantidadNodos()
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786582681629</Id>
					<Name><![CDATA[obtenerTiempoViajeMin]]></Name>
					<X>-810</X><Y>1150</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[origenId]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[destinoId]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (travelTimeProvider == null) {

    throw new IllegalStateException(
        "TravelTimeProvider no inicializado."
    );
}


return travelTimeProvider
    .tiempoViajeMin(
        origenId,
        destinoId,
        minutoDiaActual()
    );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786582712494</Id>
					<Name><![CDATA[obtenerDistanciaViajeMetros]]></Name>
					<X>-810</X><Y>1180</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[origenId]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[destinoId]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (travelTimeProvider == null) {

    throw new IllegalStateException(
        "TravelTimeProvider no inicializado."
    );
}


return travelTimeProvider
    .distanciaMetros(
        origenId,
        destinoId
    );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[MetricasCamion]]></ReturnType>
					<Id>1786625601320</Id>
					<Name><![CDATA[construirMetricasCamion]]></Name>
					<X>-810</X><Y>1210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[camion]]></Name>
						<Type><![CDATA[Camion]]></Type>
					</Parameter>
					<Body><![CDATA[if (camion == null) {

    throw new IllegalArgumentException(
        "camion no puede ser null."
    );
}


if (instanciaActual == null) {

    throw new IllegalStateException(
        "No existe instanciaActual."
    );
}


MetricasCamion metricas =
    new MetricasCamion();


metricas.camionId =
    camion.camionId;


metricas.minutoInicioOperacion =
    instanciaActual.horaInicioTurnoMin;


metricas.minutoFinOperacion =
    camion.minutoFinPlan;


metricas.duracionOperacionMin =
    Math.max(
        0.0,
        metricas.minutoFinOperacion
        - metricas.minutoInicioOperacion
    );


double personaMinCarga =
    0.0;


// =====================================================
// ACTIVIDADES
// =====================================================

for (
    RegistroActividadCamion registro
    : camion.historialActividades
) {

    metricas.distanciaTotalMetros +=
        registro.distanciaMetros;


    if (
        registro.tipo
        == TipoActividadCamion.CARGA
    ) {

        metricas.tiempoCargaMin +=
            registro.duracionMin;

        personaMinCarga +=
            registro.personasAsignadas
            * registro.duracionMin;
    }


    else if (
        registro.tipo
        == TipoActividadCamion.VIAJE_CLIENTE
    ) {

        metricas.tiempoViajeClienteMin +=
            registro.duracionMin;
    }


    else if (
        registro.tipo
        == TipoActividadCamion.REGRESO_CORRALON
    ) {

        metricas.tiempoRegresoMin +=
            registro.duracionMin;
    }


    else if (
        registro.tipo
        == TipoActividadCamion.ESPERA_CLIENTE
    ) {

        metricas.tiempoEsperaClienteMin +=
            registro.duracionMin;
    }


    else if (
        registro.tipo
        == TipoActividadCamion.DESCARGA
    ) {

        metricas.tiempoDescargaMin +=
            registro.duracionMin;
    }
}


// =====================================================
// TOTALES TEMPORALES
// =====================================================

metricas.distanciaTotalKm =
    metricas.distanciaTotalMetros
    / 1000.0;


metricas.tiempoViajeTotalMin =
    metricas.tiempoViajeClienteMin
    + metricas.tiempoRegresoMin;


metricas.tiempoActivoMin =
    metricas.tiempoCargaMin
    + metricas.tiempoViajeTotalMin
    + metricas.tiempoEsperaClienteMin
    + metricas.tiempoDescargaMin;


metricas.tiempoInactivoMin =
    Math.max(
        0.0,
        metricas.duracionOperacionMin
        - metricas.tiempoActivoMin
    );


if (metricas.tiempoCargaMin > 0.0) {

    metricas.promedioPersonasCarga =
        personaMinCarga
        / metricas.tiempoCargaMin;
}


// =====================================================
// PEDIDOS ASIGNADOS AL CAMIÓN
// =====================================================

for (
    PedidoRuntime runtime
    : pedidosRuntime.values()
) {

    if (
        runtime.camionIdAsignado
        != camion.camionId
    ) {
        continue;
    }


    metricas.tareasPlanificadas++;


    metricas.unidadesPlanificadas +=
        runtime.input.unidadesCapacidad;


    if (
        runtime.estado
        == EstadoPedido.ENTREGADO
    ) {

        metricas.tareasEntregadas++;

        metricas.unidadesEntregadas +=
            runtime.input.unidadesCapacidad;
    }


    else if (
        runtime.estado
        == EstadoPedido.NO_ENTREGADO
        ||
        runtime.estado
        == EstadoPedido.PENDIENTE_DIA_SIGUIENTE
    ) {

        metricas.tareasNoEntregadas++;
    }
}


metricas.unidadesRetornadas =
    camion.unidadesRetornadasCorralon;


// =====================================================
// VIAJES Y OCUPACIÓN
// =====================================================

metricas.viajesCompletados =
    camion.indiceViaje;


if (
    camion.planAsignado != null
    &&
    !camion.planAsignado.viajes.isEmpty()
) {

    int unidadesTotalesViajes =
        0;


    for (
        ViajePlan viaje
        : camion.planAsignado.viajes
    ) {

        for (
            String pedidoId
            : viaje.pedidoIds
        ) {

            unidadesTotalesViajes +=
                obtenerPedidoInput(
                    pedidoId
                ).unidadesCapacidad;
        }
    }


    double capacidadTotalDisponible =
        camion.planAsignado.viajes.size()
        * instanciaActual.capacidadCamion;


    metricas.ocupacionPromedioViajes =
        unidadesTotalesViajes
        / capacidadTotalDisponible;
}


return metricas;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786625657012</Id>
					<Name><![CDATA[imprimirMetricasCamiones]]></Name>
					<X>-810</X><Y>1240</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[resultado]]></Name>
						<Type><![CDATA[ResultadoTurno]]></Type>
					</Parameter>
					<Body><![CDATA[if (resultado == null) {
    return;
}


traceln("");
traceln("================================");
traceln("=== MÉTRICAS POR CAMIÓN ========");
traceln("================================");


for (
    MetricasCamion m
    : resultado.metricasCamiones
) {

    traceln("");
    traceln("Camión " + m.camionId);

    traceln(
        "  Viajes completados: "
        + m.viajesCompletados
    );

    traceln(
        "  Tareas entregadas: "
        + m.tareasEntregadas
        + "/"
        + m.tareasPlanificadas
    );

    traceln(
        "  Unidades entregadas: "
        + m.unidadesEntregadas
        + "/"
        + m.unidadesPlanificadas
    );

    traceln(
        "  Unidades retornadas: "
        + m.unidadesRetornadas
    );

    traceln(
        "  Distancia: "
        + m.distanciaTotalKm
        + " km"
    );

    traceln(
        "  Tiempo carga: "
        + m.tiempoCargaMin
        + " min"
    );

    traceln(
        "  Tiempo viaje: "
        + m.tiempoViajeTotalMin
        + " min"
    );

    traceln(
        "  Tiempo espera cliente: "
        + m.tiempoEsperaClienteMin
        + " min"
    );

    traceln(
        "  Tiempo descarga: "
        + m.tiempoDescargaMin
        + " min"
    );

    traceln(
        "  Tiempo activo: "
        + m.tiempoActivoMin
        + " min"
    );

    traceln(
        "  Tiempo inactivo: "
        + m.tiempoInactivoMin
        + " min"
    );

    traceln(
        "  Ocupación promedio: "
        + 100.0
          * m.ocupacionPromedioViajes
        + " %"
    );

    traceln(
        "  Personas promedio en carga: "
        + m.promedioPersonasCarga
    );

    traceln(
        "  Finalización: "
        + m.minutoFinOperacion
    );
}


traceln("");
traceln(
    "Registros de actividad generados: "
    + resultado.registrosActividad.size()
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786626351798</Id>
					<Name><![CDATA[divisionSegura]]></Name>
					<X>-810</X><Y>1270</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[numerador]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[denominador]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (denominador == 0.0) {
    return 0.0;
}

return numerador / denominador;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.util.ArrayList<ResumenPedidoOriginal>]]></ReturnType>
					<Id>1786626382485</Id>
					<Name><![CDATA[construirResumenesPedidosOriginales]]></Name>
					<X>-810</X><Y>1300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[java.util.LinkedHashMap<String, ResumenPedidoOriginal> porOriginal =
    new java.util.LinkedHashMap<String, ResumenPedidoOriginal>();


for (
    PedidoRuntime runtime
    : pedidosRuntime.values()
) {

    PedidoInput pedido =
        runtime.input;


    String originalId =
        pedido.pedidoOriginalId;


    if (
        originalId == null
        || originalId.trim().isEmpty()
    ) {

        originalId =
            pedido.pedidoId;
    }


    ResumenPedidoOriginal resumen =
        porOriginal.get(
            originalId
        );


    if (resumen == null) {

        resumen =
            new ResumenPedidoOriginal();

        resumen.pedidoOriginalId =
            originalId;

        porOriginal.put(
            originalId,
            resumen
        );
    }


    resumen.partesPlanificadas++;

    resumen.unidadesPlanificadas +=
        pedido.unidadesCapacidad;


    if (
        runtime.estado
        == EstadoPedido.ENTREGADO
    ) {

        resumen.partesEntregadas++;

        resumen.unidadesEntregadas +=
            pedido.unidadesCapacidad;
    }
}


for (
    ResumenPedidoOriginal resumen
    : porOriginal.values()
) {

    resumen.completo =
        resumen.partesEntregadas
        == resumen.partesPlanificadas;
}


return new java.util.ArrayList<ResumenPedidoOriginal>(
    porOriginal.values()
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[MetricasGlobalesTurno]]></ReturnType>
					<Id>1786626405476</Id>
					<Name><![CDATA[construirMetricasGlobales]]></Name>
					<X>-810</X><Y>1330</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[resultado]]></Name>
						<Type><![CDATA[ResultadoTurno]]></Type>
					</Parameter>
					<Body><![CDATA[if (resultado == null) {

    throw new IllegalArgumentException(
        "resultado no puede ser null."
    );
}


if (instanciaActual == null) {

    throw new IllegalStateException(
        "No existe instanciaActual."
    );
}


MetricasGlobalesTurno global =
    new MetricasGlobalesTurno();


double menorFinCamion =
    Double.POSITIVE_INFINITY;

double mayorFinCamion =
    Double.NEGATIVE_INFINITY;

double menorDistanciaKm =
    Double.POSITIVE_INFINITY;

double mayorDistanciaKm =
    Double.NEGATIVE_INFINITY;

double menorTiempoActivo =
    Double.POSITIVE_INFINITY;

double mayorTiempoActivo =
    Double.NEGATIVE_INFINITY;


// =====================================================
// MÉTRICAS POR CAMIÓN
// =====================================================

for (
    MetricasCamion m
    : resultado.metricasCamiones
) {

    if (m == null) {

        continue;
    }


    global.viajesTotales +=
        m.viajesCompletados;

    global.distanciaTotalKm +=
        m.distanciaTotalKm;

    global.tiempoCargaTotalMin +=
        m.tiempoCargaMin;

    global.tiempoViajeTotalMin +=
        m.tiempoViajeTotalMin;

    global.tiempoEsperaClienteTotalMin +=
        m.tiempoEsperaClienteMin;

    global.tiempoDescargaTotalMin +=
        m.tiempoDescargaMin;

    global.tiempoActivoAcumuladoCamionesMin +=
        m.tiempoActivoMin;

    global.unidadesRetornadas +=
        m.unidadesRetornadas;


    global.personaMinCarga +=
        m.promedioPersonasCarga
        * m.tiempoCargaMin;


    menorFinCamion =
        Math.min(
            menorFinCamion,
            m.minutoFinOperacion
        );

    mayorFinCamion =
        Math.max(
            mayorFinCamion,
            m.minutoFinOperacion
        );


    menorDistanciaKm =
        Math.min(
            menorDistanciaKm,
            m.distanciaTotalKm
        );

    mayorDistanciaKm =
        Math.max(
            mayorDistanciaKm,
            m.distanciaTotalKm
        );


    menorTiempoActivo =
        Math.min(
            menorTiempoActivo,
            m.tiempoActivoMin
        );

    mayorTiempoActivo =
        Math.max(
            mayorTiempoActivo,
            m.tiempoActivoMin
        );
}


// =====================================================
// PEDIDOS / TAREAS
// =====================================================

for (
    PedidoRuntime runtime
    : pedidosRuntime.values()
) {

    if (runtime == null) {

        throw new IllegalStateException(
            "pedidosRuntime contiene un "
            + "PedidoRuntime null."
        );
    }


    PedidoInput pedido =
        runtime.input;


    if (pedido == null) {

        throw new IllegalStateException(
            "Existe un PedidoRuntime sin "
            + "PedidoInput asociado."
        );
    }


    global.tareasPlanificadas++;

    global.unidadesPlanificadas +=
        pedido.unidadesCapacidad;


    if (
        runtime.estado
        == EstadoPedido.ENTREGADO
    ) {

        global.tareasEntregadas++;

        global.unidadesEntregadas +=
            pedido.unidadesCapacidad;


        /*
         * Toda tarea entregada debe pertenecer
         * exactamente a una de estas categorías:
         *
         * 1. Aceptada antes de la ventana.
         * 2. Entregada después de una llegada tardía
         *    que el cliente aceptó.
         * 3. Entregada normalmente dentro de la
         *    ventana o después de esperar su apertura.
         *
         * En el tercer caso no debe usarse únicamente
         * minutoLlegada, porque el camión puede llegar
         * antes, esperar hasta la apertura de la ventana
         * y efectuar correctamente la entrega.
         */

        if (runtime.aceptadoAntes) {

            global.entregasAceptadasAntes++;

        } else if (runtime.llegadaTardia) {

            global.entregasTardiasAceptadas++;

        } else {

            global.entregasEnVentana++;
        }

    } else {

        global.tareasNoEntregadas++;


        if (runtime.llegadaTardia) {

            global.llegadasTardiasRechazadas++;
        }
    }


    if (runtime.llegadaTardia) {

        global.cantidadLlegadasTardias++;

        global.tardanzaTotalMin +=
            runtime.tardanzaLlegadaMin;

        global.tardanzaMaxMin =
            Math.max(
                global.tardanzaMaxMin,
                runtime.tardanzaLlegadaMin
            );
    }
}


// =====================================================
// VALIDACIÓN DE CLASIFICACIÓN DE ENTREGAS
// =====================================================

int entregasClasificadas =
    global.entregasEnVentana
    +
    global.entregasAceptadasAntes
    +
    global.entregasTardiasAceptadas;


if (
    entregasClasificadas
    != global.tareasEntregadas
) {

    throw new IllegalStateException(
        "Inconsistencia en la clasificación "
        + "de entregas. Entregadas="
        + global.tareasEntregadas
        + ", clasificadas="
        + entregasClasificadas
        + ", enVentana="
        + global.entregasEnVentana
        + ", aceptadasAntes="
        + global.entregasAceptadasAntes
        + ", tardiasAceptadas="
        + global.entregasTardiasAceptadas
        + "."
    );
}


int tareasContabilizadas =
    global.tareasEntregadas
    +
    global.tareasNoEntregadas;


if (
    tareasContabilizadas
    != global.tareasPlanificadas
) {

    throw new IllegalStateException(
        "Inconsistencia en el balance de tareas. "
        + "Planificadas="
        + global.tareasPlanificadas
        + ", entregadas="
        + global.tareasEntregadas
        + ", no entregadas="
        + global.tareasNoEntregadas
        + "."
    );
}


global.entregasSinTardanza =
    global.entregasEnVentana
    +
    global.entregasAceptadasAntes;


// =====================================================
// PEDIDOS ORIGINALES
// =====================================================

for (
    ResumenPedidoOriginal resumen
    : resultado.resumenesPedidosOriginales
) {

    if (resumen == null) {

        continue;
    }


    global.pedidosOriginalesPlanificados++;


    if (resumen.completo) {

        global.pedidosOriginalesCompletos++;

    } else {

        global.pedidosOriginalesIncompletos++;
    }
}


// =====================================================
// PORCENTAJES
// =====================================================

global.porcentajeTareasEntregadas =
    divisionSegura(
        global.tareasEntregadas,
        global.tareasPlanificadas
    );


global.porcentajePedidosOriginalesCompletos =
    divisionSegura(
        global.pedidosOriginalesCompletos,
        global.pedidosOriginalesPlanificados
    );


global.porcentajeUnidadesEntregadas =
    divisionSegura(
        global.unidadesEntregadas,
        global.unidadesPlanificadas
    );


global.porcentajeEnVentanaSobreEntregadas =
    divisionSegura(
        global.entregasEnVentana,
        global.tareasEntregadas
    );


global.porcentajeServicioSinTardanzaSobrePlanificadas =
    divisionSegura(
        global.entregasSinTardanza,
        global.tareasPlanificadas
    );


global.tardanzaPromedioMin =
    divisionSegura(
        global.tardanzaTotalMin,
        global.cantidadLlegadasTardias
    );


// =====================================================
// FINALIZACIÓN Y OVERTIME
// =====================================================

if (!resultado.metricasCamiones.isEmpty()) {

    global.minutoFinTurnoReal =
        mayorFinCamion;


    global.duracionTurnoRealMin =
        Math.max(
            0.0,
            global.minutoFinTurnoReal
            - instanciaActual.horaInicioTurnoMin
        );


    global.overtimeMin =
        Math.max(
            0.0,
            global.minutoFinTurnoReal
            - instanciaActual.horaFinObjetivoMin
        );


    global.excesoToleranciaMin =
        Math.max(
            0.0,
            global.minutoFinTurnoReal
            - instanciaActual.horaFinToleranciaMin
        );


    global.diferenciaFinCamionesMin =
        Math.max(
            0.0,
            mayorFinCamion
            - menorFinCamion
        );


    global.diferenciaDistanciaCamionesKm =
        Math.max(
            0.0,
            mayorDistanciaKm
            - menorDistanciaKm
        );


    global.diferenciaTiempoActivoCamionesMin =
        Math.max(
            0.0,
            mayorTiempoActivo
            - menorTiempoActivo
        );
}


// =====================================================
// OCUPACIÓN GLOBAL
// =====================================================

double capacidadTotalViajes =
    global.viajesTotales
    * instanciaActual.capacidadCamion;


global.ocupacionGlobalViajes =
    divisionSegura(
        global.unidadesPlanificadas,
        capacidadTotalViajes
    );


global.promedioPersonasCargaGlobal =
    divisionSegura(
        global.personaMinCarga,
        global.tiempoCargaTotalMin
    );


// =====================================================
// PROVEEDORES
// =====================================================

global.proveedoresLlegados =
    historialProveedores.size();


for (
    SolicitudProveedorRuntime solicitud
    : historialProveedores
) {

    if (solicitud == null) {

        continue;
    }


    if (
        solicitud.empleadosRequeridos == 2
    ) {

        global.proveedoresQueRequirieronDosEmpleados++;
    }


    if (
        solicitud.estado
        == EstadoSolicitudProveedor.COMPLETADA
    ) {

        global.proveedoresCompletados++;

    } else if (
        solicitud.estado
        == EstadoSolicitudProveedor
            .CANCELADA_FIN_EJECUCION
    ) {

        global.proveedoresCanceladosFinEjecucion++;
    }


    double esperaProveedor =
        0.0;


    if (
        solicitud.minutoInicioAtencion >= 0.0
    ) {

        esperaProveedor =
            solicitud.minutoInicioAtencion
            - solicitud.minutoLlegada;

    } else if (
        solicitud.minutoFinReal >= 0.0
    ) {

        /*
         * Nunca comenzó la atención y quedó
         * esperando hasta el cierre de la
         * ejecución.
         */

        esperaProveedor =
            solicitud.minutoFinReal
            - solicitud.minutoLlegada;
    }


    esperaProveedor =
        Math.max(
            0.0,
            esperaProveedor
        );


    global.esperaProveedorTotalMin +=
        esperaProveedor;


    global.esperaProveedorMaxMin =
        Math.max(
            global.esperaProveedorMaxMin,
            esperaProveedor
        );


    if (
        solicitud.minutoInicioAtencion >= 0.0
        &&
        solicitud.minutoFinReal
            >= solicitud.minutoInicioAtencion
    ) {

        double tiempoAtencionReal =
            solicitud.minutoFinReal
            - solicitud.minutoInicioAtencion;


        global.tiempoAtencionProveedorTotalMin +=
            tiempoAtencionReal;


        global.personaMinProveedor +=
            tiempoAtencionReal
            * solicitud.empleadosAsignados.size();
    }
}


global.esperaProveedorPromedioMin =
    divisionSegura(
        global.esperaProveedorTotalMin,
        global.proveedoresLlegados
    );


return global;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[DesgloseCostoTurno]]></ReturnType>
					<Id>1786626445922</Id>
					<Name><![CDATA[evaluarCostoTurno]]></Name>
					<X>-810</X><Y>1360</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metricas]]></Name>
						<Type><![CDATA[MetricasGlobalesTurno]]></Type>
					</Parameter>
					<Body><![CDATA[if (metricas == null) {

    throw new IllegalArgumentException(
        "metricas no puede ser null."
    );
}


DesgloseCostoTurno costo =
    new DesgloseCostoTurno();


costo.costoTareasNoEntregadas =
    metricas.tareasNoEntregadas
    * COSTO_TAREA_NO_ENTREGADA;


costo.costoPedidosOriginalesIncompletos =
    metricas.pedidosOriginalesIncompletos
    * COSTO_PEDIDO_ORIGINAL_INCOMPLETO;


costo.costoTardanza =
    metricas.tardanzaTotalMin
    * COSTO_POR_MIN_TARDANZA;


costo.costoExcesoTolerancia =
    metricas.excesoToleranciaMin
    * COSTO_POR_MIN_EXCESO_TOLERANCIA;


costo.costoOperacion =
    metricas.duracionTurnoRealMin
    * COSTO_POR_MIN_OPERACION;


costo.costoDistancia =
    metricas.distanciaTotalKm
    * COSTO_POR_KM;


costo.costoViajes =
    metricas.viajesTotales
    * COSTO_POR_VIAJE;


costo.costoDesbalance =
    metricas.diferenciaFinCamionesMin
    * COSTO_POR_MIN_DESBALANCE_FIN;


costo.costoTotal =
    costo.costoTareasNoEntregadas
    + costo.costoPedidosOriginalesIncompletos
    + costo.costoTardanza
    + costo.costoExcesoTolerancia
    + costo.costoOperacion
    + costo.costoDistancia
    + costo.costoViajes
    + costo.costoDesbalance;


return costo;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ResultadoTurno]]></ReturnType>
					<Id>1786626499999</Id>
					<Name><![CDATA[construirResultadoTurno]]></Name>
					<X>-810</X><Y>1390</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (instanciaActual == null) {

    throw new IllegalStateException(
        "No existe instanciaActual."
    );
}


if (planActual == null) {

    throw new IllegalStateException(
        "No existe planActual."
    );
}


ResultadoTurno resultado =
    new ResultadoTurno();


resultado.instanciaId =
    instanciaActual.instanciaId;

resultado.fechaOperacion =
    instanciaActual.fechaOperacion;

resultado.turno =
    instanciaActual.turno;

resultado.algoritmo =
    planActual.algoritmo;

resultado.seedEscenario =
    instanciaActual.seedEscenario;

resultado.seedEjecucion =
    instanciaActual.seedEjecucion;

resultado.planValido =
    true;

resultado.ejecucionCompletada =
    ejecucionFinalizada;


// =====================================================
// CAMIONES Y ACTIVIDADES
// =====================================================

for (Camion camion : camiones) {

    MetricasCamion metricas =
        construirMetricasCamion(
            camion
        );


    resultado.metricasCamiones.add(
        metricas
    );


    resultado.registrosActividad.addAll(
        camion.historialActividades
    );
}


// =====================================================
// PEDIDOS ORIGINALES
// =====================================================

resultado.resumenesPedidosOriginales.addAll(
    construirResumenesPedidosOriginales()
);


// =====================================================
// KPI GLOBAL
// =====================================================

resultado.metricasGlobales =
    construirMetricasGlobales(
        resultado
    );


if (resultado.metricasGlobales == null) {

    throw new IllegalStateException(
        "construirMetricasGlobales devolvió null."
    );
}


// =====================================================
// VALIDACIÓN DEFENSIVA DE CLASIFICACIÓN
// =====================================================

int entregasClasificadas =
    resultado.metricasGlobales
        .entregasEnVentana
    +
    resultado.metricasGlobales
        .entregasAceptadasAntes
    +
    resultado.metricasGlobales
        .entregasTardiasAceptadas;


if (
    entregasClasificadas
    != resultado.metricasGlobales
        .tareasEntregadas
) {

    throw new IllegalStateException(
        "Inconsistencia en la clasificación "
        + "de entregas. Entregadas="
        + resultado.metricasGlobales
            .tareasEntregadas
        + ", clasificadas="
        + entregasClasificadas
        + ", enVentana="
        + resultado.metricasGlobales
            .entregasEnVentana
        + ", aceptadasAntes="
        + resultado.metricasGlobales
            .entregasAceptadasAntes
        + ", tardiasAceptadas="
        + resultado.metricasGlobales
            .entregasTardiasAceptadas
        + "."
    );
}


// =====================================================
// COSTO
// =====================================================

resultado.desgloseCosto =
    evaluarCostoTurno(
        resultado.metricasGlobales
    );


if (resultado.desgloseCosto == null) {

    throw new IllegalStateException(
        "evaluarCostoTurno devolvió null."
    );
}


resultado.costoTotal =
    resultado.desgloseCosto.costoTotal;


return resultado;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786626524198</Id>
					<Name><![CDATA[imprimirMetricasGlobales]]></Name>
					<X>-810</X><Y>1420</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[resultado]]></Name>
						<Type><![CDATA[ResultadoTurno]]></Type>
					</Parameter>
					<Body><![CDATA[if (
    resultado == null
    || resultado.metricasGlobales == null
) {
    return;
}


MetricasGlobalesTurno g =
    resultado.metricasGlobales;


traceln("");
traceln("================================");
traceln("=== MÉTRICAS GLOBALES =========");
traceln("================================");


traceln(
    "Tareas entregadas: "
    + g.tareasEntregadas
    + "/"
    + g.tareasPlanificadas
    + " ("
    + 100.0 * g.porcentajeTareasEntregadas
    + " %)"
);


traceln(
    "Pedidos originales completos: "
    + g.pedidosOriginalesCompletos
    + "/"
    + g.pedidosOriginalesPlanificados
    + " ("
    + 100.0
      * g.porcentajePedidosOriginalesCompletos
    + " %)"
);


traceln(
    "Unidades entregadas: "
    + g.unidadesEntregadas
    + "/"
    + g.unidadesPlanificadas
    + " ("
    + 100.0
      * g.porcentajeUnidadesEntregadas
    + " %)"
);


traceln(
    "Entregas en ventana: "
    + g.entregasEnVentana
);


traceln(
    "Aceptadas antes: "
    + g.entregasAceptadasAntes
);


traceln(
    "Tardías aceptadas: "
    + g.entregasTardiasAceptadas
);


traceln(
    "Tardías rechazadas: "
    + g.llegadasTardiasRechazadas
);


traceln(
    "Tardanza total/media/máxima: "
    + g.tardanzaTotalMin
    + " / "
    + g.tardanzaPromedioMin
    + " / "
    + g.tardanzaMaxMin
    + " min"
);


traceln(
    "Viajes totales: "
    + g.viajesTotales
);


traceln(
    "Distancia total: "
    + g.distanciaTotalKm
    + " km"
);


traceln(
    "Tiempo carga total: "
    + g.tiempoCargaTotalMin
    + " min"
);


traceln(
    "Tiempo viaje total: "
    + g.tiempoViajeTotalMin
    + " min"
);


traceln(
    "Tiempo espera cliente total: "
    + g.tiempoEsperaClienteTotalMin
    + " min"
);


traceln(
    "Tiempo descarga total: "
    + g.tiempoDescargaTotalMin
    + " min"
);


traceln(
    "Fin real: "
    + g.minutoFinTurnoReal
);


traceln(
    "Duración operativa: "
    + g.duracionTurnoRealMin
    + " min"
);


traceln(
    "Overtime: "
    + g.overtimeMin
    + " min"
);


traceln(
    "Exceso de tolerancia: "
    + g.excesoToleranciaMin
    + " min"
);


traceln(
    "Ocupación global: "
    + 100.0
      * g.ocupacionGlobalViajes
    + " %"
);


traceln(
    "Promedio personas en carga: "
    + g.promedioPersonasCargaGlobal
);


traceln(
    "Diferencia de finalización: "
    + g.diferenciaFinCamionesMin
    + " min"
);


traceln(
    "Proveedores llegados/completados/cancelados: "
    + g.proveedoresLlegados
    + "/"
    + g.proveedoresCompletados
    + "/"
    + g.proveedoresCanceladosFinEjecucion
);


traceln("");
traceln("=== COSTO PRELIMINAR ===");


traceln(
    resultado.desgloseCosto
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[InstanciaTurno]]></ReturnType>
					<Id>1786648005413</Id>
					<Name><![CDATA[crearInstanciaAlpyneHandshake]]></Name>
					<X>-810</X><Y>1450</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[seed]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[InstanciaTurno instancia =
    new InstanciaTurno();


instancia.instanciaId =
    "ALPYNE-HANDSHAKE-"
    + seed;

instancia.fechaOperacion =
    "2026-08-13";

instancia.turno =
    Turno.MANANA;


instancia.latCorralon =
    LAT_CORRALON;

instancia.lonCorralon =
    LON_CORRALON;


instancia.capacidadCamion =
    CAPACIDAD_CAMION;

instancia.cantidadCamiones =
    CANTIDAD_CAMIONES;


instancia.horaInicioTurnoMin =
    horaInicioTurno(
        instancia.turno
    );

instancia.horaFinObjetivoMin =
    horaFinObjetivoTurno(
        instancia.turno
    );

instancia.horaFinToleranciaMin =
    horaFinToleranciaTurno(
        instancia.turno
    );


instancia.seedEscenario =
    seed;

instancia.seedEjecucion =
    seed;


// Pedido pequeño y cercano al corralón.
// La intención es terminar el episodio
// bastante antes de 60 minutos simulados.

PedidoInput pedido =
    crearPedidoPrueba(
        "ALP-P001",
        1,
        false,
        LAT_CORRALON + 0.001,
        LON_CORRALON + 0.001
    );


pedido.cliente =
    "Cliente handshake Alpyne";

pedido.direccion =
    "Ubicación de prueba";

pedido.barrio =
    "TEST_ALPYNE";


instancia.pedidos.add(
    pedido
);


return instancia;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[PlanTurno]]></ReturnType>
					<Id>1786648081442</Id>
					<Name><![CDATA[crearPlanAlpyneHandshake]]></Name>
					<X>-810</X><Y>1480</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Body><![CDATA[if (instancia == null) {

    throw new IllegalArgumentException(
        "La instancia Alpyne no puede ser null."
    );
}


PlanTurno plan =
    new PlanTurno();


plan.instanciaId =
    instancia.instanciaId;

plan.algoritmo =
    AlgoritmoPlanificacion.MANUAL_TEST;

plan.costoEstimado =
    0.0;

plan.tiempoComputoMs =
    0.0;


// =====================================================
// CAMIÓN 0
// =====================================================

PlanCamion camion0 =
    new PlanCamion();

camion0.camionId =
    0;


ViajePlan viaje0 =
    new ViajePlan();

viaje0.numeroViaje =
    1;

viaje0.pedidoIds.add(
    "ALP-P001"
);


camion0.viajes.add(
    viaje0
);


// =====================================================
// CAMIÓN 1
// =====================================================
//
// Se incluye porque el validador exige exactamente
// CANTIDAD_CAMIONES elementos PlanCamion.
// Puede tener cero viajes.

PlanCamion camion1 =
    new PlanCamion();

camion1.camionId =
    1;


// =====================================================
// PLAN COMPLETO
// =====================================================

plan.camiones.add(
    camion0
);

plan.camiones.add(
    camion1
);


return plan;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786648136315</Id>
					<Name><![CDATA[procesarAccionAlpyne]]></Name>
					<X>-810</X><Y>1510</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[accionCodigo]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[alpyneAccionRecibida =
    true;

alpyneAccionCodigo =
    accionCodigo;

alpyneError =
    false;

alpyneInstanciaAceptada =
    false;

alpynePlanAceptado =
    false;

alpyneCantidadPedidos =
    0;

alpyneMensaje =
    "ACCIÓN RECIBIDA";


if (ejecucionEnCurso) {

    alpyneError =
        true;

    alpyneMensaje =
        "Ya existe una ejecución en curso.";

    return;
}


try {

    InstanciaTurno instancia;

    PlanTurno plan;


    if (accionCodigo == 1) {

        instancia =
            crearInstanciaAlpyneHandshake(
                alpyneSeedEjecucion
            );

        plan =
            crearPlanAlpyneHandshake(
                instancia
            );

    } else if (accionCodigo == 2) {

        instancia =
            crearInstanciaAlpyneDinamica(
                alpyneInstanciaVector,
                alpyneSeedEjecucion
            );

        alpyneInstanciaAceptada =
            true;

        alpyneCantidadPedidos =
            instancia.pedidos.size();


        plan =
            crearPlanAlpyneDinamico(
                alpynePlanVector,
                instancia
            );

    } else {

        throw new IllegalArgumentException(
            "Código de acción no soportado: "
            + accionCodigo
        );
    }


    alpyneInstanciaAceptada =
        true;

    alpyneCantidadPedidos =
        instancia.pedidos.size();


    ResultadoValidacionPlan validacion =
        validarPlan(
            instancia,
            plan
        );


    if (!validacion.valido) {

        alpyneError =
            true;

        alpyneMensaje =
            "Plan Alpyne inválido: "
            + validacion.errores;

        return;
    }


    alpynePlanAceptado =
        true;


    boolean inicioCorrecto =
        ejecutarPlan(
            instancia,
            plan
        );


    if (!inicioCorrecto) {

        alpyneError =
            true;

        alpynePlanAceptado =
            false;

        alpyneMensaje =
            "ejecutarPlan devolvió false.";

        return;
    }


    alpyneMensaje =
        accionCodigo == 1
        ? "PLAN HANDSHAKE EN EJECUCIÓN"
        : "PLAN DINÁMICO EN EJECUCIÓN";


} catch (Exception ex) {

    alpyneError =
        true;

    alpyneMensaje =
        ex.getClass().getSimpleName()
        + ": "
        + ex.getMessage();


    traceln(
        "ERROR ALPYNE: "
        + alpyneMensaje
    );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1786648157977</Id>
					<Name><![CDATA[esTerminalAlpyne]]></Name>
					<X>-810</X><Y>1540</Y>
