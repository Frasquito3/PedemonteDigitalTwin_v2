						<Name><![CDATA[pedidoId]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[PedidoRuntime pedido = pedidosRuntime.get(pedidoId);

if (pedido == null) {
    throw new IllegalArgumentException(
        "No existe PedidoRuntime para el ID: " + pedidoId
    );
}

return pedido;]]></Body>
