		<JavaClass>
			<Id>1786562122298</Id>
			<Name><![CDATA[TrabajadorRuntime]]></Name>
			<Folder>1786556019063</Folder>
			<Text><![CDATA[/**
 * TrabajadorRuntime
 */	
public class TrabajadorRuntime implements Serializable {

	public String trabajadorId = "";

	public TipoTrabajador tipo =
	    TipoTrabajador.EMPLEADO_CORRALON;

	// Sólo se usa para choferes.
	// -1 significa que no tiene camión propio.
	public int camionPropioId = -1;

	// -1 significa que no está cargando ningún camión.
	public int cargandoCamionId = -1;

	// Indica si un proveedor ocupa temporalmente el recurso de carga.
	public boolean ocupadoProveedor = false;


	public boolean estaLibre() {
	    return cargandoCamionId < 0
	        && !ocupadoProveedor;
	}


	@Override
	public String toString() {
	    return trabajadorId;
	}

}]]></Text>
		</JavaClass>
