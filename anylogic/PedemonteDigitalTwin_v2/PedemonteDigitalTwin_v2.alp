					<Text><![CDATA[text]]></Text>
					<TextCode><![CDATA[planActual == null
?
"Sin plan disponible.\nMétodo aplicado: —"
:
(
    ejecucionEnCurso
    ?
    (
        "Plan en ejecución.\nMétodo aplicado: "
        + planActual.algoritmo
    )
    :
    (
        ejecucionFinalizada
        ?
        (
            "Plan finalizado.\nMétodo aplicado: "
            + planActual.algoritmo
        )
        :
        (
            "Plan preparado.\nMétodo aplicado: "
            + planActual.algoritmo
        )
    )
)]]></TextCode>
