				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788117632653</Id>
					<Name><![CDATA[textoEstadoGraficoComparacion]]></Name>
					<X>-810</X><Y>5680</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    !comparacionEstimadaDisponible
) {

    return
        "Ejecute la comparación estimada "
        + "para habilitar el gráfico.";
}

if (
    graficoCostoTiempoSeleccionado()
    &&
    !"Estimado".equals(
        modoDatosComparacion
    )
) {

    return
        "Este gráfico relaciona el costo estimado "
        + "con el tiempo de planificación de Python."
        + "\nSeleccione la fuente Estimado.";
}

boolean requiereSimulacion =
    "Simulado".equals(
        modoDatosComparacion
    )
    ||
    modoGraficoComparacionDoble();


if (
    requiereSimulacion
    &&
    (
        !comparacionSimuladaDisponible
        ||
        !comparacionSimuladaCompleta
    )
) {

    return
        "Todavía no hay resultados simulados."
        + "\nEjecute la comparación simulada "
        + "para utilizar esta fuente.";
}


if (
    "Tiempo de planificación".equals(
        graficoComparacionSeleccionado
    )
    &&
    requiereSimulacion
) {

    return
        "El tiempo de planificación "
        + "solo posee valores estimados."
        + "\nSeleccione la fuente Estimado.";
}


if (
    graficoDesgloseCostoSeleccionado()
    &&
    modoGraficoComparacionDoble()
) {

    return
        "El desglose del costo se muestra "
        + "para una fuente por vez."
        + "\nSeleccione Estimado o Simulado.";
}


return
    "No hay datos disponibles para "
    + "la métrica seleccionada.";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
