				<Event>
					<Id>1786648252277</Id>
					<Name><![CDATA[eventoDecisionAlpyne]]></Name>
					<X>-1390</X><Y>100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="occuresOnce">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_MINUTE]]></Unit>
						</Rate>
						<Id>1786648252275</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1786694400000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[if (
    MODO_EJECUCION
        == ModoEjecucion.RL_TRAINING

    ||

    MODO_EJECUCION
        == ModoEjecucion.RL_EVALUATION
) {

    alpyneConfigurado =
        true;

    alpyneAccionRecibida =
        false;

    alpyneAccionCodigo =
        0;

    alpynePlanVector =
        new double[0];

    alpyneError =
        false;

    alpyneInstanciaAceptada =
        false;

    alpynePlanAceptado =
        false;

    alpyneCantidadPedidos =
        0;

    alpyneMensaje =
    "ESPERANDO ACCIÓN";


	traceln(
	    "ALPYNE CONFIG | seed="
	    + alpyneSeedEjecucion
	    + " | instanciaVector.length="
	    + (
	        alpyneInstanciaVector == null
	        ? -1
	        : alpyneInstanciaVector.length
	    )
	);
	
	
	AlpyneExperiment.takeAction(
	    this
	);
}]]></Action>
				</Event>
