				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788120424108</Id>
					<Name><![CDATA[formatearValorGraficoComparacion]]></Name>
					<X>-810</X><Y>5860</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[valor]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (
    Double.isNaN(valor)
    ||
    Double.isInfinite(valor)
) {

    return "—";
}


String metrica =
    graficoComparacionSeleccionado == null
    ? ""
    : graficoComparacionSeleccionado.trim();


switch (metrica) {

    case "Costo total":

        return
            formatearNumeroComparacion(
                valor,
                2
            );

	case "Desglose del costo":

	    return
	        formatearNumeroComparacion(
	            valor,
	            2
	        );

    case "Distancia":

        return
            formatearNumeroComparacion(
                valor,
                2
            )
            + " km";


    case "Duración":

        return
            formatearNumeroComparacion(
                valor,
                1
            )
            + " min";


    case "Viajes":

        return String.valueOf(
            (int) Math.round(
                valor
            )
        );


    case "Tardanza":

    case "Desbalance":

        return
            formatearNumeroComparacion(
                valor,
                1
            )
            + " min";


    case "Tiempo de planificación":

        return
            formatearNumeroComparacion(
                valor,
                2
            )
            + " ms";


    default:

        return "—";
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
