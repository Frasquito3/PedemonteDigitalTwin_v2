						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[PedidoInput p =
    new PedidoInput();


p.pedidoId = id;

p.pedidoOriginalId = id;

p.numeroParte = 1;

p.totalPartes = 1;

p.turno =
    Turno.MANANA;

p.latitud = lat;

p.longitud = lon;

p.unidadesCapacidad =
    unidades;

p.requiereVolcador =
    volcador;

p.tieneVentanaEspecifica =
    false;

p.horaDesdeMin =
    HORA_INICIO_MANANA_MIN;

p.horaHastaMin =
    HORA_FIN_MANANA_MIN;

p.cliente =
    "Cliente " + id;

p.direccion =
    "Dirección " + id;

p.barrio =
    "TEST";

p.observaciones =
    "";


return p;]]></Body>
