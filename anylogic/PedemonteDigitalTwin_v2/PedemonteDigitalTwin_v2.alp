					<Id>1788121891250</Id>
					<Name><![CDATA[maximoTotalDesgloseCosto]]></Name>
					<X>-810</X><Y>5980</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[String[] metodos = {
    "RL",
    "HIBRIDO",
    "GREEDY",
    "RANDOM",
    "GA"
};


double maximo =
    0.0;


for (
    String metodo
    : metodos
) {

    double total =
        valorAcumuladoDesgloseCosto(
            metodo,
            "TOTAL"
        );


    if (
        !Double.isNaN(
            total
        )
        &&
        !Double.isInfinite(
            total
        )
        &&
        total > maximo
    ) {

        maximo =
            total;
    }
}


return maximo;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788121905778</Id>
					<Name><![CDATA[anchoCapaDesgloseCosto]]></Name>
					<X>-810</X><Y>6010</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metodo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[capa]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[double valor =
    valorAcumuladoDesgloseCosto(
        metodo,
        capa
    );


double maximo =
    maximoTotalDesgloseCosto();


if (
    Double.isNaN(
        valor
    )
    ||
    Double.isInfinite(
        valor
    )
    ||
    valor <= 0.0
    ||
    maximo <= 0.0
) {

    return 0.0;
}


double ancho =
    600.0
    *
    valor
    /
    maximo;


return Math.max(
    1.0,
    Math.min(
        600.0,
        ancho
    )
);]]></Body>
				</Function>
