			<ObservationCode><![CDATA[protocoloVersion =
    root.alpyneProtocoloVersion;

configurado =
    root.alpyneConfigurado;

accionRecibida =
    root.alpyneAccionRecibida;

instanciaAceptada =
    root.alpyneInstanciaAceptada;

planAceptado =
    root.alpynePlanAceptado;

cantidadPedidos =
    root.alpyneCantidadPedidos;

ejecucionEnCurso =
    root.ejecucionEnCurso;

ejecucionFinalizada =
    root.ejecucionFinalizada;

error =
    root.alpyneError;

mensaje =
    root.alpyneMensaje;

costoTotal =
    root.costoTotalAlpyne();

tareasEntregadas =
    root.tareasEntregadasAlpyne();

tareasNoEntregadas =
    root.tareasNoEntregadasAlpyne();

viajesTotales =
    root.viajesTotalesAlpyne();


if (
    root.resultadoActual == null
    ||
    root.resultadoActual.metricasGlobales == null
) {

    tiempoSimuladoMin =
        0.0;

} else {

    tiempoSimuladoMin =
        root.resultadoActual
            .metricasGlobales
            .duracionTurnoRealMin;
}

resultadoDisponible =
    root.resultadoActual != null
    &&
    root.resultadoActual.ejecucionCompletada
    &&
    root.resultadoActual.metricasGlobales != null
    &&
    root.resultadoActual.desgloseCosto != null;


if (!resultadoDisponible) {

    instanciaId =
        "";
        
    fechaOperacionResultado =
    	"";

    algoritmoAplicado =
        "";

    seedEscenarioResultado =
        0L;

    seedEjecucionResultado =
        0L;

    distanciaTotalKm =
        0.0;

    tardanzaTotalMin =
        0.0;

    diferenciaFinCamionesMin =
        0.0;

    ocupacionGlobalPct =
        0.0;

    costoTareasNoEntregadas =
        0.0;

    costoPedidosOriginalesIncompletos =
        0.0;

    costoTardanza =
        0.0;

    costoExcesoTolerancia =
        0.0;

    costoOperacion =
        0.0;

    costoDistancia =
        0.0;

    costoViajes =
        0.0;

    costoDesbalance =
        0.0;

} else {

    instanciaId =
        root.resultadoActual.instanciaId == null
        ? ""
        : root.resultadoActual.instanciaId;
	
	fechaOperacionResultado =
	    root.resultadoActual.fechaOperacion == null
	    ? ""
	    : root.resultadoActual.fechaOperacion;

    algoritmoAplicado =
        root.resultadoActual.algoritmo == null
        ? ""
        : root.resultadoActual
            .algoritmo
            .toString();


    seedEscenarioResultado =
        root.resultadoActual.seedEscenario;


    seedEjecucionResultado =
        root.resultadoActual.seedEjecucion;


    distanciaTotalKm =
        root.resultadoActual
            .metricasGlobales
            .distanciaTotalKm;


    tardanzaTotalMin =
        root.resultadoActual
            .metricasGlobales
            .tardanzaTotalMin;


    diferenciaFinCamionesMin =
        root.resultadoActual
            .metricasGlobales
            .diferenciaFinCamionesMin;


    ocupacionGlobalPct =
	    100.0
	    *
	    root.resultadoActual
	        .metricasGlobales
	        .ocupacionGlobalViajes;


    costoTareasNoEntregadas =
        root.resultadoActual
            .desgloseCosto
            .costoTareasNoEntregadas;


    costoPedidosOriginalesIncompletos =
        root.resultadoActual
            .desgloseCosto
            .costoPedidosOriginalesIncompletos;


    costoTardanza =
        root.resultadoActual
            .desgloseCosto
            .costoTardanza;


    costoExcesoTolerancia =
        root.resultadoActual
            .desgloseCosto
            .costoExcesoTolerancia;


    costoOperacion =
        root.resultadoActual
            .desgloseCosto
            .costoOperacion;


    costoDistancia =
        root.resultadoActual
            .desgloseCosto
            .costoDistancia;


    costoViajes =
        root.resultadoActual
            .desgloseCosto
            .costoViajes;


    costoDesbalance =
        root.resultadoActual
            .desgloseCosto
            .costoDesbalance;
}]]></ObservationCode>
			<StopCondition><![CDATA[root.esTerminalAlpyne()]]></StopCondition>
			<ActionField>
				<Name><![CDATA[accionCodigo]]></Name>
				<Type><![CDATA[int]]></Type>
			</ActionField>
			<ActionField>
				<Name><![CDATA[planVector]]></Name>
				<Type><![CDATA[double[]]]></Type>
			</ActionField>
			<ActionCode><![CDATA[root.alpynePlanVector =
    planVector == null
    ? new double[0]
    : planVector.clone();


root.procesarAccionAlpyne(
    accionCodigo
);]]></ActionCode>
			<ConfigurationField>
				<Name><![CDATA[seedEjecucion]]></Name>
				<Type><![CDATA[int]]></Type>
			</ConfigurationField>
			<ConfigurationField>
				<Name><![CDATA[instanciaVector]]></Name>
				<Type><![CDATA[double[]]]></Type>
			</ConfigurationField>
			<ConfigurationField>
				<Name><![CDATA[rutaPythonProyectoPypeline]]></Name>
				<Type><![CDATA[String]]></Type>
			</ConfigurationField>
			<ConfigurationField>
				<Name><![CDATA[proveedoresHabilitados]]></Name>
				<Type><![CDATA[boolean]]></Type>
			</ConfigurationField>
			<ConfigurationField>
				<Name><![CDATA[instanciaId]]></Name>
				<Type><![CDATA[String]]></Type>
			</ConfigurationField>
			<ConfigurationField>
				<Name><![CDATA[fechaOperacion]]></Name>
				<Type><![CDATA[String]]></Type>
			</ConfigurationField>
			<ConfigurationField>
				<Name><![CDATA[identificadoresPedidos]]></Name>
				<Type><![CDATA[String]]></Type>
			</ConfigurationField>
			<ConfigurationField>
				<Name><![CDATA[seedEscenario]]></Name>
				<Type><![CDATA[int]]></Type>
			</ConfigurationField>
			<ConfigurationCode><![CDATA[root.MODO_EJECUCION =
    ModoEjecucion.RL_EVALUATION;


root.PROVEEDORES_HABILITADOS =
    proveedoresHabilitados;


/*
 * El modelo exportado se ejecuta dentro de una carpeta
 * temporal de Alpyne.
 *
 * La ruta se conserva también como propiedad del proceso
 * Java para que pueda recuperarse durante la inicialización.
 */
String rutaPythonConfigurada =
    rutaPythonProyectoPypeline == null
    ? ""
    : rutaPythonProyectoPypeline.trim();


if (rutaPythonConfigurada.isEmpty()) {

    System.clearProperty(
        "pedemonte.python.root"
    );

} else {

    System.setProperty(
        "pedemonte.python.root",
        rutaPythonConfigurada
    );
}


root.rutaPythonProyectoPypeline =
    rutaPythonConfigurada;


root.alpyneSeedEjecucion =
    seedEjecucion;


root.alpyneSeedEscenario =
    seedEscenario;


root.alpyneInstanciaVector =
    instanciaVector == null
    ? new double[0]
    : instanciaVector.clone();


root.alpyneInstanciaId =
    instanciaId == null
    ? ""
    : instanciaId.trim();


root.alpyneFechaOperacion =
    fechaOperacion == null
    ? ""
    : fechaOperacion.trim();


root.alpyneIdentificadoresPedidos =
    identificadoresPedidos == null
    ? ""
    : identificadoresPedidos.trim();


traceln(
    "CONFIG ALPYNE RECIBIDA"
    + " | instanciaId="
    + root.alpyneInstanciaId
    + " | fecha="
    + root.alpyneFechaOperacion
    + " | seedEscenario="
    + root.alpyneSeedEscenario
    + " | seedEjecucion="
    + root.alpyneSeedEjecucion
    + " | instanciaVector="
    + root.alpyneInstanciaVector.length
    + " | contratoIdsChars="
    + root.alpyneIdentificadoresPedidos.length()
    + " | proveedores="
    + root.PROVEEDORES_HABILITADOS
);]]></ConfigurationCode>
		</ReinforcementLearningExperiment>
	</Experiments>
	<JavaClasses>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1786556719840</Id>
			<Name><![CDATA[PedidoInput]]></Name>
			<Folder>1786556019063</Folder>
			<Text><![CDATA[/**
 * PedidoInput
 */	
public class PedidoInput implements Serializable {

	public String pedidoId = "";

	public String pedidoOriginalId = "";

	public int numeroParte = 1;

	public int totalPartes = 1;

	public Turno turno = Turno.MANANA;

	public double latitud = 0.0;

	public double longitud = 0.0;

	public int unidadesCapacidad = 0;

	public boolean requiereVolcador = false;

	public boolean tieneVentanaEspecifica = false;

	public int horaDesdeMin = 0;

	public int horaHastaMin = 0;

	public String cliente = "";

	public String direccion = "";

	public String barrio = "";

	public String observaciones = "";


	public boolean esSplit() {
	    return totalPartes > 1;
	}


	@Override
	public String toString() {
	    return "PedidoInput{" +
	        "pedidoId='" + pedidoId + '\'' +
	        ", pedidoOriginalId='" + pedidoOriginalId + '\'' +
	        ", parte=" + numeroParte + "/" + totalPartes +
	        ", turno=" + turno +
	        ", unidades=" + unidadesCapacidad +
	        ", volcador=" + requiereVolcador +
	        '}';
	}

}            ]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1786556831673</Id>
			<Name><![CDATA[InstanciaTurno]]></Name>
			<Folder>1786556019063</Folder>
			<Text><![CDATA[/**
 * InstanciaTurno
 */	
public class InstanciaTurno implements Serializable {

	public String instanciaId = "";

	public String fechaOperacion = "";

	public Turno turno = Turno.MANANA;

	public java.util.ArrayList<PedidoInput> pedidos =
	    new java.util.ArrayList<PedidoInput>();

	public double latCorralon = 0.0;

	public double lonCorralon = 0.0;

	public int capacidadCamion = 0;

	public int cantidadCamiones = 0;

	public int horaInicioTurnoMin = 0;

	public int horaFinObjetivoMin = 0;

	public int horaFinToleranciaMin = 0;

	public long seedEscenario = 0L;

	public long seedEjecucion = 0L;


	@Override
	public String toString() {
	    return "InstanciaTurno{" +
	        "instanciaId='" + instanciaId + '\'' +
	        ", turno=" + turno +
	        ", pedidos=" + pedidos.size() +
	        ", capacidadCamion=" + capacidadCamion +
	        ", cantidadCamiones=" + cantidadCamiones +
	        '}';
	}

}]]></Text>
