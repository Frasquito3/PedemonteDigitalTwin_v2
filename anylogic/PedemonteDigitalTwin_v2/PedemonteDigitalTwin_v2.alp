			<Name><![CDATA[MetricasCamion]]></Name>
			<Folder>1786556019063</Folder>
			<Text><![CDATA[/**
 * MetricasCamion
 */	
public class MetricasCamion implements Serializable {

	public int camionId = -1;


	// =====================================================
	// PRODUCCIÓN
	// =====================================================

	public int viajesCompletados = 0;

	public int tareasPlanificadas = 0;

	public int tareasEntregadas = 0;

	public int tareasNoEntregadas = 0;

	public int unidadesPlanificadas = 0;

	public int unidadesEntregadas = 0;

	public int unidadesRetornadas = 0;


	// =====================================================
	// DISTANCIA
	// =====================================================

	public double distanciaTotalMetros = 0.0;

	public double distanciaTotalKm = 0.0;


	// =====================================================
	// TIEMPOS
	// =====================================================

	public double tiempoCargaMin = 0.0;

	public double tiempoViajeClienteMin = 0.0;

	public double tiempoRegresoMin = 0.0;

	public double tiempoViajeTotalMin = 0.0;

	public double tiempoEsperaClienteMin = 0.0;

	public double tiempoDescargaMin = 0.0;

	public double tiempoActivoMin = 0.0;

	public double tiempoInactivoMin = 0.0;


	// =====================================================
	// INICIO Y FINALIZACIÓN
	// =====================================================

	public double minutoInicioOperacion = -1.0;

	public double minutoFinOperacion = -1.0;

	public double duracionOperacionMin = 0.0;


	// =====================================================
	// UTILIZACIÓN
	// =====================================================

	public double ocupacionPromedioViajes = 0.0;

	public double promedioPersonasCarga = 0.0;


	@Override
	public String toString() {

	    return "MetricasCamion{" +
	        "camionId=" + camionId +
	        ", viajes=" + viajesCompletados +
	        ", entregadas=" + tareasEntregadas +
	        "/" + tareasPlanificadas +
	        ", distanciaKm=" + distanciaTotalKm +
	        ", cargaMin=" + tiempoCargaMin +
	        ", viajeMin=" + tiempoViajeTotalMin +
	        ", esperaMin=" + tiempoEsperaClienteMin +
	        ", descargaMin=" + tiempoDescargaMin +
	        ", activoMin=" + tiempoActivoMin +
	        ", inactivoMin=" + tiempoInactivoMin +
	        ", ocupacion=" + ocupacionPromedioViajes +
	        '}';
	}

}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1786626144858</Id>
			<Name><![CDATA[ResumenPedidoOriginal]]></Name>
			<Folder>1786556019063</Folder>
			<Text><![CDATA[/**
 * ResumenPedidoOriginal
 */	
public class ResumenPedidoOriginal implements Serializable {

	public String pedidoOriginalId = "";

	public int partesPlanificadas = 0;

	public int partesEntregadas = 0;

	public int unidadesPlanificadas = 0;

	public int unidadesEntregadas = 0;

	public boolean completo = false;


	@Override
	public String toString() {

	    return "ResumenPedidoOriginal{" +
	        "pedidoOriginalId='" + pedidoOriginalId + '\'' +
	        ", partesEntregadas=" + partesEntregadas +
	        "/" + partesPlanificadas +
	        ", unidadesEntregadas=" + unidadesEntregadas +
	        "/" + unidadesPlanificadas +
	        ", completo=" + completo +
	        '}';
	}

}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1786626165121</Id>
			<Name><![CDATA[MetricasGlobalesTurno]]></Name>
			<Folder>1786556019063</Folder>
			<Text><![CDATA[/**
 * MetricasGlobalesTurno
 */	
public class MetricasGlobalesTurno implements Serializable {

	// =====================================================
	// ENTREGA POR TAREA
	// =====================================================

	public int tareasPlanificadas = 0;

	public int tareasEntregadas = 0;

	public int tareasNoEntregadas = 0;

	public double porcentajeTareasEntregadas = 0.0;


	// =====================================================
	// PEDIDOS EMPRESARIALES ORIGINALES
	// =====================================================

	public int pedidosOriginalesPlanificados = 0;

	public int pedidosOriginalesCompletos = 0;

	public int pedidosOriginalesIncompletos = 0;

	public double porcentajePedidosOriginalesCompletos = 0.0;


	// =====================================================
	// UNIDADES
	// =====================================================

	public int unidadesPlanificadas = 0;

	public int unidadesEntregadas = 0;

	public int unidadesRetornadas = 0;

	public double porcentajeUnidadesEntregadas = 0.0;


	// =====================================================
	// VENTANAS Y ATENCIÓN
	// =====================================================

	public int entregasEnVentana = 0;

	public int entregasAceptadasAntes = 0;

	public int entregasTardiasAceptadas = 0;

	public int llegadasTardiasRechazadas = 0;

	public int entregasSinTardanza = 0;

	public double porcentajeEnVentanaSobreEntregadas = 0.0;

	public double porcentajeServicioSinTardanzaSobrePlanificadas = 0.0;


	// =====================================================
	// TARDANZA
	// =====================================================

	public int cantidadLlegadasTardias = 0;

	public double tardanzaTotalMin = 0.0;

	public double tardanzaPromedioMin = 0.0;

	public double tardanzaMaxMin = 0.0;


	// =====================================================
	// OPERACIÓN
	// =====================================================

	public int viajesTotales = 0;

	public double distanciaTotalKm = 0.0;

	public double tiempoCargaTotalMin = 0.0;

	public double tiempoViajeTotalMin = 0.0;

	public double tiempoEsperaClienteTotalMin = 0.0;

	public double tiempoDescargaTotalMin = 0.0;

	public double tiempoActivoAcumuladoCamionesMin = 0.0;


	// =====================================================
	// FINALIZACIÓN DEL TURNO
	// =====================================================

	public double minutoFinTurnoReal = -1.0;

	public double duracionTurnoRealMin = 0.0;

	public double overtimeMin = 0.0;

	public double excesoToleranciaMin = 0.0;


	// =====================================================
	// OCUPACIÓN Y PERSONAL
	// =====================================================

	public double ocupacionGlobalViajes = 0.0;

	public double promedioPersonasCargaGlobal = 0.0;

	public double personaMinCarga = 0.0;

	public double personaMinProveedor = 0.0;


	// =====================================================
	// BALANCE
	// =====================================================

	public double diferenciaFinCamionesMin = 0.0;

	public double diferenciaDistanciaCamionesKm = 0.0;

	public double diferenciaTiempoActivoCamionesMin = 0.0;


	// =====================================================
	// PROVEEDORES
	// =====================================================

	public int proveedoresLlegados = 0;

	public int proveedoresCompletados = 0;

	public int proveedoresCanceladosFinEjecucion = 0;

	public int proveedoresQueRequirieronDosEmpleados = 0;

	public double esperaProveedorTotalMin = 0.0;

	public double esperaProveedorPromedioMin = 0.0;

	public double esperaProveedorMaxMin = 0.0;

	public double tiempoAtencionProveedorTotalMin = 0.0;


	@Override
	public String toString() {

	    return "MetricasGlobalesTurno{" +
	        "tareasEntregadas=" + tareasEntregadas +
	        "/" + tareasPlanificadas +
	        ", pedidosOriginalesCompletos=" +
	        pedidosOriginalesCompletos +
	        "/" + pedidosOriginalesPlanificados +
	        ", unidadesEntregadas=" + unidadesEntregadas +
	        "/" + unidadesPlanificadas +
	        ", distanciaTotalKm=" + distanciaTotalKm +
	        ", viajesTotales=" + viajesTotales +
	        ", tardanzaTotalMin=" + tardanzaTotalMin +
	        ", minutoFinTurnoReal=" + minutoFinTurnoReal +
	        '}';
	}

}]]></Text>
		</JavaClass>
