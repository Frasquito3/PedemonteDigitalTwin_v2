						<ActionCode><![CDATA[boolean eliminado =
    eliminarUltimoPedidoFormulario();


if (eliminado) {

    emitirEstadoPedidosWeb(
        "",
        "ELIMINAR_ANYLOGIC",
        true,
        mensajeFormulario
    );
}]]></ActionCode>
