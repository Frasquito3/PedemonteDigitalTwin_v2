				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[InstanciaTurno]]></ReturnType>
					<Id>1786560543699</Id>
					<Name><![CDATA[crearInstanciaPruebaFase3]]></Name>
					<X>-810</X><Y>490</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[InstanciaTurno instancia =
    new InstanciaTurno();


instancia.instanciaId =
    "FASE3-TEST-001";

instancia.fechaOperacion =
    "2026-08-12";

instancia.turno =
    Turno.MANANA;


instancia.latCorralon =
    LAT_CORRALON;

instancia.lonCorralon =
    LON_CORRALON;


instancia.capacidadCamion =
    CAPACIDAD_CAMION;

instancia.cantidadCamiones =
    CANTIDAD_CAMIONES;


instancia.horaInicioTurnoMin =
    horaInicioTurno(
        instancia.turno
    );

instancia.horaFinObjetivoMin =
    horaFinObjetivoTurno(
        instancia.turno
    );

instancia.horaFinToleranciaMin =
    horaFinToleranciaTurno(
        instancia.turno
    );


instancia.seedEscenario =
    1001L;

instancia.seedEjecucion =
    2001L;


// -----------------------------------------------------
// Pedidos
// -----------------------------------------------------

instancia.pedidos.add(
    crearPedidoPrueba(
        "P001",
        3,
        false,
        LAT_CORRALON + 0.010,
        LON_CORRALON + 0.010
    )
);


instancia.pedidos.add(
    crearPedidoPrueba(
        "P002",
        4,
        false,
        LAT_CORRALON + 0.015,
        LON_CORRALON + 0.005
    )
);


instancia.pedidos.add(
    crearPedidoPrueba(
        "P003",
        2,
        true,
        LAT_CORRALON - 0.010,
        LON_CORRALON + 0.020
    )
);


instancia.pedidos.add(
    crearPedidoPrueba(
        "P004",
        6,
        false,
        LAT_CORRALON - 0.015,
        LON_CORRALON - 0.010
    )
);


return instancia;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[PlanTurno]]></ReturnType>
					<Id>1786560571476</Id>
					<Name><![CDATA[crearPlanManualFase3]]></Name>
					<X>-810</X><Y>520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Body><![CDATA[PlanTurno plan =
    new PlanTurno();


plan.instanciaId =
    instancia.instanciaId;

plan.algoritmo =
    AlgoritmoPlanificacion.MANUAL_TEST;


// =====================================================
// CAMIÓN 0
// =====================================================

PlanCamion camion0 =
    new PlanCamion();

camion0.camionId = 0;


// Viaje 1: P002
ViajePlan viaje01 =
    new ViajePlan();

viaje01.numeroViaje = 1;

viaje01.pedidoIds.add("P002");

camion0.viajes.add(
    viaje01
);


// Viaje 2:
// P003 requiere volcador, pero ponemos P001 después.
// Capacidad = 2 + 3 = 5, así que capacidad sigue siendo válida.
ViajePlan viaje02 =
    new ViajePlan();

viaje02.numeroViaje = 2;

viaje02.pedidoIds.add("P001");
viaje01.pedidoIds.add("P003");

camion0.viajes.add(
    viaje02
);


// =====================================================
// CAMIÓN 1
// =====================================================

PlanCamion camion1 =
    new PlanCamion();

camion1.camionId = 1;


// P004 queda asignado una vez
ViajePlan viaje11 =
    new ViajePlan();

viaje11.numeroViaje = 1;

viaje11.pedidoIds.add("P004");

camion1.viajes.add(
    viaje11
);


// =====================================================

plan.camiones.add(
    camion0
);

plan.camiones.add(
    camion1
);


return plan;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[PlanTurno]]></ReturnType>
					<Id>1786561496633</Id>
					<Name><![CDATA[crearPlanPruebaVolcadorInvalido]]></Name>
					<X>-810</X><Y>550</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Body><![CDATA[PlanTurno plan =
    new PlanTurno();

plan.instanciaId =
    instancia.instanciaId;

plan.algoritmo =
    AlgoritmoPlanificacion.MANUAL_TEST;


// =====================================================
// CAMIÓN 0
// =====================================================

PlanCamion camion0 =
    new PlanCamion();

camion0.camionId = 0;


// Viaje 1: solamente P002
ViajePlan viaje01 =
    new ViajePlan();

viaje01.numeroViaje = 1;

viaje01.pedidoIds.add("P002");

camion0.viajes.add(viaje01);


// Viaje 2:
// P003 requiere volcador.
// P001 después de P003 hace el viaje INVÁLIDO.
ViajePlan viaje02 =
    new ViajePlan();

viaje02.numeroViaje = 2;

viaje02.pedidoIds.add("P003");
viaje02.pedidoIds.add("P001");

camion0.viajes.add(viaje02);


// =====================================================
// CAMIÓN 1
// =====================================================

PlanCamion camion1 =
    new PlanCamion();

camion1.camionId = 1;

ViajePlan viaje11 =
    new ViajePlan();

viaje11.numeroViaje = 1;

viaje11.pedidoIds.add("P004");

camion1.viajes.add(viaje11);


// =====================================================

plan.camiones.add(camion0);
plan.camiones.add(camion1);

return plan;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
