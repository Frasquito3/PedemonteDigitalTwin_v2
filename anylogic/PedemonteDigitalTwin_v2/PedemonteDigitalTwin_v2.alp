		<!--   =========   Active Object Class   ========  -->
		<ActiveObjectClass>
			<Id>1786559212049</Id>
			<Name><![CDATA[Camion]]></Name>
			<StartupCode><![CDATA[camionId =
    getIndex();


Main main =
    (Main) getRootAgent();


latActual =
    main.LAT_CORRALON;


lonActual =
    main.LON_CORRALON;


nodoActualId =
    main.ID_NODO_CORRALON;


/*
 * El agente vive en el espacio GIS de Main.
 *
 * Al iniciar lo ubicamos junto al corralón.
 * La separación es solamente visual.
 */

jumpTo(
    latitudVisualCorralon2D(),
    main.LON_CORRALON
);


traceln(
    "Camión creado. camionId="
    + camionId
);]]></StartupCode>
