			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Main]]></ReturnType>
					<Id>1786559452107</Id>
					<Name><![CDATA[mainModel]]></Name>
					<X>-260</X><Y>50</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return (Main) getRootAgent();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786559490532</Id>
					<Name><![CDATA[asignarPlan]]></Name>
					<X>-260</X><Y>80</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[plan]]></Name>
						<Type><![CDATA[PlanCamion]]></Type>
					</Parameter>
					<Body><![CDATA[planAsignado = plan;

enCalle = false;

cargandoAhora = false;

trabajadoresCarga.clear();

personasCargaActual = 0;

duracionCargaActualMin = 0.0;

indiceViaje = 0;
indicePedido = 0;

viajeActual = null;
pedidoActual = null;

unidadesViajeActual = 0;
cargaActual = 0;

turnoFinalizado = false;

latActual =
    mainModel().LAT_CORRALON;

lonActual =
    mainModel().LON_CORRALON;


traceln(
    "Camión " + camionId +
    " recibió su plan: "
    + plan.viajes.size()
    + " viaje(s)."
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1786559522691</Id>
					<Name><![CDATA[hayViajePendiente]]></Name>
					<X>-260</X><Y>110</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return planAsignado != null
    && indiceViaje
       < planAsignado.viajes.size();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786559542932</Id>
					<Name><![CDATA[prepararViajeActual]]></Name>
					<X>-260</X><Y>140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (!hayViajePendiente()) {

    throw new IllegalStateException(
        "Camión " + camionId +
        " no tiene viaje pendiente."
    );
}


viajeActual =
    planAsignado.viajes.get(
        indiceViaje
    );

indicePedido = 0;

unidadesViajeActual = 0;


for (
    String pedidoId
    : viajeActual.pedidoIds
) {

    unidadesViajeActual +=
        mainModel()
        .obtenerPedidoInput(
            pedidoId
        )
        .unidadesCapacidad;
}


if (
    unidadesViajeActual
    > mainModel().CAPACIDAD_CAMION
) {

    throw new IllegalStateException(
        "ERROR DE DEFENSA: viaje excede capacidad."
    );
}


traceln(
    "[" + mainModel().minutoDiaActual() + "] " +
    "Camión " + camionId +
    " inicia viaje "
    + viajeActual.numeroViaje +
    ". Carga programada: "
    + unidadesViajeActual +
    "/"
    + mainModel().CAPACIDAD_CAMION
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786559580547</Id>
					<Name><![CDATA[finalizarCarga]]></Name>
					<X>-260</X><Y>170</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[cargaActual =
    unidadesViajeActual;


for (
    String pedidoId
    : viajeActual.pedidoIds
) {

    PedidoRuntime runtime =
        mainModel()
        .obtenerPedidoRuntime(
            pedidoId
        );

    runtime.estado =
        EstadoPedido.CARGADO;

    runtime.minutoCarga =
        mainModel().minutoDiaActual();
}


traceln(
    "[" + mainModel().minutoDiaActual() + "] " +
    "Camión " + camionId +
    " terminó carga: "
    + cargaActual +
    "/"
    + mainModel().CAPACIDAD_CAMION
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786559599332</Id>
					<Name><![CDATA[prepararPedidoActual]]></Name>
					<X>-260</X><Y>200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (viajeActual == null) {

    throw new IllegalStateException(
        "No existe viaje actual."
    );
}


if (
    indicePedido
    >= viajeActual.pedidoIds.size()
) {

    throw new IllegalStateException(
        "No existe pedido actual."
    );
}


String pedidoId =
    viajeActual.pedidoIds.get(
        indicePedido
    );


pedidoActual =
    mainModel()
    .obtenerPedidoRuntime(
        pedidoId
    );


pedidoActual.estado =
    EstadoPedido.EN_TRANSITO;

pedidoActual.minutoSalida =
    mainModel().minutoDiaActual();

enCalle = true;

traceln(
    "[" + mainModel().minutoDiaActual() + "] " +
    "Camión " + camionId +
    " sale hacia "
    + pedidoActual.input.pedidoId
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786559629443</Id>
					<Name><![CDATA[tiempoViajePedidoActualMin]]></Name>
					<X>-260</X><Y>230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return mainModel()
    .tiempoViajeDeterministaMin(
        latActual,
        lonActual,
        pedidoActual.input.latitud,
        pedidoActual.input.longitud
    );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786559645531</Id>
					<Name><![CDATA[llegarPedidoActual]]></Name>
					<X>-260</X><Y>260</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[latActual =
    pedidoActual.input.latitud;

lonActual =
    pedidoActual.input.longitud;

pedidoActual.minutoLlegada =
    mainModel().minutoDiaActual();


traceln(
    "[" + mainModel().minutoDiaActual() + "] " +
    "Camión " + camionId +
    " llegó a "
    + pedidoActual.input.pedidoId
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786559657427</Id>
					<Name><![CDATA[tiempoDescargaPedidoActualMin]]></Name>
					<X>-260</X><Y>290</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return mainModel()
    .tiempoDescargaDeterministaMin(
        pedidoActual.input
    );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786559674498</Id>
					<Name><![CDATA[finalizarPedidoActual]]></Name>
					<X>-260</X><Y>320</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (pedidoActual == null) {

    throw new IllegalStateException(
        "pedidoActual es null."
    );
}


PedidoInput input =
    pedidoActual.input;


// -----------------------------------------------------
// Defensa operacional adicional para volcador
// -----------------------------------------------------

if (input.requiereVolcador) {

    if (
        indicePedido
        != viajeActual.pedidoIds.size() - 1
    ) {

        throw new IllegalStateException(
            "VIOLACIÓN DE VOLCADOR: " +
            input.pedidoId +
            " no es último del viaje."
        );
    }

    // El volcador descarga todo.
    cargaActual = 0;

} else {

    cargaActual -=
        input.unidadesCapacidad;
}


if (cargaActual < 0) {

    throw new IllegalStateException(
        "Carga negativa en camión "
        + camionId
    );
}


pedidoActual.estado =
    EstadoPedido.ENTREGADO;

pedidoActual.minutoEntrega =
    mainModel().minutoDiaActual();


traceln(
    "[" + mainModel().minutoDiaActual() + "] " +
    "Camión " + camionId +
    " entregó "
    + input.pedidoId +
    ". Carga restante="
    + cargaActual
);


indicePedido++;

pedidoActual = null;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1786559693523</Id>
					<Name><![CDATA[hayMasPedidosEnViaje]]></Name>
					<X>-260</X><Y>350</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return viajeActual != null
    && indicePedido
       < viajeActual.pedidoIds.size();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786559714411</Id>
					<Name><![CDATA[tiempoRegresoCorralonMin]]></Name>
					<X>-260</X><Y>380</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return mainModel()
    .tiempoViajeDeterministaMin(
        latActual,
        lonActual,
        mainModel().LAT_CORRALON,
        mainModel().LON_CORRALON
    );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786559729995</Id>
					<Name><![CDATA[finalizarRegreso]]></Name>
					<X>-260</X><Y>410</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[latActual =
    mainModel().LAT_CORRALON;

lonActual =
    mainModel().LON_CORRALON;
    
enCalle = false;    

cargaActual = 0;

traceln(
    "[" + mainModel().minutoDiaActual() + "] " +
    "Camión " + camionId +
    " regresó al corralón del viaje "
    + viajeActual.numeroViaje
);


viajeActual = null;

pedidoActual = null;

indicePedido = 0;

indiceViaje++;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786559744707</Id>
					<Name><![CDATA[finalizarTurnoCamion]]></Name>
					<X>-260</X><Y>440</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (turnoFinalizado) {
    return;
}


turnoFinalizado = true;


traceln(
    "[" + mainModel().minutoDiaActual() + "] " +
    "Camión " + camionId +
    " FINALIZÓ su plan."
);


mainModel()
    .notificarCamionFinalizado(
        camionId
    );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1786562644507</Id>
					<Name><![CDATA[tieneTrabajoRestante]]></Name>
					<X>-260</X><Y>470</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return planAsignado != null
    &&
    (
        viajeActual != null
        ||
        indiceViaje
            < planAsignado.viajes.size()
    );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786562834010</Id>
					<Name><![CDATA[iniciarCarga]]></Name>
					<X>-260</X><Y>500</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[trabajadoresCarga.clear();


trabajadoresCarga.addAll(
    mainModel()
        .asignarTrabajadoresCarga(
            this
        )
);


personasCargaActual =
    trabajadoresCarga.size();


if (personasCargaActual <= 0) {

    throw new IllegalStateException(
        "Camión "
        + camionId
        + " intentó cargar sin trabajadores."
    );
}


duracionCargaActualMin =
    mainModel()
        .tiempoCargaMin(
            unidadesViajeActual,
            personasCargaActual
        );


cargandoAhora =
    true;


traceln(
    "[" + mainModel().minutoDiaActual() + "] "
    + "Camión " + camionId
    + " inicia CARGA con "
    + personasCargaActual
    + " persona(s): "
    + trabajadoresCarga
    + ". Duración="
    + duracionCargaActualMin
    + " min"
);]]></Body>
				</Function>
