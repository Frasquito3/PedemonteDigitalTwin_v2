					<Text><![CDATA[text]]></Text>
					<TextCode><![CDATA[resumenEstadosPedidosGIS() == null
?
""
:
resumenEstadosPedidosGIS()
    .replace(
        "Pedidos GIS | ",
        "Pedidos | "
    )
    .replace(
        " | pendientes=0",
        ""
    )
    .replace(
        " | planificados=0",
        ""
    )
    .replace(
        " | cargados=0",
        ""
    )
    .replace(
        " | en tránsito=0",
        ""
    )
    .replace(
        " | esperando=0",
        ""
    )
    .replace(
        " | parciales=0",
        ""
    )
    .replace(
        " | entregados=0",
        ""
    )
    .replace(
        " | no entregados=0",
        ""
    )
    .replace(
        " | día siguiente=0",
        ""
    )
    .replace(
        "pendientes=",
        "Pendientes: "
    )
    .replace(
        "planificados=",
        "Planificados: "
    )
    .replace(
        "cargados=",
        "Cargados: "
    )
    .replace(
        "en tránsito=",
        "En tránsito: "
    )
    .replace(
        "esperando=",
        "Esperando: "
    )
    .replace(
        "parciales=",
        "Parciales: "
    )
    .replace(
        "entregados=",
        "Entregados: "
    )
    .replace(
        "no entregados=",
        "No entregados: "
    )
    .replace(
        "día siguiente=",
        "Día siguiente: "
    )]]></TextCode>
