					<Id>1786560543699</Id>
					<Name><![CDATA[crearInstanciaPruebaFase3]]></Name>
					<X>-810</X><Y>400</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[InstanciaTurno instancia =
    new InstanciaTurno();


instancia.instanciaId =
    "FASE3-TEST-001";

instancia.fechaOperacion =
    "2026-08-12";

instancia.turno =
    Turno.MANANA;


instancia.latCorralon =
    LAT_CORRALON;

instancia.lonCorralon =
    LON_CORRALON;


instancia.capacidadCamion =
    CAPACIDAD_CAMION;

instancia.cantidadCamiones =
    CANTIDAD_CAMIONES;


instancia.horaInicioTurnoMin =
    horaInicioTurno(
        instancia.turno
    );

instancia.horaFinObjetivoMin =
    horaFinObjetivoTurno(
        instancia.turno
    );

instancia.horaFinToleranciaMin =
    horaFinToleranciaTurno(
        instancia.turno
    );


instancia.seedEscenario =
    1001L;

instancia.seedEjecucion =
    2001L;


// -----------------------------------------------------
// Pedidos
// -----------------------------------------------------

instancia.pedidos.add(
    crearPedidoPrueba(
        "P001",
        3,
        false,
        LAT_CORRALON + 0.010,
        LON_CORRALON + 0.010
    )
);


instancia.pedidos.add(
    crearPedidoPrueba(
        "P002",
        4,
        false,
        LAT_CORRALON + 0.015,
        LON_CORRALON + 0.005
    )
);


instancia.pedidos.add(
    crearPedidoPrueba(
        "P003",
        2,
        true,
        LAT_CORRALON - 0.010,
        LON_CORRALON + 0.020
    )
);


instancia.pedidos.add(
    crearPedidoPrueba(
        "P004",
        6,
        false,
        LAT_CORRALON - 0.015,
        LON_CORRALON - 0.010
    )
);


return instancia;]]></Body>
