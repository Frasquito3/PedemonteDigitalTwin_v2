				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786562384883</Id>
					<Name><![CDATA[inicializarRNGsEjecucion]]></Name>
					<X>-810</X><Y>610</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[seedBase]]></Name>
						<Type><![CDATA[long]]></Type>
					</Parameter>
					<Body><![CDATA[rngCarga =
    new java.util.Random(
        seedBase + 1001L
    );

rngDescarga =
    new java.util.Random(
        seedBase + 2003L
    );

rngCliente =
    new java.util.Random(
        seedBase + 3001L
    );

rngTrafico =
    new java.util.Random(
        seedBase + 4001L
    );

rngProveedor =
    new java.util.Random(
        seedBase + 5003L
    );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786562445467</Id>
					<Name><![CDATA[inicializarTrabajadores]]></Name>
					<X>-810</X><Y>640</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[trabajadores.clear();


// =====================================================
// CHOFER CAMIÓN 0
// =====================================================

TrabajadorRuntime chofer0 =
    new TrabajadorRuntime();

chofer0.trabajadorId =
    "CHOFER_0";

chofer0.tipo =
    TipoTrabajador.CHOFER;

chofer0.camionPropioId =
    0;

trabajadores.add(
    chofer0
);


// =====================================================
// CHOFER CAMIÓN 1
// =====================================================

TrabajadorRuntime chofer1 =
    new TrabajadorRuntime();

chofer1.trabajadorId =
    "CHOFER_1";

chofer1.tipo =
    TipoTrabajador.CHOFER;

chofer1.camionPropioId =
    1;

trabajadores.add(
    chofer1
);


// =====================================================
// EMPLEADO 0
// =====================================================

TrabajadorRuntime empleado0 =
    new TrabajadorRuntime();

empleado0.trabajadorId =
    "EMPLEADO_0";

empleado0.tipo =
    TipoTrabajador.EMPLEADO_CORRALON;

trabajadores.add(
    empleado0
);


// =====================================================
// EMPLEADO 1
// =====================================================

TrabajadorRuntime empleado1 =
    new TrabajadorRuntime();

empleado1.trabajadorId =
    "EMPLEADO_1";

empleado1.tipo =
    TipoTrabajador.EMPLEADO_CORRALON;

trabajadores.add(
    empleado1
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[TrabajadorRuntime]]></ReturnType>
					<Id>1786562466403</Id>
					<Name><![CDATA[obtenerChofer]]></Name>
					<X>-810</X><Y>670</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[camionId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[for (
    TrabajadorRuntime trabajador
    : trabajadores
) {

    if (
        trabajador.tipo
            == TipoTrabajador.CHOFER
        &&
        trabajador.camionPropioId
            == camionId
    ) {

        return trabajador;
    }
}


throw new IllegalArgumentException(
    "No existe chofer para camionId="
    + camionId
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Camion]]></ReturnType>
					<Id>1786562552923</Id>
					<Name><![CDATA[obtenerOtroCamion]]></Name>
					<X>-810</X><Y>700</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[camionId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[for (Camion camion : camiones) {

    if (
        camion.camionId
        != camionId
    ) {

        return camion;
    }
}


throw new IllegalStateException(
    "No se encontró el otro camión."
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.util.ArrayList<TrabajadorRuntime>]]></ReturnType>
					<Id>1786562730747</Id>
					<Name><![CDATA[asignarTrabajadoresCarga]]></Name>
					<X>-810</X><Y>730</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[camion]]></Name>
						<Type><![CDATA[Camion]]></Type>
					</Parameter>
					<Body><![CDATA[java.util.ArrayList<TrabajadorRuntime> asignados =
    new java.util.ArrayList<TrabajadorRuntime>();


// =====================================================
// 1. El chofer propio siempre participa
// =====================================================

TrabajadorRuntime choferPropio =
    obtenerChofer(
        camion.camionId
    );


if (!choferPropio.estaLibre()) {

    throw new IllegalStateException(
        "El chofer del camión "
        + camion.camionId
        + " no está disponible para cargar."
    );
}


choferPropio.cargandoCamionId =
    camion.camionId;

asignados.add(
    choferPropio
);


// =====================================================
// 2. Analizamos al otro camión
// =====================================================

Camion otroCamion =
    obtenerOtroCamion(
        camion.camionId
    );


boolean otroSinTrabajo =
    !otroCamion.tieneTrabajoRestante();


int maxEmpleadosCorralon;


// -----------------------------------------------------
// CASO A:
// El otro camión ya no tiene trabajo.
// Los dos empleados pueden ayudar.
// Además puede ayudar el otro chofer.
// -----------------------------------------------------

if (otroSinTrabajo) {

    maxEmpleadosCorralon = 2;
}


// -----------------------------------------------------
// CASO B:
// El otro camión está en la calle.
//
// Chofer propio + ambos empleados
// -> normalmente 3 personas.
// -----------------------------------------------------

else if (otroCamion.enCalle) {

    maxEmpleadosCorralon = 2;
}


// -----------------------------------------------------
// CASO C:
// Ambos camiones tienen trabajo y están
// en el corralón.
//
// Intentamos repartir:
// chofer + 1 empleado para cada uno.
// -----------------------------------------------------

else {

    maxEmpleadosCorralon = 1;
}


// =====================================================
// 3. Empleados permanentes disponibles
// =====================================================

int empleadosAsignados = 0;


for (
    TrabajadorRuntime trabajador
    : trabajadores
) {

    if (
        trabajador.tipo
            != TipoTrabajador.EMPLEADO_CORRALON
    ) {
        continue;
    }


    if (!trabajador.estaLibre()) {
        continue;
    }


    if (
        empleadosAsignados
        >= maxEmpleadosCorralon
    ) {
        break;
    }


    trabajador.cargandoCamionId =
        camion.camionId;

    asignados.add(
        trabajador
    );

    empleadosAsignados++;
}


// =====================================================
// 4. Si el otro camión terminó,
// puede ayudar su chofer.
// =====================================================

if (otroSinTrabajo) {

    TrabajadorRuntime otroChofer =
        obtenerChofer(
            otroCamion.camionId
        );


    if (otroChofer.estaLibre()) {

        otroChofer.cargandoCamionId =
            camion.camionId;

        asignados.add(
            otroChofer
        );
    }
}


return asignados;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786562778122</Id>
					<Name><![CDATA[liberarTrabajadoresCarga]]></Name>
					<X>-810</X><Y>760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[camion]]></Name>
						<Type><![CDATA[Camion]]></Type>
					</Parameter>
					<Body><![CDATA[for (
    TrabajadorRuntime trabajador
    : camion.trabajadoresCarga
) {

    if (
        trabajador.cargandoCamionId
        == camion.camionId
    ) {

        trabajador.cargandoCamionId =
            -1;
    }
}


camion.trabajadoresCarga.clear();

camion.cargandoAhora =
    false;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786562796715</Id>
					<Name><![CDATA[tiempoCargaMin]]></Name>
					<X>-810</X><Y>790</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[unidades]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[personas]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if (unidades <= 0) {

    throw new IllegalArgumentException(
        "unidades debe ser > 0."
    );
}


if (personas <= 0) {

    throw new IllegalArgumentException(
        "personas debe ser > 0."
    );
}


if (rngCarga == null) {

    throw new IllegalStateException(
        "rngCarga no fue inicializado."
    );
}


// =====================================================
// Eficiencia efectiva del equipo
// =====================================================

double personasEfectivas =
    1.0
    +
    CARGA_EFICIENCIA_PERSONA_ADICIONAL
    * (personas - 1);


// =====================================================
// Tiempo esperado base
// =====================================================

double tiempoBase =
    CARGA_SETUP_MIN
    +
    (
        CARGA_MIN_POR_UNIDAD_1_PERSONA
        * unidades
    )
    / personasEfectivas;


// =====================================================
// Variabilidad
// =====================================================

double factorVariacion =
    triangular(
        CARGA_FACTOR_VARIACION_MIN,
        CARGA_FACTOR_VARIACION_MODA,
        CARGA_FACTOR_VARIACION_MAX,
        rngCarga
    );


return tiempoBase
    * factorVariacion;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[PlanTurno]]></ReturnType>
					<Id>1786563351018</Id>
					<Name><![CDATA[crearPlanTestTresPersonasFase4A]]></Name>
					<X>-810</X><Y>820</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Body><![CDATA[PlanTurno plan =
    new PlanTurno();

plan.instanciaId =
    instancia.instanciaId;

plan.algoritmo =
    AlgoritmoPlanificacion.MANUAL_TEST;


// =====================================================
// CAMIÓN 0
// =====================================================

PlanCamion camion0 =
    new PlanCamion();

camion0.camionId = 0;


// Viaje pequeño primero.
ViajePlan viaje01 =
    new ViajePlan();

viaje01.numeroViaje = 1;
viaje01.pedidoIds.add("P003");

camion0.viajes.add(viaje01);


// Segundo viaje.
ViajePlan viaje02 =
    new ViajePlan();

viaje02.numeroViaje = 2;
viaje02.pedidoIds.add("P001");
viaje02.pedidoIds.add("P002");

camion0.viajes.add(viaje02);


// =====================================================
// CAMIÓN 1
// =====================================================

PlanCamion camion1 =
    new PlanCamion();

camion1.camionId = 1;

ViajePlan viaje11 =
    new ViajePlan();

viaje11.numeroViaje = 1;
viaje11.pedidoIds.add("P004");

camion1.viajes.add(viaje11);


// =====================================================

plan.camiones.add(camion0);
plan.camiones.add(camion1);

return plan;]]></Body>
				</Function>
