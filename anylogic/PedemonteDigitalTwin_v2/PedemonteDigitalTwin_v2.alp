				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786559490532</Id>
					<Name><![CDATA[asignarPlan]]></Name>
					<X>-320</X><Y>80</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[plan]]></Name>
						<Type><![CDATA[PlanCamion]]></Type>
					</Parameter>
					<Body><![CDATA[planAsignado = plan;

nodoActualId =
    mainModel().ID_NODO_CORRALON;

duracionViajeActualMin =
    0.0;

distanciaViajeActualMetros =
    0.0;

historialActividades.clear();

actividadActual = null;

inicioActividadActualMin = -1.0;

pedidoIdActividadActual = "";

distanciaActividadActualMetros = 0.0;

personasActividadActual = 0;

unidadesActividadActual = 0;

minutoFinPlan = -1.0;

enCalle = false;

abortarViajeActual = false;

decisionClienteActual =
    DecisionAtencionCliente.DESCARGAR_AHORA;

duracionEsperaClienteActualMin =
    0.0;

duracionDescargaActualMin =
    0.0;

unidadesRetornadasCorralon =
    0;

cargandoAhora = false;

trabajadoresCarga.clear();

personasCargaActual = 0;

duracionCargaActualMin = 0.0;

indiceViaje = 0;
indicePedido = 0;

viajeActual = null;
pedidoActual = null;

unidadesViajeActual = 0;
cargaActual = 0;

turnoFinalizado = false;

latActual =
    mainModel().LAT_CORRALON;

lonActual =
    mainModel().LON_CORRALON;


traceln(
    "Camión " + camionId +
    " recibió su plan: "
    + plan.viajes.size()
    + " viaje(s)."
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1786559522691</Id>
					<Name><![CDATA[hayViajePendiente]]></Name>
					<X>-320</X><Y>110</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return planAsignado != null
    && indiceViaje
       < planAsignado.viajes.size();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786559542932</Id>
					<Name><![CDATA[prepararViajeActual]]></Name>
					<X>-320</X><Y>140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (!hayViajePendiente()) {

    throw new IllegalStateException(
        "Camión " + camionId +
        " no tiene viaje pendiente."
    );
}


viajeActual =
    planAsignado.viajes.get(
        indiceViaje
    );

indicePedido = 0;

unidadesViajeActual = 0;


for (
    String pedidoId
    : viajeActual.pedidoIds
) {

    unidadesViajeActual +=
        mainModel()
        .obtenerPedidoInput(
            pedidoId
        )
        .unidadesCapacidad;
}


if (
    unidadesViajeActual
    > mainModel().CAPACIDAD_CAMION
) {

    throw new IllegalStateException(
        "ERROR DE DEFENSA: viaje excede capacidad."
    );
}

abortarViajeActual = false;

traceln(
    "[" + mainModel().minutoDiaActual() + "] " +
    "Camión " + camionId +
    " inicia viaje "
    + viajeActual.numeroViaje +
    ". Carga programada: "
    + unidadesViajeActual +
    "/"
    + mainModel().CAPACIDAD_CAMION
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786559580547</Id>
					<Name><![CDATA[finalizarCarga]]></Name>
					<X>-320</X><Y>170</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[cerrarActividadActual();

cargaActual =
    unidadesViajeActual;


for (
    String pedidoId
    : viajeActual.pedidoIds
) {

    PedidoRuntime runtime =
        mainModel()
        .obtenerPedidoRuntime(
            pedidoId
        );

    runtime.estado =
        EstadoPedido.CARGADO;

    runtime.minutoCarga =
        mainModel().minutoDiaActual();
}


traceln(
    "[" + mainModel().minutoDiaActual() + "] " +
    "Camión " + camionId +
    " terminó carga: "
    + cargaActual +
    "/"
    + mainModel().CAPACIDAD_CAMION
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786559599332</Id>
					<Name><![CDATA[prepararPedidoActual]]></Name>
					<X>-320</X><Y>200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (viajeActual == null) {

    throw new IllegalStateException(
        "No existe viaje actual."
    );
}


if (
    indicePedido
    >= viajeActual.pedidoIds.size()
) {

    throw new IllegalStateException(
        "No existe pedido actual."
    );
}


String pedidoId =
    viajeActual.pedidoIds.get(
        indicePedido
    );


pedidoActual =
    mainModel()
    .obtenerPedidoRuntime(
        pedidoId
    );
    
duracionViajeActualMin =
    mainModel()
        .obtenerTiempoViajeMin(
            nodoActualId,
            pedidoId
        );


distanciaViajeActualMetros =
    mainModel()
        .obtenerDistanciaViajeMetros(
            nodoActualId,
            pedidoId
        );

iniciarActividad(
    TipoActividadCamion.VIAJE_CLIENTE,
    pedidoId,
    distanciaViajeActualMetros,
    0,
    0
);

pedidoActual.estado =
    EstadoPedido.EN_TRANSITO;

pedidoActual.minutoSalida =
    mainModel().minutoDiaActual();

enCalle = true;

decisionClienteActual =
    DecisionAtencionCliente.DESCARGAR_AHORA;

duracionEsperaClienteActualMin =
    0.0;

duracionDescargaActualMin =
    0.0;

traceln(
    "[" + mainModel().minutoDiaActual() + "] "
    + "Camión " + camionId
    + " sale hacia "
    + pedidoActual.input.pedidoId
    + ". Distancia="
    + distanciaViajeActualMetros
    + " m"
    + ", tiempo="
    + duracionViajeActualMin
    + " min"
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786559645531</Id>
					<Name><![CDATA[llegarPedidoActual]]></Name>
					<X>-320</X><Y>230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[cerrarActividadActual();

latActual =
    pedidoActual.input.latitud;

lonActual =
    pedidoActual.input.longitud;
    
nodoActualId =
    pedidoActual.input.pedidoId;

pedidoActual.minutoLlegada =
    mainModel().minutoDiaActual();


traceln(
    "[" + mainModel().minutoDiaActual() + "] " +
    "Camión " + camionId +
    " llegó a "
    + pedidoActual.input.pedidoId
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786559674498</Id>
					<Name><![CDATA[finalizarPedidoActual]]></Name>
					<X>-320</X><Y>260</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (pedidoActual == null) {

    throw new IllegalStateException(
        "pedidoActual es null."
    );
}

cerrarActividadActual();

PedidoInput input =
    pedidoActual.input;


// -----------------------------------------------------
// Defensa operacional adicional para volcador
// -----------------------------------------------------

if (input.requiereVolcador) {

    if (
        indicePedido
        != viajeActual.pedidoIds.size() - 1
    ) {

        throw new IllegalStateException(
            "VIOLACIÓN DE VOLCADOR: " +
            input.pedidoId +
            " no es último del viaje."
        );
    }

    // El volcador descarga todo.
    cargaActual = 0;

} else {

    cargaActual -=
        input.unidadesCapacidad;
}


if (cargaActual < 0) {

    throw new IllegalStateException(
        "Carga negativa en camión "
        + camionId
    );
}


pedidoActual.estado =
    EstadoPedido.ENTREGADO;

pedidoActual.minutoEntrega =
    mainModel().minutoDiaActual();


traceln(
    "[" + mainModel().minutoDiaActual() + "] " +
    "Camión " + camionId +
    " entregó "
    + input.pedidoId +
    ". Carga restante="
    + cargaActual
);


indicePedido++;

pedidoActual = null;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1786559693523</Id>
					<Name><![CDATA[hayMasPedidosEnViaje]]></Name>
					<X>-320</X><Y>290</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return viajeActual != null
    && indicePedido
       < viajeActual.pedidoIds.size();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786559729995</Id>
					<Name><![CDATA[finalizarRegreso]]></Name>
					<X>-320</X><Y>320</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[cerrarActividadActual();

latActual =
    mainModel().LAT_CORRALON;

lonActual =
    mainModel().LON_CORRALON;
    
nodoActualId =
    mainModel().ID_NODO_CORRALON;
    
enCalle = false;  

if (cargaActual > 0) {

    unidadesRetornadasCorralon +=
        cargaActual;

    traceln(
        "[" + mainModel().minutoDiaActual() + "] "
        + "Camión " + camionId
        + " regresa con "
        + cargaActual
        + " unidad(es) no entregadas."
    );
}  

cargaActual = 0;

traceln(
    "[" + mainModel().minutoDiaActual() + "] " +
    "Camión " + camionId +
    " regresó al corralón del viaje "
    + viajeActual.numeroViaje
);


viajeActual = null;

pedidoActual = null;

indicePedido = 0;

indiceViaje++;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786559744707</Id>
					<Name><![CDATA[finalizarTurnoCamion]]></Name>
					<X>-320</X><Y>350</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (turnoFinalizado) {
    return;
}

// Defensa: no debería quedar una actividad abierta.
cerrarActividadActual();

minutoFinPlan =
    mainModel().minutoDiaActual();

turnoFinalizado = true;


traceln(
    "[" + mainModel().minutoDiaActual() + "] " +
    "Camión " + camionId +
    " FINALIZÓ su plan."
);


mainModel()
    .notificarCamionFinalizado(
        camionId
    );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1786562644507</Id>
					<Name><![CDATA[tieneTrabajoRestante]]></Name>
					<X>-320</X><Y>380</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return planAsignado != null
    &&
    (
        viajeActual != null
        ||
        indiceViaje
            < planAsignado.viajes.size()
    );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786562834010</Id>
					<Name><![CDATA[iniciarCarga]]></Name>
					<X>-320</X><Y>410</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[trabajadoresCarga.clear();


trabajadoresCarga.addAll(
    mainModel()
        .asignarTrabajadoresCarga(
            this
        )
);


personasCargaActual =
    trabajadoresCarga.size();


if (personasCargaActual <= 0) {

    throw new IllegalStateException(
        "Camión "
        + camionId
        + " intentó cargar sin trabajadores."
    );
}


duracionCargaActualMin =
    mainModel()
        .tiempoCargaMin(
            unidadesViajeActual,
            personasCargaActual
        );


cargandoAhora =
    true;

iniciarActividad(
    TipoActividadCamion.CARGA,
    "",
    0.0,
    personasCargaActual,
    unidadesViajeActual
);

traceln(
    "[" + mainModel().minutoDiaActual() + "] "
    + "Camión " + camionId
    + " inicia CARGA con "
    + personasCargaActual
    + " persona(s): "
    + trabajadoresCarga
    + ". Duración="
    + duracionCargaActualMin
    + " min"
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786563033916</Id>
					<Name><![CDATA[activarEjecucion]]></Name>
					<X>-320</X><Y>440</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[scOperacion.onChange();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786578445652</Id>
					<Name><![CDATA[evaluarClienteActual]]></Name>
					<X>-320</X><Y>470</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (pedidoActual == null) {

    throw new IllegalStateException(
        "pedidoActual es null."
    );
}


ResultadoAtencionCliente resultado =
    mainModel()
        .evaluarLlegadaCliente(
            pedidoActual.input,
            pedidoActual.minutoLlegada
        );


decisionClienteActual =
    resultado.decision;

duracionEsperaClienteActualMin =
    resultado.esperaMin;


pedidoActual.anticipacionLlegadaMin =
    resultado.anticipacionMin;

pedidoActual.tardanzaLlegadaMin =
    resultado.tardanzaMin;

pedidoActual.aceptadoAntes =
    resultado.aceptadoAntes;

pedidoActual.llegadaTardia =
    resultado.llegadaTardia;


traceln(
    "[" + mainModel().minutoDiaActual() + "] "
    + "Cliente "
    + pedidoActual.input.pedidoId
    + ": "
    + resultado
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786578462420</Id>
					<Name><![CDATA[iniciarEsperaCliente]]></Name>
					<X>-320</X><Y>500</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (pedidoActual == null) {

    throw new IllegalStateException(
        "pedidoActual es null."
    );
}

iniciarActividad(
    TipoActividadCamion.ESPERA_CLIENTE,
    pedidoActual.input.pedidoId,
    0.0,
    0,
    0
);

pedidoActual.estado =
    EstadoPedido.ESPERANDO;

pedidoActual.minutoInicioEspera =
    mainModel().minutoDiaActual();

pedidoActual.tiempoEsperaClienteMin =
    duracionEsperaClienteActualMin;


traceln(
    "[" + mainModel().minutoDiaActual() + "] "
    + "Camión " + camionId
    + " espera "
    + duracionEsperaClienteActualMin
    + " min por "
    + pedidoActual.input.pedidoId
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786578480444</Id>
					<Name><![CDATA[iniciarDescarga]]></Name>
					<X>-320</X><Y>530</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (pedidoActual == null) {

    throw new IllegalStateException(
        "pedidoActual es null."
    );
}

// Si venimos de EsperandoCliente,
// cerramos primero esa actividad.
//
// Si la descarga es inmediata,
// actividadActual ya será null.

cerrarActividadActual();

duracionDescargaActualMin =
    mainModel()
        .tiempoDescargaMin(
            pedidoActual.input
        );

iniciarActividad(
    TipoActividadCamion.DESCARGA,
    pedidoActual.input.pedidoId,
    0.0,
    0,
    pedidoActual.input.unidadesCapacidad
);

pedidoActual.minutoInicioDescarga =
    mainModel().minutoDiaActual();

pedidoActual.duracionDescargaMin =
    duracionDescargaActualMin;


traceln(
    "[" + mainModel().minutoDiaActual() + "] "
    + "Camión " + camionId
    + " inicia descarga de "
    + pedidoActual.input.pedidoId
    + ". Duración="
    + duracionDescargaActualMin
    + " min"
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786578497196</Id>
					<Name><![CDATA[finalizarPedidoNoEntregadoActual]]></Name>
					<X>-320</X><Y>560</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[motivo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (pedidoActual == null) {

    throw new IllegalStateException(
        "pedidoActual es null."
    );
}

boolean hayVolcadorDespues =
    hayVolcadorPendienteDespues();

pedidoActual.estado =
    EstadoPedido.NO_ENTREGADO;

pedidoActual.minutoNoEntrega =
    mainModel().minutoDiaActual();

pedidoActual.motivoNoEntrega =
    motivo;


traceln(
    "[" + mainModel().minutoDiaActual() + "] "
    + "Camión " + camionId
    + " NO pudo entregar "
    + pedidoActual.input.pedidoId
    + ". Motivo="
    + motivo
    + ". La carga permanece en el camión."
);


// IMPORTANTE:
// NO reducimos cargaActual.

indicePedido++;

pedidoActual = null;

if (hayVolcadorDespues) {

    abortarViajeActual = true;

    marcarRestantesComoNoEntregados(
        "VIAJE_ABORTADO_POR_RECHAZO_ANTES_DE_VOLCADOR"
    );


    traceln(
        "[" + mainModel().minutoDiaActual() + "] "
        + "Camión " + camionId
        + " aborta el viaje por seguridad: "
        + "quedó material rechazado antes de un volcador."
    );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1786580523308</Id>
					<Name><![CDATA[hayVolcadorPendienteDespues]]></Name>
					<X>-320</X><Y>590</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (viajeActual == null) {
    return false;
}


for (
    int i = indicePedido + 1;
    i < viajeActual.pedidoIds.size();
    i++
) {

    PedidoInput pedido =
        mainModel()
            .obtenerPedidoInput(
                viajeActual.pedidoIds.get(i)
            );

    if (pedido.requiereVolcador) {
        return true;
    }
}


return false;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786580550444</Id>
					<Name><![CDATA[marcarRestantesComoNoEntregados]]></Name>
					<X>-320</X><Y>620</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[motivo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (viajeActual == null) {
    return;
}


for (
    int i = indicePedido;
    i < viajeActual.pedidoIds.size();
    i++
) {

    String pedidoId =
        viajeActual.pedidoIds.get(i);

    PedidoRuntime runtime =
        mainModel()
            .obtenerPedidoRuntime(
                pedidoId
            );


    if (
        runtime.estado
        == EstadoPedido.ENTREGADO
    ) {
        continue;
    }


    runtime.estado =
        EstadoPedido.NO_ENTREGADO;

    runtime.minutoNoEntrega =
        mainModel().minutoDiaActual();

    runtime.motivoNoEntrega =
        motivo;


    traceln(
        "[" + mainModel().minutoDiaActual() + "] "
        + pedidoId
        + " queda NO_ENTREGADO. Motivo="
        + motivo
    );
}


// No intentaremos ningún otro pedido
// de este viaje.
indicePedido =
    viajeActual.pedidoIds.size();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786582941877</Id>
					<Name><![CDATA[prepararRegresoCorralon]]></Name>
					<X>-320</X><Y>650</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[duracionViajeActualMin =
    mainModel()
        .obtenerTiempoViajeMin(
            nodoActualId,
            mainModel().ID_NODO_CORRALON
        );


distanciaViajeActualMetros =
    mainModel()
        .obtenerDistanciaViajeMetros(
            nodoActualId,
            mainModel().ID_NODO_CORRALON
        );

iniciarActividad(
    TipoActividadCamion.REGRESO_CORRALON,
    "",
    distanciaViajeActualMetros,
    0,
    0
);

traceln(
    "[" + mainModel().minutoDiaActual() + "] "
    + "Camión " + camionId
    + " regresa al corralón. Distancia="
    + distanciaViajeActualMetros
    + " m"
    + ", tiempo="
    + duracionViajeActualMin
    + " min"
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786625140562</Id>
					<Name><![CDATA[iniciarActividad]]></Name>
					<X>-320</X><Y>680</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[tipo]]></Name>
						<Type><![CDATA[TipoActividadCamion]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[pedidoId]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[distanciaMetros]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[personasAsignadas]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[unidades]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if (tipo == null) {

    throw new IllegalArgumentException(
        "El tipo de actividad no puede ser null."
    );
}


if (actividadActual != null) {

    throw new IllegalStateException(
        "Camión " + camionId +
        " intentó iniciar " + tipo +
        " sin cerrar la actividad " +
        actividadActual
    );
}


if (distanciaMetros < 0.0) {

    throw new IllegalArgumentException(
        "La distancia de actividad no puede ser negativa."
    );
}


if (personasAsignadas < 0) {

    throw new IllegalArgumentException(
        "La cantidad de personas no puede ser negativa."
    );
}


if (unidades < 0) {

    throw new IllegalArgumentException(
        "Las unidades no pueden ser negativas."
    );
}


actividadActual =
    tipo;

inicioActividadActualMin =
    mainModel().minutoDiaActual();

pedidoIdActividadActual =
    pedidoId == null
    ? ""
    : pedidoId;

distanciaActividadActualMetros =
    distanciaMetros;

personasActividadActual =
    personasAsignadas;

unidadesActividadActual =
    unidades;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786625203053</Id>
					<Name><![CDATA[cerrarActividadActual]]></Name>
					<X>-320</X><Y>710</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (actividadActual == null) {

    return;
}


double fin =
    mainModel().minutoDiaActual();


if (
    fin
    < inicioActividadActualMin - 1e-9
) {

    throw new IllegalStateException(
        "Fin de actividad anterior al inicio. " +
        "Camión=" + camionId +
        ", actividad=" + actividadActual
    );
}


RegistroActividadCamion registro =
    new RegistroActividadCamion();


registro.camionId =
    camionId;

registro.tipo =
    actividadActual;

registro.inicioMinDia =
    inicioActividadActualMin;

registro.finMinDia =
    fin;

registro.duracionMin =
    Math.max(
        0.0,
        fin - inicioActividadActualMin
    );

registro.numeroViaje =
    viajeActual == null
    ? -1
    : viajeActual.numeroViaje;

registro.pedidoId =
    pedidoIdActividadActual;

registro.distanciaMetros =
    distanciaActividadActualMetros;

registro.personasAsignadas =
    personasActividadActual;

registro.unidades =
    unidadesActividadActual;


historialActividades.add(
    registro
);


// =====================================================
// RESET
// =====================================================

actividadActual = null;

inicioActividadActualMin = -1.0;

pedidoIdActividadActual = "";

distanciaActividadActualMetros = 0.0;

personasActividadActual = 0;

unidadesActividadActual = 0;]]></Body>
				</Function>
			</Functions>
