					<X>-810</X><Y>5920</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metodo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[componente]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String clave =
    componente == null
    ? ""
    : componente
        .trim()
        .toUpperCase(
            java.util.Locale.ROOT
        );


if (
    "Simulado".equals(
        modoDatosComparacion
    )
) {

    double[] resultado =
        bloqueComparacionSimulada(
            metodo
        );


    if (
        resultado == null
        ||
        (int) Math.round(
            resultado[1]
        ) != 1
    ) {

        return Double.NaN;
    }


    switch (clave) {

        case "PENALIZACIONES":

            return
                resultado[12]
                +
                resultado[13]
                +
                resultado[14]
                +
                resultado[15];


        case "OPERACION":

            return resultado[16];


        case "DISTANCIA":

            return resultado[17];


        case "VIAJES":

            return resultado[18];


        case "DESBALANCE":

            return resultado[19];


        default:

            return Double.NaN;
    }
}


double[] resultado =
    bloqueComparacionEstimada(
        metodo
    );


if (
    resultado == null
    ||
    resultado[1] < 0.5
) {

    return Double.NaN;
}


switch (clave) {

    case "PENALIZACIONES":

        return
            resultado[4]
            +
            resultado[5]
            +
            resultado[6]
            +
            resultado[7];


    case "OPERACION":

        return resultado[8];


    case "DISTANCIA":

        return resultado[9];


    case "VIAJES":

        return resultado[10];


    case "DESBALANCE":

        return resultado[11];


    default:

        return Double.NaN;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788121856738</Id>
					<Name><![CDATA[valorAcumuladoDesgloseCosto]]></Name>
					<X>-810</X><Y>5950</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metodo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[capa]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[double penalizaciones =
    valorComponenteCostoComparacion(
        metodo,
        "PENALIZACIONES"
    );


double operacion =
    valorComponenteCostoComparacion(
        metodo,
        "OPERACION"
    );


double distancia =
    valorComponenteCostoComparacion(
        metodo,
        "DISTANCIA"
    );


double viajes =
    valorComponenteCostoComparacion(
        metodo,
        "VIAJES"
    );


double desbalance =
    valorComponenteCostoComparacion(
        metodo,
        "DESBALANCE"
    );


if (
    Double.isNaN(
        penalizaciones
    )
    ||
    Double.isNaN(
        operacion
    )
    ||
    Double.isNaN(
        distancia
    )
    ||
    Double.isNaN(
        viajes
    )
    ||
    Double.isNaN(
        desbalance
    )
) {

    return Double.NaN;
}


String clave =
    capa == null
    ? ""
    : capa
        .trim()
        .toUpperCase(
            java.util.Locale.ROOT
        );


switch (clave) {

    case "TOTAL":

        return
            penalizaciones
            +
            operacion
            +
            distancia
            +
            viajes
            +
            desbalance;


    case "SIN_DESBALANCE":

        return
            penalizaciones
            +
            operacion
            +
            distancia
            +
            viajes;


    case "SIN_VIAJES_DESBALANCE":

        return
            penalizaciones
            +
            operacion
            +
            distancia;


    case "PENALIZACIONES_OPERACION":

        return
            penalizaciones
            +
            operacion;


    case "PENALIZACIONES":

        return penalizaciones;


    default:

        return Double.NaN;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
