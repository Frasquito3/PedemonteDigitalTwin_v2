			<Text><![CDATA[public interface TravelTimeProvider
{
	double tiempoViajeMin(
	    String origenId,
	    String destinoId,
	    double minutoDia
	);


	double distanciaMetros(
	    String origenId,
	    String destinoId
	);


	double tiempoBaseMin(
	    String origenId,
	    String destinoId
	);


	String nombreProvider();
}]]></Text>
