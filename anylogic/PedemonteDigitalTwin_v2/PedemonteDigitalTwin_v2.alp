		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1786558171676</Id>
			<Name><![CDATA[PedidoRuntime]]></Name>
			<Folder>1786556019063</Folder>
			<Text><![CDATA[/**
 * PedidoRuntime
 */	
public class PedidoRuntime implements Serializable {

	public PedidoInput input = null;

	public EstadoPedido estado = EstadoPedido.PENDIENTE;

	public int camionIdAsignado = -1;

	public int numeroViajeAsignado = -1;

	public int ordenEnViaje = -1;

	public double minutoCarga = -1.0;

	public double minutoSalida = -1.0;

	public double minutoLlegada = -1.0;

	public double minutoEntrega = -1.0;


	public PedidoRuntime() {
	}


	public PedidoRuntime(PedidoInput input) {
	    this.input = input;
	}


	@Override
	public String toString() {

	    String id = input == null
	        ? "null"
	        : input.pedidoId;

	    return "PedidoRuntime{" +
	        "pedidoId='" + id + '\'' +
	        ", estado=" + estado +
	        ", camion=" + camionIdAsignado +
	        ", viaje=" + numeroViajeAsignado +
	        ", orden=" + ordenEnViaje +
	        '}';
	}

}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1786562122298</Id>
			<Name><![CDATA[TrabajadorRuntime]]></Name>
			<Folder>1786556019063</Folder>
			<Text><![CDATA[/**
 * TrabajadorRuntime
 */	
public class TrabajadorRuntime implements Serializable {

	public String trabajadorId = "";

	public TipoTrabajador tipo =
	    TipoTrabajador.EMPLEADO_CORRALON;

	// Sólo se usa para choferes.
	// -1 significa que no tiene camión propio.
	public int camionPropioId = -1;

	// -1 significa que no está cargando ningún camión.
	public int cargandoCamionId = -1;

	// Lo utilizaremos en Fase 4C.
	public boolean ocupadoProveedor = false;


	public boolean estaLibre() {
	    return cargandoCamionId < 0
	        && !ocupadoProveedor;
	}


	@Override
	public String toString() {
	    return trabajadorId;
	}

}]]></Text>
		</JavaClass>
