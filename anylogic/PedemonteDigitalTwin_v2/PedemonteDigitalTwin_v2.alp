				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788119900873</Id>
					<Name><![CDATA[valorGraficoComparacionFuente]]></Name>
					<X>-810</X><Y>5770</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metodo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[fuente]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String metrica =
    graficoComparacionSeleccionado == null
    ? ""
    : graficoComparacionSeleccionado.trim();


boolean fuenteSimulada =
    "Simulado".equals(
        fuente
    );


if (fuenteSimulada) {

    double[] resultado =
        bloqueComparacionSimulada(
            metodo
        );


    if (
        resultado == null
        ||
        (int) Math.round(
            resultado[1]
        ) != 1
    ) {

        return Double.NaN;
    }


    switch (metrica) {

        case "Costo total":
            return resultado[3];
            
        case "Desglose del costo":
		    return resultado[3];

        case "Distancia":
            return resultado[4];

        case "Duración":
            return resultado[5];

        case "Viajes":
            return resultado[6];

        case "Tardanza":
            return resultado[7];

        case "Desbalance":
            return resultado[8];

        default:
            return Double.NaN;
    }
}


double[] resultado =
    bloqueComparacionEstimada(
        metodo
    );


if (
    resultado == null
    ||
    resultado[1] < 0.5
) {

    return Double.NaN;
}


switch (metrica) {

    case "Costo total":
        return resultado[3];
        
    case "Desglose del costo":
	    return resultado[3];

    case "Distancia":
        return resultado[12];

    case "Duración":
        return resultado[13];

    case "Viajes":
        return resultado[14];

    case "Tardanza":
        return resultado[16];

    case "Desbalance":
        return resultado[17];

    case "Tiempo de planificación":
        return resultado[18];

    default:
        return Double.NaN;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788120228878</Id>
					<Name><![CDATA[maximoValorGraficoComparacionDoble]]></Name>
					<X>-810</X><Y>5800</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[String[] metodos = {
    "RL",
    "HIBRIDO",
    "GREEDY",
    "RANDOM",
    "GA"
};


String[] fuentes = {
    "Estimado",
    "Simulado"
};


double maximo =
    Double.NaN;


for (
    String metodo
    : metodos
) {

    for (
        String fuente
        : fuentes
    ) {

        double valor =
            valorGraficoComparacionFuente(
                metodo,
                fuente
            );


        if (
            Double.isNaN(valor)
            ||
            Double.isInfinite(valor)
            ||
            valor < 0.0
        ) {

            continue;
        }


        if (
            Double.isNaN(maximo)
            ||
            valor > maximo
        ) {

            maximo =
                valor;
        }
    }
}


return
    Double.isNaN(maximo)
    ? 0.0
    : maximo;]]></Body>
				</Function>
