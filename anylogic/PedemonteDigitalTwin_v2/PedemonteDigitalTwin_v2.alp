					</Properties>
					<Action><![CDATA[if (
    MODO_EJECUCION
        == ModoEjecucion.SIMULACION

    ||

    MODO_EJECUCION
        == ModoEjecucion.PRODUCCION
) {

    inicializarGIS();
}


if (
    MODO_EJECUCION
        == ModoEjecucion.SIMULACION
) {

    mensajeInterfazPlanificacion =
        "Configure la instancia y seleccione "
        + "el algoritmo.";


    pauseSimulation();
}]]></Action>
