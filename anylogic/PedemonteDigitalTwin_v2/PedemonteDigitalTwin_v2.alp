				<Control Type="Button">
				 	<EmbeddedIcon>false</EmbeddedIcon>				
					<Id>1787143902718</Id>
					<Name><![CDATA[btnPlanificarEjecutar]]></Name>
					<X>1320</X><Y>226</Y>
					<Label><X>0</X><Y>-10</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
					<BasicProperties Width="240" Height="34">
                        <EmbeddedIcon>false</EmbeddedIcon>	
						<TextColor>-15257011</TextColor>
						<Enabled>true</Enabled>
						<EnableExpression><![CDATA[instanciaInterfazActual != null
&&
cacheVialInstanciaCompleta
&&
!ejecucionEnCurso
&&
!pypelineSolicitudEnCurso]]></EnableExpression>
						<ActionCode><![CDATA[if (
    ejecucionEnCurso
    ||
    pypelineSolicitudEnCurso
) {

    traceln(
        "Ya existe una planificación "
        + "o ejecución en curso."
    );

    return;
}


if (
    instanciaInterfazActual == null
) {

    mensajeInterfazPlanificacion =
        "Primero debe cargarse "
        + "una instancia.";

    traceln(
        mensajeInterfazPlanificacion
    );

    return;
}

if (
    !verificarCacheVialInstanciaActual()
) {

    mensajeInterfazPlanificacion =
        "Matriz vial incompleta."
        + "\nFaltan "
        + cacheVialTramosFaltantes
        + " tramos."
        + "\nExporte la matriz vial.";


    traceln(
        mensajeInterfazPlanificacion
    );


    return;
}

pypelineSolicitudEnCurso =
    true;


try {

    InstanciaTurno instancia =
        instanciaInterfazActual;


    String modoSolicitado =
        modoPlanificacionPypeline == null
        ? ""
        : modoPlanificacionPypeline
            .trim()
            .toUpperCase();


    traceln(
        "================================"
    );

    traceln(
        "=== SOLICITUD DE PLANIFICACIÓN ="
    );

    traceln(
        "================================"
    );

    traceln(
        resumenInstanciaInterfaz()
    );
    
    reiniciarPanelSelectorVisual(
	    modoSolicitado
	);

    traceln(
        "MODO SOLICITADO: "
        + modoSolicitado
    );


    PlanTurno plan =
        generarPlanSeleccionadoPypeline(
            instancia
        );


    traceln(
        "PLAN DEL SELECTOR RECIBIDO"
    );

    traceln(
        "Algoritmo resultante: "
        + plan.algoritmo
    );

    traceln(
        "Costo estimado: "
        + plan.costoEstimado
    );

    traceln(
        "Tiempo cómputo: "
        + plan.tiempoComputoMs
        + " ms"
    );


    // Representamos el plan antes de
    // comenzar la ejecución operativa.

    mostrarPlanEnGIS(
        instancia,
        plan
    );


    boolean iniciado =
        ejecutarPlan(
            instancia,
            plan
        );


    if (!iniciado) {

        throw new IllegalStateException(
            "ejecutarPlan devolvió false."
        );
    }


    // ejecutarPlan ya creó pedidosRuntime
    // y marcó las asignaciones como PLANIFICADO.

    actualizarEstadosPedidosGIS();


    mensajeInterfazPlanificacion =
        "Plan "
        + plan.algoritmo
        + " en ejecución.";


    boolean simulacionReanudada =
        runSimulation();


    if (!simulacionReanudada) {

        throw new IllegalStateException(
            "No fue posible reanudar "
            + "la simulación."
        );
    }


    ultimoModoEjecutado =
        modoSolicitado;


    instanciaInterfazActual =
        null;


} catch (Exception ex) {

    String detalleError =
        ex.getClass()
            .getSimpleName()
        + ": "
        + String.valueOf(
            ex.getMessage()
        );
        
    marcarSelectorErrorVisual(
	    detalleError
	);


    String detalleNormalizado =
        detalleError.toLowerCase(
            java.util.Locale.ROOT
        );


    boolean faltaTramoCacheVial =
        detalleNormalizado.contains(
            "no contiene el tramo dirigido"
        )
        ||
        (
            detalleNormalizado.contains(
                "keyerror"
            )
            &&
            detalleNormalizado.contains(
                "vial"
            )
        );


    if (faltaTramoCacheVial) {

        mensajeInterfazPlanificacion =
            "Faltan rutas viales."
            + "\nExportá la matriz vial"
            + "\ny volvé a planificar.";

    } else {

        mensajeInterfazPlanificacion =
            "Error de planificación."
            + "\nRevisá la consola.";
    }


    // El detalle completo queda disponible
    // en la consola para diagnóstico técnico.

    traceln(
        "ERROR SELECTOR PYPELINE: "
        + detalleError
    );


    ex.printStackTrace();


} finally {

    pypelineSolicitudEnCurso =
        false;
}]]></ActionCode>
					</BasicProperties>
					<ExtendedProperties>
						<Font Name="SansSerif" Size="10" Style="1"/>
						<LabelText><![CDATA[Generar y ejecutar plan]]></LabelText>
					</ExtendedProperties>
