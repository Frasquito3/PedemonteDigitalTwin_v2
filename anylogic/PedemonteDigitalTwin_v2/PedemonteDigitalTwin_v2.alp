					<Body><![CDATA[PlanTurno plan =
    new PlanTurno();

plan.instanciaId =
    instancia.instanciaId;

plan.algoritmo =
    AlgoritmoPlanificacion.MANUAL_TEST;


// =====================================================
// CAMIÓN 0
// =====================================================

PlanCamion camion0 =
    new PlanCamion();

camion0.camionId = 0;


// Viaje 1: solamente P002
ViajePlan viaje01 =
    new ViajePlan();

viaje01.numeroViaje = 1;

viaje01.pedidoIds.add("P002");

camion0.viajes.add(viaje01);


// Viaje 2:
// P003 requiere volcador.
// P001 después de P003 hace el viaje INVÁLIDO.
ViajePlan viaje02 =
    new ViajePlan();

viaje02.numeroViaje = 2;

viaje02.pedidoIds.add("P003");
viaje02.pedidoIds.add("P001");

camion0.viajes.add(viaje02);


// =====================================================
// CAMIÓN 1
// =====================================================

PlanCamion camion1 =
    new PlanCamion();

camion1.camionId = 1;

ViajePlan viaje11 =
    new ViajePlan();

viaje11.numeroViaje = 1;

viaje11.pedidoIds.add("P004");

camion1.viajes.add(viaje11);


// =====================================================

plan.camiones.add(camion0);
plan.camiones.add(camion1);

return plan;]]></Body>
