				<Control Type="Button">
				 	<EmbeddedIcon>false</EmbeddedIcon>				
					<Id>1787143902718</Id>
					<Name><![CDATA[btnPlanificarEjecutar]]></Name>
					<X>3005</X><Y>223</Y>
					<Label><X>0</X><Y>-10</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
					<BasicProperties Width="170" Height="38">
                        <EmbeddedIcon>false</EmbeddedIcon>	
						<TextColor>-15257011</TextColor>
						<Enabled>true</Enabled>
						<EnableExpression><![CDATA[instanciaInterfazActual != null
&&
cacheVialInstanciaCompleta
&&
!ejecucionEnCurso
&&
!pypelineSolicitudEnCurso]]></EnableExpression>
						<ActionCode><![CDATA[if (
    ejecucionEnCurso
    ||
    pypelineSolicitudEnCurso
) {

    traceln(
        "Ya existe una planificación "
        + "o ejecución en curso."
    );

    return;
}


if (
    instanciaInterfazActual == null
) {

    mensajeInterfazPlanificacion =
        "Primero debe cargarse "
        + "una instancia.";

    traceln(
        mensajeInterfazPlanificacion
    );

    return;
}


if (
    !verificarCacheVialInstanciaActual()
) {

    mensajeInterfazPlanificacion =
        "Matriz vial incompleta."
        + "\nFaltan "
        + cacheVialTramosFaltantes
        + " tramos."
        + "\nExporte la matriz vial.";


    traceln(
        mensajeInterfazPlanificacion
    );


    return;
}


pypelineSolicitudEnCurso =
    true;


try {

    InstanciaTurno instancia =
        instanciaInterfazActual;


    boolean usarPlanComparacion =
        planComparacionSeleccionadoListo
        &&
        planComparacionSeleccionadoActual
            != null;


    String modoSolicitado;


    PlanTurno plan;


    traceln(
        "================================"
    );

    traceln(
        "=== SOLICITUD DE PLANIFICACIÓN ="
    );

    traceln(
        "================================"
    );

    traceln(
        resumenInstanciaInterfaz()
    );


    if (usarPlanComparacion) {

        modoSolicitado =
            metodoPlanComparacionAplicado;


        if (
            modoSolicitado == null
            ||
            modoSolicitado.trim().isEmpty()
        ) {

            throw new IllegalStateException(
                "El plan comparativo no tiene "
                + "un método asociado."
            );
        }


        plan =
            planComparacionSeleccionadoActual;


        ResultadoValidacionPlan validacion =
            validarPlan(
                instancia,
                plan
            );


        if (!validacion.valido) {

            throw new IllegalStateException(
                "El plan comparativo dejó "
                + "de ser válido: "
                + validacion.errores
            );
        }


        if (
            vectorPlanComparacionSeleccionado
                == null
            ||
            vectorPlanComparacionSeleccionado
                .length < 5
        ) {

            throw new IllegalStateException(
                "No se conserva el vector "
                + "del plan comparativo."
            );
        }


        pypelineUltimoPlanVector =
            vectorPlanComparacionSeleccionado
                .clone();


        prepararVisualPlanComparacion(
            modoSolicitado,
            plan
        );


        traceln(
            "PLAN RECUPERADO DE LA "
            + "COMPARACIÓN ESTIMADA"
        );


    } else {

        modoSolicitado =
            modoPlanificacionPypeline == null
            ? ""
            : modoPlanificacionPypeline
                .trim()
                .toUpperCase();


        reiniciarPanelSelectorVisual(
            modoSolicitado
        );


        traceln(
            "MODO SOLICITADO: "
            + modoSolicitado
        );


        plan =
            generarPlanSeleccionadoPypeline(
                instancia
            );
    }


    traceln(
        "PLAN DEL SELECTOR RECIBIDO"
    );

    traceln(
        "Algoritmo resultante: "
        + plan.algoritmo
    );

    traceln(
        "Costo estimado: "
        + plan.costoEstimado
    );

    traceln(
        "Tiempo cómputo: "
        + plan.tiempoComputoMs
        + " ms"
    );


    mostrarPlanEnGIS(
        instancia,
        plan
    );


    boolean iniciado =
        ejecutarPlan(
            instancia,
            plan
        );


    if (!iniciado) {

        throw new IllegalStateException(
            "ejecutarPlan devolvió false."
        );
    }


    actualizarEstadosPedidosGIS();


    mensajeInterfazPlanificacion =
        "Plan "
        + plan.algoritmo
        + " en ejecución.";


    boolean simulacionReanudada =
        runSimulation();


    if (!simulacionReanudada) {

        throw new IllegalStateException(
            "No fue posible reanudar "
            + "la simulación."
        );
    }


    ultimoModoEjecutado =
        modoSolicitado;


    instanciaInterfazActual =
        null;


    if (usarPlanComparacion) {

        limpiarPlanComparacionSeleccionado();
    }


} catch (Exception ex) {

    String detalleError =
        ex.getClass()
            .getSimpleName()
        + ": "
        + String.valueOf(
            ex.getMessage()
        );


    marcarSelectorErrorVisual(
        detalleError
    );


    String detalleNormalizado =
        detalleError.toLowerCase(
            java.util.Locale.ROOT
        );


    boolean faltaTramoCacheVial =
        detalleNormalizado.contains(
            "no contiene el tramo dirigido"
        )
        ||
        (
            detalleNormalizado.contains(
                "keyerror"
            )
            &&
            detalleNormalizado.contains(
                "vial"
            )
        );


    if (faltaTramoCacheVial) {

        mensajeInterfazPlanificacion =
            "Faltan rutas viales."
            + "\nExportá la matriz vial"
            + "\ny volvé a planificar.";

    } else {

        mensajeInterfazPlanificacion =
            "Error de planificación."
            + "\nRevisá la consola.";
    }


    traceln(
        "ERROR SELECTOR PYPELINE: "
        + detalleError
    );


    ex.printStackTrace();


} finally {

    pypelineSolicitudEnCurso =
        false;
}]]></ActionCode>
					</BasicProperties>
