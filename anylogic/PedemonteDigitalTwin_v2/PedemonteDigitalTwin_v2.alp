				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788117538434</Id>
					<Name><![CDATA[maximoValorGraficoComparacion]]></Name>
					<X>-810</X><Y>5560</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[String[] metodos = {
    "RL",
    "HIBRIDO",
    "GREEDY",
    "RANDOM",
    "GA"
};


double maximo =
    Double.NaN;


for (
    String metodo
    : metodos
) {

    double valor =
        valorGraficoComparacion(
            metodo
        );


    if (
        Double.isNaN(
            valor
        )
        ||
        Double.isInfinite(
            valor
        )
        ||
        valor < 0.0
    ) {

        continue;
    }


    if (
        Double.isNaN(
            maximo
        )
        ||
        valor > maximo
    ) {

        maximo =
            valor;
    }
}


return
    Double.isNaN(
        maximo
    )
    ? 0.0
    : maximo;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788117550650</Id>
					<Name><![CDATA[anchoBarraGraficoComparacion]]></Name>
					<X>-810</X><Y>5590</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metodo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[double valor =
    valorGraficoComparacion(
        metodo
    );


double maximo =
    maximoValorGraficoComparacion();


if (
    Double.isNaN(
        valor
    )
    ||
    Double.isInfinite(
        valor
    )
    ||
    valor <= 0.0
    ||
    maximo <= 0.0
) {

    return 0.0;
}


double ancho =
    600.0
    *
    valor
    /
    maximo;


return Math.max(
    3.0,
    Math.min(
        600.0,
        ancho
    )
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788117576564</Id>
					<Name><![CDATA[textoValorGraficoComparacion]]></Name>
					<X>-810</X><Y>5620</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metodo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (
    graficoCostoTiempoSeleccionado()
) {

    double costo =
        valorGraficoCostoTiempo(
            metodo,
            "COSTO"
        );


    double tiempo =
        valorGraficoCostoTiempo(
            metodo,
            "TIEMPO"
        );


    if (
        Double.isNaN(costo)
        ||
        Double.isNaN(tiempo)
    ) {

        return "—";
    }


    return
        nombreVisibleRankingComparacion(
            metodo
        )

        + "\n"

        + formatearNumeroComparacion(
            costo,
            2
        )

        + " | "

        + formatearNumeroComparacion(
            tiempo,
            2
        )

        + " ms";
}

if (
    modoGraficoComparacionDoble()
) {

    double estimado =
        valorGraficoComparacionFuente(
            metodo,
            "Estimado"
        );


    double simulado =
        valorGraficoComparacionFuente(
            metodo,
            "Simulado"
        );


    return
        "E "
        + formatearValorGraficoComparacion(
            estimado
        )
        + " | S "
        + formatearValorGraficoComparacion(
            simulado
        );
}


return formatearValorGraficoComparacion(
    valorGraficoComparacion(
        metodo
    )
);]]></Body>
