			</ObservationField>
			<ObservationField>
				<Name><![CDATA[mensaje]]></Name>
				<Type><![CDATA[String]]></Type>
			</ObservationField>
			<ObservationField>
				<Name><![CDATA[costoTotal]]></Name>
				<Type><![CDATA[double]]></Type>
			</ObservationField>
			<ObservationField>
				<Name><![CDATA[tareasEntregadas]]></Name>
				<Type><![CDATA[int]]></Type>
			</ObservationField>
			<ObservationField>
				<Name><![CDATA[tareasNoEntregadas]]></Name>
				<Type><![CDATA[int]]></Type>
			</ObservationField>
			<ObservationField>
				<Name><![CDATA[viajesTotales]]></Name>
				<Type><![CDATA[int]]></Type>
			</ObservationField>
			<ObservationField>
				<Name><![CDATA[tiempoSimuladoMin]]></Name>
				<Type><![CDATA[double]]></Type>
			</ObservationField>
			<ObservationField>
				<Name><![CDATA[protocoloVersion]]></Name>
				<Type><![CDATA[int]]></Type>
			</ObservationField>
			<ObservationField>
				<Name><![CDATA[instanciaAceptada]]></Name>
				<Type><![CDATA[boolean]]></Type>
			</ObservationField>
			<ObservationField>
				<Name><![CDATA[planAceptado]]></Name>
				<Type><![CDATA[boolean]]></Type>
			</ObservationField>
			<ObservationField>
				<Name><![CDATA[cantidadPedidos]]></Name>
				<Type><![CDATA[int]]></Type>
			</ObservationField>
			<ObservationCode><![CDATA[protocoloVersion =
    root.alpyneProtocoloVersion;

configurado =
    root.alpyneConfigurado;

accionRecibida =
    root.alpyneAccionRecibida;

instanciaAceptada =
    root.alpyneInstanciaAceptada;

planAceptado =
    root.alpynePlanAceptado;

cantidadPedidos =
    root.alpyneCantidadPedidos;

ejecucionEnCurso =
    root.ejecucionEnCurso;

ejecucionFinalizada =
    root.ejecucionFinalizada;

error =
    root.alpyneError;

mensaje =
    root.alpyneMensaje;

costoTotal =
    root.costoTotalAlpyne();

tareasEntregadas =
    root.tareasEntregadasAlpyne();

tareasNoEntregadas =
    root.tareasNoEntregadasAlpyne();

viajesTotales =
    root.viajesTotalesAlpyne();


if (
    root.resultadoActual == null
    ||
    root.resultadoActual.metricasGlobales == null
) {

    tiempoSimuladoMin =
        0.0;

} else {

    tiempoSimuladoMin =
        root.resultadoActual
            .metricasGlobales
            .duracionTurnoRealMin;
}]]></ObservationCode>
			<StopCondition><![CDATA[root.esTerminalAlpyne()]]></StopCondition>
			<ActionField>
				<Name><![CDATA[accionCodigo]]></Name>
				<Type><![CDATA[int]]></Type>
			</ActionField>
			<ActionField>
				<Name><![CDATA[planVector]]></Name>
				<Type><![CDATA[double[]]]></Type>
			</ActionField>
			<ActionCode><![CDATA[root.alpynePlanVector =
    planVector == null
    ? new double[0]
    : planVector.clone();


root.procesarAccionAlpyne(
    accionCodigo
);]]></ActionCode>
			<ConfigurationField>
				<Name><![CDATA[seedEjecucion]]></Name>
				<Type><![CDATA[int]]></Type>
			</ConfigurationField>
			<ConfigurationField>
				<Name><![CDATA[instanciaVector]]></Name>
				<Type><![CDATA[double[]]]></Type>
			</ConfigurationField>
			<ConfigurationField>
				<Name><![CDATA[rutaPythonProyectoPypeline]]></Name>
				<Type><![CDATA[String]]></Type>
			</ConfigurationField>
			<ConfigurationCode><![CDATA[root.MODO_EJECUCION =
    ModoEjecucion.RL_EVALUATION;


root.PROVEEDORES_HABILITADOS =
    false;


/*
 * El modelo exportado se ejecuta dentro de una carpeta
 * temporal de Alpyne.
 *
 * La ruta recibida se guarda también como propiedad
 * del proceso Java porque las variables normales de
 * Main se inicializan nuevamente durante el arranque.
 */
String rutaPythonConfigurada =
    rutaPythonProyectoPypeline == null
    ? ""
    : rutaPythonProyectoPypeline.trim();


if (rutaPythonConfigurada.isEmpty()) {

    System.clearProperty(
        "pedemonte.python.root"
    );

} else {

    System.setProperty(
        "pedemonte.python.root",
        rutaPythonConfigurada
    );
}


root.rutaPythonProyectoPypeline =
    rutaPythonConfigurada;


root.alpyneSeedEjecucion =
    seedEjecucion;


root.alpyneInstanciaVector =
    instanciaVector == null
    ? new double[0]
    : instanciaVector.clone();]]></ConfigurationCode>
		</ReinforcementLearningExperiment>
	</Experiments>
