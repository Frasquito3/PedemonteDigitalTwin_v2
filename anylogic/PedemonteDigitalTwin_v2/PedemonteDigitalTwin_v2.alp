						<ActionCode><![CDATA[rutaArchivoExcelSubido =
    value;


traceln(
    "ARCHIVO EXCEL SUBIDO"
    + " | value="
    + value
);


boolean importado =
    importarPedidosExcel();


if (importado) {

    traceln(
        "IMPORTACION EXCEL OK"
        + " | "
        + mensajeFormulario
    );
    
    emitirEstadoPedidosWeb(
	    "",
	    "IMPORTAR_EXCEL_ANYLOGIC",
	    true,
	    mensajeFormulario
	);

} else {

    traceln(
        "IMPORTACION EXCEL FALLIDA"
        + " | "
        + mensajeFormulario
    );
}]]></ActionCode>
					</BasicProperties>
					<ExtendedProperties>
						<Font Name="SansSerif" Size="10" Style="1"/>
