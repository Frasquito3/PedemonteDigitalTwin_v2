				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ResultadoValidacionPlan]]></ReturnType>
					<Id>1786558755592</Id>
					<Name><![CDATA[validarPlan]]></Name>
					<X>-810</X><Y>220</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[plan]]></Name>
						<Type><![CDATA[PlanTurno]]></Type>
					</Parameter>
					<Body><![CDATA[ResultadoValidacionPlan resultado =
    new ResultadoValidacionPlan();


if (instancia == null) {
    resultado.agregarError("La instancia es null.");
    return resultado;
}


if (plan == null) {
    resultado.agregarError("El plan es null.");
    return resultado;
}


if (instancia.instanciaId == null
    || !instancia.instanciaId.equals(plan.instanciaId)) {

    resultado.agregarError(
        "El plan no corresponde a la instancia. " +
        "Instancia esperada: " + instancia.instanciaId +
        ", plan recibido: " + plan.instanciaId
    );
}


// -----------------------------------------------------
// Mapa de pedidos válidos
// -----------------------------------------------------

java.util.HashMap<String, PedidoInput> pedidosPorId =
    new java.util.HashMap<String, PedidoInput>();


for (PedidoInput pedido : instancia.pedidos) {

    if (pedido == null) {
        resultado.agregarError(
            "La instancia contiene un pedido null."
        );
        continue;
    }

    if (pedido.pedidoId == null
        || pedido.pedidoId.trim().isEmpty()) {

        resultado.agregarError(
            "Existe un pedido con ID vacío."
        );
        continue;
    }

    if (pedidosPorId.containsKey(pedido.pedidoId)) {

        resultado.agregarError(
            "ID de pedido duplicado en la instancia: "
            + pedido.pedidoId
        );

        continue;
    }

    pedidosPorId.put(
        pedido.pedidoId,
        pedido
    );


    if (pedido.turno != instancia.turno) {

        resultado.agregarError(
            "Pedido " + pedido.pedidoId +
            " pertenece al turno " + pedido.turno +
            " pero la instancia es " + instancia.turno
        );
    }
}


// -----------------------------------------------------
// Camiones
// -----------------------------------------------------

if (plan.camiones == null) {

    resultado.agregarError(
        "La lista de camiones del plan es null."
    );

    return resultado;
}


if (plan.camiones.size()
    != instancia.cantidadCamiones) {

    resultado.agregarError(
        "Cantidad incorrecta de camiones en el plan. " +
        "Esperados: " + instancia.cantidadCamiones +
        ", recibidos: " + plan.camiones.size()
    );
}


java.util.HashSet<Integer> camionesEncontrados =
    new java.util.HashSet<Integer>();

java.util.HashMap<String, Integer> cantidadAsignaciones =
    new java.util.HashMap<String, Integer>();


// Inicializamos el contador de todos los pedidos.
for (String pedidoId : pedidosPorId.keySet()) {
    cantidadAsignaciones.put(pedidoId, 0);
}


// -----------------------------------------------------
// Recorremos el plan
// -----------------------------------------------------

for (PlanCamion planCamion : plan.camiones) {

    if (planCamion == null) {

        resultado.agregarError(
            "El plan contiene un PlanCamion null."
        );

        continue;
    }


    if (planCamion.camionId < 0
        || planCamion.camionId
           >= instancia.cantidadCamiones) {

        resultado.agregarError(
            "camionId inválido: "
            + planCamion.camionId
        );
    }


    if (!camionesEncontrados.add(
            planCamion.camionId)) {

        resultado.agregarError(
            "Camión repetido en el plan: "
            + planCamion.camionId
        );
    }


    if (planCamion.viajes == null) {

        resultado.agregarError(
            "El camión " + planCamion.camionId +
            " tiene viajes = null."
        );

        continue;
    }


    for (ViajePlan viaje : planCamion.viajes) {

        if (viaje == null) {

            resultado.agregarError(
                "El camión " +
                planCamion.camionId +
                " contiene un viaje null."
            );

            continue;
        }


        if (viaje.pedidoIds == null
            || viaje.pedidoIds.isEmpty()) {

            resultado.agregarError(
                "Viaje vacío en camión "
                + planCamion.camionId +
                ", viaje "
                + viaje.numeroViaje
            );

            continue;
        }


        int cargaViaje = 0;

        int cantidadVolcadores = 0;

        int posicionVolcador = -1;


        for (
            int posicion = 0;
            posicion < viaje.pedidoIds.size();
            posicion++
        ) {

            String pedidoId =
                viaje.pedidoIds.get(posicion);


            if (!pedidosPorId.containsKey(
                    pedidoId)) {

                resultado.agregarError(
                    "Pedido inexistente en el plan: "
                    + pedidoId
                );

                continue;
            }


            PedidoInput pedido =
                pedidosPorId.get(pedidoId);


            cargaViaje +=
                pedido.unidadesCapacidad;


            if (pedido.turno
                != instancia.turno) {

                resultado.agregarError(
                    "Pedido " + pedidoId +
                    " pertenece a otro turno."
                );
            }


            if (pedido.requiereVolcador) {

                cantidadVolcadores++;

                posicionVolcador =
                    posicion;
            }


            int contador =
                cantidadAsignaciones.get(
                    pedidoId
                );

            cantidadAsignaciones.put(
                pedidoId,
                contador + 1
            );
        }


        // ---------------------------------------------
        // Capacidad
        // ---------------------------------------------

        if (cargaViaje
            > instancia.capacidadCamion) {

            resultado.agregarError(
                "Capacidad excedida. Camión "
                + planCamion.camionId +
                ", viaje "
                + viaje.numeroViaje +
                ": carga="
                + cargaViaje +
                ", capacidad="
                + instancia.capacidadCamion
            );
        }


        // ---------------------------------------------
        // Volcador
        // ---------------------------------------------

        if (cantidadVolcadores > 1) {

            resultado.agregarError(
                "Más de un pedido con volcador. " +
                "Camión "
                + planCamion.camionId +
                ", viaje "
                + viaje.numeroViaje
            );
        }


        if (
            cantidadVolcadores == 1
            &&
            posicionVolcador
            != viaje.pedidoIds.size() - 1
        ) {

            resultado.agregarError(
                "El pedido con volcador no es " +
                "el último del viaje. Camión "
                + planCamion.camionId +
                ", viaje "
                + viaje.numeroViaje
            );
        }
    }
}


// -----------------------------------------------------
// Todos los pedidos exactamente una vez
// -----------------------------------------------------

for (
    java.util.Map.Entry<String, Integer> entry
    : cantidadAsignaciones.entrySet()
) {

    if (entry.getValue() == 0) {

        resultado.agregarError(
            "Pedido no asignado: "
            + entry.getKey()
        );
    }


    if (entry.getValue() > 1) {

        resultado.agregarError(
            "Pedido asignado más de una vez: "
            + entry.getKey()
        );
    }
}


return resultado;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1786558904560</Id>
					<Name><![CDATA[prepararPedidosRuntime]]></Name>
					<X>-810</X><Y>250</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Body><![CDATA[pedidosRuntime.clear();


for (PedidoInput pedido : instancia.pedidos) {

    PedidoRuntime runtime =
        new PedidoRuntime(pedido);

    runtime.estado =
        EstadoPedido.PENDIENTE;

    pedidosRuntime.put(
        pedido.pedidoId,
        runtime
    );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[PlanCamion]]></ReturnType>
					<Id>1786558951929</Id>
					<Name><![CDATA[obtenerPlanCamion]]></Name>
					<X>-810</X><Y>280</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[plan]]></Name>
						<Type><![CDATA[PlanTurno]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[camionId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[for (PlanCamion planCamion : plan.camiones) {

    if (planCamion.camionId == camionId) {
        return planCamion;
    }
}


throw new IllegalArgumentException(
    "No existe PlanCamion para camionId="
    + camionId
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1786560383763</Id>
					<Name><![CDATA[notificarCamionFinalizado]]></Name>
					<X>-810</X><Y>310</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[camionId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[camionesFinalizados++;


traceln(
    "Main recibió fin de Camión "
    + camionId +
    ". Finalizados: "
    + camionesFinalizados +
    "/"
    + CANTIDAD_CAMIONES
);


if (
    camionesFinalizados
    >= CANTIDAD_CAMIONES
) {

    ejecucionEnCurso = false;

    ejecucionFinalizada = true;


    cerrarSistemaProveedores();


    resultadoActual =
    	construirResultadoTurno();


    traceln("");
    traceln("==============================");
    traceln("=== EJECUCIÓN FINALIZADA =====");
    traceln("==============================");


    imprimirMetricasCamiones(
        resultadoActual
    );
    
    imprimirMetricasGlobales(
    	resultadoActual
	);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1786560433139</Id>
					<Name><![CDATA[ejecutarPlan]]></Name>
					<X>-810</X><Y>340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instancia]]></Name>
						<Type><![CDATA[InstanciaTurno]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[plan]]></Name>
						<Type><![CDATA[PlanTurno]]></Type>
					</Parameter>
					<Body><![CDATA[ResultadoValidacionPlan validacion =
    validarPlan(
        instancia,
        plan
    );


if (!validacion.valido) {

    traceln("");
    traceln(
        "=== PLAN RECHAZADO ==="
    );

    for (
        String error
        : validacion.errores
    ) {

        traceln(
            "ERROR: " + error
        );
    }

    return false;
}


// -----------------------------------------------------
// Estado general
// -----------------------------------------------------

instanciaActual =
    instancia;

planActual =
    plan;

inicializarRNGsEjecucion(
    instancia.seedEjecucion
);

inicializarTravelTimeProvider(
    instanciaActual
);

inicializarTrabajadores();

ejecucionEnCurso =
    true;
    
inicializarSistemaProveedores();

ejecucionFinalizada =
    false;

camionesFinalizados =
    0;


// -----------------------------------------------------
// Crear runtime
// -----------------------------------------------------

prepararPedidosRuntime(
    instanciaActual
);


// -----------------------------------------------------
// Marcar asignaciones
// -----------------------------------------------------

for (
    PlanCamion planCamion
    : plan.camiones
) {

    for (
        ViajePlan viaje
        : planCamion.viajes
    ) {

        for (
            int orden = 0;
            orden < viaje.pedidoIds.size();
            orden++
        ) {

            String pedidoId =
                viaje.pedidoIds.get(
                    orden
                );


            PedidoRuntime runtime =
                obtenerPedidoRuntime(
                    pedidoId
                );


            runtime.estado =
                EstadoPedido.PLANIFICADO;

            runtime.camionIdAsignado =
                planCamion.camionId;

            runtime.numeroViajeAsignado =
                viaje.numeroViaje;

            runtime.ordenEnViaje =
                orden;
        }
    }
}


// -----------------------------------------------------
// Asignar plan a cada agente Camion
// -----------------------------------------------------

for (Camion camion : camiones) {

    PlanCamion planCamion =
        obtenerPlanCamion(
            plan,
            camion.camionId
        );

    camion.asignarPlan(
        planCamion
    );
}


traceln("");
traceln("==============================");
traceln("=== PLAN EN EJECUCIÓN ========");
traceln("==============================");
traceln(
    "Instancia: "
    + instancia.instanciaId
);
traceln(
    "Algoritmo: "
    + plan.algoritmo
);
traceln("");

for (Camion camion : camiones) {

    camion.activarEjecucion();
}


return true;]]></Body>
				</Function>
