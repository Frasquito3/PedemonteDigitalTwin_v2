		<JavaClass>
			<Id>1786556719840</Id>
			<Name><![CDATA[PedidoInput]]></Name>
			<Folder>1786556019063</Folder>
			<Text><![CDATA[/**
 * PedidoInput
 */	
public class PedidoInput implements Serializable {

	public String pedidoId = "";

	public String pedidoOriginalId = "";

	public int numeroParte = 1;

	public int totalPartes = 1;

	public Turno turno = Turno.MANANA;

	public double latitud = 0.0;

	public double longitud = 0.0;

	public int unidadesCapacidad = 0;

	public boolean requiereVolcador = false;

	public boolean tieneVentanaEspecifica = false;

	public int horaDesdeMin = 0;

	public int horaHastaMin = 0;

	public String cliente = "";

	public String direccion = "";

	public String barrio = "";

	public String observaciones = "";


	public boolean esSplit() {
	    return totalPartes > 1;
	}


	@Override
	public String toString() {
	    return "PedidoInput{" +
	        "pedidoId='" + pedidoId + '\'' +
	        ", pedidoOriginalId='" + pedidoOriginalId + '\'' +
	        ", parte=" + numeroParte + "/" + totalPartes +
	        ", turno=" + turno +
	        ", unidades=" + unidadesCapacidad +
	        ", volcador=" + requiereVolcador +
	        '}';
	}

}            ]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1786556831673</Id>
			<Name><![CDATA[InstanciaTurno]]></Name>
			<Folder>1786556019063</Folder>
			<Text><![CDATA[/**
 * InstanciaTurno
 */	
public class InstanciaTurno implements Serializable {

	public String instanciaId = "";

	public String fechaOperacion = "";

	public Turno turno = Turno.MANANA;

	public java.util.ArrayList<PedidoInput> pedidos =
	    new java.util.ArrayList<PedidoInput>();

	public double latCorralon = 0.0;

	public double lonCorralon = 0.0;

	public int capacidadCamion = 0;

	public int cantidadCamiones = 0;

	public int horaInicioTurnoMin = 0;

	public int horaFinObjetivoMin = 0;

	public int horaFinToleranciaMin = 0;

	public long seedEscenario = 0L;

	public long seedEjecucion = 0L;


	@Override
	public String toString() {
	    return "InstanciaTurno{" +
	        "instanciaId='" + instanciaId + '\'' +
	        ", turno=" + turno +
	        ", pedidos=" + pedidos.size() +
	        ", capacidadCamion=" + capacidadCamion +
	        ", cantidadCamiones=" + cantidadCamiones +
	        '}';
	}

}]]></Text>
		</JavaClass>
