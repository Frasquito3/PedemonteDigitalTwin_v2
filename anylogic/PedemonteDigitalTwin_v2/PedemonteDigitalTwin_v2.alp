					<Parameter>
						<Name><![CDATA[metodo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[fuente]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[double valor =
    valorGraficoComparacionFuente(
        metodo,
        fuente
    );


double maximo =
    maximoValorGraficoComparacionDoble();


if (
    Double.isNaN(valor)
    ||
    Double.isInfinite(valor)
    ||
    valor <= 0.0
    ||
    maximo <= 0.0
) {

    return 0.0;
}


double ancho =
    600.0
    *
    valor
    /
    maximo;


return Math.max(
    3.0,
    Math.min(
        600.0,
        ancho
    )
);]]></Body>
