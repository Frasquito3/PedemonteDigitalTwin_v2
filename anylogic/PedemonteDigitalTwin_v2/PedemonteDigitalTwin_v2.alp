						<Font Name="SansSerif" Size="10" Style="1"/>
						<LabelText><![CDATA[Agregar pedido]]></LabelText>
					</ExtendedProperties>
				</Control>
				<Control Type="Button">
				 	<EmbeddedIcon>false</EmbeddedIcon>				
